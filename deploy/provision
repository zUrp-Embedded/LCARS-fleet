#!/usr/bin/env bash
# SOURCE: deploy/provision
# AUTHOR: DrDree
# STARDATE: 2026-07-05
# STATUS: le runner du provisionnement — apply, doctor, mesure, list, audit sur modules.d/
#
# USAGE
#   provision apply  [--substrate S] [--only MODULE]… [--human USER] [--env FILE] [--verbose]
#                    [--port-forge N] [--port-deck N] [--port-ssh N] [--forge-project NOM]
#                    [--faits F]
#   provision doctor (mêmes options, sans --faits) [--porcelain]
#   provision mesure --faits F [--sans-privilege] [--substrate S] [--human USER] [--env FILE]
#                    [--port-forge N] [--port-deck N] [--port-ssh N] [--forge-project NOM]
#   provision list   [--substrate S]
#   provision audit  --before F --after F
#
#   apply    converge la machine, en root : chaque module joue check, fix, re-check
#   doctor   sonde seule, en root — le même check que l'apply
#   mesure   le préflight seul, pour un lanceur qui décide avant d'agir : sans root, ce qui se lit
#            sans privilège ; en root, les refus qui protègent la machine, mesurés par root. Ses
#            faits vont dans --faits ; --sans-privilege joue la première phase même en root, pour la
#            grille d'un installeur lancé directement en root
#   list     les modules sélectionnés et leurs en-têtes
#   audit    ce que la machine porte et que la table ne déclare pas, entre deux instantanés
#            « find / … > avant ; install ; find / … > après » (une ligne par objet :
#            <type> <mode> <uid>:<gid> <chemin>)
#
#   Un module modules.d/NN-nom.sh déclare en tête APPLY-ON (où il mute), CHECK-ON (où son état
#   doit être vrai), NEEDS: root et AFTER (les modules dont il emploie le travail, que « list »
#   affiche). Il est joué en processus séparé, dans l'ordre du préfixe, seul ordre du runner. Le
#   préflight (00) est la barrière de l'apply : un terrain qu'il ne déclare pas conforme ne reçoit
#   aucun autre module. Un apply qui reçoit --faits, la mesure root rendue conforme dans la même
#   invocation, ne le rejoue pas : il le compte, rendu par la mesure.
#
#   Codes  module check  0 conforme · 1 drift · 2 échec (ses lignes FAIL) · 3 mort avant son verdict
#          module apply  0 convergé · 1 échec · 2 drift résiduel · 3 mort avant son verdict
#          runner apply  0 convergé · 1 échec, ou terrain refusé par le préflight · 2 drift résiduel
#          runner doctor, mesure  0 conforme · 1 drift · 2 erreur
#          runner audit  0 rien de non déclaré · 1 au moins un objet non déclaré, ou instantané illisible
#          un refus avant tout module (commande ou option inconnue, valeur absente ou invalide, --env
#          illisible, substrat contredit) sort en 1, sous chaque commande
#
#   --substrate S    wsl, linux ou docker : celui que ce système mesure (docker si /.dockerenv ou
#                    LCARS_DOCKER=1, wsl sous un noyau Microsoft, linux sinon) ; un autre est refusé,
#                    sauf par list, qui lit les en-têtes du substrat nommé
#   --only M         ce module seulement, répétable — nom complet ou préfixe numérique ; apply joue
#                    le préflight en plus
#   --human USER     l'humain que les modules servent (défaut : SUDO_USER, sinon l'appelant)
#   --env FILE       fichier KEY=VALUE sourcé et exporté avant la lib ; les constantes de
#                    deploy/installer-constants.env ne s'y règlent pas
#   --port-forge N   ce que la machine publie ; retenu dans son journal pour les passes suivantes
#   --port-deck N
#   --port-ssh N
#   --forge-project NOM   la base des projets compose (NOM-forge, NOM-runner) et du nom d'hôte
#                    WSL ; une étiquette DNS, retenue dans le journal
#   --faits F        mesure : le fichier où le préflight écrit ses faits `nom=valeur`, et son
#                    verdict (preflight=conforme|refuse) ; apply : ce fichier, écrit par une mesure
#                    root conforme et privé à son compte (0600), à la place du préflight
#   --verbose, -v
#   --porcelain      (doctor seulement) une ligne MODULE=OK|DRIFT|FAIL|ERROR par module
#
#   LCARS_BUILTIN_HUMAN   l'humain de démonstration d'un banc, retenu dans le journal ; il ne se retire
#                    pas : son compte de forge porte son travail, et un terrain se refait

set -euo pipefail

SELF="$(readlink -f "$0")"
DEPLOY_DIR="$(dirname "$SELF")"
MODULES_DIR="$DEPLOY_DIR/modules.d"
export PROVISION_LIB="$DEPLOY_DIR/lib/provision-lib.sh"

usage() { sed -n '/^# USAGE/,/^$/p' "$SELF" | sed 's/^# \{0,1\}//'; }
die()   { echo "provision: $*" >&2; exit 1; }

[[ "$EUID" -ne 0 || -z "${LCARS_DECOR_ROOT:-}" ]] \
  || die "LCARS_DECOR_ROOT est posée et le runner tourne en root : ce décor de témoin déplace les chemins, pas les comptes, les paquets, les services ni docker. Retirer LCARS_DECOR_ROOT de l'environnement (sudo -E, profil du shell), puis relancer."

# ─── Args ───────────────────────────────────────────────────────────────────────────────────────
CMD="${1:-}"; shift || true
SUBSTRATE="auto"
PORCELAIN=0
ENV_FILE=""
AUDIT_BEFORE=""
AUDIT_AFTER=""
FAITS=""
SANS_PRIVILEGE=0
declare -a ONLY=()

# les validations ne rendent rien : dans une substitution `X="$(valid_port …)"`, le die ne tuerait
# que le sous-shell et le refus s'imprimerait sans refuser
valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "$2 : « $1 » n'est pas un nombre"
  (( $1 >= 1024 && $1 <= 65535 )) || die "$2 : $1 hors plage — 1024 à 65535 (sous 1024 le deck, qui tourne sous son compte de service, ne peut pas binder)"
}

# la base nomme les projets compose et, « _ » devenu « - », le hostname de l'instance (30-wsl) : une étiquette DNS
valid_project() {
  local etiquette="${1//_/-}"
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ && "$etiquette" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
    || die "$2 : « $1 » n'est pas une base de projet — minuscules, chiffres, « _ » et « - », ni « _ » ni « - » aux bords, 63 caractères au plus"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --substrate) SUBSTRATE="${2:?--substrate attend une valeur}"; shift 2 ;;
    --only)      ONLY+=("${2:?--only attend un module}"); shift 2 ;;
    --human)     export PROV_HUMAN="${2:?--human attend un user}"; shift 2 ;;
    --port-forge) valid_port "${2:?--port-forge attend un port}" --port-forge
                  export PROV_FORGE_HOST_PORT="$2"; shift 2 ;;
    --port-deck)  valid_port "${2:?--port-deck attend un port}" --port-deck
                  export PROV_DECK_PORT="$2"; shift 2 ;;
    --port-ssh)   valid_port "${2:?--port-ssh attend un port}" --port-ssh
                  export PROV_SSH_PORT="$2"; shift 2 ;;
    --forge-project) valid_project "${2:?--forge-project attend un nom}" --forge-project
                     export PROV_FORGE_BASE="$2"; shift 2 ;;
    --env)       ENV_FILE="${2:?--env attend un fichier}"; shift 2 ;;
    --faits)     FAITS="${2:?--faits attend un fichier}"; shift 2 ;;
    --sans-privilege) SANS_PRIVILEGE=1; shift ;;
    --porcelain) PORCELAIN=1; shift ;;
    --verbose|-v) export PROV_VERBOSE=1; shift ;;
    --before)    AUDIT_BEFORE="${2:?--before attend un fichier}"; shift 2 ;;
    --after)     AUDIT_AFTER="${2:?--after attend un fichier}"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    *) die "option inconnue: $1 (--help)" ;;
  esac
done
case "$CMD" in apply|doctor|mesure|list|audit) ;; ""|-h|--help) usage; exit 0 ;; *) die "commande inconnue: $CMD (--help)" ;; esac
[[ "$PORCELAIN" -eq 0 || "$CMD" == doctor ]] || die "--porcelain ne vaut que pour doctor : $CMD écrit son verdict et son journal en clair"
[[ -z "$FAITS" || "$CMD" == mesure || "$CMD" == apply ]] || die "--faits ne vaut que pour mesure, qui l'écrit, et apply, qui le reçoit"
[[ -n "$FAITS" || "$CMD" != mesure ]] || die "mesure écrit ses faits dans --faits FICHIER : sans lui, rien ne serait rendu"
[[ "${#ONLY[@]}" -eq 0 || "$CMD" != mesure ]] || die "--only ne vaut pas pour mesure : elle joue le préflight seul"
[[ "$SANS_PRIVILEGE" -eq 0 || "$CMD" == mesure ]] || die "--sans-privilege ne vaut que pour mesure"
# sous un décor de témoin, le runner ne tourne jamais en root (refus plus haut) : apply et doctor s'y jouent sans privilège
[[ "$EUID" -eq 0 || -n "${LCARS_DECOR_ROOT:-}" || ( "$CMD" != apply && "$CMD" != doctor ) ]] \
  || die "$CMD exige root : un fichier que ce compte ne lit pas passerait pour absent — relancer : sudo $SELF $CMD${ONLY[0]:+ --only ${ONLY[*]}}"
if [[ "$CMD" == mesure ]]; then
  : 2>/dev/null > "$FAITS" || die "--faits $FAITS : non inscriptible — la mesure y écrit ses faits"
  PROV_PHASE=sans-privilege; [[ "$EUID" -ne 0 || "$SANS_PRIVILEGE" -eq 1 ]] || PROV_PHASE=root
  export PROV_FACTS_FILE="$FAITS" PROV_PHASE
else
  # hors mesure, le préflight se joue entier et n'écrit aucun fait
  unset PROV_FACTS_FILE PROV_PHASE
  [[ -z "$FAITS" || "$(sed -n 's/^phase=//p' "$FAITS" 2>/dev/null)|$(sed -n 's/^preflight=//p' "$FAITS" 2>/dev/null)" == "root|conforme" ]] \
    || die "--faits $FAITS : ce n'est pas une mesure root conforme (phase=root, preflight=conforme) — apply refusé avant tout module"
  # la mesure de l'invocation écrit un fichier privé au compte qui joue l'apply : un fichier d'un autre ne dispense pas du préflight
  [[ -z "$FAITS" || "$(stat -c '%u %a' "$FAITS" 2>/dev/null)" == "$EUID 600" ]] \
    || die "--faits $FAITS : ce fichier n'a pas été écrit par la mesure de ce compte (propriétaire $EUID, mode 0600 attendus) — apply refusé avant tout module"
fi

if [[ -n "$ENV_FILE" ]]; then
  [[ -r "$ENV_FILE" ]] || die "--env illisible: $ENV_FILE"
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi

# Les paramètres retenus par la machine (ligne `params` de son journal) : lus après les drapeaux,
# avant les défauts de la lib — un drapeau explicite gagne, le défaut d'usine perd. Le chemin du
# journal se lit dans le fichier des constantes, que la lib n'a pas encore chargé.
_journal_params() {
  local f ligne kv k v
  # illisible, le refus revient à la lib, qui le nomme
  f="${LCARS_DECOR_ROOT:-}$(sed -n 's/^PROV_JOURNAL_FILE=//p' "$DEPLOY_DIR/installer-constants.env" 2>/dev/null)" || return 0
  [[ -r "$f" ]] || return 0
  ligne="$(sed -n 's/^params  *//p' "$f" | head -1)" || return 0
  for kv in $ligne; do
    k="${kv%%=*}"; v="${kv#*=}"
    [[ -n "$k" && "$k" != "$kv" ]] || continue
    [[ "$k" == PROV_* ]] || continue
    [[ -n "${!k:-}" ]] || export "$k=$v"
  done
}
_journal_params
[[ -z "${PROV_FORGE_BASE:-}" ]] || valid_project "$PROV_FORGE_BASE" PROV_FORGE_BASE

# shellcheck source=lib/provision-lib.sh
. "$PROVISION_LIB"

_mesure="$(detect_substrate)"
[[ "$SUBSTRATE" != "auto" ]] || SUBSTRATE="$_mesure"
case "$SUBSTRATE" in wsl|docker|linux) ;; *) die "substrat inconnu: $SUBSTRATE (wsl|docker|linux)" ;; esac
# un substrat forcé choisirait les modules d'un autre terrain : 30-wsl sur un linux, docker-ce à côté de Docker Desktop
[[ "$CMD" == list || "$SUBSTRATE" == "$_mesure" ]] \
  || die "--substrate $SUBSTRATE : ce système se mesure « $_mesure » — le substrat se constate, il ne se force pas. Relancer sans --substrate."
export PROV_SUBSTRATE="$SUBSTRATE"
unset _mesure

# Ce qui POSE refuse un nom demandé deux fois dans l'espace de noms de la forge ; ce qui LIT ne
# refuse rien — la machine fautive est celle qu'on veut sonder. Le nom arrive par trois chemins,
# et le journal en est un : une machine installée avant ce refus le rejouerait telle quelle.
[[ "$CMD" != apply ]] || prov_refuse_homonymes || exit 1

# l'uid du siège vient du compte qui a lancé le runner, jamais de --human
if [[ -z "${LCARS_SYSADMIN_UID:-}" ]]; then
  _seat_login="${SUDO_USER:-$(id -un)}"
  LCARS_SYSADMIN_UID="$(id -u -- "$_seat_login" 2>/dev/null)" \
    || die "uid du siège illisible pour « $_seat_login » (SUDO_USER, sinon l'appelant) — la garde du siège ne retient pas un uid deviné ; LCARS_SYSADMIN_UID le donne"
  unset _seat_login
fi
export LCARS_SYSADMIN_UID

# shellcheck disable=SC2119 # l'argument de prov_source_rev est optionnel : l'appel nu est le cas nominal
PROV_SOURCE_REV="$(prov_source_rev)"
export PROV_SOURCE_REV

# ─── Découverte et sélection ────────────────────────────────────────────────────────────────────
module_field() {
  sed -n "s/^# ${2}: *//p" "$1" | head -1
}

substrate_in() {
  prov_substrate_satisfait "$1" "$SUBSTRATE"
}

declare -a SELECTED=() EFFECTIVE=()
for mod in "$MODULES_DIR"/[0-9][0-9]-*.sh; do
  [[ -f "$mod" ]] || die "aucun module dans $MODULES_DIR"
  name="$(basename "$mod" .sh)"
  if [[ "$CMD" == mesure ]]; then
    [[ "$name" == 00-* ]] || continue
  elif [[ "${#ONLY[@]}" -gt 0 ]]; then
    keep=0
    for o in "${ONLY[@]}"; do [[ "$name" == "$o" || "$name" == "$o"-* ]] && keep=1; done
    # le préflight est la barrière de tout apply : --only choisit ce qui mute, pas ce qui garde
    [[ "$CMD" == apply && "$name" == 00-* ]] && keep=1
    [[ "$keep" -eq 1 ]] || continue
  fi
  substrate_in "$(module_field "$mod" CHECK-ON)" || continue
  SELECTED+=("$mod")
  if [[ -n "$FAITS" && "$CMD" == apply && "$name" == 00-* ]]; then
    EFFECTIVE+=("mesure")
  elif [[ "$CMD" == "apply" ]] && substrate_in "$(module_field "$mod" APPLY-ON)"; then
    EFFECTIVE+=("apply")
  else
    EFFECTIVE+=("check")
  fi
done
[[ "${#SELECTED[@]}" -gt 0 ]] || die "aucun module ne matche (substrat=$SUBSTRATE${ONLY[0]:+, only=${ONLY[*]}})"

if [[ "$CMD" == "list" ]]; then
  for mod in "${SELECTED[@]}"; do
    printf '%-28s APPLY-ON=%-12s CHECK-ON=%-10s NEEDS=%-6s AFTER=%s\n' "$(basename "$mod" .sh)" \
      "$(module_field "$mod" APPLY-ON)" "$(module_field "$mod" CHECK-ON)" "$(module_field "$mod" NEEDS)" \
      "$(module_field "$mod" AFTER)"
  done
  exit 0
fi

# ─── Verrou (apply) ─────────────────────────────────────────────────────────────────────────────
if [[ "$CMD" == "apply" ]]; then
  LOCK="$(prov_lock_path)" || die "verrou: emplacement sûr indisponible — apply refusé"
  exec 9>"$LOCK"
  flock -n 9 || die "un autre apply est en cours (lock: $LOCK)"
fi

# ─── Le journal de cette machine ────────────────────────────────────────────────────────────────
# shellcheck source=lib/provision-audit.sh
. "$(dirname "$PROVISION_LIB")/provision-audit.sh"

if [[ "$CMD" == "audit" ]]; then
  audit_run "$AUDIT_BEFORE" "$AUDIT_AFTER"
  exit $?
fi
if [[ "$CMD" == "apply" ]]; then
  PROV_JOURNAL_ACC="$(mktemp "${TMPDIR:-/tmp}/prov-journal.XXXXXX" 2>/dev/null)" \
    || die "aucun fichier temporaire ne se crée dans ${TMPDIR:-/tmp} — la passe y accumule son journal ; apply refusé avant tout module"
  export PROV_JOURNAL_ACC
fi

# run_module <module> <nom> <apply|check> — un sous-shell par module, le fd du verrou fermé (un enfant
# détaché par un module ne doit pas le garder)
run_module() {
  ( export PROVISION_RUN=1 PROVISION_MODULE="$2"; bash "$1" "$3" ) 9>&- </dev/null
}

garde_armee() { # garde_armee <module> → 0 s'il source la lib, dont la garde change une mort en 3
  grep -qE '^\. "\$\{PROVISION_LIB' "$1"
}

# ─── Exécution ──────────────────────────────────────────────────────────────────────────────────
total=0 ok=0 drift=0 failed=0 REFUS=0
declare -a REPORT=()

for i in "${!SELECTED[@]}"; do
  mod="${SELECTED[$i]}"
  name="$(basename "$mod" .sh)"
  eff="${EFFECTIVE[$i]}"
  total=$((total + 1))
  if [[ "$eff" == mesure ]]; then
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name (rendu par la mesure) ===${_PN}"
    ok=$((ok + 1)); REPORT+=("$name=OK")
    continue
  fi
  if [[ "$CMD" == "apply" && "$eff" == "check" ]]; then
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name (check — APPLY-ON=$(module_field "$mod" APPLY-ON), hors substrat $SUBSTRATE) ===${_PN}"
  else
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name ($eff) ===${_PN}"
  fi
  rc=0
  run_module "$mod" "$name" "$eff" || rc=$?
  if [[ "$CMD" == mesure ]]; then
    if [[ "$rc" -eq 0 ]]; then echo preflight=conforme; else echo preflight=refuse; fi >> "$FAITS"
  fi
  # tout verdict du préflight autre que « convergé » refuse le terrain, un plancher en dérive compris
  if [[ "$CMD" == apply && "$name" == 00-* && "$rc" -ne 0 ]]; then
    failed=$((failed + 1)); REPORT+=("$name=FAIL"); REFUS=1
    case "$rc" in
      1) constat="ses lignes FAIL ci-dessus" ;;
      2) constat="ses lignes DRIFT ci-dessus" ;;
      3) constat="la ligne ERREUR ci-dessus" ;;
      *) echo "${_PR}ERREUR $name:${_PN} mort avant de rendre son verdict (rc=$rc)" >&2
         constat="la ligne ERREUR ci-dessus" ;;
    esac
    echo "${_PR}ARRÊT${_PN} : le préflight refuse ce terrain ($constat) — aucun autre module n'est joué" >&2
    break
  fi
  case "$CMD:$eff:$rc" in
    *:*:3) failed=$((failed + 1)); REPORT+=("$name=ERROR") ;;
    doctor:check:0|mesure:check:0) ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    doctor:check:1|mesure:check:1) drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    # un module qui source la lib meurt en 3 par sa garde : son 2 est verdict_check sur ses lignes FAIL, qui
    # sont le constat ; sans la lib, un 2 peut être une mort sous pipefail, et reste une sonde en erreur
    doctor:check:2|mesure:check:2) if garde_armee "$mod"; then failed=$((failed + 1)); REPORT+=("$name=FAIL")
      else failed=$((failed + 1)); REPORT+=("$name=ERROR")
        echo "${_PR}ERREUR $name:${_PN} sonde en erreur (rc=2) — ce module ne source pas la lib : sans ligne FAIL au-dessus, il est mort avant de rendre son verdict" >&2
      fi ;;
    doctor:check:*|mesure:check:*)
      failed=$((failed + 1)); REPORT+=("$name=ERROR")
      echo "${_PR}ERREUR $name:${_PN} sonde en erreur (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est mort avant de rendre son verdict" >&2 ;;
    apply:apply:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    apply:apply:2)  drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    apply:apply:*)
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      echo "${_PR}ERREUR $name:${_PN} apply en échec (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est mort avant de rendre son verdict" >&2 ;;
    apply:check:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    apply:check:*)
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      echo "FAIL  $name: état-cible non tenu sur $SUBSTRATE et inapplicable ici (APPLY-ON=$(module_field "$mod" APPLY-ON)) — rebâtir l'image qui le fournit" >&2 ;;
  esac
done

# ─── Verdict ────────────────────────────────────────────────────────────────────────────────────
if [[ "$PORCELAIN" -eq 1 ]]; then
  printf '%s\n' "${REPORT[@]}"
else
  echo ""
  # Le journal s'écrit même quand la passe ne pose rien ; l'inventaire apt_installed s'additionne
  # avec celui des passes précédentes, le reste décrit cette passe.
  if [[ "$CMD" == "apply" ]]; then
    _journal_ancien=""
    [[ -r "$PROV_JOURNAL_FILE" ]] && _journal_ancien="$(grep -E '^apt_installed ' "$PROV_JOURNAL_FILE" || true)"
    if ! {
      mkdir -p "$(dirname "$PROV_JOURNAL_FILE")" \
      && {
        echo "# SOURCE: $PROV_JOURNAL_FILE"
        echo "# STATUS: mesure, pas declaration — ce qui a été posé sur cette machine ; deploy/system.manifest dit ce qui peut l'être."
        echo "posed_at      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "source_rev    $PROV_SOURCE_REV"
        echo "substrate     $SUBSTRATE"
        echo "params        $(prov_params_line)"
        echo "prefix        $PROV_PREFIX"
        echo "modules       total=$total ok=$ok drift=$drift failed=$failed"
        { printf '%s\n' "$_journal_ancien"; cat "$PROV_JOURNAL_ACC"; } \
        | awk 'NF { k=$1; $1=""; sub(/^ /,""); acc[k]=acc[k] " " $0 }
             END { for (k in acc) {
                     n=split(acc[k], w, " "); delete seen; out=""
                     for (i=1;i<=n;i++) if (w[i]!="" && !(w[i] in seen)) { seen[w[i]]=1; out=out " " w[i] }
                     printf "%-13s%s\n", k, out } }' | sort
      } > "$PROV_JOURNAL_FILE" \
      && chmod 0644 "$PROV_JOURNAL_FILE"
    } 2>/dev/null; then
      echo "  ${_PA}journal NON écrit ($PROV_JOURNAL_FILE) — la passe a joué, sa trace n'est pas posée${_PN}"
    fi
    rm -f "$PROV_JOURNAL_ACC"
  fi

  echo "${_PC}=== provision $CMD — substrat $SUBSTRATE · source $PROV_SOURCE_REV ===${_PN}"
  _tint() {
    if [[ "$3" -gt 0 ]]; then printf '%s%s: %s%s' "$1" "$2" "$3" "$_PN"; else printf '%s: %s' "$2" "$3"; fi
  }
  printf '  modules: %d · %s · %s · %s\n' "$total" \
    "$(_tint "$_PG" "conformes/convergés" "$ok")" \
    "$(_tint "$_PA" "drift" "$drift")" \
    "$(_tint "$_PR" "échecs" "$failed")"
  if [[ "$CMD" == "doctor" && "$drift" -gt 0 ]]; then
    if [[ "$SUBSTRATE" == "docker" ]]; then
      # qui lit ce doctor a tiré l'image publiée : le remède se joue depuis l'hôte, sans bâtir
      echo "  ${_PA}→ un conteneur ne se converge pas sur place :${_PN} depuis l'hôte, tirer à nouveau l'image de cette version"
      echo "    et recréer le conteneur sur ses volumes : LCARS_IMAGE=<image:version> deploy/container pull, puis"
      echo "    LCARS_IMAGE=<image:version> deploy/container -p <projet> up (un banc : deploy/docker/bench/bench-swap-image.sh"
      echo "    --forge-project <base> --image <image:version>). Si le drift revient sur l'image fraîche, le signaler avec"
      echo "    la révision $PROV_SOURCE_REV et ces lignes."
    else
      echo "  ${_PA}→ converger :${_PN} sudo $SELF apply"
    fi
  fi
  if [[ "$REFUS" -eq 1 ]]; then
    echo "  ${_PR}→ TERRAIN REFUSÉ${_PN} par le préflight — aucun module n'a été joué après lui ; son constat est au-dessus."
  elif [[ "$CMD" == "apply" && "$failed" -gt 0 ]]; then
    echo "  ${_PR}→ EN ÉCHEC${_PN} sur $failed module(s) — voir les lignes FAIL ci-dessus."
    [[ "$drift" -gt 0 ]] && \
      echo "    ($drift autre(s) module(s) en DRIFT : état-cible non tenu, souvent en conséquence.)"
  elif [[ "$CMD" == "apply" && "$drift" -gt 0 ]]; then
    echo "  ${_PA}→ APPLIQUÉ, MAIS L'ÉTAT-CIBLE N'EST PAS TENU${_PN} sur $drift module(s) — voir les lignes"
    echo "    DRIFT ci-dessus. Rien n'est cassé ; il manque un geste (forge, credentials, réseau)."
  fi
fi
[[ "$failed" -gt 0 ]] && exit "$([[ "$CMD" == "apply" ]] && echo 1 || echo 2)"
[[ "$drift" -gt 0 ]] && exit "$([[ "$CMD" == "apply" ]] && echo 2 || echo 1)"
exit 0
