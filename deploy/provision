#!/usr/bin/env bash
# SOURCE: deploy/provision
# AUTHOR: DrDree
# STARDATE: 2026-07-05
# STATUS: PROTO-V2 — LE point d'entrée provisioning : apply (converge), doctor (sonde nuke-drill), list
#
# Machine nue → `fleet_v2 start` fonctionnel, en UN geste rejouable à l'infini :
#     sudo deploy/provision apply
#     deploy/provision doctor        # sonde read-only — LA sonde du nuke-drill
#
# Modèle (inversion délibérée de la v1) :
#   - les modules `modules.d/NN-*.sh` sont des PROCESSUS exécutés, pas des scripts sourcés dans un
#     namespace commun : un module qui meurt rend SON verdict, il n'avorte pas le durcissement des
#     autres à moitié fait. L'ordre est le préfixe numérique, lisible dans un `ls`.
#   - chaque module expose `check` (sonde read-only) et `apply` (check → fix → re-check) ;
#     le doctor N'EST PAS un autre code : c'est le même check que l'apply utilise. Une seule vérité.
#   - chaque module DÉCLARE son terrain en tête (greppable, pas de registre à maintenir), sur
#     DEUX axes (D6 de l'ADR install/compile/release — les confondre rendait le doctor Docker
#     muet sur le verrou RO, le câblage bin et la sonde bwrap) :
#         # APPLY-ON: wsl linux   où les MUTATIONS tournent (en Docker le stage image a déjà
#                                 appliqué → l'apply de ce module est remplacé par son check)
#         # CHECK-ON: any         où l'ÉTAT-CIBLE doit être VRAI (le doctor sonde tout ça)
#         # NEEDS: root|human     SOUS QUELLE IDENTITÉ le module est joué (le runner la pose)
#   - AUCUNE sentinelle d'état : l'état, c'est le système, re-sondé à chaque run. (La machine à
#     états v1 — .install_ok/.fleet_ready/.deploy_ok/.offline-bootstrap éparpillées sur 2 dossiers —
#     pouvait rester coincée « ni-vierge-ni-provisionnée » sans un message pour l'humain.)
#   - pas de reprise-par-bashrc-trigger : après le reboot WSL (lockdown C:), l'humain RELANCE le
#     même apply — l'idempotence rend la reprise triviale, le doctor dit où on en est.
#
# Codes retour module (contrat) : check 0=conforme 1=drift 2=erreur-de-sonde ·
#                                 apply 0=convergé 1=échec 2=appliqué, drift résiduel ·
#                                 3 (les DEUX verbes) = MORT AVANT SON VERDICT, rendu par la garde
#                                 de sortie de provision-lib. Il lui fallait son propre code : `2`
#                                 est pris des deux cotes, et un module tue par `set -e` rendait
#                                 justement 2 — donc « rien n'est cassé » sur un module inacheve.
# Codes retour runner : apply 0=tout convergé 1=au moins un échec 2=appliqué, drift résiduel ·
#                       doctor 0=conforme 1=drift 2=erreur.
# Le 2 d'apply manquait, et son absence n'etait pas un trou de vocabulaire : un module qui constate
# une non-convergence dans son apply rendait 0, donc « tout convergé », drift compris a zero dans le
# bilan alors qu'une ligne DRIFT venait d'etre imprimee.
#
# USAGE :
#   provision apply  [--substrate S] [--only MODULE]… [--human USER] [--env FILE] [--verbose]
#                    [--port-forge N] [--port-deck N]
#   provision doctor [--substrate S] [--only MODULE]… [--human USER] [--env FILE] [--porcelain] [--verbose]
#   provision update [--substrate S] [--human USER] [--env FILE]
#   provision list   [--substrate S]
#   provision audit  --before F --after F  — ce que la MACHINE porte et que la table ne declare pas
#   provision uninstall [--substrate S] [--humans] [--annexes] [--yes]
#
# ⚠ `uninstall` MANQUAIT A CETTE LISTE, et c'est le seul verbe qui detruit. Un operateur qui lit
# l'en-tete ne pouvait pas savoir qu'il existe, ni — surtout — que SANS `--yes` il n'execute RIEN :
# il imprime le plan complet de ce qu'il retirerait, et sort. Le mode « lister sans detruire » n'est
# donc pas un drapeau a trouver, c'est le DEFAUT ; lui donner en plus un nom (`--dry-run`) ajouterait
# une piece mobile pour renommer ce qui se passe deja quand on ne demande rien.
#   `--yes`     execute. Demande root, parce qu'il retire des objets systeme.
#   `--humans`  retire aussi les COMPTES unix des personnes. ⚠ JAMAIS leur home : `/home` est hors
#               du perimetre entier, par tous les binaires — ni un `rm`, ni un `userdel -r`.
#   `--annexes` retire aussi les ANNEXES docker (§ 13) — la forge et le runner CI. SANS lui elles
#               sont GARDEES, et c'est le defaut : la forge est le PET du corpus, elle porte les
#               depots et le backlog. Un banc se jette par `bench-down.sh`, dont c'est le metier ;
#               `uninstall` desinstalle un DEPLOIEMENT et n'a pas a emporter ce qui le nourrit.
#               Les volumes restent dans les deux cas — ce drapeau ne touche que conteneurs+reseau.
#
# `audit` est la definition de fin du chantier d'empreinte, et le SEUL instrument sans angle mort.
# Un temoin qui lit le CODE herite des angles morts du code : deux unites systemd actives sont
# passees sous le mur ISO parce que leur nom se compose a l'execution sous un repertoire exempte,
# et `lcars-system` — un second compte de service — est ne sans que rien ne le signale. Le
# balayage d'une machine n'a aucun de ces angles : il voit ce QUI EST, pas ce qui est ecrit.
#
#   find / … > avant ; <install> ; find / … > apres ; provision audit --before avant --after apres
#
# Les deux instantanes se prennent avec le meme filtre ; le format attendu est
# « <type> <mode> <uid>:<gid> <chemin> », une ligne par objet. Ce que le diff montre et que la
# table ne couvre pas est un DEFAUT — pas une curiosite.
#
# `update` = la jambe runtime du triangle (source→forge→runtime) : pull --ff-only du checkout,
# APRÈS vérification d'autorité (le remote DOIT matcher PROV_EXPECTED_REPO — déclaré, jamais
# deviné), puis re-exec du runner FRAÎCHEMENT PULLÉ en `apply` (le provisioning qui vient
# d'arriver s'applique lui-même — pas de vieux code qui déroule du neuf). Toujours un converge
# COMPLET : pas de --only sur update (un update partiel est un état qu'on ne veut pas pouvoir
# représenter). Héritier direct de fleet-update.sh v1 (F-E1 : autorité-avant-pull ; « already
# up to date — reconverging anyway »).
# Options :
#   --substrate S   force le substrat (auto par défaut : docker si /.dockerenv, wsl si kernel
#                   Microsoft, linux sinon)
#   --only M        n'exécute que ce module (répétable ; nom complet ou préfixe numérique)
#   --human USER    humain cible des modules per-humain (défaut : SUDO_USER, sinon l'appelant)
#   --env FILE      fichier KEY=VALUE sourcé avant tout (surcharge les défauts de la lib)
#   --porcelain     (doctor) sortie machine `MODULE=OK|DRIFT|ERROR`, une ligne par module

set -euo pipefail

SELF="$(readlink -f "$0")"
# ⚠ NE PAS RENOMMER EN `PROV_ROOT` : la lib en a fait son contrat, et il y designe la RACINE
# D'INSTALL (`/opt/lcars`), dont derivent `PROV_PREFIX`, `PROV_TOKENS_DIR`, `PROV_CATALOGUES_WORK`.
# La collision est SILENCIEUSE — les modules sont des processus separes, ils n'heritent pas de la
# variable et continuent de poser au bon endroit. Seul le runner divergerait, et son journal
# mentirait sur ce qui vient d'etre installe.
DEPLOY_DIR="$(dirname "$SELF")"                     # l'arbre deploy/ de ce script, résolu UNE fois
MODULES_DIR="$DEPLOY_DIR/modules.d"                 # puis propagé par env — jamais d'heuristique ../..
export PROVISION_LIB="$DEPLOY_DIR/lib/provision-lib.sh"

# ⚠ L'AIDE SE DÉLIMITE PAR SON CONTENU, JAMAIS PAR DES NUMÉROS DE LIGNE : la forme `sed -n '6,52p'`
# tronque en silence dès qu'on insère une ligne en tête, et une aide amputée ne se signale pas.
usage() { sed -n '/^# Machine nue →/,/^#   --porcelain/p' "$SELF" | sed 's/^# \{0,1\}//'; }
die()   { echo "provision: $*" >&2; exit 1; }

[[ -f "$PROVISION_LIB" ]] || die "lib introuvable: $PROVISION_LIB"
[[ -d "$MODULES_DIR" ]]   || die "modules.d introuvable: $MODULES_DIR"

# ─── Args ─────────────────────────────────────────────────────────────────────────────────────────
CMD="${1:-}"; shift || true
SUBSTRATE="auto"
PORCELAIN=0
ENV_FILE=""
UNINSTALL_YES=0
AUDIT_BEFORE=""
AUDIT_AFTER=""
UNINSTALL_HUMANS=0
UNINSTALL_ANNEXES=0
declare -a ONLY=()

# ⚠ ELLE NE REND RIEN, ET C'EST LOAD-BEARING. Écrite en `export X="$(valid_port …)"`, son `die`
# tuait le SOUS-SHELL de la substitution : le script continuait, avec une valeur vide. Le refus
# s'imprimait et ne refusait pas.
valid_port() { # valid_port <valeur> <nom du drapeau> — valide ou meurt, n'imprime rien
  [[ "$1" =~ ^[0-9]+$ ]] || die "$2 : « $1 » n'est pas un nombre"
  (( $1 >= 1024 && $1 <= 65535 )) || die "$2 : $1 hors plage — 1024 à 65535 (sous 1024 le deck, qui tourne sous « lcars-system », ne peut pas binder)"
}

# ⚠ LA FORME EST CELLE DE DOCKER, PAS LA NÔTRE : elle ne s'assouplit pas.
valid_project() { # valid_project <valeur> <nom du drapeau>
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || die "$2 : « $1 » n'est pas un nom de projet compose — minuscules, chiffres, « _ » et « - », et le premier caractère n'est ni l'un ni l'autre"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --substrate) SUBSTRATE="${2:?--substrate attend une valeur}"; shift 2 ;;
    # ─── L'AXE DESTINATION (40-RAILS.md § 13) ────────────────────────────────
    #
    # ⚠ TROIS AXES, PAS DEUX : substrat (`--substrate`), forge (montée / fournie par
    # `FORGE_BASE_URL`). Il n'y a PAS d'axe destination (⚖ user 2026-09-04) : `--disposable`
    # portait jusqu'à `forge-gestures.sh` un nom d'humain de démonstration par défaut que plus
    # personne ne demandait — seul le banc sème un humain, et il le NOMME. Un déploiement de
    # travail n'en fabrique aucun : les personnes s'inscrivent sur la forge.
    --only)      ONLY+=("${2:?--only attend un module}"); shift 2 ;;
    --human)     export PROV_HUMAN="${2:?--human attend un user}"; shift 2 ;;
    # ⚠ IL N'Y A PAS DE `--fleet-human`, ET IL NE SE RÉINTRODUIT PAS : le nom de l'humain de fleet a
    # UNE source, « fleet/services/forge-gestures.sh builtin-human ». Un drapeau en poserait une
    # seconde, en concurrence avec elle.
    #
    # Les deux ports que la machine PUBLIE. Des DRAPEAUX et non des variables d'environnement :
    # une variable ne survit pas au `sudo` de la porte.
    --port-forge) valid_port "${2:?--port-forge attend un port}" --port-forge
                  export PROV_FORGE_HOST_PORT="$2"; shift 2 ;;
    --port-deck)  valid_port "${2:?--port-deck attend un port}" --port-deck
                  export PROV_DECK_PORT="$2"; shift 2 ;;
    --forge-project) valid_project "${2:?--forge-project attend un nom}" --forge-project
                     # LA BASE, pas le projet : `bob` donne `bob-forge` et `bob-runner` (48-forge-host).
                     export PROV_FORGE_BASE="$2"; shift 2 ;;
    --env)       ENV_FILE="${2:?--env attend un fichier}"; shift 2 ;;
    --porcelain) PORCELAIN=1; shift ;;
    --yes)       UNINSTALL_YES=1; shift ;;
    --humans)    UNINSTALL_HUMANS=1; shift ;;
    --annexes)   UNINSTALL_ANNEXES=1; shift ;;
    --verbose|-v) export PROV_VERBOSE=1; shift ;;
    # ⚠ DES DRAPEAUX, PAS DES POSITIONNELS : ce parseur consomme tout `$@` avant que le verbe ne
    # tourne, donc un argument positionnel meurt sur « option inconnue » sans jamais l'atteindre.
    --before)    AUDIT_BEFORE="${2:?--before attend un fichier}"; shift 2 ;;
    --after)     AUDIT_AFTER="${2:?--after attend un fichier}"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    *) die "option inconnue: $1 (--help)" ;;
  esac
done
case "$CMD" in apply|doctor|update|list|uninstall|audit) ;; ""|-h|--help) usage; exit 0 ;; *) die "commande inconnue: $CMD (--help)" ;; esac
[[ "$CMD" == "update" && "${#ONLY[@]}" -gt 0 ]] && die "update est TOUJOURS un converge complet — pas de --only (lance apply --only pour un module isolé)"

if [[ -n "$ENV_FILE" ]]; then
  [[ -r "$ENV_FILE" ]] || die "--env illisible: $ENV_FILE"
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi

# ─── CE QUE LA MACHINE SE RAPPELLE, LU AVANT QUE LA LIB NE FIGE SES DEFAUTS ─────────────────────
#
# ⚠ L'ORDRE EST TOUT, ET IL EST DEJA CELUI DU FICHIER. Les options de la ligne de commande ont
# EXPORTE leurs variables plus haut ; la lib, plus bas, pose ses defauts en `: "${VAR:=…}"`, qui ne
# mord que sur du vide. En lisant ICI, entre les deux, la memoire de la machine s'intercale
# exactement ou il faut : elle perd contre un drapeau explicite, elle gagne contre le defaut d'usine.
#
# LE DEFAUT QU'ELLE FERME : `apply --port-deck 20997` posait le deck sur 20997, et le `doctor` sans
# drapeau exigeait 20999 — le rail declarait en drift une machine qu'il venait de convergir. Un
# operateur voyait un drift qui ne partait jamais, sur un objet parfaitement conforme a ce qu'il
# avait demande.
#
# ⚠ LE JOURNAL ET PAS UN FICHIER DE PLUS. Il dit deja « ce qui a ete pose sur CETTE machine » et il
# porte deja `substrate` et `prefix` — des faits de la meme nature. Un second fichier d'etat aurait
# ouvert la question de savoir lequel des deux ment quand ils divergent.
_journal_params() {
  local f="${LCARS_JOURNAL_FILE:-${PROV_ROOT:-/opt/lcars}/var/install.journal}" ligne kv k v
  [[ -r "$f" ]] || return 0
  ligne="$(sed -n 's/^params  *//p' "$f" | head -1)" || return 0
  for kv in $ligne; do
    k="${kv%%=*}"; v="${kv#*=}"
    [[ -n "$k" && "$k" != "$kv" ]] || continue
    # La liste FERMEE vit dans la lib, mais elle n'est pas encore sourcee ici : la recopier serait
    # une seconde source. On accepte donc tout `PROV_*` que le journal porte — c'est NOUS qui
    # l'avons ecrit, et `prov_params_line` est le seul endroit qui decide de ce qui y entre.
    [[ "$k" == PROV_* ]] || continue
    [[ -n "${!k:-}" ]] || export "$k=$v"
  done
}
_journal_params

# shellcheck source=lib/provision-lib.sh
. "$PROVISION_LIB"

[[ "$SUBSTRATE" == "auto" ]] && SUBSTRATE="$(detect_substrate)"
case "$SUBSTRATE" in wsl|docker|linux) ;; *) die "substrat inconnu: $SUBSTRATE (wsl|docker|linux)" ;; esac
# ⚖ user 2026-09-04 (Q1, lot 7 du chantier deploy-independance) : docker N'EST PAS UN RAIL. L'image se
# bâtit par le Dockerfile, l'instance s'initialise côté produit (fleet/services/box/), et rien ne
# se rejoue au boot. `docker` reste un substrat de MESURE — c'est celui du stage `verify` de
# l'image (doctor au build) et de `list` — jamais un substrat qu'on converge ou qu'on désinstalle.
case "$CMD" in
  apply|uninstall) [[ "$SUBSTRATE" != "docker" ]] || die "docker n'est pas un rail : « $CMD » ne s'y joue pas.
  L'image se bâtit (deploy/docker/Dockerfile, « deploy/box build »), se vérifie au build (stage verify,
  « provision doctor --substrate docker ») et son instance s'initialise côté produit au boot
  (fleet/services/box/init.sh). Pour l'instance : « deploy/box status » · « deploy/box down »." ;;
esac
export PROV_SUBSTRATE="$SUBSTRATE"

# ─── L'UID DU SIÈGE — DÉRIVÉ ICI, UNE FOIS, ET SURTOUT PAS DEPUIS `PROV_HUMAN` ──────────────────
# ⚠ ET SURTOUT PAS DEPUIS `PROV_HUMAN`, MÊME S'IL PORTE LA MÊME VALEUR ICI. Le convergeur le
# REMPLACE par l'humain de fleet quand il rejoue les modules `NEEDS: human` pour un compte qu'il
# vient de matérialiser. Une dérivation posée dans la lib rendrait donc, dans CETTE passe-là, l'uid
# de l'humain de FLEET : la garde réserverait exactement le compte qu'elle doit laisser passer, et
# le siège deviendrait libre. Ici le runner n'a pas encore d'humain cible — c'est le seul point du
# rail où la question a une seule réponse.
#
# `:=` et pas `=` : une valeur posée par l'appelant reste la sienne (le banc en a besoin).
_seat_login="${SUDO_USER:-$(id -un)}"
_seat_uid="$(id -u -- "$_seat_login" 2>/dev/null || true)"
if [[ "$_seat_uid" =~ ^[0-9]+$ ]]; then
  : "${LCARS_SYSADMIN_UID:=$_seat_uid}"
else
  echo "[provision] uid du siège ILLISIBLE pour « $_seat_login » — LCARS_SYSADMIN_UID reste ${LCARS_SYSADMIN_UID:-1000}, donc GUARD B garde cet uid-là et pas celui du siège" >&2
  : "${LCARS_SYSADMIN_UID:=1000}"
fi
export LCARS_SYSADMIN_UID
unset _seat_login _seat_uid

# ─── D'OÙ VIENT CE QU'ON S'APPRÊTE À POSER ──────────────────────────────────────────────────────
# shellcheck disable=SC2119 # `prov_source_rev` prend un argument OPTIONNEL ; les args de fonction
# masquent ceux du script, donc l'appel nu est sur — c'est le cas nominal, pas un oubli.
PROV_SOURCE_REV="$(prov_source_rev)"
export PROV_SOURCE_REV

# ─── update : pull VÉRIFIÉ du checkout, puis re-exec du runner pullé en apply ─────────────────────
if [[ "$CMD" == "update" ]]; then
  [[ "$EUID" -eq 0 ]] || die "update exige root (il enchaîne sur apply) — relance : sudo $SELF update"
  ROOT="$(repo_root)"
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "update: $ROOT n'est pas un checkout git"

  [[ -n "$PROV_EXPECTED_REPO" ]] || die "update: PROV_EXPECTED_REPO non posé — déclare l'autorité COMPLÈTE, hôte compris (ex: PROV_EXPECTED_REPO=forge.example.org/fleet/lcars) via --env ou l'environnement ; SANS elle, aucun pull"
  case "$PROV_EXPECTED_REPO" in
    */*/*) ;;
    *) die "update: PROV_EXPECTED_REPO=« $PROV_EXPECTED_REPO » n'a pas d'hôte — une autorité sans hôte autorise n'importe quelle forge. Écris « <hôte>/<owner>/<repo> » (ex: forge.example.org/fleet/lcars)" ;;
  esac
  REMOTE_URL="$(git -C "$ROOT" remote get-url "$PROV_UPDATE_REMOTE" 2>/dev/null || true)"
  [[ -n "$REMOTE_URL" ]] || die "update: remote « $PROV_UPDATE_REMOTE » absent du checkout $ROOT"
  REMOTE_ID="$(prov_parse_remote "$REMOTE_URL")" \
    || die "update: remote « $REMOTE_URL » non analysable (forme inconnue, userinfo, ou chemin qui n'est pas <owner>/<repo>) — pull REFUSÉ"
  [[ "$REMOTE_ID" == "$PROV_EXPECTED_REPO" ]] \
    || die "update: remote « $REMOTE_URL » → « $REMOTE_ID » ≠ autorité déclarée « $PROV_EXPECTED_REPO » — pull REFUSÉ"

  # 2. Le pull s'exécute comme l'OWNER du checkout (jamais root : des objets .git root dans le
  #    checkout d'un humain = le clobber qu'on a fui). Identité validée avant usage (IEC, v1:84).
  OWNER="$(stat -c '%U' "$ROOT")"
  [[ "$OWNER" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "update: owner du checkout invalide: « $OWNER »"
  BEFORE="$(git -C "$ROOT" rev-parse --short=8 HEAD)"

  # Lock apply pris AVANT le pull (un converge concurrent pendant qu'on change le code sous lui
  # est exactement ce que le lock interdit) ; relâché avant le re-exec — le nouveau runner le reprend.
  LOCK="$(prov_lock_path)" || die "verrou: emplacement sûr indisponible — apply/update REFUSÉ"
  exec 9>"$LOCK"
  flock -n 9 || die "un autre apply/update est en cours (lock: $LOCK)"
  runuser -u "$OWNER" -- git -C "$ROOT" pull --ff-only "$PROV_UPDATE_REMOTE" \
    || die "update: pull --ff-only en échec (divergence ? réseau ?) — rien n'a été appliqué"
  AFTER="$(git -C "$ROOT" rev-parse --short=8 HEAD)"
  if [[ "$BEFORE" == "$AFTER" ]]; then
    echo "provision update: déjà à jour ($AFTER) — re-converge quand même (idempotent)"
  else
    echo "provision update: $BEFORE → $AFTER"
    git -C "$ROOT" --no-pager log --oneline "$BEFORE..$AFTER" | sed 's/^/  /'
  fi
  flock -u 9

  # 3. Re-exec du runner FRAÎCHEMENT PULLÉ : c'est le code qui vient d'arriver qui s'applique,
  #    pas celui chargé avant le pull (sinon un update du provisioning lui-même ne prend
  #    effet qu'à l'update SUIVANT — la faille self-update classique).
  REEXEC=(--substrate "$SUBSTRATE" --human "$PROV_HUMAN")
  [[ -n "$ENV_FILE" ]] && REEXEC+=(--env "$ENV_FILE")
  exec "$SELF" apply "${REEXEC[@]}"
fi

# ─── Découverte + filtrage ────────────────────────────────────────────────────────────────────────
module_field() { # $1=file $2=FIELD → valeur (vide si absent)
  sed -n "s/^# ${2}: *//p" "$1" | head -1
}

substrate_in() { # $1=liste (`any` ou mots séparés par des espaces) → 0 si $SUBSTRATE dedans
  [[ "$1" == "any" ]] && return 0
  case " $1 " in *" $SUBSTRATE "*) return 0 ;; *) return 1 ;; esac
}

declare -a SELECTED=() EFFECTIVE=()
for mod in "$MODULES_DIR"/[0-9][0-9]-*.sh; do
  [[ -f "$mod" ]] || die "aucun module dans $MODULES_DIR"
  name="$(basename "$mod" .sh)"
  apply_on="$(module_field "$mod" APPLY-ON)"
  check_on="$(module_field "$mod" CHECK-ON)"
  needs="$(module_field "$mod" NEEDS)"
  [[ -n "$apply_on" ]] || die "$name: header '# APPLY-ON:' manquant"
  [[ -n "$check_on" ]] || die "$name: header '# CHECK-ON:' manquant"
  [[ -n "$needs" ]]    || die "$name: header '# NEEDS:' manquant"
  # ─── CE QUE `AFTER` GARANTIT, ET CE QU'IL NE GARANTIT PAS ─────────────────────────────────────
  #
  # ⚠ IL VERIFIE DEUX CHOSES, ET IL EN LAISSE CROIRE TROIS. Les deux qu'il tient :
  #   · le module nomme EXISTE (une dependance vers un module renomme meurt ici, pas au run) ;
  #   · il PRECEDE dans l'ordre du rang (une arete qui remonte est refusee a l'ouverture).
  #
  # Ce qu'il ne tient pas, et qu'un lecteur suppose :
  #   · que TOUTES les dependances reelles soient declarees. Rien ne le mesure. Quatre aretes
  #     manquaient au 2026-09-02 — `60-deploy`->`15-toolchain`, `22-fleet-human`->`20-groups`,
  #     `25-directories`->`20-groups`+`21-service-accounts`, `64-services`->trois de plus — toutes
  #     reelles, toutes declarables, aucune declaree. Elles le sont maintenant ; rien n'empeche la
  #     cinquieme d'etre oubliee.
  #   · que `--only` ferme transitivement. Il ne joue QUE ce qu'on lui nomme : demander un module
  #     sans ses `AFTER` est permis, et c'est parfois le geste voulu.
  #
  # ⚠ ET CERTAINES ARETES REELLES NE SONT PAS DECLARABLES DU TOUT — c'est la limite dure, pas un
  # oubli. La garde du rang refuse une dependance qui ne precede pas, or il en existe deux :
  # `45-catalogues` a besoin de l'adresse de forge qu'ecrit `48-forge-host` (trois rangs plus loin),
  # et `48-forge-host` lisait la release que `60-deploy` pose (douze rangs plus loin). Les deux sont
  # traitees dans les modules concernes, en le NOMMANT ; aucune ne peut vivre ici.
  #
  # Ce champ est donc une liste de CICATRICES D'ORDRE verifiees, pas un graphe de dependances
  # complet. Le prefixe numerique reste l'autorite.
  after="$(module_field "$mod" AFTER)"
  for dep in $after; do
    [[ -f "$MODULES_DIR/$dep.sh" ]] || die "$name: AFTER nomme « $dep », qui n'est pas un module de $MODULES_DIR"
    [[ "$dep" < "$name" ]] || die "$name: AFTER « $dep », mais $dep ne le precede pas — le rang est l'ordre, renomme l'un des deux"
  done
  if [[ "$check_on" != "any" ]]; then
    for s in $apply_on; do
      [[ "$s" == "any" ]] && die "$name: APPLY-ON any exige CHECK-ON any"
      case " $check_on " in *" $s "*) ;; *) die "$name: APPLY-ON contient « $s » hors de CHECK-ON ($check_on)" ;; esac
    done
  fi
  if [[ "${#ONLY[@]}" -gt 0 ]]; then
    keep=0
    for o in "${ONLY[@]}"; do [[ "$name" == "$o" || "$name" == "$o"-* ]] && keep=1; done
    [[ "$keep" -eq 1 ]] || continue
  fi
  substrate_in "$check_on" || continue
  SELECTED+=("$mod")
  if [[ "$CMD" == "apply" ]] && substrate_in "$apply_on"; then
    EFFECTIVE+=("apply")
  else
    EFFECTIVE+=("check")
  fi
done
[[ "${#SELECTED[@]}" -gt 0 ]] || die "aucun module ne matche (substrat=$SUBSTRATE${ONLY[0]:+, only=${ONLY[*]}})"

if [[ "$CMD" == "list" ]]; then
  for mod in "${SELECTED[@]}"; do
    printf '%-28s APPLY-ON=%-12s CHECK-ON=%-10s NEEDS=%-6s AFTER=%s\n' "$(basename "$mod" .sh)" \
      "$(module_field "$mod" APPLY-ON)" "$(module_field "$mod" CHECK-ON)" "$(module_field "$mod" NEEDS)" \
      "$(module_field "$mod" AFTER)"
  done
  exit 0
fi

# ─── Garde de privilège (apply) ───────────────────────────────────────────────────────────────────
# Le runner N'ESCALADE JAMAIS lui-même : pas d'`exec sudo` caché, c'est la porte qui porte le
# consentement et l'escalade. Il DÉS-escalade en revanche — un module `NEEDS: human` est joué sous
# son humain par `run_module`, donc root peut tout appliquer.
if [[ "$CMD" == "apply" && "$EUID" -ne 0 ]]; then
  for i in "${!SELECTED[@]}"; do
    if [[ "${EFFECTIVE[$i]}" == "apply"&& "$(module_field "${SELECTED[$i]}" NEEDS)" == "root" ]]; then
      die "apply exige root pour $(basename "${SELECTED[$i]}" .sh) — relance : sudo $SELF apply${ONLY[0]:+ --only ${ONLY[*]}}"
    fi
  done
fi

# ─── Lock anti-runs-concurrents (apply seulement — doctor est read-only, libre) ──────────────────
if [[ "$CMD" == "apply" ]]; then
  # ⚠ DÉRIVÉE, JAMAIS PASSÉE EN ARGUMENT : rien de ce que l'APPELANT écrit ne décide de ce qui est
  # verrouillé. Un `--per-human` pourrait mentir ; `SELECTED` est ce qui va réellement tourner —
  # d'où le verrou APRÈS la sélection.
  _lock_scope=""
  if [[ -n "${PROV_HUMAN:-}" ]]; then
    _lock_scope="$PROV_HUMAN"
    for mod in "${SELECTED[@]}"; do
      [[ "$(module_field "$mod" NEEDS)" == "human" ]] || { _lock_scope=""; break; }
    done
  fi

  LOCK="$(prov_lock_path "$_lock_scope")" || die "verrou: emplacement sûr indisponible — apply REFUSÉ"
  exec 9>"$LOCK"
  flock -n 9 \
    || die "un autre apply est en cours${_lock_scope:+ pour « $_lock_scope »} (lock: $LOCK)"
fi

# ─── LE JOURNAL DE CETTE MACHINE ─────────────────────────────────────────────────────────────────
JOURNAL_FILE="${LCARS_JOURNAL_FILE:-$PROV_ROOT/var/install.journal}"
MANIFEST_FILE="${LCARS_SYSTEM_MANIFEST:-$(dirname "$SELF")/system.manifest}"

# ─── uninstall — IL NE CONTIENT AUCUNE LISTE ────────────────────────────────────────────────────
uninstall_run() {
  [[ -r "$MANIFEST_FILE" ]] || die "manifeste introuvable ($MANIFEST_FILE) — un désinstalleur qui devine est plus dangereux qu'un qui s'arrête"

  local rows preserve_roots=() journal_pkgs=() cls trait obj _mode _owner sub
  rows="$(grep -vE '^\s*#|^\s*$' "$MANIFEST_FILE")"

  # ⚠ LA CLASSE SE LIT TOUJOURS DECOUPEE. Un trait qualifie la classe (`anchor:cond`), il ne la
  # remplace pas — comparer la colonne brute a « anchor » ferait tomber la ligne dans le silence du
  # `case`, sans classe et sans erreur. Le seul mode de defaillance d'un suffixe optionnel est muet.
  split_class() { # split_class <colonne 1> — pose `cls` et `trait`
    cls="${1%%:*}"
    trait="${1#*:}"; [[ "$trait" != "$1" ]] || trait=""
  }

  while read -r cls obj _mode _owner sub; do
    split_class "$cls"
    [[ "$cls" == "preserve" ]] && preserve_roots+=("$obj")
  done <<<"$rows"

  preserved() { # preserved <chemin> -> 0 si lui-meme ou un ancetre est preserve
    local p="$1" r
    for r in "${preserve_roots[@]}"; do
      [[ "$p" == "$r" || "$p" == "$r"/* ]] && return 0
    done
    return 1
  }

  # LES COMPTES D'HUMAINS : la carte du convergeur, LUE AVANT TOUT.
  #
  # ⚠ ELLE VIT DANS UN REPERTOIRE QUE CE VERBE RETIRE : la seule source qui sache quels comptes LCARS
  # a materialises est detruite par la passe qui en a besoin. On la lit ici, avant qu'aucun objet ne parte.
  #
  # ⚠ ET LE SIEGE EST DEDANS : `forge_id = 1` est l'operateur lui-meme — pas un compte que LCARS a
  # cree, celui qui a lance l'install. D'ou les DEUX exclusions de l'awk : le retirer supprimerait
  # la personne qui desinstalle.
  local -a persons=()
  local _seat_login; _seat_login="$(prov_seat_from_map 2>/dev/null || true)"
  if [[ -r "${PROV_UID_MAP_FILE:-}" ]]; then
    mapfile -t persons < <(
      awk -F'\t' -v seat="${_seat_login:-}" '$1 != 1 && $3 != "" && $3 != seat { print $3 }' \
        "$PROV_UID_MAP_FILE" 2>/dev/null | sort -u)
  fi

  # LES PROJETS DOCKER : le journal, et lui seul. Leur nom se DERIVE de `PROV_FORGE_PROJECT`,
  # surchargeable par `--forge-project` — aucune table statique ne peut le porter.
  local -a docker_projects=() annexes_gardees=()
  [[ -r "$JOURNAL_FILE" ]] && mapfile -t docker_projects < <(
    awk '$1=="posed_docker"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" | tr ' ' '\n' | grep -v '^$' | sort -u)

  # ⚠ LA DECISION SE PREND ICI, A LA LECTURE — PAS A L'EXECUTION. C'est l'emplacement de la garde
  # `/home` (A1), et pour la meme raison : ce qui est ECARTE ne doit jamais entrer dans le plan.
  # Une garde posee apres le point de non-retour laisse le plan annoncer une destruction qui
  # n'aura pas lieu — et le plan est justement ce que l'operateur lit AVANT de decider.
  #
  # ⚠ ET C'EST CE QUI REND LE CONTRAT TESTABLE. `--yes` exige root, donc aucune suite ne peut jouer
  # l'execution : une garde qui n'agit que la n'est verifiable que par lecture du code. Ici, le
  # PLAN compte — et un temoin qui compte mord, comme celui du substrat.
  if [[ "$UNINSTALL_ANNEXES" -ne 1 && "${#docker_projects[@]}" -gt 0 ]]; then
    annexes_gardees=("${docker_projects[@]}")
    docker_projects=()
  fi

  # LE DEPOT APT POSE SOUS CONDITION : le journal, et lui seul. Il n'est pose que sur `linux` et
  # seulement si aucun daemon ne repond — une condition qu'aucune ligne statique ne sait porter. Le
  # declarer dans la table autoriserait a detruire le depot d'un operateur qui l'avait deja ; ne
  # rien declarer le laisserait sur la machine pour toujours.
  local -a apt_repo_files=()
  [[ -r "$JOURNAL_FILE" ]] && mapfile -t apt_repo_files < <(
    awk '$1=="posed_apt_repo"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" | tr ' ' '\n' | grep -v '^$' | sort -u)

  # LES PAQUETS : le journal, et lui seul.
  # Le FAIT « ce journal etait lisible » se capture ici parce qu'il ne le sera plus a la fin : la
  # boucle `dirs` emporte la racine d'install, journal compris, bien avant le bilan de sortie.
  local _journal_lisible=0
  [[ -r "$JOURNAL_FILE" ]] && _journal_lisible=1
  if [[ -r "$JOURNAL_FILE" ]]; then
    mapfile -t journal_pkgs < <(awk '$1=="apt_installed"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" | tr ' ' '\n' | grep -v '^$' | sort -u)
  fi

  # ─── LE PLAN ──────────────────────────────────────────────────────────────────────────────────
  local -a files=() dirs=() groups=() humans=() accounts=() refuses_home=() refuses_home_j=()
  applies_here() { # applies_here <colonne substrat> -> 0 si cet objet concerne CE substrat
    local col="$1"
    [[ "$col" == "any" ]] && return 0
    [[ ",${col//+/,}," == *",$SUBSTRATE,"* ]]
  }
  # ⚠ UN SEUL PREDICAT, PARCE QUE LE DEFAUT ETAIT D'EN AVOIR UN SEUL SITE. La boucle de la TABLE
  # portait cette garde ; celle du JOURNAL, non — et le journal alimente le MEME plan executable.
  # Deux modules `NEEDS: root` posent sous /home par des primitives qui JOURNALISENT (`30-wsl` :
  # `$home/.config` et un lien ; `45-sudoers-toolchain` : `$home/.claude/skills/system-issues`),
  # donc ces chemins entraient dans le `rm -rf` pendant que le bilan imprimait, deux ecrans plus
  # haut, « JAMAIS retires, par aucun drapeau ». Mesure du 2026-09-01 : plan vierge = 0 fichier /
  # 2 dirs ; les trois memes entrees ajoutees au journal = 1 fichier / 4 dirs.
  #
  # Une garde qui vit a UN endroit du plan n'est pas une garde : elle est une propriete du chemin
  # qu'on a relu. Un predicat nomme, lui, se cherche — et son absence dans une quatrieme boucle se
  # voit.
  sous_home() { [[ "$1" == /home || "$1" == /home/* ]]; }

  expand_version() { # expand_version <chemin pouvant porter <version>> -> 0..n chemins reels
    local pat="$1"
    [[ "$pat" == *"<version>"* ]] || { printf '%s\n' "$pat"; return 0; }
    local g; for g in ${pat//<version>/*}; do [[ -e "$g" ]] && printf '%s\n' "$g"; done
  }

  local resolved
  local -a jokers=()
  while read -r cls obj _mode _owner sub; do
    split_class "$cls"
    applies_here "$sub" || continue
    preserved "$obj" && continue
    # `merge` : le fichier est a quelqu'un d'autre, on n'y a POSE qu'une cle. Le retirer detruirait
    # la configuration de son proprietaire pour desinstaller la notre.
    [[ "$trait" == "merge" ]] && continue
    while read -r resolved; do
      [[ -n "$resolved" ]] || continue
      # ⚠ CE QUI VIENT D'UN JOKER SE NOMME DANS LE PLAN : un chemin resolu depuis un motif est
      # precisement celui que l'operateur n'a pas ecrit et ne peut pas deviner. « 4 repertoire(s) »
      # ne se relit pas.
      [[ "$obj" == "$resolved" ]] || jokers+=("$resolved")
      # ⚠ LA GARDE EST DANS LE CODE, PAS DANS LA TABLE, ET C'EST LA DIFFERENCE QUI COMPTE. `preserve`
      # protege ce qu'on a pense a y ecrire ; celle-ci protege `/home` meme quand personne n'y a
      # pense. Une ligne `dir /home/<n'importe quoi>` ajoutee demain — par distraction, ou parce
      # qu'un objet operator-facing semblait y avoir sa place — retomberait sinon dans un `rm -rf`
      # sans qu'aucun relecteur ait a s'en apercevoir. Un perimetre qui depend de la vigilance de
      # celui qui edite la table n'est pas un perimetre.
      if sous_home "$resolved"; then
        [[ "$cls" == "human" ]] && humans+=("$resolved")   # inventaire seul : on le DIT, on n'y touche pas
        [[ "$cls" == "human" ]] || refuses_home+=("$cls $resolved")
        continue
      fi
      case "$cls" in
        anchor|link|runtime) files+=("$resolved") ;;
        dir|prefix)          dirs+=("$resolved") ;;
        group)               groups+=("$resolved") ;;
        human)               humans+=("$resolved") ;;
        account)             accounts+=("$resolved") ;;
      esac
    done < <(expand_version "$obj")
  done <<<"$rows"

  # ─── CE QUE LE JOURNAL SAIT ET QUE LA TABLE A OUBLIE ──────────────────────────────────────────
  # ⚠ LE JOURNAL NE PRIME JAMAIS SUR `preserve` — d'ou le filtre EN PREMIER. C'est la seule classe
  # dont l'autorite est absolue, et un second inventaire ne doit pas la contourner par derriere.
  local -a journal_files=() journal_dirs=()
  if [[ -r "$JOURNAL_FILE" ]]; then
    local _o _known
    while read -r _o; do
      [[ -n "$_o" ]] || continue
      preserved "$_o" && continue
      # `preserved` N'EST PAS UN PERIMETRE : il protege ce qu'on a pense a y ecrire. Voir `sous_home`.
      sous_home "$_o" && { refuses_home_j+=("$_o"); continue; }
      _known=0
      for _k in ${files[@]+"${files[@]}"} ${dirs[@]+"${dirs[@]}"}; do
        [[ "$_o" == "$_k" || "$_o" == "$_k"/* ]] && { _known=1; break; }
      done
      [[ "$_known" -eq 1 ]] && continue
      journal_files+=("$_o")
    done < <(awk '$1=="posed_file"||$1=="posed_link"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" \
               | tr ' ' '\n' | grep -v '^$' | sort -u)
    while read -r _o; do
      [[ -n "$_o" ]] || continue
      preserved "$_o" && continue
      sous_home "$_o" && { refuses_home_j+=("$_o"); continue; }
      _known=0
      for _k in ${dirs[@]+"${dirs[@]}"}; do
        [[ "$_o" == "$_k" || "$_o" == "$_k"/* ]] && { _known=1; break; }
      done
      [[ "$_known" -eq 1 ]] && continue
      journal_dirs+=("$_o")
    done < <(awk '$1=="posed_dir"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" \
               | tr ' ' '\n' | grep -v '^$' | sort -u)
    files+=(${journal_files[@]+"${journal_files[@]}"})
    dirs+=(${journal_dirs[@]+"${journal_dirs[@]}"})
  fi

  mapfile -t dirs < <(printf '%s\n' "${dirs[@]}" | awk '{ print gsub(/\//,"/"), $0 }' | sort -rn | cut -d' ' -f2-)

  echo "${_PC}=== provision uninstall — plan lu dans $(basename "$MANIFEST_FILE") ===${_PN}"
  # ⚠ CES DEUX-LA SE NOMMENT, ILS NE SE COMPTENT PAS : venus du journal, l'operateur ne peut pas les
  # retrouver en relisant la table. Les compter lui cacherait ce qu'il ne peut pas deviner.
  if [[ "${#apt_repo_files[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "dépôt apt" "${apt_repo_files[*]} — posés par CETTE install (journal)"
  fi
  if [[ "${#journal_files[@]}" -gt 0 || "${#journal_dirs[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "hors table" \
      "${journal_files[*]-}${journal_files[*]+ }${journal_dirs[*]-} — POSÉS par cette install, ABSENTS de la table (journal)"
  fi
  printf '  %-10s %d objet(s)\n' "fichiers" "${#files[@]}"
  printf '  %-10s %d répertoire(s)\n' "dirs" "${#dirs[@]}"
  printf '  %-10s %d groupe(s)\n' "groupes" "${#groups[@]}"
  printf '  %-10s %d compte(s) de service\n' "comptes" "${#accounts[@]}"
  if [[ "${#docker_projects[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "docker" "${docker_projects[*]} — ${_PA}DÉTRUITS (--annexes)${_PN} : conteneurs et réseau. Les volumes restent."
  fi
  if [[ "${#journal_pkgs[@]}" -gt 0 ]]; then
    printf '  %-10s %d paquet(s) : %s\n' "apt" "${#journal_pkgs[@]}" "${journal_pkgs[*]}"
  elif [[ ! -r "$JOURNAL_FILE" ]]; then
    printf '  %-10s %s\n' "apt" "${_PA}AUCUN — journal illisible ou absent ($JOURNAL_FILE) : impossible de distinguer ce que LCARS a posé de ce qui était déjà là${_PN}"
  else
    printf '  %-10s %s\n' "apt" "AUCUN — le journal est là et dit que ce rail n'a posé aucun paquet ($JOURNAL_FILE). Rien à retirer."
  fi
  if [[ "${#persons[@]}" -gt 0 ]]; then
    if [[ "$UNINSTALL_HUMANS" -eq 1 ]]; then
      printf '  %-10s %s\n' "comptes h." "${persons[*]} — comptes RETIRÉS, leurs homes RESTENT"
    else
      printf '  %-10s %s\n' "comptes h." "${persons[*]} — LAISSÉS. « --humans » retire les COMPTES ; les homes restent dans tous les cas"
    fi
  fi
  # ⚠ CE COMPTEUR NE PROMET PLUS RIEN, ET C'EST TOUT SON OBJET. Il disait « N objet(s) dans les homes
  # (--humans) », donc « ce drapeau les emporte » — ce qui etait vrai et ne l'est plus. Le dire au
  # passe serait pire que se taire : un operateur qui lit un inventaire le lit comme une liste de ce
  # qui va disparaitre.
  printf '  %-10s %s\n' "homes" "${#humans[@]} objet(s) posés sous /home — JAMAIS retirés, par aucun drapeau"
  # Une ligne de la table qui vise `/home` sans etre de classe `human` est une ligne qui s'est
  # trompee de perimetre. La garde l'ecarte ; se taire ferait croire que la table est appliquee
  # telle qu'elle est ecrite.
  # Les annexes ecartees se NOMMENT, au meme titre que les lignes qui visent /home : un plan qui
  # tait ce qu'il epargne laisse croire qu'il n'a rien vu. Et c'est ce qui rend la garde mesurable
  # depuis le plan — donc testable sans root.
  if [[ "${#annexes_gardees[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "annexes" "${_PC}${annexes_gardees[*]} GARDÉES (défaut) — la forge et le runner continuent de tourner.${_PN}"
    printf '             %s\n' "« --annexes » les retire · « bench-down.sh --project <nom> --yes » détruit un banc"
  fi
  if [[ "${#refuses_home[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "écartés" "${_PA}${#refuses_home[@]} ligne(s) de la table visent /home et sont IGNORÉES :${_PN}"
    printf '             %s\n' "${refuses_home[@]}"
  fi
  # ⚠ CEUX-CI SE NOMMENT AUSSI, ET LEUR CAUSE N'EST PAS LA MEME. Une ligne de TABLE qui vise /home
  # s'est trompee de perimetre — c'est une faute d'edition. Un objet de JOURNAL sous /home a ete
  # POSE la par un module, legitimement (`30-wsl`, `45-sudoers-toolchain`) : il n'y a rien a
  # corriger en amont, et tout a dire ici, parce que ce sont exactement les objets que la
  # desinstallation LAISSE derriere elle sans que la table en parle.
  if [[ "${#refuses_home_j[@]}" -gt 0 ]]; then
    printf '  %-10s %s\n' "écartés" "${_PC}${#refuses_home_j[@]} objet(s) du JOURNAL sous /home — POSÉS par cette install, JAMAIS retirés :${_PN}"
    printf '             %s\n' "${refuses_home_j[@]}"
  fi
  [[ "${#jokers[@]}" -eq 0 ]] \
    || printf '  %-10s %s\n' "résolus" "${jokers[*]}"
  printf '  %-10s %s\n' "préservé" "${preserve_roots[*]}"

  if [[ "$UNINSTALL_YES" -ne 1 ]]; then
    echo ""
    echo "  ${_PA}RIEN N'A ÉTÉ RETIRÉ.${_PN} Relis ce plan, puis : sudo $SELF uninstall --yes"
    return 0
  fi

  # ─── L'EXÉCUTION ──────────────────────────────────────────────────────────────────────────────
  local o removed=0 kept=0

  # ─── LES UNITES SYSTEMD — ARRETEES AVANT D'ETRE RETIREES ──────────────────────────────────────
  #
  # ⚠ RETIRER LE FICHIER D'UNITE N'ARRETE PAS LE SERVICE : arreter, PUIS retirer. Un service
  # desactive apres l'effacement de son fichier survit jusqu'au reboot, sur une machine que
  # l'operateur croit desinstallee — et `userdel` refuse ensuite son compte, process encore vivant.
  local _unit
  for _unit in "${files[@]}"; do
    case "$_unit" in
      */systemd/system/*.service) ;;
      *) continue ;;
    esac
    command -v systemctl >/dev/null 2>&1 || break
    systemctl disable --now "$(basename "$_unit")" >/dev/null 2>&1 || true
  done


  # ⚠ LES PAQUETS D'ABORD, ET C'EST UNE PROPRIETE D'ORDRE. Le journal vit sous la racine d'install,
  # que la boucle `dirs` emporte au `rm -rf`. Dans un run complet c'est sans effet — il est charge
  # en memoire bien avant. INTERROMPU entre les deux, « sans journal, aucun paquet » gele les
  # paquets DEFINITIVEMENT : le fichier qui disait lesquels retirer n'existe plus.
  for o in "${journal_pkgs[@]}"; do
    run_quiet env DEBIAN_FRONTEND=noninteractive apt-get remove -y "$o" \
      && removed=$((removed + 1)) || echo "  ${_PA}paquet non retiré : $o${_PN}"
  done

  # ⚠ C'EST LA NATURE DE L'OBJET SUR LE DISQUE QUI DECIDE, PAS SA CLASSE DANS LA TABLE : `runtime`
  # porte aussi des repertoires, et un `rm -f` sur un dossier imprime « non retiré » a chaque passage
  # sans jamais rien retirer.
  for o in ${apt_repo_files[@]+"${apt_repo_files[@]}"} "${files[@]}"; do
    if [[ -d "$o" && ! -L "$o" ]]; then
      rm -rf "$o" && removed=$((removed + 1)) || echo "  ${_PA}non retiré : $o${_PN}"
    elif [[ -e "$o" || -L "$o" ]]; then
      rm -f "$o" && removed=$((removed + 1)) || echo "  ${_PA}non retiré : $o${_PN}"
    fi
  done

  # ─── /home NE SE TOUCHE PAS. IL N'Y A PAS DE BLOC ICI, ET IL N'EN REVIENDRA PAS ────────────────
  #
  # Un `for h in /home/*` + `rm -rf` vivait a cet endroit, sous `--humans`. Il portait sa propre
  # mise en garde — « rien ne garantit que ce soit un home d'humain, une racine de travail partagee
  # y vit aussi » — et il gardait le geste quand meme, avec `preserved` pour filet. Un commentaire
  # qui decrit un danger sans le fermer ne ferme rien : mesure du 2026-08-31, ce bloc detruisait les
  # `.lcars` et les `pods` de cinq personnes, plus tout ce que la table ne pensait pas a preserver.
  #
  # LA REGLE EST MAINTENANT LA MEME POUR TOUS LES BINAIRES : ni `rm`, ni `userdel -r`. Elle ne se
  # negocie pas objet par objet, parce que c'est exactement ainsi qu'elle s'etait perdue — un
  # perimetre qui accepte une exception argumentee en accepte une deuxieme.
  #
  # La classe `human` reste LUE, et seulement pour DIRE ce qui reste (voir le bilan) : declarer ce
  # qu'on POSE garde tout son sens, c'est le droit de le RETIRER qui n'existe plus.
  for o in "${dirs[@]}"; do
    [[ -d "$o" ]] || continue
    rm -rf "$o" && removed=$((removed + 1)) || echo "  ${_PA}non retiré : $o${_PN}"
  done
  # ─── LES OBJETS DOCKER — GARDÉS PAR DÉFAUT, DÉTRUITS SUR DEMANDE ──────────────────────────────
  #
  # ⚠ LE DÉFAUT S'EST INVERSÉ, ET C'EST LA MÊME RÈGLE QUE POUR `/home`. Ces projets sont les
  # ANNEXES du § 13 — la forge et le runner CI. La forge est le PET du corpus : elle porte les
  # dépôts, le backlog, et sur WSL elle vit SOUS le substrat (§ 10) — elle survit même à un
  # `wsl --unregister`. Un `uninstall` qui la détruisait rendait la désinstallation du rail plus
  # destructrice que la destruction de la machine.
  #
  # ⚠ ET LE VOCABULAIRE DES GESTES LE DISAIT DÉJÀ (§ 11) : nuke (banc, routine) ≠ désinstallation
  # (déploiement, admin) ≠ reconstruction. Un banc se jette par `bench-down.sh --yes`, qui existe et
  # dont c'est le métier. `uninstall` désinstalle un DÉPLOIEMENT : il n'avait aucune raison
  # d'emporter avec lui une forge que quelqu'un d'autre alimente.
  #
  # Les volumes étaient déjà gardés et nommés ; ce qui tombait était le CONTENEUR, donc le service.
  # Garder les données d'une forge éteinte est un demi-geste : elle ne répond plus.
  # ⚠ AUCUNE GARDE ICI, ET C'EST VOULU : la liste est deja vide quand `--annexes` n'est pas demande.
  # Une seconde garde a cet endroit serait redondante ET nuisible — elle ferait croire que la
  # decision se prend a l'execution, alors qu'elle se prend a la lecture, comme celle de `/home`.
  local proj cid vol
  kept=$((kept + ${#annexes_gardees[@]}))
  for proj in ${docker_projects[@]+"${docker_projects[@]}"}; do
    command -v docker >/dev/null 2>&1 || { echo "  ${_PA}docker absent — projet « $proj » laissé entier${_PN}"; break; }
    while read -r cid; do
      [[ -n "$cid" ]] || continue
      docker rm -f "$cid" >/dev/null 2>&1 && removed=$((removed + 1)) \
        || echo "  ${_PA}conteneur non retiré : $cid${_PN}"
    done < <(docker ps -aq --filter "label=com.docker.compose.project=$proj" 2>/dev/null)
    if docker network rm "${proj}_default" >/dev/null 2>&1; then
      removed=$((removed + 1))
    fi
    while read -r vol; do
      [[ -n "$vol" ]] || continue
      kept=$((kept + 1))
      echo "  ${_PC}volume $vol GARDÉ — il porte du travail (les dépôts de la forge). « docker volume rm $vol » si tu en es sûr.${_PN}"
    done < <(docker volume ls -q --filter "label=com.docker.compose.project=$proj" 2>/dev/null)
  done

  # ─── LES COMPTES D'HUMAINS — SOUS `--humans`, ET JAMAIS AUTREMENT ─────────────────────────────
  if [[ "$UNINSTALL_HUMANS" -eq 1 ]]; then
    local per home
    for per in ${persons[@]+"${persons[@]}"}; do
      home="$(getent passwd "$per" 2>/dev/null | cut -d: -f6)"
      if [[ -n "$home" ]] && preserved "$home"; then
        kept=$((kept + 1))
        echo "  ${_PA}compte $per gardé — son home est du travail préservé ($home)${_PN}"
        continue
      fi
      # ⚠ `userdel`, JAMAIS `userdel -r`. Le `-r` emporte le home : c'est un `rm -rf` sous `/home`
      # par un autre binaire, et la regle ne porte pas sur le nom de l'outil. La garde `preserved`
      # ci-dessus ne couvrait que la classe `preserve` — jamais un home ordinaire, c'est-a-dire
      # exactement celui d'une personne.
      if userdel "$per" >/dev/null 2>&1; then
        removed=$((removed + 1))
        echo "  compte $per retiré — ${_PC}son home reste${_PN} ($home)"
      else
        kept=$((kept + 1))
        echo "  ${_PA}compte $per non retiré — « userdel $per » refuse (session ouverte ?)${_PN}"
      fi
    done
  fi

  # ⚠ LES COMPTES AVANT LES GROUPES : `groupdel` refuse un groupe PRIMAIRE d'un compte existant, donc
  # l'inverse laisserait les deux en place.
  for o in "${accounts[@]}"; do
    getent passwd "$o" >/dev/null 2>&1 || continue
    if userdel "$o" >/dev/null 2>&1; then
      removed=$((removed + 1))
    else
      kept=$((kept + 1))
      echo "  ${_PA}compte $o non retiré — « userdel $o » refuse (process encore vivant ?)${_PN}"
    fi
  done
  for o in "${groups[@]}"; do
    getent group "$o" >/dev/null 2>&1 || continue
    # ⚠ ÇA SE VÉRIFIE ICI, PAS DANS `groupdel` : il RÉUSSIT sur un groupe qui possède encore des
    # fichiers, et les laisse avec un GID orphelin que le prochain `groupadd` réattribuera.
    local porteur
    if porteur="$(prov_group_owns_preserved "$o" "${preserve_roots[@]}")"; then
      kept=$((kept + 1))
      echo "  ${_PA}groupe $o gardé — encore porté par du travail préservé ($porteur)${_PN}"
    elif groupdel "$o" >/dev/null 2>&1; then
      removed=$((removed + 1))
    else
      kept=$((kept + 1))
      echo "  ${_PA}groupe $o non retiré — « groupdel $o » refuse (groupe primaire d'un compte ?)${_PN}"
    fi
  done

  echo ""
  printf '  %d objet(s) retiré(s), %d gardé(s) délibérément.\n' "$removed" "$kept"

  # ─── CE QUI RESTE — LE BILAN DE SORTIE, ET IL EST AUSSI IMPORTANT QUE LE PLAN D'ENTREE ────────
  #
  # Le plan d'entree dit ce qui VA partir ; celui-ci dit ce qui EST reste. Les deux ne se deduisent
  # pas l'un de l'autre : entre les deux il y a les refus (« session ouverte »), les gardes, et tout
  # ce que le perimetre ne couvre pas. Sans cette section, un operateur qui vient de desinstaller ne
  # peut connaitre l'etat de sa machine qu'en la fouillant — c'est-a-dire en refaisant a la main le
  # travail que ce script vient de faire, avec moins d'information que lui.
  #
  # ⚠ ELLE NOMME, ELLE NE COMPTE PAS. « 12 objets gardes » n'est pas quelque chose sur quoi on peut
  # agir ; un chemin l'est. C'est la meme raison qui fait nommer les chemins resolus depuis un joker.
  echo ""
  echo "  ${_PC}── CE QUI RESTE SUR CETTE MACHINE ─────────────────────────────${_PN}"
  echo "  ${_PC}travail préservé${_PN}      ${preserve_roots[*]}"
  echo "  ${_PC}sous /home${_PN}           tout — ni un « rm », ni un « userdel -r ». Les homes, leur contenu,"
  echo "                       et les ${#humans[@]} objet(s) que LCARS y a posés."
  # ⚠ LE JOURNAL N'EXISTE PLUS QUAND CETTE LIGNE S'IMPRIME, et c'est pourquoi la question se pose
  # PLUS HAUT. Il vit sous la racine d'install, que la boucle `dirs` vient d'emporter au `rm -rf` :
  # un `-r "$JOURNAL_FILE"` teste ici l'absence que le script vient lui-meme de creer, et tombe
  # toujours dans la branche « la machine portait deja ». Mesure du 2026-09-01, banc 2001. C'est la
  # meme cicatrice d'ordre que « les paquets d'abord » — ce fichier meurt en cours de route, donc
  # tout ce qu'on veut en dire se lit AVANT.
  if [[ "${#journal_pkgs[@]}" -eq 0 && "$_journal_lisible" -eq 1 ]]; then
    echo "  ${_PC}paquets apt${_PN}          aucun retiré — le journal disait qu'aucun n'a été posé par ce rail"
  elif [[ "$_journal_lisible" -eq 1 ]]; then
    echo "  ${_PC}paquets apt${_PN}          ceux que la machine portait DÉJÀ (« apt_already » au journal) restent"
  else
    echo "  ${_PC}paquets apt${_PN}          ${_PA}aucun retiré — le journal était illisible ou absent : impossible de distinguer ce que LCARS a posé de ce qui était déjà là${_PN}"
  fi
  # Le cache des catalogues a demenage sous le prefixe le 2026-09-01 ; ce qui reste a l'ancienne
  # adresse est sous /home, donc hors de portee de ce script — et invisible si personne ne le dit.
  [[ -d "$PROV_LEGACY_CATALOGUES_DIR" ]] \
    && echo "  ${_PA}reliquat${_PN}             $PROV_LEGACY_CATALOGUES_DIR (cache d'avant le 2026-09-01) — « rm -rf $PROV_LEGACY_CATALOGUES_DIR » si tu n'en veux plus"
  [[ "$kept" -gt 0 ]] \
    && echo "  ${_PA}refus${_PN}                $kept objet(s) que ce script n'a PAS pu retirer — voir les lignes ci-dessus"
  return 0
}

# ─── audit — LA TABLE CONTRE LA MACHINE ─────────────────────────────────────────────────────────
audit_run() {
  local avant="${1:-}" apres="${2:-}"
  [[ -r "$avant" && -r "$apres" ]] \
    || die "audit attend deux instantanes lisibles : provision audit --before <f> --after <f>"
  [[ -r "$MANIFEST_FILE" ]] || die "manifeste introuvable ($MANIFEST_FILE)"

  local rows; rows="$(grep -vE '^\s*#|^\s*$' "$MANIFEST_FILE")"
  local -a declares=()
  local cls obj _mode _owner sub
  while read -r cls obj _mode _owner sub; do declares+=("$obj"); done <<<"$rows"  # le trait ne change pas la couverture

  couvert() {
    local p="$1" d
    for d in "${declares[@]}"; do
      case "$d" in
        *"<"*) d="${d%%<*}"; [[ "$p" == "$d"* ]] && return 0 ;;
        *)     [[ "$p" == "$d" || "$p" == "$d"/* ]] && return 0 ;;
      esac
    done
    return 1
  }

  # ⚠ ET IL SE JOUE SUR LA MACHINE DANS L'ETAT QUE DECRIT SON « APRES », PAS PLUS TARD : `dpkg -L`
  # interroge ce qui est installe MAINTENANT. Rejoue apres une desinstallation, il ne rend plus rien
  # et les fichiers des paquets ressortent tous comme non declares.
  local -A _apt=()
  local _dpkg="${LCARS_DPKG:-dpkg}"
  if [[ -r "$JOURNAL_FILE" ]] && command -v "$_dpkg" >/dev/null 2>&1; then
    local _pkg _f
    # ⚠ ECLATEMENT VOULU : `apt_installed` porte UNE ligne de noms separes par des espaces, et c'est
    # le mot qu'on veut, pas la ligne. Un `while read` lirait la ligne entiere comme un seul paquet.
    # shellcheck disable=SC2013
    for _pkg in $(awk '$1=="apt_installed"{ $1=""; print }' "$JOURNAL_FILE"); do
      while read -r _f; do [[ -n "$_f" ]] && _apt["$_f"]=1; done < <("$_dpkg" -L "$_pkg" 2>/dev/null || true)
    done
  fi

  local n_apparu=0 n_nu=0 n_apt=0 p
  while read -r _t _m _o p; do
    [[ -n "$p" ]] || continue
    n_apparu=$((n_apparu + 1))
    [[ -n "${_apt[$p]:-}" ]] && { n_apt=$((n_apt + 1)); continue; }
    couvert "$p" || { n_nu=$((n_nu + 1)); printf '  %s\n' "$p"; }
  done < <(comm -13 <(sort "$avant") <(sort "$apres"))

  echo ""
  printf '  %d objet(s) apparu(s), %d appartenant a un paquet apt journalise, %d NON couvert(s) par la table.\n' \
    "$n_apparu" "$n_apt" "$n_nu"
  [[ -r "$JOURNAL_FILE" ]] \
    || echo "  ${_PA}⚠ journal illisible ($JOURNAL_FILE) — les fichiers des paquets apt sont comptes comme non declares${_PN}"
  [[ "$n_nu" -eq 0 ]] || {
    echo "  ${_PA}Chacun est un DEFAUT : soit on le declare, soit on cesse de le poser.${_PN}"
    return 1
  }
  echo "  ${_PG}La machine ne porte rien que la table ne declare.${_PN}"
}

if [[ "$CMD" == "audit" ]]; then
  audit_run "$AUDIT_BEFORE" "$AUDIT_AFTER"
  exit $?
fi
if [[ "$CMD" == "uninstall" ]]; then
  [[ "$UNINSTALL_YES" -ne 1 || "$EUID" -eq 0 ]] \
    || die "uninstall --yes demande root (il retire des objets systeme) — sans --yes, il imprime son plan"
  uninstall_run
  exit $?
fi
if [[ "$CMD" == "apply" ]]; then
  PROV_JOURNAL_ACC="$(mktemp "${TMPDIR:-/tmp}/prov-journal.XXXXXX" 2>/dev/null || true)"
  export PROV_JOURNAL_ACC
fi

# ─── run_module <mod> <eff> — L'UID SE DÉCIDE ICI, ET UNE SEULE FOIS ─────────────────────────────
#
#
# ⚠ `runuser` GARDE l'environnement exporté (mesuré) mais REPOSE le PATH depuis `login.defs`. Les
# modules travaillent en chemins absolus et le runner ne pose aucun PATH, donc le décor est le même
# des deux côtés de la frontière — mais un module qui prendrait une dépendance sur le PATH du runner
# la perdrait ICI, silencieusement.
#
#
run_module() {
  local mod="$1" eff="$2" human="${PROV_HUMAN:-}" name
  name="$(basename "$mod" .sh)"
  # ⚠ LE SOUS-SHELL EST LE MECANISME, PAS UN EFFET DE BORD : sans lui l'`export PROV_HUMAN` survit
  # au retour, et le tour suivant de la boucle joue sous l'humain du precedent.
  # ⚠ ET SANS LE FD DU VERROU (`9>&-`) : un enfant detache par un module — la premiere passe du
  # convergeur lance les consoles ttyd, reparentees a 1 — herite de TOUS les fds, dont le flock. Sans
  # cette fermeture, chaque apply APRES une install reussie repondait « un autre apply est en cours »
  # tant qu une console tournait (banc WSL, 2026-08-30). Le runner tient son verrou seul.
  # shellcheck disable=SC2030,SC2031 # portee voulue : un tour de boucle = un shell
  (
    export PROVISION_RUN=1 PROVISION_MODULE="$name" PROV_HUMAN="$human"
    if [[ "$(module_field "$mod" NEEDS)" != "human" || "$(id -un)" == "$human" ]]; then
      bash "$mod" "$eff"
    else
      as_human bash "$mod" "$eff"
    fi
  ) 9>&-
}

# ─── Exécution ────────────────────────────────────────────────────────────────────────────────────
total=0 ok=0 drift=0 failed=0
declare -a REPORT=()

for i in "${!SELECTED[@]}"; do
  mod="${SELECTED[$i]}"
  name="$(basename "$mod" .sh)"
  eff="${EFFECTIVE[$i]}"
  total=$((total + 1))
  if [[ "$CMD" == "apply" && "$eff" == "check" ]]; then
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name (check — APPLY-ON=$(module_field "$mod" APPLY-ON), hors substrat $SUBSTRATE) ===${_PN}"
  else
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name ($eff) ===${_PN}"
  fi
  rc=0
  run_module "$mod" "$eff" || rc=$?
  case "$CMD:$eff:$rc" in
    *:*:3) failed=$((failed + 1)); REPORT+=("$name=ERROR") ;;
    doctor:check:0) ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    doctor:check:1) drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    doctor:check:*)
      failed=$((failed + 1)); REPORT+=("$name=ERROR")
      echo "${_PR}ERREUR $name:${_PN} sonde en erreur (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est MORT avant de rendre son verdict" >&2 ;;
    apply:apply:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    # ⚠ AVANT LE FOURRE-TOUT `apply:apply:*` : `case` prend la PREMIERE clause qui matche, donc
    # l'ordre EST ce qui distingue un drift résiduel d'un échec.
    apply:apply:2)  drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    apply:apply:*)
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      echo "${_PR}ERREUR $name:${_PN} apply en echec (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est MORT avant de rendre son verdict" >&2 ;;
    apply:check:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    apply:check:*)
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      echo "FAIL  $name: etat-cible non tenu sur $SUBSTRATE et inapplicable ici (APPLY-ON=$(module_field "$mod" APPLY-ON)) — rebuild l'image/le build qui le fournit" >&2 ;;
  esac
done

# ─── Verdict ──────────────────────────────────────────────────────────────────────────────────────
if [[ "$PORCELAIN" -eq 1 ]]; then
  printf '%s\n' "${REPORT[@]}"
else
  echo ""
  # ⚠ ON ECRIT MEME SI L'ACCUMULATEUR EST VIDE — surtout pas de `-s` ici. Une passe qui ne pose RIEN
  # (un `--only`, une machine deja convergee) laisserait sinon l'ANCIEN journal en place avec son
  # `posed_at` d'une autre passe : un fichier qui se declare « mesure » et date d'avant est pire
  # qu'absent, il repond avec assurance.
  if [[ "$CMD" == "apply" && -n "${PROV_JOURNAL_ACC:-}" ]]; then
    # ⚠ L'ANCIEN JOURNAL SE LIT AVANT, DANS UNE VARIABLE — jamais dans le bloc redirige. Le
    # `> "$JOURNAL_FILE"` de la fin TRONQUE le fichier a l'ouverture, donc un `grep` place a
    # l'interieur lirait du vide et la fusion serait silencieusement sans effet. shellcheck le dit
    # (SC2094, « read and write the same file in the same pipeline ») et il a raison.
    _journal_ancien=""
    # ⚠ LES CLEFS D'INVENTAIRE S'ENUMERENT, ELLES NE SE DEVINENT PAS A UN PREFIXE : `^posed_`
    # matcherait `posed_at`, et la METADONNEE de la passe se fusionnerait avec les inventaires —
    # le fichier porterait deux `posed_at`, dont un accumulant tous les horodatages.
    [[ -r "$JOURNAL_FILE" ]] && _journal_ancien="$(grep -E '^(apt_installed|apt_already|posed_(dir|file|link|group|docker|apt_repo)) ' "$JOURNAL_FILE" || true)"
    if mkdir -p "$(dirname "$JOURNAL_FILE")" 2>/dev/null; then
      {
        echo "# SOURCE: $JOURNAL_FILE"
        echo "# STATUS: mesure, pas declaration — CE QUI A ETE POSE SUR CETTE MACHINE."
        echo "#"
        echo "# Son jumeau statique est deploy/system.manifest, qui dit ce que le"
        echo "# provisionnement a le DROIT de poser. Celui-ci dit ce qu'il A pose, ici."
        echo "#"
        echo "# ⚠ apt_installed / apt_already EST LA RAISON D'ETRE DE CE FICHIER. La distinction"
        echo "# n'est connaissable QU'AVANT l'install : une seconde plus tard, dpkg repond"
        echo "# « present » pour les deux. Un uninstall qui l'ignore retire des paquets que"
        echo "# l'operateur avait avant — pire que d'en laisser."
        echo "posed_at      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "source_rev    ${PROV_SOURCE_REV:-inconnue}"
        echo "substrate     $SUBSTRATE"
        # ⚠ CE QUE L'OPERATEUR A DEMANDE, POUR QUE LA PASSE SUIVANTE NE LE REDEMANDE PAS. Sans cette
        # ligne, `apply --port-deck 20997` posait le deck sur 20997 et le `doctor` sans drapeau, une
        # minute plus tard, exigeait 20999 : le rail declarait en drift une machine qu'il venait
        # lui-meme de convergir. Un parametre passe a `apply` EST l'etat-cible de la machine jusqu'a
        # ce qu'un autre `apply` le remplace — pas une opinion valable le temps d'une commande.
        echo "params        $(prov_params_line)"
        # Sans repli : la lib pose `PROV_PREFIX`, et un « inconnu » afficherait un etat qui n'existe pas.
        echo "prefix        $PROV_PREFIX"
        echo "modules       total=$total ok=$ok drift=$drift failed=$failed"
        # ⚠ LE JOURNAL FUSIONNE AVEC LE PRECEDENT, IL NE LE REECRIT PAS. Le rail est CONCU pour etre
        # rejoue : a la seconde passe les paquets sont deja presents, donc `apt_installed` serait
        # VIDE et l'uninstall ne retirerait plus rien. Le fichier dirait « ce qui a ete pose sur
        # cette machine » en decrivant la DERNIERE PASSE.
        #
        # ⚠ ET LA FUSION NE VAUT QUE POUR CE QUI EST CUMULATIF : `posed_at`, `source_rev`,
        # `substrate`, `prefix`, `modules` decrivent LA passe et s'ecrasent. Seuls les inventaires
        # `apt_*` et `posed_*` s'additionnent.
        { printf '%s\n' "$_journal_ancien"; cat "$PROV_JOURNAL_ACC"; } \
        | awk '{ k=$1; $1=""; sub(/^ /,""); acc[k]=acc[k] " " $0 }
             END { for (k in acc) {
                     n=split(acc[k], w, " "); delete seen; out=""
                     for (i=1;i<=n;i++) if (w[i]!="" && !(w[i] in seen)) { seen[w[i]]=1; out=out " " w[i] }
                     printf "%-13s%s\n", k, out } }' | sort
      } > "$JOURNAL_FILE" 2>/dev/null \
        && chmod 0644 "$JOURNAL_FILE" 2>/dev/null \
        || echo "  ${_PA}journal NON écrit ($JOURNAL_FILE) — l'install est faite, sa trace ne l'est pas${_PN}"
    else
      echo "  ${_PA}journal NON écrit : $(dirname "$JOURNAL_FILE") inaccessible${_PN}"
    fi
    rm -f "$PROV_JOURNAL_ACC"
  fi

  echo "${_PC}=== provision $CMD — substrat $SUBSTRATE · source $PROV_SOURCE_REV ===${_PN}"
  _tint() { # _tint <couleur> <libellé> <valeur>
    if [[ "$3" -gt 0 ]]; then printf '%s%s: %s%s' "$1" "$2" "$3" "$_PN"; else printf '%s: %s' "$2" "$3"; fi
  }
  printf '  modules: %d · %s · %s · %s\n' "$total" \
    "$(_tint "$_PG" "conformes/convergés" "$ok")" \
    "$(_tint "$_PA" "drift" "$drift")" \
    "$(_tint "$_PR" "échecs" "$failed")"
  if [[ "$CMD" == "doctor" && "$drift" -gt 0 ]]; then
    if [[ "$SUBSTRATE" == "docker" ]]; then
      # docker n'est pas un rail : un drift ici est une IMAGE non conforme a son build, pas un
      # etat a converger — le geste est le rebuild (le stage verify le refuse au build).
      echo "  ${_PA}→ l'image ne se converge pas :${_PN} rebuild (deploy/box build) — un drift ici est une image non conforme"
    else
      echo "  ${_PA}→ converger :${_PN} sudo $SELF apply"
    fi
  fi
  # ⚠ L'ÉCHEC PASSE DEVANT, ET L'`elif` EST LOAD-BEARING : en deux `if` separes, « Rien n'est cassé »
  # sortirait APRÈS « EN ÉCHEC sur 3 module(s) », et ce serait la derniere ligne que l'opérateur lit.
  # Rien ne casserait pour autant — le code de retour reste juste, aucun test ne rougit ; seul un
  # humain se ferait une idee fausse de l'etat de sa machine.
  if [[ "$CMD" == "apply" && "$failed" -gt 0 ]]; then
    echo "  ${_PR}→ EN ÉCHEC${_PN} sur $failed module(s) — voir les lignes FAIL ci-dessus."
    [[ "$drift" -gt 0 ]] && \
      echo "    ($drift autre(s) module(s) en DRIFT : état-cible non tenu, souvent en conséquence.)"
  elif [[ "$CMD" == "apply" && "$drift" -gt 0 ]]; then
    echo "  ${_PA}→ APPLIQUÉ, MAIS L'ÉTAT-CIBLE N'EST PAS TENU${_PN} sur $drift module(s) — voir les lignes"
    echo "    DRIFT ci-dessus. Rien n'est cassé ; il manque un geste (forge, credentials, réseau)."
  fi
fi
[[ "$failed" -gt 0 ]] && exit "$([[ "$CMD" == "doctor" ]] && echo 2 || echo 1)"
[[ "$drift" -gt 0 ]] && exit "$([[ "$CMD" == "doctor" ]] && echo 1 || echo 2)"
exit 0
