# SOURCE: deploy/installer-constants.env
# AUTHOR: bob
# STARDATE: 2026-09-14
# STATUS: les constantes de l'installeur — une déclaration par fait, lue par tout ce qui en a besoin
#
# Format : CLE=valeur, une par ligne, sans expansion ni guillemets ; une valeur peut porter des
# espaces. La lib le lit comme une donnée, jamais comme du code ; compose le lit par --env-file. Une
# valeur écrite ici ne s'écrit nulle part ailleurs dans deploy/ : un mur le tient.
#
# Les chemins sont canoniques. La lib les lit sous LCARS_DECOR_ROOT quand un témoin la pose ; sur une
# machine, cette racine est vide. Modes, propriétaires et gid de ces chemins : deploy/system.manifest.
#
# Les valeurs en _DEFAULT sont un choix de l'opérateur (drapeau, journal) ; les autres ne se règlent
# pas : la lib les affecte, l'environnement ne les surcharge pas.

# ─── racines ──────────────────────────────────────────────────────────────────────────────────────
PROV_ROOT=/opt/lcars
PROV_PREFIX=/opt/lcars/runtime
PROV_LINK_DIR=/usr/local/bin
PROV_TOFU_DIR=/opt/lcars/tofu
PROV_TOFU_RC=/opt/lcars/tofu/tofurc
PROV_FORGE_STATE_DIR=/opt/lcars/tofu/forge-state
PROV_TOFU_BIN=/usr/local/bin/tofu
PROV_MEDIA_ROOT=/opt/lcars/share
PROV_CATALOGUES_DIR=/opt/lcars/var/catalogues
PROV_CATALOGUES_WORK=/opt/lcars/var/tofu
PROV_JOURNAL_FILE=/opt/lcars/var/install.journal
PROV_STORE_ROOT=/var/lib/lcars

# ─── secrets et identité de la forge ─────────────────────────────────────────────────────────────
PROV_TOKENS_DIR=/opt/lcars/var/tokens
PROV_MASTER_TOKEN_FILE=/opt/lcars/var/tokens/forge-master.token
PROV_FORGE_SEED_FILE=/opt/lcars/var/tokens/forge-seed.pass
PROV_UID_MAP_FILE=/opt/lcars/var/tokens/forge-uid.map
PROV_FORGE_URL_FILE=/opt/lcars/var/tokens/forge.url
PROV_FORGE_PUBLIC_URL_FILE=/opt/lcars/var/tokens/forge.public.url
PROV_FORGE_MODE_FILE=/opt/lcars/var/tokens/forge.mode
PROV_SYSTEM_ACCOUNT=system_starfleet
PROV_SYSTEM_TOKEN_FILE=/opt/lcars/var/tokens/system_starfleet.gitea_token
PROV_FORGE_INTERNAL_URL=http://gitea:3000
PROV_HUMANS_TEAM=humans
# ⚠ PAS DE PLANCHER DE RÔLES ICI (⚖ décision 2 du plan runtime, 2026-09-19). Les comptes de rôle
# sont un fait du PRODUIT : le catalogue embarqué de la release et chaque catalogue installé les
# déclarent, et `lcars tool roles` les rend. L'installeur en portait une copie (`PROV_ROLES`), qui
# voyageait en `LCARS_ROLES` — une liste tenue à la main qui divergeait du canon sans rien casser
# de visible. Mesuré : aucun lecteur ne tourne avant que la release soit posée (tous déclarent
# `60-deploy` dans leur `AFTER`), donc le plancher n'avait plus de raison d'être.
# shell porte node et bash, qu'une action JavaScript (actions/checkout) et un run: exigent ; pas de label
# elixir : le servir demanderait une image locale que l'installation ne construit pas
PROV_RUNNER_LABELS=shell:docker://catthehacker/ubuntu:act-latest,dood:docker://docker:cli,ubuntu-latest:docker://catthehacker/ubuntu:act-latest

# ─── /etc/lcars ───────────────────────────────────────────────────────────────────────────────────
PROV_SEAT_UID_FILE=/etc/lcars/seat.uid
PROV_SERVICES_ENV=/etc/lcars/services.env
PROV_CHANNEL_FILE=/etc/lcars/channel
PROV_DECK_OIDC_FILE=/etc/lcars/deck-oidc.json

# ─── comptes et groupes ───────────────────────────────────────────────────────────────────────────
PROV_FLEET_GROUP=fleet
PROV_CONSOLE_GROUP=lcars-console
PROV_AUTHORITY_USER=lcars-authority
PROV_SYSTEM_USER=lcars-system

# ─── toolchain ────────────────────────────────────────────────────────────────────────────────────
PROV_ELIXIR_OTP_MAJOR=27
PROV_ELIXIR_PIN=1.20.4
PROV_ELIXIR_PIN_SHA256=4389f216eec086b34a08d70a3eb0a649d00e6631987d1cbb649a2f81092f034c
# node précompilé officiel : le toolchain de la doc du deck, à la majeure du workflow du site
PROV_NODE_PIN=24.20.0
PROV_NODE_PIN_SHA256_X64=2f2c0da162318f0de47665410c7c8c2ed3d36c8f3105de4bbc61176c70a7cbf2
PROV_NODE_PIN_SHA256_ARM64=5f4ddab610c1ab2016b3c227cebdbf6d9495161487e4739c7b90090595f465f7
# la clé des dépôts apt de Docker, la même pour ubuntu et debian
PROV_DOCKER_GPG_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570

# ─── tampons des arbres posés ────────────────────────────────────────────────────────────────────
PROV_SOURCE_STAMP=.source-revision
PROV_HELPERS_STAMP=.helpers-revision

# ─── ce que 62-runtime-helpers pose sous PROV_ROOT, et que kit-verify exige du kit ──────────────
# auxiliaires (0755) et données (0644) de runtime/services ; arbres de runtime/, puis de la racine du dépôt
PROV_HELPERS=console.sh console-humans.sh console-status.sh console-landing.sh console-deck.py console-pod.sh human-converger.sh forge-gestures.sh provision-role-tokens.sh catalogue-executor.py lcars_socket.py privileged-executor.py supervise.sh
PROV_HELPERS_DATA=console.tmux.conf
PROV_SHELL_RC=/etc/lcars/lcars.bashrc
PROV_EMBEDDED=etc services bin
PROV_EMBEDDED_ROOT=assets catalogues deploy

# ─── choix de l'opérateur, et leurs défauts ──────────────────────────────────────────────────────
PROV_FORGE_BASE_DEFAULT=lcars
# l'org SYSTÈME de la forge : l'identité (team humans) et le dépôt du système (_ops) ;
# les projets vivent dans l'org de leur catalogue
PROV_FORGE_ORG_DEFAULT=lcars
# le catalogue que la release embarque, et l'org de ses projets : c'est le `name:` de
# runtime/priv/catalogue/catalogue.yaml (mur bats) — le banc en dérive le dépôt de source que le conteneur clone
PROV_BUNDLED_CATALOGUE=fleet
PROV_DECK_PORT_DEFAULT=20999
PROV_SSH_PORT_DEFAULT=2222
PROV_FORGE_HOST_PORT_DEFAULT=21000
# l'humain de démonstration d'un banc : aucun hors banc
PROV_BUILTIN_HUMAN_DEFAULT=
# son nom SOUS --bench, pour les deux rails (poste et conteneur). PAS « lcars » : sur Gitea une org
# et un compte partagent l'espace de noms, et ce nom est celui de l'org système — les deux ne
# peuvent pas coexister (mesure du 2026-09-17, banc vierge : « user already exists [name: lcars] »)
PROV_BENCH_HUMAN_DEFAULT=captain
