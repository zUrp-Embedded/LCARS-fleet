# SOURCE: deploy/installer-constants.env
# AUTHOR: bob
# STARDATE: 2026-09-14
# STATUS: les constantes de l'installeur — une déclaration par fait, lue par tout ce qui en a besoin
#
# Format : CLE=valeur, une par ligne, sans expansion ni guillemets ; une valeur peut porter des
# espaces. La lib le lit comme une donnée, jamais comme du code ; compose le lit par --env-file. Une
# valeur écrite ici ne s'écrit nulle part ailleurs dans deploy/ : un mur le tient.
#
# Les chemins sont canoniques. La lib les lit sous LCARS_DECOR_ROOT quand un témoin la pose ; sur une
# machine, cette racine est vide. Modes, propriétaires et gid de ces chemins : deploy/system.manifest.
#
# Les valeurs en _DEFAULT sont un choix de l'opérateur (drapeau, journal) ; les autres ne se règlent
# pas : la lib les affecte, l'environnement ne les surcharge pas.

# ─── racines ──────────────────────────────────────────────────────────────────────────────────────
PROV_ROOT=/opt/lcars
PROV_PREFIX=/opt/lcars/runtime
PROV_LINK_DIR=/usr/local/bin
PROV_TOFU_DIR=/opt/lcars/tofu
PROV_TOFU_BIN=/usr/local/bin/tofu
PROV_MEDIA_ROOT=/opt/lcars/share
PROV_CATALOGUES_DIR=/opt/lcars/var/catalogues
PROV_CATALOGUES_WORK=/opt/lcars/var/tofu
PROV_JOURNAL_FILE=/opt/lcars/var/install.journal
PROV_STORE_ROOT=/var/lib/lcars

# ─── secrets et identité de la forge ─────────────────────────────────────────────────────────────
PROV_TOKENS_DIR=/opt/lcars/var/tokens
PROV_MASTER_TOKEN_FILE=/opt/lcars/var/tokens/forge-master.token
PROV_FORGE_SEED_FILE=/opt/lcars/var/tokens/forge-seed.pass
PROV_UID_MAP_FILE=/opt/lcars/var/tokens/forge-uid.map
PROV_FORGE_URL_FILE=/opt/lcars/var/tokens/forge.url
PROV_FORGE_PUBLIC_URL_FILE=/opt/lcars/var/tokens/forge.public.url
PROV_FORGE_MODE_FILE=/opt/lcars/var/tokens/forge.mode
PROV_SYSTEM_ACCOUNT=system_starfleet
PROV_SYSTEM_TOKEN_FILE=/opt/lcars/var/tokens/system_starfleet.gitea_token
PROV_FORGE_INTERNAL_URL=http://gitea:3000
PROV_HUMANS_TEAM=humans
PROV_ROLES=system_architect system_chief system_gatekeeper fleet_engineer fleet_scribe fleet_qualifier fleet_reviewer fleet_scoper fleet_vulcan
# pas de label elixir : le servir demanderait une image locale que l'installation ne construit pas
PROV_RUNNER_LABELS=shell:docker://alpine:3.20,dood:docker://docker:cli,ubuntu-latest:docker://catthehacker/ubuntu:act-latest

# ─── /etc/lcars ───────────────────────────────────────────────────────────────────────────────────
PROV_SEAT_UID_FILE=/etc/lcars/seat.uid
PROV_SERVICES_ENV=/etc/lcars/services.env
PROV_CHANNEL_FILE=/etc/lcars/channel
PROV_DECK_OIDC_FILE=/etc/lcars/deck-oidc.json

# ─── comptes et groupes ───────────────────────────────────────────────────────────────────────────
PROV_FLEET_GROUP=fleet
PROV_CONSOLE_GROUP=lcars-console
PROV_AUTHORITY_USER=lcars-authority
PROV_SYSTEM_USER=lcars-system

# ─── toolchain ────────────────────────────────────────────────────────────────────────────────────
PROV_ELIXIR_OTP_MAJOR=27
PROV_ELIXIR_PIN=1.20.4
PROV_ELIXIR_PIN_SHA256=4389f216eec086b34a08d70a3eb0a649d00e6631987d1cbb649a2f81092f034c

# ─── tampons des arbres posés ────────────────────────────────────────────────────────────────────
PROV_SOURCE_STAMP=.source-revision
PROV_HELPERS_STAMP=.helpers-revision

# ─── choix de l'opérateur, et leurs défauts ──────────────────────────────────────────────────────
PROV_FORGE_BASE_DEFAULT=lcars
PROV_FORGE_ORG_DEFAULT=fleet
PROV_DECK_PORT_DEFAULT=20999
PROV_SSH_PORT_DEFAULT=2222
PROV_FORGE_HOST_PORT_DEFAULT=21000
