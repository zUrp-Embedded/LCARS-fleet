# SOURCE: deploy/system.manifest
# STARDATE: 2026-09-13
# STATUS: data, not code — ce que le provisionnement a le droit de poser sur une machine ; lu par provision (audit), la lib (gid, mode, propriétaire, substrat), 25, 44, 46 et 61
#
#   <classe>[:<trait>]  <objet>  <mode>  <propriétaire>  <substrat>
#
#   classe     prefix   la racine de l'installation
#              dir      un répertoire durable
#              anchor   un fichier à un chemin fixe hors préfixe (ce que l'OS ou le PATH exige)
#              link     un symlink hors préfixe
#              group    un groupe unix, avec son GID
#              runtime  un objet volatile, refait au boot (tmpfs)
#              human    un objet dans le home d'une personne
#              account  un compte unix de service et son groupe éponyme ; le propriétaire porte le shell
#              person   un compte unix d'humain
#   trait      unset    mode observé, pas affirmé : le doctor ne le compare pas
#   mode       octal, ou - quand la classe n'en porte pas · propriétaire user:group, ou -
#   substrat   any | wsl | linux | docker, ou une combinaison séparée par +
#   <human> dans un chemin vaut pour chaque humain enrôlé ; <version> pour la version épinglée
#
# Les paquets apt ont leur table dans 10-packages.sh et leur journal par machine.

prefix    /opt/lcars/runtime                              0750  root:fleet          any

dir       /opt/lcars                                   0755  root:root           any
# deux tampons sans rapport : .helpers-revision dit d'où sortent les auxiliaires (62) ; .source-revision
# dit « cet arbre est un kit » (prov_delivery), posé ou retiré par 62 selon la livraison
anchor    /opt/lcars/.source-revision                  0644  root:root           any
anchor    /opt/lcars/.helpers-revision                 0644  root:root           any
dir       /opt/lcars/tofu                              0755  root:root           any
dir       /opt/lcars/tofu/providers                    0755  root:root           any
# l'état tofu de la structure de la forge, gardé par 61 d'une passe à l'autre : il porte le seed des comptes en clair
dir       /opt/lcars/tofu/forge-state                  0700  root:root           wsl+linux
dir       /opt/lcars/share                                  0755  root:root           any
dir       /opt/lcars/share/avatars                     0755  root:root           any
dir       /opt/lcars/share/favicon                     0755  root:root           any
dir       /opt/lcars/share/doc                         0755  root:root           any
# 44-media ne l'écrit que sur un arbre propre ; à côté de doc/, que prov_promote_dir remplace
anchor    /opt/lcars/share/.doc-revision               0644  root:root           any
# 0710 : le groupe traverse (forge.url en 0644 s'ouvre par son chemin), il ne liste pas, les secrets restent 0600
dir       /opt/lcars/var/tokens                       0710  lcars-authority:fleet  any
# le matériel des catalogues : « lcars catalogue install » le clone sous le compte d'autorité, le groupe le lit
dir       /opt/lcars/var/catalogues                    0750  lcars-authority:fleet  any
# la racine du magasin : ses natures sont celles de deploy/lib/store.sh
dir       /var/lib/lcars                              0755  root:root           any

# /var/tmp est 1777 : déclarés, ces répertoires sont posés par l'installeur et leur propriétaire est
# relu à chaque passe, sinon le premier venu possède le dossier où root télécharge puis exécute
dir       /var/tmp/lcars                               0755  root:root           any
dir       /var/tmp/lcars/toolchain-work                0700  root:root           any
# la zone de transit de la boîte de dépôt : le DECK y écrit, la PORTE y lit. sgid, pour que le
# fichier naisse au groupe de la porte sans que le deck ait à le donner.
dir       /var/tmp/lcars/deposit                       2750  lcars-system:lcars-authority  any

dir       /opt/lcars/var                               0755  root:root           any
dir       /opt/lcars/var/tofu                          0700  lcars-authority:lcars-authority  wsl+linux
dir       /etc/lcars                                   0755  root:root           any

dir       /home/projects                               2775  root:fleet          any
dir       /home/projects.ops                           2775  root:fleet          any
dir       /home/projects.workshop                      2775  root:fleet          any

dir       /opt/node-<version>                          0755  root:root           wsl+linux
dir       /opt/elixir-<version>                        0755  root:root           wsl+linux

anchor    /etc/tmpfiles.d/lcars-console.conf           0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-landing.service    0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-converger.service  0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-catalogue.service  0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-privileged.service 0644  root:root           wsl+linux
anchor    /etc/lcars/services.env                      0640  root:fleet          wsl+linux
anchor    /etc/lcars/seat.uid                          0644  root:root           any
# source ou kit : écrit par 60-deploy après la pose, lu par prov_channel ; un canal ne se pose pas sur un autre
anchor    /etc/lcars/channel                           0644  root:root           any
anchor    /etc/lcars/deck-oidc.json                    0640  root:lcars-system   wsl+linux
anchor    /usr/local/bin/tofu                          0755  root:root           any
anchor    /usr/local/bin/lcars-toolchain-converge      0755  root:root           any
anchor    /usr/local/bin/lcars-authority-ask           0755  root:root           any
anchor    /etc/wsl.conf                                0644  root:root           wsl
anchor    /etc/apt/keyrings/docker.asc                 0644  root:root           linux
anchor    /etc/apt/sources.list.d/docker.list          0644  root:root           linux

# les liens d'activation sont écrits par systemctl enable, jamais par un module : déclarés pour être audités
link      /etc/systemd/system/multi-user.target.wants/lcars-landing.service     -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-converger.service   -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-catalogue.service   -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-privileged.service  -  -  wsl+linux

link      /usr/local/bin/fleet                      -     -                   any
link      /usr/local/bin/lcars                         -     -                   any
link      /usr/local/bin/node                          -     -                   wsl+linux
link      /usr/local/bin/elixir                       -     -                   wsl+linux
link      /usr/local/bin/elixirc                      -     -                   wsl+linux
link      /usr/local/bin/mix                          -     -                   wsl+linux
link      /usr/local/bin/iex                          -     -                   wsl+linux
link      /usr/local/bin/npm                           -     -                   wsl+linux
link      /usr/local/bin/npx                           -     -                   wsl+linux

group     fleet                                        2000  -                   any
group     lcars-console                                2001  -                   any

# 21 crée le compte sur son groupe éponyme, et refuse un compte existant qui s'en écarte
account   lcars-authority                              -     /usr/sbin/nologin   any
account   lcars-system                                 -     /usr/sbin/nologin   any

runtime   /run/lcars                                   0755  root:root           any
runtime   /run/lcars/console                           0711  root:root           any
runtime   /run/lcars/console/<human>                   2710  <human>:lcars-console  any
# sgid : le marqueur posé par le BEAM doit rester du groupe fleet
runtime   /run/lcars/toolchain                         2775  root:fleet          any
runtime   /run/lcars/authority                         0750  lcars-authority:fleet  any
runtime   /run/lcars/authority/catalogue.sock          0660  lcars-authority:fleet  any
runtime   /run/lcars/authority/roles.sock              0660  lcars-authority:fleet  any
# la porte de dépôt du deck, dans un répertoire à part : le cycle de vie partagé donne au parent le
# groupe de la socket qu'on y pose, et l'y mêler aux deux portes d'au-dessus leur retirerait `fleet`.
# Son groupe est celui de l'AUTORITÉ, et le deck le reçoit à l'exec (`console-landing.sh`, setpriv
# --groups) : `lcars-console` ne se donne par adhésion à personne (MUR 5 ter), et `fleet` donnerait
# au deck les jetons de rôle.
runtime   /run/lcars/deposit                           0750  lcars-authority:lcars-authority  any
runtime   /run/lcars/deposit/deposit.sock              0660  lcars-authority:lcars-authority  any
runtime   /run/lcars/privileged                        0750  root:fleet          any
runtime   /run/lcars/privileged/toolchain.sock         0660  root:fleet          any
runtime   /run/lcars-converger.refused                 0644  root:root           any

runtime   /run/lock/lcars                              0700  root:root           any

# posé par tofu lui-même (cache de plugins sous le HOME de root) : déclaré parce que provoqué
dir       /root/.terraform.d                           0755  root:root           wsl+linux

human     /home/<human>/.lcars                         0700  <human>:-           any
human     /home/<human>/.lcars/log                     0700  <human>:-           any
human     /home/<human>/.lcars/fleet.env            0600  <human>:-           any
human     /home/<human>/pods                           0700  <human>:-           any
human:unset  /home/<human>/.local/bin/claude               0755  <human>:-        any

# ~/.claude naît au umask : mode observé
human:unset  /home/<human>/.claude                        775   <human>:-        any
human     /home/<human>/.claude/settings.json          0644  <human>:-        any
# posé chez le siège seul (45-seat-skill), le seul humain qui lit la boîte de réception d'admiral
human     /home/<human>/.claude/skills/system-issues   0755  <human>:-        any

# posés par mix lui-même (mix local.hex), mode au umask de la machine
human:unset  /home/<human>/.hex                           770   <human>:-        any
human:unset  /home/<human>/.mix                           770   <human>:-        any

# 30-wsl : les dossiers de ~/.config ne sont posés que s'ils manquent (mode observé), le masque de
# gpg-agent y est un lien vers /dev/null, et ~/.docker/config.json n'est réécrit que pour retirer credsStore
human:unset  /home/<human>/.config                        0700  <human>:-        wsl
human:unset  /home/<human>/.config/systemd                0700  <human>:-        wsl
human:unset  /home/<human>/.config/systemd/user           0700  <human>:-        wsl
human     /home/<human>/.config/systemd/user/gpg-agent-ssh.socket  -  -    wsl
human     /home/<human>/.docker/config.json            0600  <human>:-        wsl

# le compte, son groupe privé et son home arrivent ensemble par useradd ; la ligne dit ce qui peut être créé
person    <human>                                      -     /bin/bash           any

# le squelette de la distribution reçoit un bloc géré de trois lignes qui source lcars.bashrc, tout le reste est préservé
anchor    /etc/skel/.bashrc                            0644  root:root           any
anchor    /etc/lcars/lcars.bashrc                      0644  root:root           any
