#!/usr/bin/env bash
# SOURCE: deploy/workstation
# AUTHOR: bob
# STARDATE: (posee par /push-github)
# STATUS: PROTO-V2 — LE délégué du POSTE DE TRAVAIL : escalade, paquets, provisionnement, acceptation
#
#     deploy/workstation  up | doctor
#
# Jumeau de `deploy/box` : celui-là pilote une BOÎTE, celui-ci provisionne CE SYSTÈME. Mêmes
# verbes en tête, mêmes codes retour — qui sait lire l'un sait lire l'autre. Et le troisième larron
# reste l'autorité : `deploy/provision`, que ces deux-là appellent sans jamais le doubler.
#
# ─── POURQUOI CE FICHIER EXISTE ─────────────────────────────────────────────────────────────────
#
# Tout ce qui suit vivait dans `install.sh`, la porte. Elle y faisait donc DEUX métiers : choisir un
# rail, et exécuter l'un des deux. Le canon les sépare (« le rail poste sédimenté dans install.sh :
# il SORT, dans son propre script »), pour une raison qui n'est pas de rangement :
#
# ⚠ LA PORTE SE REJOUAIT ELLE-MÊME SOUS SUDO. Elle devait donc se dire, à la seconde instance, de
# sauter l'accueil et la pause qu'elle venait de jouer — d'où un drapeau `--consented`, c'est-à-dire
# un script qui contourne un problème qu'il s'est créé en voulant tout porter. Ici l'escalade n'a
# rien à sauter : ce script n'a ni accueil ni pause, et `EUID` suffit à distinguer les deux passages.
# `--consented` MEURT avec ce déplacement, il n'est pas réimplémenté.
#
# EXIT : 0 convergé · 2 appliqué avec drift résiduel (rien n'est cassé) · 1 échec

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ⚠ UN SEUL CRAN DEPUIS QUE `deploy/` EST A LA RACINE — meme cicatrice que `deploy/box`. Deux crans
# depuis `deploy/` tombent sur le PARENT du depot, et tout ce qui derive de `REPO_ROOT` vise alors
# un arbre voisin qui ne nous appartient pas.
REPO_ROOT="$(cd "$HERE/.." && pwd)"
PROVISION="$HERE/provision"
PROVISION_LIB="$HERE/lib/provision-lib.sh"

# ⚠ CE MOTIF PORTE LE CHEMIN ECHAPPE, ET C'EST CE QUI L'A RENDU INVISIBLE AU DEMENAGEMENT. Le
# recensement qui a reecrit 148 fichiers cherchait la chaine `fleet/deploy` ; ici elle s'ecrit
# `fleet\/deploy` — pour le `sed` qui la lit, pas pour le `grep` qui la cherche. Les LIGNES du bloc
# d'aide ont donc ete mises a jour, et le motif qui les delimite non : il ne matchait plus rien,
# `usage` rendait le VIDE, et le script sortait 0. Une aide amputee qui ne se signale pas — c'est
# mot pour mot ce que l'en-tete de `provision` reproche a la forme `sed -n '6,52p'`.
usage() { sed -n '/^#     deploy\/workstation/,/^# EXIT :/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# ─── L'aide passe AVANT tout : elle doit marcher sans root et sans clone complet ─────────────────
case "${1:-help}" in
  -h|--help|help) usage; exit 0 ;;
esac

# shellcheck source=lib/provision-lib.sh
. "$PROVISION_LIB"

fail() { printf 'workstation: %s\n' "$1" >&2; [[ -n "${2:-}" ]] && printf '   %s\n' "$2" >&2; exit 1; }

# ─── L'ESCALADE — ICI, ET NULLE PART AILLEURS ───────────────────────────────────────────────────
#
# ⚠ `sudo` FAIT `env_reset` : tout réglage posé avant l'escalade meurt en la traversant. Cette liste
# est le SEUL passage — une variable qui n'y figure pas est mangée en SILENCE, et le geste qu'elle
# commande ne produit rien. Le mode de défaillance est circulaire et muet : la seconde instance ne
# voit pas le drapeau, se refuse elle-même, et invite à poser celui qu'on vient de poser.
#
# On les nomme une par une plutôt que d'ouvrir `-E` : une liste blanche se relit, `-E` laisse passer
# tout ce que l'appelant traîne, y compris ce qui retunerait les témoins du gate joué plus bas.
# ⚠ CETTE LISTE EST LA FRONTIERE DE L'ESCALADE, et ce qui n'y est pas MEURT au `sudo`. `sudo` remet
# l'environnement a zero : une variable posee par la porte et absente d'ici traverse sans bruit et
# n'arrive jamais — le geste demande par l'operateur disparait entre deux processus, sans une ligne.
# `PROV_FORGE_MONTEE` porte `--bench` sur ce rail ; l'oublier ici aurait re-avale le drapeau qu'on
# vient de cabler, un cran plus loin.
#
# ⚠ ET C'EST EXACTEMENT CE QUI EST ARRIVE A L'AUTRE MOITIE DE L'AXE. Aucune `FORGE_*` ne figurait
# ici, alors que le rail les lit : `FORGE_BASE_URL` decide de MONTER ou de CONSOMMER
# (`48-forge-host.sh:69`, `lib/provision-lib.sh:79`) et `FORGE_PUBLIC_URL` porte l'adresse que le
# navigateur doit resoudre (`lib/provision-lib.sh:88`). Mesure : `FORGE_BASE_URL=http://forge.lan:3000
# bash install.sh --workstation` affichait « forge fournie » au preflight — qui tourne NON-ROOT,
# donc avant l'escalade — puis montait un conteneur Gitea sur 127.0.0.1, et `70-human.sh:195`
# ecrivait ensuite cette adresse locale dans le `fleet_v2.env` de chaque humain. La fleet visait la
# mauvaise forge, sans qu'une seule ligne ait dit non. Sur ce rail, l'axe « forge fournie » du § 13
# n'existait donc pas : la porte refuse root, `workstation up` escalade TOUJOURS.
#
# ⚠ AUCUN JETON ICI, ET C'EST UNE REGLE, PAS UN OUBLI. `sudo VAR=valeur` met la valeur dans l'argv
# d'un process root, lisible par tout compte local. Un secret traverse par un FICHIER
# (`$PROV_TOKENS_DIR`), jamais par cette liste — c'est la meme frontiere que le shim docker, qui
# ecarte explicitement `*TOKEN*`, `*PASSWORD*` et `*SECRET*` de ce qu'il repasse.
ESCALADE_ENV=(PROV_COLOR NO_COLOR PROV_VERBOSE PROV_DUMP_LINES LCARS_ALLOW_ANY_HOST PROV_FORGE_ADMIN_RESET PROV_FORGE_MONTEE FORGE_BASE_URL FORGE_PUBLIC_URL)

escalade_si_besoin() {
  [[ "$EUID" -ne 0 ]] || return 0
  command -v sudo >/dev/null 2>&1 \
    || fail "root requis et sudo absent" "lance ce script en root, ou installe sudo"
  printf '\n  [sudo] Privilèges root requis — ton mot de passe peut être demandé.\n'
  local env_args=() v
  for v in "${ESCALADE_ENV[@]}"; do
    [[ -n "${!v:-}" ]] && env_args+=("$v=${!v}")
  done
  # ⚠ AUCUN DRAPEAU DE PASSAGE. La seconde instance se reconnaît à `EUID`, qui est un FAIT ; un
  # marqueur passé en argument est une CROYANCE, que n'importe qui peut poser à la main.
  exec sudo "${env_args[@]}" bash "$(readlink -f "${BASH_SOURCE[0]}")" "$@"
}

# ─── LES FAITS : LE MÊME PRÉFLIGHT QUE LA PORTE, REJOUÉ ─────────────────────────────────────────
#
# La porte a mesuré avant de proposer ; l'escalade sudo a vidé l'environnement entre les deux, donc
# rien de ce qu'elle savait ne traverse. On rejoue LE module — pas une sonde à nous. C'est le même
# code, il est read-only, et l'`apply` plus bas est sa vraie garde : deux lectures d'une mesure
# unique, jamais deux mesures.
FACTS_FILE=""
fait() {
  [[ -n "$FACTS_FILE" ]] || return 0
  sed -n "s/^$1=//p" "$FACTS_FILE" 2>/dev/null | tail -1
}
mesurer() {
  [[ -n "$FACTS_FILE" ]] || {
    FACTS_FILE="$(mktemp "${TMPDIR:-/tmp}/lcars-facts.XXXXXX")" || FACTS_FILE=""
  }
  [[ -n "$FACTS_FILE" ]] || return 0
  : > "$FACTS_FILE"
  env PROV_FACTS_FILE="$FACTS_FILE" "$PROVISION" doctor --only 00-preflight >/dev/null 2>&1 || true
}

# ─── LES IDENTIFIANTS — IMPRIMER PUIS DÉTRUIRE, DANS LE MÊME GESTE ──────────────────────────────
#
# ⚠ SUR TOUS LES CHEMINS DE SORTIE, Ctrl-C COMPRIS. Un `rm` qui s'exécute sans l'impression perd
# POUR DE BON un secret déjà posé sur la forge : le compte existe, avec un mot de passe que personne
# n'a jamais vu.
_CREDS_PRINTED=0
print_credentials_once() {
  [[ "$_CREDS_PRINTED" -eq 0 ]] || return 0
  [[ -n "${PROV_ANNOUNCE_FILE:-}" && -s "$PROV_ANNOUNCE_FILE" ]] || return 0
  _CREDS_PRINTED=1
  prov_print_credentials < "$PROV_ANNOUNCE_FILE"
}
nettoyer() {
  print_credentials_once
  [[ -n "${PROV_ANNOUNCE_FILE:-}" ]] && rm -f "$PROV_ANNOUNCE_FILE"
  [[ -n "${FACTS_FILE:-}" ]] && rm -f "$FACTS_FILE"
  return 0
}

# ─── LE BANDEAU DE FIN ──────────────────────────────────────────────────────────────────────────
bandeau_final() {
  local substrat="$1" step1 step1b step3 step3b
  if [[ "$substrat" == "wsl" ]]; then
    step1="1. WSL : si demandé, « wsl --shutdown » (PowerShell),"
    step1b="   rouvrir un NOUVEL onglet, relancer cet install."
  else
    step1="1. Rien à redémarrer : ce terrain n'a pas de WSL."
    step1b=""
  fi
  # ⚠ AUCUN NOM ICI : ce rail n'en crée plus, et à cette seconde il n'y a peut-être encore personne.
  # Nommer un compte que l'opérateur n'a pas serait lui faire taper une commande qui échoue.
  step3="3. « sudo -u <ton humain> fleet_v2 start » — la fleet tourne sous un"
  step3b="   humain de fleet ; toi tu l'atteins par le groupe fleet. Personne encore ? Inscris-toi sur la forge, team « humans »."

  local corps=("  Suite (les verdicts ci-dessus font foi) :" "  $step1")
  [[ -n "$step1b" ]] && corps+=("  $step1b")
  corps+=("  2. « claude » → /login (geste d'identité, une fois)." "  $step3" "  $step3b")
  corps+=("  Sonde à tout moment : « deploy/workstation doctor »")
  echo ""
  prov_box_emit --rule "       LCARS-FLEET v2 — PROVISIONING TERMINÉ" "${corps[@]}"
}

# ─── up ─────────────────────────────────────────────────────────────────────────────────────────
cmd_up() {
  escalade_si_besoin up "$@"
  # À partir d'ici : root, SUDO_USER = l'humain.
  [[ -x "$PROVISION" ]] || fail "provision introuvable : $PROVISION" "ce rail exige le checkout complet"

  PROV_ANNOUNCE_FILE="$(mktemp "${TMPDIR:-/tmp}/lcars-creds.XXXXXX")" \
    && chmod 0600 "$PROV_ANNOUNCE_FILE" || PROV_ANNOUNCE_FILE=""
  export PROV_ANNOUNCE_FILE
  trap nettoyer EXIT INT TERM

  mesurer

  # ─── LES PAQUETS D'ABORD, SI C'EST LE RAIL QUI POSE DOCKER ───────────────────────────────────
  # Sur une machine qui a déjà docker, rejouer trois modules serait du bruit ; sur une machine non
  # déclarée, ce serait une promesse que `00-preflight` refusera dix secondes plus tard.
  if [[ "$(fait docker)" == "absent" ]] \
     && [[ "$(fait substrat)" == "linux" ]] \
     && [[ "$(fait consent)" == "env" || "$(fait consent)" == "fichier" ]]; then
    echo ""
    echo "  docker n'est pas là et c'est le rail qui le pose — je joue d'abord les paquets."
    "$PROVISION" apply "$@" --only 00-preflight --only 05-host-consent --only 10-packages \
      || echo "  la tranche paquets n'a pas tout convergé — 48-forge-host dira ce qui manque."
    # LA MESURE SE REJOUE : le fait valait « absent » il y a trente secondes, et la suite du rail
    # travaillerait sinon sur une photographie prise avant l'installation.
    mesurer
  fi

  # ─── L'AUTORITÉ ──────────────────────────────────────────────────────────────────────────────
  # `provision apply` rend 0 (convergé), 2 (appliqué, drift résiduel — rien n'est cassé) ou 1
  # (échec) : sous `set -e`, une ligne nue tuerait ce script sur 1 ET 2, sans un mot. Même lecture
  # que `deploy/box` (`await_provision_verdict`) — deux délégués qui en tirent deux verdicts, c'est
  # un code de retour qui ne veut plus rien dire.
  local rc=0
  "$PROVISION" apply "$@" || rc=$?
  case "$rc" in
    0) ;;
    2)
      echo ""
      echo "  Provisionnement APPLIQUÉ, avec DRIFT RÉSIDUEL. Rien n'est cassé : un geste manque."
      echo "  Les lignes DRIFT ci-dessus le nomment, et « workstation doctor » les relit."
      ;;
    *)
      echo ""
      echo "  Provisionnement EN ÉCHEC (rc=$rc) — l'installation n'est PAS complète."
      echo "  Les lignes FAIL ci-dessus nomment ce qui a échoué ; « workstation doctor » les relit."
      exit "$rc"
      ;;
  esac

  # ─── L'ACCEPTATION, AVANT DE SE DÉCLARER FINI ────────────────────────────────────────────────
  # ⚠ ELLE SE JOUE ICI ET PAS APRÈS COUP : le mot de passe de la forge n'existe que pendant cette
  # passe — `nettoyer` détruit le fichier en sortant, et la forge n'en garde qu'un hash. Plus tard,
  # on ne pourrait plus vérifier « je peux me connecter », seulement « le compte existe ».
  local accept_rc=0
  if [[ -x "$HERE/accept" ]]; then
    bash "$HERE/accept" --announce-file "${PROV_ANNOUNCE_FILE:-/dev/null}" || accept_rc=$?
  fi

  bandeau_final "$(fait substrat)"

  # Les identifiants en DERNIER : la dernière chose à l'écran est la seule qu'on est sûr de ne pas
  # avoir fait défiler. `nettoyer` les imprimerait de toute façon — cet appel les place avant le
  # code de sortie sur le chemin nominal.
  print_credentials_once
  exit "$accept_rc"
}

# ─── doctor ─────────────────────────────────────────────────────────────────────────────────────
#
# ⚠ AUCUNE ESCALADE ICI, ET C'EST LE CONTRAT. `doctor` est read-only : `NEEDS: root` n'est contrôlé
# qu'à l'`apply` (`provision`, `run_module`). Demander sudo pour SONDER apprendrait à l'opérateur
# qu'une sonde coûte un mot de passe — et il finirait par le donner à n'importe quoi.
cmd_doctor() {
  [[ -x "$PROVISION" ]] || fail "provision introuvable : $PROVISION" "ce rail exige le checkout complet"
  exec "$PROVISION" doctor "$@"
}

case "${1:-help}" in
  up)     shift; cmd_up "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  *)      fail "verbe inconnu : $1" "workstation up | doctor  (--help pour l'aide)" ;;
esac
