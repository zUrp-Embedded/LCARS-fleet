#!/bin/bash
# SOURCE: deploy/pkg/lcars-bench/prerm
# AUTHOR: bob
# STARDATE: 2026-09-05
# STATUS: maintainer script dpkg — `lcars-bench` avant le retrait : dit quel humain le postrm
#         retirera, avec son home. Rien de destructif ici.
#
# dpkg l'appelle : prerm remove · prerm upgrade · prerm deconfigure · prerm failed-upgrade
set -euo pipefail

say() { echo "lcars-bench/prerm: $*" >&2; }
ROOT="${PROV_ROOT:-/opt/lcars}"
DEMO_FILE="${LCARS_DEMO_HUMAN_FILE:-$ROOT/var/demo-human}"
case "${1:-}" in
  remove) ;;
  *) exit 0 ;;
esac
if [[ -s "$DEMO_FILE" ]]; then
  say "au retrait, l'humain de demo « $(head -n1 "$DEMO_FILE" | tr -d '[:space:]') » sera retire AVEC son home (le seul que dpkg a le droit de retirer : il l'a cree). Rien ici."
else
  say "aucun humain de demo enregistre ($DEMO_FILE) — le postrm ne retirera personne"
fi
exit 0
