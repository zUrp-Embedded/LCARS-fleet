#!/bin/bash
# SOURCE: deploy/pkg/lcars/prerm
# AUTHOR: bob
# STARDATE: 2026-09-05
# STATUS: maintainer script dpkg — `lcars` avant le retrait : le PLAN de desinstallation (rien de
#         destructif), et une copie du desinstalleur pour le postrm, qui n'aura plus les fichiers
#
# dpkg l'appelle : prerm remove · prerm upgrade <nouvelle> · prerm deconfigure … · prerm failed-upgrade
#
# ⚠ LE POSTRM TOURNE APRES QUE DPKG A RETIRE LES FICHIERS — `/opt/lcars/deploy/provision` compris.
# Le desinstalleur du paquet est un fichier du paquet : au moment de s'en servir, il n'est plus la.
# Ce script le RECOPIE donc (deploy/ entier, sans les tests : la lib, le runner, les modules, la
# table) dans un dossier que la table ne nomme pas, sous /var/tmp — root cree le dossier lui-meme
# (`mkdir`, jamais `-p`, apres un `rm -rf` : un lien pre-pose par un autre compte fait echouer la
# creation, et c'est le refus voulu), et le postrm le joue puis l'efface. Le plan, lui, s'imprime
# ici, avec les drapeaux exacts que le postrm passera : `--keep-state` (remove garde l'etat) et
# `--dpkg lcars` (ce qu'un autre paquet possede n'est pas a ce script).
set -euo pipefail

say() { echo "lcars/prerm: $*" >&2; }
PROVISION="${LCARS_PROVISION_BIN:-/opt/lcars/deploy/provision}"
STASH="${LCARS_UNINSTALL_STASH:-/var/tmp/lcars-uninstall-lcars}"

case "${1:-}" in
  remove) ;;
  *) exit 0 ;;
esac

if [[ ! -x "$PROVISION" ]]; then
  say "provisionnement introuvable ($PROVISION) — aucun plan, et le postrm n'aura rien a jouer"
  exit 0
fi

say "plan de desinstallation — RIEN n'est retire ici, le postrm le joue avec ces memes drapeaux :"
"$PROVISION" uninstall --keep-state --dpkg lcars || say "le plan n'a pas pu s'imprimer (rc=$?) — le postrm tentera quand meme"

rm -rf -- "$STASH"
mkdir -m 0700 -- "$STASH" || { say "REFUS — $STASH existe encore apres son retrait : quelqu'un d'autre y ecrit"; exit 1; }
mkdir -p -- "$STASH/deploy"
( cd "$(dirname "$PROVISION")" && tar -cf - --exclude=./tests . ) | ( cd "$STASH/deploy" && tar -xf - ) \
  || { say "copie du desinstalleur ratee ($STASH) — le postrm ne pourra pas jouer « provision uninstall »"; exit 1; }
say "desinstalleur copie dans $STASH/deploy — le postrm le joue, puis l'efface au purge"
exit 0
