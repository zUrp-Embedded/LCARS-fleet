#!/bin/bash
# SOURCE: deploy/pkg/lcars/preinst
# AUTHOR: bob
# STARDATE: 2026-09-05
# STATUS: maintainer script dpkg — `lcars` AVANT le depaquetage : une machine, un canal ; et le
#         groupe que le tar du .deb nomme doit exister pour que dpkg le resolve
#
# dpkg l'appelle : preinst install [ancienne-version] · preinst upgrade <ancienne-version> ·
#                  preinst abort-upgrade <nouvelle-version>
#
# ⚠ DEUX GESTES, ET AUCUN N'EST UNE LOGIQUE DE CE SCRIPT :
#   1. LE CANAL. Un .deb par-dessus une install kit ou source fait diverger les deux
#      desinstalleurs (00-OBJECTIF § 6 : « une machine, un canal ») — dpkg ecraserait des fichiers
#      qu'il ne possede pas. Le refus se prononce ICI, avant que dpkg ne depaquete quoi que ce soit ;
#      au postinst il serait trop tard. Le remede est nomme : desinstaller, puis installer.
#   2. LE GROUPE DU PREFIXE. nFPM ecrit les noms des proprietaires dans le tar et laisse les
#      numeros a 0 (mesure sur nfpm 2.47.0) : dpkg resout le NOM au depaquetage, et retombe sur
#      root quand il n'existe pas. `/opt/lcars/runtime` est `root:fleet` pour toute la release —
#      sans ce groupe avant le depaquetage, la release naitrait `root:root` et 60-deploy, qui MESURE
#      sous le canal deb, ne la reposerait pas. C'est la regle Debian (policy § 9.2.2) : un groupe
#      dont les fichiers du paquet portent le nom se cree au preinst. Le GID est celui de la table
#      (`group fleet 2000`) ; `20-groups` le reconverge au postinst, et le temoin
#      `deploy/tests/pkg/maintainer_scripts.bats` tient l'egalite des deux nombres.
set -euo pipefail

say() { echo "lcars/preinst: $*" >&2; }
CHANNEL_FILE="${LCARS_CHANNEL_FILE:-/etc/lcars/channel}"
FLEET_GROUP="${PROV_FLEET_GROUP:-fleet}"
FLEET_GID=2000   # = deploy/system.manifest, ligne `group fleet` — tenu egal par le temoin

case "${1:-}" in
  install|upgrade) ;;
  *) exit 0 ;;
esac

if [[ -r "$CHANNEL_FILE" ]]; then
  canal="$(head -n1 "$CHANNEL_FILE" | tr -d '[:space:]')"
  if [[ -n "$canal" && "$canal" != "deb" ]]; then
    say "REFUS — cette machine porte une install de canal « $canal » ($CHANNEL_FILE), pas un paquet."
    say "  Une machine, un canal : dpkg ecraserait des fichiers que « provision uninstall » croit siens."
    say "  Le geste : « sudo provision uninstall --yes » depuis le checkout ou le kit qui l'a posee, PUIS ce paquet."
    exit 1
  fi
fi

if getent group "$FLEET_GROUP" >/dev/null 2>&1; then
  say "groupe $FLEET_GROUP present (gid $(getent group "$FLEET_GROUP" | cut -d: -f3))"
else
  groupadd -g "$FLEET_GID" "$FLEET_GROUP" \
    || { say "groupe $FLEET_GROUP (gid $FLEET_GID) non cree — le gid est-il pris ? « getent group $FLEET_GID »"; exit 1; }
  say "groupe $FLEET_GROUP cree (gid $FLEET_GID, la table) — la release du paquet lui appartiendra au depaquetage"
fi
exit 0
