#!/bin/bash
# SOURCE: deploy/pkg/lcars-workstation/prerm
# AUTHOR: bob
# STARDATE: 2026-09-05
# STATUS: maintainer script dpkg — `lcars-workstation` avant le retrait : dit ce que le postrm
#         fera (les unites de la table, arretees puis retirees). Rien de destructif ici.
#
# dpkg l'appelle : prerm remove · prerm upgrade · prerm deconfigure · prerm failed-upgrade
set -euo pipefail

say() { echo "lcars-workstation/prerm: $*" >&2; }
PROVISION="${LCARS_PROVISION_BIN:-/opt/lcars/deploy/provision}"
MANIFEST="$(dirname "$PROVISION")/system.manifest"

case "${1:-}" in
  remove) ;;
  *) exit 0 ;;
esac

if [[ ! -r "$MANIFEST" ]]; then
  say "table introuvable ($MANIFEST) — le postrm n'aura aucune unite a nommer"
  exit 0
fi
units="$(awk '$1 !~ /^#/ && $1 ~ /^anchor/ && $2 ~ /\/systemd\/system\/.*\.service$/ { print $2 }' "$MANIFEST")"
say "au retrait, ces unites seront ARRETEES puis retirees (rien ici) :"
printf '  %s\n' ${units:-"(aucune dans la table)"} >&2
say "l'etat (/etc/lcars, /opt/lcars/var), les comptes et les groupes suivent le paquet lcars, pas celui-ci"
exit 0
