#!/bin/bash
# SOURCE: deploy/pkg/lcars-forge/postinst
# AUTHOR: bob
# STARDATE: 2026-09-05
# STATUS: maintainer script dpkg — `lcars-forge` configure : monte la forge (48), enrole le
#         runner (49), pose la structure (61) — `provision apply`, rien d'autre
#
# dpkg l'appelle : postinst configure [ancienne-version]
set -euo pipefail

say() { echo "lcars-forge/postinst: $*" >&2; }
PROVISION="${LCARS_PROVISION_BIN:-/opt/lcars/deploy/provision}"
LIB="$(dirname "$PROVISION")/lib/provision-lib.sh"
CHANNEL_FILE="${LCARS_CHANNEL_FILE:-/etc/lcars/channel}"
MODS=(48 49 61)

case "${1:-}" in
  configure) ;;
  *) exit 0 ;;
esac

[[ -x "$PROVISION" ]] || { say "provisionnement introuvable ($PROVISION) — lcars est-il configure ?"; exit 1; }
[[ -r "$LIB" ]]       || { say "lib introuvable ($LIB)"; exit 1; }
[[ "$(head -n1 "$CHANNEL_FILE" 2>/dev/null | tr -d '[:space:]')" == "deb" ]] \
  || { say "REFUS — le canal n'est pas « deb » ($CHANNEL_FILE) : « sudo dpkg --configure lcars » d'abord"; exit 1; }

seat="${SUDO_USER:-}"
if [[ -z "$seat" || "$seat" == root ]] && [[ -n "${LCARS_SYSADMIN_UID:-}" ]]; then
  seat="$(getent passwd "$LCARS_SYSADMIN_UID" 2>/dev/null | cut -d: -f1 || true)"
fi
if [[ -z "$seat" || "$seat" == root ]]; then
  say "REFUS — aucun siege : ni SUDO_USER, ni LCARS_SYSADMIN_UID (« sudo env LCARS_SYSADMIN_UID=<uid> dpkg --configure lcars-forge »)"
  exit 1
fi
export LCARS_SYSADMIN_UID; LCARS_SYSADMIN_UID="$(id -u -- "$seat")"

sub="$(bash -c '. "$1"; detect_substrate' _ "$LIB")"
[[ "$sub" != docker ]] || { say "REFUS — pas dans une image"; exit 1; }

# La forge de ce paquet est MONTEE ici, meme si une FORGE_BASE_URL traine dans l'environnement :
# c'est ce que « --bench » porte sur le rail poste (48-forge-host, PROV_FORGE_MONTEE).
export LCARS_ALLOW_ANY_HOST=1 PROV_FORGE_MONTEE=1
only=(); for m in "${MODS[@]}"; do only+=(--only "$m"); done
say "provision apply --substrate $sub --human $seat --only ${MODS[*]}"
rc=0
"$PROVISION" apply --substrate "$sub" --human "$seat" "${only[@]}" || rc=$?
case "$rc" in
  0) say "forge montee, runner enrole, structure posee" ;;
  2) say "forge appliquee, drift residuel — « provision doctor » le nomme ; ce n'est pas un echec" ;;
  *) say "ECHEC (rc=$rc) — relis la sortie ci-dessus ; « sudo dpkg --configure lcars-forge » rejoue"; exit 1 ;;
esac
exit 0
