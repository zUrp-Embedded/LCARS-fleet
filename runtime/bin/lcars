#!/usr/bin/env bash
# SOURCE: bin/lcars
# AUTHOR: starfleet
# STARDATE: 2026-06-14
# STATUS: PROTO-V2 — operator CLI for the fleet: spawn / list / attach (LAUNCH-1/2/2b)
#
# `attach` requires the operator to have the SAME UID as the daemon (the per-pod sock dirs are `0700`).
#
# Config (env):
#   LCARS_API_SOCK        the daemon's control socket (default ~/.lcars/run/api.sock, per-human).
#   LCARS_TMUX_SOCK_BASE  base of the per-pod socks (default ~/.lcars/run/tmux-sock; = the Elixir
#                         default, c368f89d)
#   LCARS_TMUX_BIN        tmux binary (default: tmux from the PATH)

set -euo pipefail

# ⚖ Decision 3 : LES FAITS DE LA MACHINE SE LISENT, ILS NE SE RECOPIENT PAS (`etc/facts.env`).
# ⚠ DEUX CANDIDATS : ce CLI est atteint par un SYMLINK depuis le PATH, et bash ne le resout pas —
# `dirname "$0"` rend alors `/usr/local/bin`, ou rien de ce produit ne vit. Le voisin resout le
# checkout, la racine du produit resout la machine.
FACTS_SH="${LCARS_FACTS_SH:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../services/lib/facts.sh}"
[[ -r "$FACTS_SH" ]] || FACTS_SH=/opt/lcars/services/lib/facts.sh
# shellcheck source=../services/lib/facts.sh
. "$FACTS_SH"

# ⚠ L'ETAT DE L'HUMAIN VIT SOUS SON HOME, ET SEULS LES VERBES QUI LE LISENT LE DEMANDENT. Un service
# systemd sans `User=` n'a pas de HOME : evalue ici, au chargement, `set -u` tuerait TOUTE la CLI,
# portes `tool` comprises, qui s'en passent (elles lancent le release sous HOME=/tmp) — et
# `lcars_roles` lirait « aucun role » la ou il n'a rien pu lire.
#
# PER-HUMAN, sous ~/.lcars — PAS /opt/lcars/var/tokens, qui est le store PARTAGE des jetons worker
# (root:fleet, indexe par role). Les jetons de FORGES_DIR sont les fichiers de l'humain, et
# n'entrent JAMAIS dans un pod.
_etat_humain() { # _etat_humain <verbe> -> pose SOCK_BASE API_SOCK FORGES_DIR PUBLISH_DIR, ou refuse
  [[ -n "${HOME:-}" ]] \
    || die "HOME absent — « ${1:-} » lit l'etat de l'humain (~/.lcars) ; seules les portes « tool » s'en passent"
  SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"
  API_SOCK="${LCARS_API_SOCK:-$HOME/.lcars/run/api.sock}"
  FORGES_DIR="$HOME/.lcars/forges"
  PUBLISH_DIR="$HOME/.lcars/publish"
}

TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"

PROG="$(basename "$0")"

# ⚠ LES PORTES OUTIL, DECLAREES UNE FOIS. L'aide et le refus d'une porte inconnue les nommaient
# chacun de leur cote : l'aide a vieilli sans bruit, et une porte s'ajoutait sans y apparaitre —
# `system-project` depuis `3420d477`, `ops-repo` depuis `c6e48370` (mesure du 2026-09-19 sur le banc
# 2005, l'aide lue par-dessus l'epaule d'un operateur). Un mur tient cette liste d'accord avec les
# branches que `cmd_tool` dispatche vraiment.
TOOL_PORTES="verify <root>|roles [root]|roles-tfvars [root]|catalogue-root|catalogue-source <nom>|system-project|ops-repo|catalogue-installed"

die() { echo "lcars: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
$PROG — CLI fleet LCARS

USAGE
  $PROG spawn <role> [--issue <id>] [--brief <texte>]
      Demande au daemon de lancer un pod du role <role> (= nom de cap-profile,
      ex: architect, engineer, consultant). Dispatch ASYNC : le pod n'est pas
      vivant au retour — « $PROG list » pour le voir. NB : les roles
      boot_at_start (starfleet) montent seuls au boot de la fleet ; spawn sert
      surtout aux roles ponctuels et au test.

  $PROG admiral
      LA SEANCE DE FIX ([BL-6-101]) : demande le spawn du siege machine \`admiral\` —
      le SEUL pod hors sandbox, et il ne s'obtient que par CE geste (la porte
      generique refuse tout \`containment: none\` sans l'acquittement que cette
      commande pose). Aucun argument : c'est une seance, pas un dispatch. Le pod
      tourne sous TON uid ; « $PROG attach » pour t'y asseoir.

  $PROG list
      Liste les pods VIVANTS (socks tmux par-pod) + le statut de leur session tmux.

  $PROG ls
      Alias de « $PROG list ».

  $PROG attach <pod_id>
      Attache ce terminal sur la session tmux du pod (Ctrl-b d rend la main sans
      tuer le pod).

  $PROG tool {$TOOL_PORTES}
      Les PORTES OUTIL du release — des evaluations d'une ligne, sous un uid sans pouvoir quand
      l'appelant est root. \`forge-gestures.sh\`, le geste des jetons et l'enrolement d'un
      catalogue (\`deploy/lib/enroll-catalogue.sh\`) les appellent ici ; le boot de l'image
      (container/boot.sh) delegue ici les memes mots. Elles lisent le catalogue ou MESURENT la
      forge ; aucune ne parle a la fleet.

  $PROG catalogue list
      Ce que la FORGE porte : installes, disponibles, et ceux dont la source a bouge.

  $PROG catalogue install <nom>
      Installe — ou MET A JOUR — le catalogue <nom> depuis le depot que la forge porte.
      ADMIN SEULEMENT, et « admin » est un fait de la FORGE (is_admin), pas de l'uid :
      le geste lit le jeton master, ouvert au groupe que le convergeur derive de la forge.

      La source arrive par la FORGE : un humain pousse son catalogue dans son espace
      personnel depuis son disque, et n'importe qui peut le faire. L'installer est un
      autre geste, et c'est celui-la qui est garde. Le NOM vient du manifeste du depot,
      jamais du nom du depot ni de vous.

      Rejouable : rien n'existe -> il cree ; la source a bouge -> il reconverge ; rien
      n'a bouge -> il ne touche rien. JAMAIS declenche par le boot.

  $PROG catalogue verify <nom>
      Joue sur ce catalogue exactement les controles que le boot joue. Code de
      sortie = verdict.


  $PROG project migrate <owner/nom> <catalogue>
      Migre un projet vers un autre catalogue : transfert du depot dans l'org de ce
      catalogue, PUIS repointage de l'origin des trois faces locales. Les deux
      moities, ou rien — un transfert seul laisse un projet qui marche par accident,
      via la redirection 301. REFUSE un catalogue qui n'est pas installe ici.

  $PROG project adopt-system [--check] [--from <arbre>]
      Publie l'arbre dont CETTE machine a ete installee comme projet de sa propre fleet :
      un depot sur la forge, ses trois faces, ses labels, sa protection. Le nom et l'org
      sont declares (\`Fleet.Layout.system_project/0\`, le catalogue embarque), pas devines.
      Se rejoue : une machine qui porte deja son projet le DIT et rend 0.
      --check MESURE sans rien ecrire : le projet est la, absent, ou la source manque.
      --from <arbre> : l'arbre dont la machine a ete installee. La face de code du projet
      (\`/home/projects/<nom>\`) s'en seme si elle n'existe pas — un arbre deja la n'est
      jamais touche. Sans lui, une machine sans face de code n'a rien a publier.

  $PROG project reconcile [check|apply]
      La forge dit quels projets existent, le disque suit. Sur un /home neuf — conteneur
      reinstalle, second humain qui arrive sur une fleet deja peuplee — les faces
      locales n'existent pas alors que les projets, eux, sont intacts. « check » ne
      touche rien et liste ce qui manque ; « apply » importe. Un projet en echec
      n'arrete pas les autres.

  $PROG forge add <name> --host github|gitlab --owner <owner> [--dest-host H]
  $PROG forge list
  $PROG forge status
      Le POOL de forges de publication de CET humain (~/.lcars/forges). Une forge =
      forge + compte + repo. L'AUTH n'est pas stockee ici : c'est le CLI officiel de la
      forge (« gh auth login » / « glab auth login »), deja credential helper git.
      GitLab est une forge de plein droit ; --dest-host pour Enterprise / self-hosted.
      « status » = le doctor : chaque forge + si son CLI est authentifie ([ok]/[!!]).

  $PROG approve <owner/nom-interne> --forge <name> --as <repo-dest> [--base main] [--public]
  $PROG approve <owner/nom-interne> [--base main]
      PHASE 1 — le gate manuel dur de la publication. Avec --forge/--as : CREE-OU-LIE le
      projet a une forge du pool et POUSSE le peuplement initial. Tier 1 (gh/glab
      authentifie) : cree le repo s'il n'existe pas (--public sinon prive). Tier 2 (repo
      pre-cree dans l'UI) : le lie tel quel (refuse d'ecraser une base deja remplie).
      Sans --forge : PUSH DIRECT de l'etat courant sur la base deja liee (garde
      deterministe : refuse si la base n'est pas un ancetre du clone reecrit).
      L'attribution est reecrite (author=humain) avant tout push ; l'auth vers la forge
      externe passe par gh/glab ou le helper git cable (aucun token manipule ici). La
      phase 2 (PR/MR reguliere) : « publish run » ci-dessous, ou le tool « project_publish »
      cote pod — les deux appellent le MEME rail avec les MEMES arguments.

  $PROG publish run <owner/nom-interne> [--linearize BRANCHE]
      PHASE 2 — la publication qui se REPETE : rejoue le rail sur le projet lie. Pousse la
      branche roulante (lcars/publish) et laisse UNE seule PR/MR ouverte contre la base ;
      c'est un humain qui la merge. Tier 2 (pas de CLI authentifie) : la branche part quand
      meme et l'URL de PR/MR a ouvrir est imprimee. Porte HUMAINE : c'est le meme rail que
      le tool « project_publish », expose du cote ou on peut le rejouer pour diagnostiquer.
      Sortie 6 = la reecriture n'est plus deterministe : le clone est CONSERVE et son
      chemin imprime.
      --linearize BRANCHE : aplatit l'histoire publiee en first-parent (forme MR canonique,
      arbre final identique, merges aplatis). Geste HUMAIN : le runtime publie une PR
      roulante ou les bulles de merge sont normales ; cette forme sert une MR upstream.

  $PROG publish status <owner/nom-interne>
      Le doctor par PROJET : est-il pret a publier ? Non lie = etat valide, rapporte
      calme (pas un trou). Lie : la chaine de readiness (CLI authentifie + base peuplee
      cote forge). Chaque manque nomme le geste suivant.

  $PROG help
      Cette aide.

ENV
  LCARS_API_SOCK=${API_SOCK:-~/.lcars/run/api.sock}     (la seule voie vers la fleet, socket AF_UNIX host-only)
  LCARS_TMUX_SOCK_BASE=${SOCK_BASE:-~/.lcars/run/tmux-sock}
EOF
}


cmd_admiral() {
  [[ $# -eq 0 ]] || die "admiral: aucun argument — c'est une seance, pas un dispatch"

  local body http payload='{"cap_profile_name":"admiral","host_native_ack":true}'
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn"     -H 'Content-Type: application/json' -d "$payload" -w $'\n%{http_code}')"     || die "admiral: le daemon ne repond pas sur $API_SOCK (fleet lancee ?)"
  http="${body##*$'\n'}"; body="${body%$'\n'*}"

  case "$http" in
    202)
      echo "admiral: seance demandee (202 = en file, PAS encore vivant)."
      echo "  suivi :   $PROG list"
      echo "  s'asseoir: $PROG attach <pod_id>   (Ctrl-b d pour partir sans tuer la seance)"
      ;;
    *)
      die "admiral: refuse ($http) — $body"
      ;;
  esac
}

cmd_spawn() {
  local role="" issue="" brief="" have_brief=0
  [[ $# -ge 1 && "$1" != --* ]] || die "spawn: role requis (ex: $PROG spawn architect)"
  role="$1"; shift
  # The role is a cap-profile slug (JSON anti-injection for the jq-less payload path below).
  [[ "$role" =~ ^[a-z][a-z0-9-]*$ ]] || die "spawn: role '$role' invalide (slug [a-z0-9-] attendu)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="${2:?--issue exige une valeur}"; shift 2 ;;
      --brief) brief="${2:?--brief exige une valeur}"; have_brief=1; shift 2 ;;
      *) die "spawn: argument inconnu '$1'" ;;
    esac
  done
  [[ -z "$issue" || "$issue" =~ ^[A-Za-z0-9._-]+$ ]] || die "spawn: --issue '$issue' invalide"

  local payload
  if [[ "$have_brief" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || die "spawn: --brief exige jq (pour le quoting JSON du texte libre)"
    payload="$(jq -nc --arg r "$role" --arg t "$issue" --arg m "$brief" \
      '{cap_profile_name:$r} + (if $t=="" then {} else {issue_id:$t} end) + {brief:$m}')"
  elif [[ -n "$issue" ]]; then
    payload="$(printf '{"cap_profile_name":"%s","issue_id":"%s"}' "$role" "$issue")"
  else
    payload="$(printf '{"cap_profile_name":"%s"}' "$role")"
  fi

  # Le DTO est PLAT et allowliste : toute clef hors liste (un `opts` fourni par le client compris)
  # fait echouer le spawn en 422.
  local body http
  # La porte d'ecriture est sur la socket AF_UNIX per-humain, que le pod ne peut pas joindre. L'hote
  # de l'URL est ignore avec `--unix-socket`. curl SANS `-f` : un 4xx/5xx ne le fait pas echouer,
  # d'ou la lecture du code par `-w` — seul un echec de transport atteint le `|| die`.
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn" \
            -H 'content-type: application/json' -d "$payload" \
            -w $'\n%{http_code}' 2>/dev/null)" \
    || die "control socket injoignable ($API_SOCK) — fleet tourne pour cet utilisateur ?"

  http="${body##*$'\n'}"; body="${body%$'\n'*}"
  case "$http" in
    202) echo "spawn $role : mis en file (202). Le pod monte en async — « $PROG list » pour le voir." ;;
    503) die "fleet en drain de shutdown (503) — retente quand la fleet sera repartie" ;;
    422) die "spawn KO : cap-profile '$role' inconnu (422) — le nom de role est faux. $body" ;;
    400) die "spawn KO : appel invalide (400). $body" ;;
    *)   die "spawn KO (HTTP $http) : $body" ;;
  esac
}


cmd_list() {
  [[ -d "$SOCK_BASE" ]] || { echo "(aucun pod : $SOCK_BASE absent — la fleet tourne ?)"; return 0; }
  shopt -s nullglob
  local socks=("$SOCK_BASE"/*/pod.sock) found=0
  if [[ ${#socks[@]} -eq 0 ]]; then echo "(aucun pod vivant)"; return 0; fi
  printf '%-40s  %s\n' "POD_ID" "TMUX"
  local sock pod_id session status
  for sock in "${socks[@]}"; do
    pod_id="$(basename "$(dirname "$sock")")"
    session="lcars-pod-$pod_id"
    if "$TMUX_BIN" -S "$sock" has-session -t "$session" 2>/dev/null; then
      status="vivant"
    else
      status="sock orphelin (pas de session)"
    fi
    printf '%-40s  %s\n' "$pod_id" "$status"
    found=1
  done
  [[ "$found" -eq 1 ]] || echo "(aucun pod vivant)"
}


cmd_attach() {
  local pod_id="${1:-}"
  [[ -n "$pod_id" ]] || die "attach: pod_id requis (cf. « $PROG list »)"
  # Anti path-traversal: pod_id is ONE path component (sock = $SOCK_BASE/$pod_id/pod.sock). No `/`, no `..`.
  [[ "$pod_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$pod_id" != *..* ]] \
    || die "attach: pod_id '$pod_id' invalide"
  local sock="$SOCK_BASE/$pod_id/pod.sock"
  [[ -S "$sock" ]] || die "attach: pas de sock pour '$pod_id' ($sock) — pod vivant ? (cf. « $PROG list »)"
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "attach: tmux introuvable ($TMUX_BIN)"
  echo "attach $pod_id (Ctrl-b d rend la main sans tuer le pod)…" >&2
  # Souris ON change la selection : maintenir Shift pour copier vers le presse-papier de l'OS.
  "$TMUX_BIN" -S "$sock" set -g mouse on 2>/dev/null || true
  exec "$TMUX_BIN" -S "$sock" attach -t "lcars-pod-$pod_id"
}

# LE CACHE INSTALLE EST AUSSI CONNU D'ELIXIR (`Fleet.Layout`) : deux langages qui ne peuvent pas
# s'appeler lisent le MEME fait (`etc/facts.env`), au lieu d'en tenir chacun une copie.
CAT_DIR="$LCARS_CATALOGUES_DIR"
CAT_SHIPPED="$LCARS_CATALOGUES_SHIPPED"
# Le nom reserve du catalogue metier livre DANS le release : il n'a pas de dossier installe, donc
# rien ne l'installe et rien ne le supprime — il est la, toujours.
CAT_BUNDLED="fleet"

cat_dir_of() {
  local name="$1"
  if [[ -d "$CAT_DIR/$name" ]]; then echo "$CAT_DIR/$name"
  elif [[ -d "$CAT_SHIPPED/$name" ]]; then echo "$CAT_SHIPPED/$name"
  else return 1; fi
}

# Le fichier porte AUSSI des ports d'ecoute : `LCARS_TOOL_EVAL=1`, pose par chaque appelant,
# neutralise le bloc qui les ouvrirait. Ce CLI ne fait aucun appel forge, il transmet la config.
_load_container_env() {
  local env_file="${LCARS_FLEET_ENV:-$HOME/.lcars/fleet.env}"
  [[ -f "$env_file" ]] || return 0
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
}

# Un seul defaut, pose ici. L'appelant decide de son absence : `catalogue list` la rend en 127 pour
# la dire, les autres portes meurent dessus.
_release_bin() { printf '%s\n' "${LCARS_FLEET_BIN:-$LCARS_PREFIX/rel/lcars_fleet/bin/lcars_fleet}"; }

# ⚠ UN REPERTOIRE COURANT QUE L'APPELANT NE LIT PAS FAIT MOURIR LE BEAM, ET SA PLAINTE NE PARLE DE
# RIEN. Mesure du 2026-09-18 sur le banc 2004 : `lcars` lance par un humain depuis le home d'un
# AUTRE (`drwxr-x---`) rend un « Kernel pid terminated (logger) » avec une pile `code_server`, puis
# ecrit un crash dump — trois ecrans qui n'accusent ni le dossier ni le compte. Le meme geste, une
# ligne plus bas dans le bon dossier, marche.
#
# Ce n'est pas le cas de production (le convergeur et les modules jouent depuis le home de l'humain),
# c'est le cas de l'OPERATEUR qui tape la commande la ou il se trouve. Un refus nomme coute cinq
# lignes ; le crash lui coute une demi-heure.
_cwd_lisible() {
  local ici; ici="$(pwd -P 2>/dev/null || true)"
  [[ -n "$ici" && -r "$ici" && -x "$ici" ]] \
    || die "le repertoire courant (${ici:-inconnu}) n'est pas lisible par $(id -un) — le BEAM y meurt sans rien dire d'utile. Se placer ailleurs (« cd ~ ») et rejouer"
}

# ⚠ LE JETON ATTERRIT DANS UN FICHIER, ET C'EST DELIBERE : les rails prennent un CHEMIN, et leur
# passer le jeton en argument le mettrait dans `/proc/<pid>/cmdline`, que tout le monde lit.
_authority_ask_bin() { printf '%s\n' "${LCARS_AUTHORITY_ASK_BIN:-$LCARS_LINK_DIR/lcars-authority-ask}"; }

_forge_account() {
  printf '%s\n' "${FORGE_PUSH_ACCOUNT:-${FORGE_BOT_LOGIN:-$LCARS_SYSTEM_ACCOUNT}}"
}

# Materialise le jeton dans <dir>, rend son chemin. Le client porte deja la cause sur stderr : on ne
# la reformule pas par-dessus.
# ⚠ `umask 077` DANS UN SOUS-SHELL : pose dans le shell courant, il resterait actif pour tout ce que
# la porte ecrit ensuite.
_authority_token_file() { # <compte> <dir>
  local compte=$1 dir=$2 ask f
  ask="$(_authority_ask_bin)"
  [[ -x "$ask" ]] \
    || die "client d'autorité absent ($ask) — sans lui aucun jeton de forge n'est obtenable. Sur un poste, « deploy/workstation up » le pose ; dans un conteneur, c'est l'image qui le porte"
  f="$dir/.forge-token"
  ( umask 077; "$ask" "$compte" > "$f" ) || { rm -f "$f"; return 1; }
  printf '%s\n' "$f"
}

cat_states() {
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || return 127
  _load_container_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Application.CatalogueLifecycle.eval_main()"
}

cmd_catalogue_list() {
  # ⚠ `out="$(...)"; rc=$?` NE MARCHE PAS SOUS `set -e` : une substitution de commande qui echoue
  # dans une affectation tue le script AVANT la ligne suivante — `rc` ne serait jamais lu et aucun
  # des refus ci-dessous ne serait atteint. Le `||` fait de l'affectation une condition, ce qui est
  # exactement l'exception que `set -e` prevoit.
  local out rc=0
  out="$(cat_states 2>&1)" || rc=$?

  case "$rc" in
    0)
      printf '  %-16s %-11s %s\n' "CATALOGUE" "ETAT" "DEPOT"
      while read -r state name src; do
        case "$state" in
          INSTALLED) printf '  %-16s %-11s %s\n' "$name" "installe" "$src" ;;
          UPDATABLE) printf '  %-16s %-11s %s\n' "$name" "MAJ DISPO" "$src  → « $PROG catalogue install $name » met a jour" ;;
          AVAILABLE) printf '  %-16s %-11s %s\n' "$name" "disponible" "$src  → « $PROG catalogue install $name » (admin forge)" ;;
        esac
      done <<< "$out"
      ;;
    3)
      echo "catalogue list: DEUX depots declarent le meme catalogue — refus." >&2
      printf '%s\n' "$out" | sed 's/^DUPLICATE /  /' >&2
      echo "  Aucun des deux n'est choisi. Supprimez-en un (ou renommez-le dans son manifeste)." >&2
      return 3
      ;;
    127)
      echo "catalogue list: pas de release joignable (LCARS_FLEET_BIN) — l'etat des catalogues est" >&2
      echo "  un fait de FORGE, et cette commande n'y a pas acces. Le materiel present ici :" >&2
      [[ -d "$CAT_DIR" ]] && find "$CAT_DIR" -mindepth 1 -maxdepth 1 -type d -printf '    %f  (installe)\n' 2>/dev/null | sort >&2
      [[ -d "$CAT_SHIPPED" ]] && find "$CAT_SHIPPED" -mindepth 1 -maxdepth 1 -type d -printf '    %f  (graine de l image)\n' 2>/dev/null | sort >&2
      echo "    $CAT_BUNDLED  (dans le release)" >&2
      return 127
      ;;
    *)
      echo "catalogue list: la forge n'a pas repondu — rien n'est conclu." >&2
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      return "$rc"
      ;;
  esac
}

cat_verify_root() {
  local root="$1"
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "catalogue verify: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN, ou lancer « mix lcars.catalogue.verify $root » depuis le depot"
  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Application.CatalogueVerify.eval_main(\"$root\")"
}

cmd_catalogue_verify() {
  local name="${1:?catalogue verify: nom requis}"
  [[ "$name" == "$CAT_BUNDLED" ]] && die "catalogue verify: « $CAT_BUNDLED » est le catalogue livre dans le release — le boot le verifie a chaque demarrage"
  local root; root="$(cat_dir_of "$name")" || die "catalogue verify: « $name » n'est installe nulle part (cf. « $PROG catalogue list »)"
  cat_verify_root "$root"
}

# Cette commande ne detient rien : elle DEMANDE a un service par une socket unix, qui pose la
# question a la forge et agit. Ce defaut est une COPIE de l'adresse que porte `system.manifest` —
# les deux bougent ensemble, ou le geste frappe une porte absente et accuse le service d'etre eteint.
_CATALOGUE_SOCKET="${LCARS_CATALOGUE_SOCKET:-/run/lcars/authority/catalogue.sock}"

# LE TRANSPORT, ET BASH N'EN A PAS. `/dev/tcp` est TCP seul : ce shell ne peut pas ouvrir une socket
# unix lui-meme. `socat` d'abord, `nc -U` en repli — les deux sont poses par le provisionnement.
_catalogue_transport() {
  command -v socat >/dev/null 2>&1 && { printf 'socat'; return 0; }
  command -v nc    >/dev/null 2>&1 && { printf 'nc';    return 0; }
  return 1
}

_catalogue_ask() { # <nom> — envoie la demande, imprime le relais, rend le verdict sur stdout
  local name=$1 t; t="$(_catalogue_transport)" || return 127
  case "$t" in
    socat) printf 'install %s\n' "$name" | socat -t 86400 - UNIX-CONNECT:"$_CATALOGUE_SOCKET" ;;
    # ⚠ `-q -1` = « n'abandonne jamais l'autre sens ». Le `nc` d'OpenBSD attend par defaut, `ncat`
    #   non : sans ce drapeau, le verdict d'un geste de plusieurs minutes est perdu. Une
    #   implementation qui ne le connait pas ECHOUE ici, franchement, au lieu de rendre un silence.
    nc)    printf 'install %s\n' "$name" | nc -q -1 -U "$_CATALOGUE_SOCKET" ;;
  esac
}

# L'executeur rend un JETON stable (`FAIL:not_admin`), pas une phrase : le vocabulaire de l'operateur
# vit ICI. Un service qui redigerait pour la CLI serait une seconde autorite sur ce qu'elle dit.
_die_catalogue_refus() { # <jeton de cause> [detail]
  case "$1" in
    not_admin)
      die "catalogue install: la forge dit que ton compte n'est pas admin.
  « admin » est un fait de la FORGE, et c'est le SEUL qui compte ici : ton compte y porte is_admin,
  ou il ne le porte pas. Un proprietaire de la forge te promeut, et c'est effectif A LA COMMANDE
  SUIVANTE — il n'y a plus rien a projeter, ni session a rouvrir. Ce n'est PAS une histoire de
  sudo : personne n'est root ici." ;;
    no_authority)
      die "catalogue install: cette machine n'a pas d'autorité utilisable sur sa forge.
  Ce n'est ni un refus qui concerne ce compte, ni une panne de la forge : le jeton d'administration
  de cette machine est absent, illisible, vide, ou la forge vient de le REFUSER (révoqué ou expiré).
  Aucune quantité de réessais ne le repose — c'est un geste d'admin, une fois :
    sur un poste      deploy/workstation up
    pour un conteneur FORGE_ADMIN_TOKEN=<jeton site-admin> deploy/container config   (depuis l'hôte)
  Le journal de l'exécuteur dit lequel des quatre cas c'est : « journalctl -u lcars-catalogue »
  sur un poste, /var/log/lcars-catalogue.log dans le conteneur." ;;
    forge_unreachable)
      die "catalogue install: je n'ai pas pu DEMANDER a la forge si tu es admin.
  Ce n'est pas un refus — c'est une absence de reponse, et on ne la lit jamais comme un oui. La
  forge est peut-etre en train de redemarrer. Reessaie ; si ca dure, « lcars forge status »." ;;
    bad_name)
      die "catalogue install: « ${2:-} » n'est pas un nom de catalogue.
  Un nom est en minuscules, chiffres et tirets, et commence par une lettre ou un chiffre
  (« web-demo »). La liste de ce que cette forge sert : « $PROG catalogue list »." ;;
    unknown_peer)
      die "catalogue install: le service ne sait pas qui tu es.
  Ton uid n'a pas de compte unix sur ce conteneur — donc aucun login a demander a la forge. C'est le
  convergeur qui enrole les humains de l'equipe « humans » de l'org ; un proprietaire t'y ajoute, et
  le tour suivant (30 s) cree ton compte." ;;
    gesture_signalled)
      die "catalogue install: le geste a ete INTERROMPU (signal ${2:-?}), il n'a pas echoue.
  Quelque chose a arrete le service pendant le travail — « systemctl restart lcars-catalogue » en est
  la cause la plus courante. L'etat de « $name » est partiel : rejoue la commande, le geste est
  idempotent (rien n'a bouge -> il ne touche rien)." ;;
    busy)
      die "catalogue install: un autre geste de structure est en cours.
  Un seul a la fois — deux applies concurrents ecriraient le meme etat. RIEN n'a ete tente ;
  reessaie quand l'autre a fini." ;;
    *)
      die "catalogue install: refus non interprete du service (« $1 »).
  Le service a rendu une cause que cette version de « $PROG » ne connait pas. Les deux ne sont pas
  du meme lot : « $PROG version », et regarde « journalctl -u lcars-catalogue »." ;;
  esac
}

# Le remede depend du RAIL, et un seul des deux a systemd : dans un conteneur, le superviseur du
# demarrage tient ce service, et « systemctl » n'y designe rien. Nommer le geste de l'autre rail
# envoie chercher une commande qui n'existe pas sur la machine ou on la lit.
_die_executor_absent() {
  local remede="    sudo systemctl status lcars-catalogue
    sudo systemctl start  lcars-catalogue"
  [[ ! -r /run/lcars-boot.state && ! -f /.dockerenv ]] || remede="    le superviseur du démarrage le relance ; « docker logs <conteneur> » dit pourquoi il est tombé
    depuis l'hôte : « deploy/container status », puis « deploy/container up » si l'instance est à terre"
  die "catalogue install: le service qui execute ce geste ne tourne pas.
  Ce n'est pas un refus : la porte est fermee, pas gardee. « $_CATALOGUE_SOCKET » est absent ou
  injoignable. C'est un geste SYSTEME, pas un geste d'admin de forge :
$remede"
}

cmd_catalogue_install() {
  local name="${1:?catalogue install: nom requis (cf. « $PROG catalogue list »)}"

  [[ "$name" == "$CAT_BUNDLED" ]] \
    && die "catalogue install: « $CAT_BUNDLED » est livre DANS le release — il n'y a pas de depot d'ou l'installer, et rien a mettre a jour"

  [[ -S "$_CATALOGUE_SOCKET" ]] || _die_executor_absent
  _catalogue_transport >/dev/null \
    || die "catalogue install: ni « socat » ni « nc » sur cette machine — aucun des deux ne peut donc
  parler à « $_CATALOGUE_SOCKET », et bash n'ouvre pas de socket unix tout seul. C'est un geste
  système : sur un poste, « deploy/workstation up » les pose ; dans un conteneur, c'est l'image
  qui les porte."

  # ⚠ ON NE FAIT PAS CONFIANCE AU CODE DE SORTIE DU TRANSPORT, ET C'EST MESURE. `socat` rend ZERO
  # avec une sortie VIDE quand il ferme avant la reponse. Le verdict est la SEULE preuve qu'un geste
  # a eu lieu : pas de ligne de verdict = echec nomme, jamais un succes par defaut.
  local vu="" cause=""
  while IFS= read -r ligne; do
    case "$ligne" in
      "> "*) printf '%s\n' "${ligne#> }" ;;
      OK)         vu=1 ;;
      FAIL:*)     vu=1; cause="${ligne#FAIL:}" ;;
    esac
  done < <(_catalogue_ask "$name")

  [[ -n "$vu" ]] || die "catalogue install: le service n'a rendu AUCUN verdict.
  La demande est partie sur « $_CATALOGUE_SOCKET » et rien n'est revenu — ni accord, ni refus. On ne
  lit pas ce silence comme un succes : l'etat de « $name » sur ce conteneur est INCONNU.
  « journalctl -u lcars-catalogue » dit ce que le service a vu."

  if [[ -n "$cause" ]]; then
    # On relaie l'echec DU GESTE, dont les lignes viennent d'etre imprimees, plutot que de le
    # retraduire en refus d'autorite.
    case "$cause" in
      gesture_failed:*) exit "${cause#gesture_failed:}" ;;
      # ⚠ UN GESTE TUE PAR UN SIGNAL N'A PAS DE CODE A RELAYER : `exit -15` fait rendre 241 a bash,
      # un nombre qui ne designe rien. D'ou un refus ordinaire, et une PHRASE qui distingue
      # « interrompu » de « echoue » — les deux appellent des gestes differents.
      gesture_signalled:*) _die_catalogue_refus gesture_signalled "${cause#gesture_signalled:}" ;;
      *) _die_catalogue_refus "${cause%%:*}" "$name" ;;
    esac
  fi
}

cmd_project_migrate() {
  local repo="${1:?project migrate: depot requis (owner/nom)}"
  local cat="${2:?project migrate: catalogue forge requis}"
  [[ "$repo" == */* ]] || die "project migrate: « $repo » n'est pas un owner/nom"
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "project migrate: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"
  _load_container_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Project.Onboard.eval_migrate(\"$repo\", \"$cat\")"
}

cmd_project_reconcile() {
  local mode="${1:-check}"
  case "$mode" in
    check|apply) ;;
    *) die "project reconcile: mode inconnu « $mode » (check|apply)" ;;
  esac
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "project reconcile: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"
  _load_container_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Project.Onboard.eval_reconcile(:$mode)"
}

# ⚠ LCARS EST UN PROJET DE LA FLEET QU'IL INSTALLE (⚖ user 2026-09-16). Cette porte publie l'arbre
# dont CETTE machine a ete installee, sous le nom que `Fleet.Layout.system_project/0` declare et dans
# l'org du catalogue embarque. Elle se REJOUE : une machine qui porte deja son projet rend 0 en le
# disant, parce qu'un installeur et un boot la jouent a chaque passage.
cmd_project_adopt_system() {
  # `--check` MESURE et n'ecrit rien : c'est ce que le verbe `check` d'un module demande, et une
  # mesure n'est pas un verdict (elle rend 0 quel que soit l'etat, en le NOMMANT).
  #
  # `--from <arbre>` : D'OU vient la source de cette machine. OU elle va reste une decision du
  # layout (`/home/projects/<projet>`), jamais d'ici — le rail conteneur l'y clone a l'init, le rail
  # POSTE n'y mettait rien et l'adoption refusait en `no_local_main`. Un arbre deja en place n'est
  # jamais touche. Passe par l'environnement : ces portes sont des `eval` sans argument.
  local porte="eval_adopt" source=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) porte="eval_state"; shift ;;
      --from)  source="${2:?--from attend un repertoire}"; shift 2 ;;
      *)       die "project adopt-system: option inconnue « $1 » (--check, --from <arbre>)" ;;
    esac
  done
  [[ -z "$source" || -d "$source" ]] \
    || die "project adopt-system: --from « $source » n'est pas un repertoire — la face de code se seme depuis un arbre git, rien n'a ete fait"
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "project adopt-system: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"
  _load_container_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
  LCARS_SYSTEM_SOURCE="$source" \
    "$bin" eval "Fleet.Project.Onboard.SystemProject.$porte()"
}

cmd_project() {
  case "${1:-}" in
    migrate)      shift; cmd_project_migrate "$@" ;;
    reconcile)    shift; cmd_project_reconcile "$@" ;;
    adopt-system) shift; cmd_project_adopt_system "$@" ;;
    "")           die "project: sous-commande requise (migrate|reconcile|adopt-system)" ;;
    *)            die "project: sous-commande inconnue « $1 » (migrate|reconcile|adopt-system)" ;;
  esac
}

# ─── LES PORTES OUTIL DU RELEASE ────────────────────────────────────────────────────────────────
#
# ⚖ user 2026-09-04 : ces portes vivent DANS LA CLI DU PRODUIT, posee sur les deux rails
# (`/usr/local/bin/lcars`), et nulle part ailleurs. Un geste du produit qui devrait executer le PID 1
# de l'image pour evaluer une fonction du release aurait sa porte au mauvais endroit. Le boot du
# conteneur garde les MOTS (`docker run IMAGE roles-tfvars` est l'API de l'image, le banc s'en sert)
# et delegue ici.
#
# ⚠ SOUS UN UID SANS POUVOIR quand on est root. Ces evaluations chargent le release et son
# catalogue — du code — et un appelant root (le boot, un geste de forge) ne doit pas les executer
# comme root : `nobody:fleet`. Sous un humain, l'uid courant.
# `LCARS_TOOL_EVAL=1` est le seam du release pour un OUTIL : `runtime.exs` ne monte pas de fleet.
_tool_run() { # _tool_run <expression elixir>
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "tool: release introuvable ($bin) — sur un poste, « deploy/workstation up » la pose ; dans un conteneur, c'est l'image qui la porte"
  if [[ "$(id -u)" -eq 0 ]]; then
    exec setpriv --reuid 65534 --regid 2000 --clear-groups \
      env HOME=/tmp RELEASE_TMP=/tmp LCARS_TOOL_EVAL=1 \
      FORGE_BASE_URL="${FORGE_BASE_URL:-}" FORGE_TOKEN_FILE="${FORGE_TOKEN_FILE:-}" FORGE_TOKEN="${FORGE_TOKEN:-}" \
      "$bin" eval "$1"
  else
    exec env HOME=/tmp RELEASE_TMP=/tmp LCARS_TOOL_EVAL=1 \
      FORGE_BASE_URL="${FORGE_BASE_URL:-}" FORGE_TOKEN_FILE="${FORGE_TOKEN_FILE:-}" FORGE_TOKEN="${FORGE_TOKEN:-}" \
      "$bin" eval "$1"
  fi
}
cmd_tool() {
  case "${1:-}" in
    verify)
      local root="${2:?tool verify: chemin de racine catalogue requis}"
      _tool_run "Fleet.Application.CatalogueVerify.eval_main(\"${root}\")" ;;
    roles|roles-tfvars)
      local fun="Fleet.Roster.eval_main" arg
      [[ "$1" == "roles-tfvars" ]] && fun="Fleet.Roster.eval_tfvars"
      if [[ -n "${2:-}" ]]; then arg="\"${2}\""; else arg="Fleet.Catalogue.root()"; fi
      _tool_run "${fun}(${arg})" ;;
    catalogue-root)
      _tool_run 'IO.puts(Fleet.Catalogue.root())' ;;
    system-project)
      # le nom du projet du systeme, DECLARE par le layout : le geste de forge le demande ici
      # plutot que de le recopier, sinon deux ecritures d'un meme nom derivent
      _tool_run 'IO.puts(Fleet.Layout.system_project())' ;;
    catalogue-source)
      local name="${2:?tool catalogue-source: nom de catalogue requis}"
      _tool_run "Fleet.Application.CatalogueLifecycle.eval_source(\"${name}\")" ;;
    ops-repo)
      # MESURE le depot du systeme et rend une ligne « <gravite>\t<phrase> » par constat, code 0
      # quel que soit l'etat : le VERDICT appartient au protocole de l'appelant, pas a la porte.
      _tool_run 'Fleet.Application.OpsRepo.eval_check()' ;;
    catalogue-installed)
      # MESURE ce que la forge INSTALLE : une ligne « <OK|HOLD|WARN>\t<nom>\t<arg> » par branche
      # signee du magasin. Le CODE porte la distinction qui empeche d'effacer a tort : 0 le magasin
      # a ete lu ENTIER (aucune ligne = il n'installe rien), 2 le magasin est ABSENT, 1 il n'a pas
      # pu etre lu. Le convergeur (`forge.d/catalogues.sh`) decide, la porte mesure.
      _tool_run 'Fleet.Application.CatalogueMaterial.eval_check()' ;;
    *) die "tool: porte inconnue '${1:-}' ($TOOL_PORTES)" ;;
  esac
}

cmd_catalogue() {
  case "${1:-list}" in
    list|ls)  shift; cmd_catalogue_list "$@" ;;
    install)  shift; cmd_catalogue_install "$@" ;;
    verify)   shift; cmd_catalogue_verify "$@" ;;
    *) die "catalogue: sous-commande inconnue '${1}' (list|install|verify)" ;;
  esac
}

# Plain destination URL — no token, ever: auth is the CLI credential helper (gh/glab), not ours.
_dest_url() { printf 'https://%s/%s.git' "$1" "$2"; }  # dest_host repo

_FORGE_CLI="$(dirname "$(readlink -f "$0")")/forge-cli.sh"
_fc() { # _fc <verbe> <host> <dest_host> <repo> [args...]
  "$_FORGE_CLI" "$1" --host "$2" --dest-host "$3" --repo "$4" "${@:5}"
}

_dest_cli() { case "$1" in github) echo gh ;; gitlab) echo glab ;; *) die "host inconnu: $1 (github|gitlab)" ;; esac; }
_json_field() { python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$1" "$2"; }

_dest_repo_exists() { _fc repo-exists "$1" "$2" "$3"; }              # host dest_host repo
_dest_repo_create() { _fc repo-create "$1" "$2" "$3" --visibility "$4"; }

cmd_forge() {
  case "${1:-}" in
    add)      shift; cmd_forge_add "$@" ;;
    list|ls)  shift; cmd_forge_list "$@" ;;
    status)   shift; cmd_forge_status "$@" ;;
    "")       die "forge: sous-commande requise (add|list|status)" ;;
    *)        die "forge: sous-commande inconnue « $1 » (add|list|status)" ;;
  esac
}

cmd_forge_add() {
  local name="" host="" owner="" dest_host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --owner) owner="$2"; shift 2 ;;
      --dest-host) dest_host="$2"; shift 2 ;;
      -*) die "forge add: option inconnue $1" ;;
      *) if [[ -z "$name" ]]; then name="$1"; shift; else die "forge add: argument en trop « $1 »"; fi ;;
    esac
  done
  [[ -n "$name" && -n "$host" && -n "$owner" ]] || \
    die "forge add: usage — forge add <name> --host github|gitlab --owner <owner> [--dest-host H]"
  case "$host" in
    github) [[ -n "$dest_host" ]] || dest_host="github.com" ;;
    gitlab) [[ -n "$dest_host" ]] || dest_host="gitlab.com" ;;
    *) die "forge add: --host inconnu « $host » (github|gitlab)" ;;
  esac
  # No token here: auth is `$(_dest_cli "$host") auth login`, the CLI's own credential store.
  # `name` becomes a path component — refuse traversal (self-harm, but the slug guard has it too).
  [[ "$name" != */* && "$name" != .* ]] || die "forge add: nom invalide « $name » (pas de '/' ni de '.' en tete)"
  mkdir -p "$FORGES_DIR"; chmod 700 "$FORGES_DIR"
  local out="$FORGES_DIR/$name.json"
  python3 -c 'import json,sys;json.dump({"host":sys.argv[2],"dest_host":sys.argv[3],"owner":sys.argv[4]},open(sys.argv[1],"w"),indent=2)' \
    "$out" "$host" "$dest_host" "$owner"
  chmod 600 "$out"
  echo "forge « $name » enregistree ($host $owner @ $dest_host). Auth: $(_dest_cli "$host") auth login."
}

cmd_forge_list() {
  local f found=0
  if [[ -d "$FORGES_DIR" ]]; then
    for f in "$FORGES_DIR"/*.json; do
      [[ -e "$f" ]] || continue
      found=1
      python3 -c 'import json,os,sys;d=json.load(open(sys.argv[1]));print("  %-16s %-7s %s/%s" % (os.path.basename(sys.argv[1])[:-5],d.get("host"),d.get("dest_host"),d.get("owner")))' "$f"
    done
  fi
  [[ "$found" == 1 ]] || echo "aucune forge (pool vide) — lcars forge add <name> ..."
}

cmd_forge_status() {
  local f found=0
  if [[ -d "$FORGES_DIR" ]]; then
    for f in "$FORGES_DIR"/*.json; do
      [[ -e "$f" ]] || continue
      found=1
      local name host owner dest_host cli
      name="$(basename "$f" .json)"
      host="$(_json_field "$f" host)"
      owner="$(_json_field "$f" owner)"
      dest_host="$(_json_field "$f" dest_host)"
      cli="$(_dest_cli "$host")"
      # SUR L'HOTE DE CETTE FORGE, jamais sur un etat global : un tableau de bord qui affiche [ok]
      # a qui n'est pas authentifie ICI ment a l'endroit exact ou on cherche la panne.
      local arc=0
      _fc auth-ok "$host" "$dest_host" "$owner/-" || arc=$?
      case "$arc" in
        0) echo "  [ok] $name  ($host $owner @ $dest_host) — $cli authentifie" ;;
        4) echo "  [!!] $name  ($host $owner @ $dest_host) — $cli PAS INSTALLE. Tier 2 : cable un helper git (PR/MR a ouvrir a la main). Tier 1 : installe $cli puis « $cli auth login »." ;;
        *) echo "  [!!] $name  ($host $owner @ $dest_host) — $cli non authentifie : « $cli auth login »" ;;
      esac
    done
  fi
  [[ "$found" == 1 ]] || echo "aucune forge (pool vide) — lcars forge add <name> ..."
}

cmd_publish() {
  case "${1:-}" in
    status) shift; cmd_publish_status "$@" ;;
    run)    shift; cmd_publish_run "$@" ;;
    "")     die "publish: sous-commande requise (run|status)" ;;
    *)      die "publish: sous-commande inconnue « $1 » (run|status)" ;;
  esac
}

# Porte HUMAINE, et elle n'ouvre rien a un agent : les pods n'ont pas de shell sur l'hote. Elle
# appelle le MEME rail avec les MEMES arguments que le runtime — une seconde implementation de la
# liste d'arguments deriverait de la premiere.
cmd_publish_run() {
  local repo="" linearize=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --linearize) linearize="$2"; shift 2 ;;
      -*) die "publish run: option inconnue $1" ;;
      *) if [[ -z "$repo" ]]; then repo="$1"; shift; else die "publish run: argument en trop « $1 »"; fi ;;
    esac
  done
  [[ -n "$repo" ]] || die "publish run: usage — publish run <owner/nom-interne> [--linearize BRANCHE]"
  [[ "$repo" == */* ]] || die "publish run: « $repo » n'est pas un owner/nom (repo interne)"
  local slug="${repo//\//__}"
  local binding="$PUBLISH_DIR/$slug.json"
  [[ -r "$binding" ]] \
    || die "publish run: « $repo » n'est pas lie — « lcars approve $repo --forge <name> --as <repo-dest> » d'abord"

  local host dest_host dest_repo base
  host="$(_json_field "$binding" host)"
  dest_host="$(_json_field "$binding" dest_host)"
  dest_repo="$(_json_field "$binding" dest_repo)"
  base="$(_json_field "$binding" base)"
  # Une liaison qui ne dit pas OU elle publie n'est pas une liaison : deviner ici rouvrirait ce que
  # le refus du runtime a ferme.
  for k in host dest_host dest_repo base; do
    [[ -n "${!k}" ]] || die "publish run: la liaison $binding ne declare pas « $k » — relie a nouveau"
  done

  _load_container_env
  [[ -n "${FORGE_BASE_URL:-}" ]] || die "publish run: FORGE_BASE_URL absent — conteneur non configure"

  local rail; rail="$(dirname "$(readlink -f "$0")")/publish-rail.sh"
  [[ -x "$rail" ]] || die "publish run: rail introuvable a cote: $rail"

  # Un chemin NEUF a chaque passage : le rail refuse un `--work` existant (la transformation exige
  # un clone propre).
  local base_dir; base_dir="$(mktemp -d)"
  local work="$base_dir/clone"

  local tokfile
  tokfile="$(_authority_token_file "$(_forge_account)" "$base_dir")" \
    || { rm -rf "$base_dir"; die "publish run: pas de jeton de forge (cause ci-dessus)"; }

  local -a extra=()
  [[ -n "$linearize" ]] && extra=(--linearize "$linearize")

  local rc=0
  "$rail" --project "$repo" --forge "$FORGE_BASE_URL" --forge-token-file "$tokfile" \
    --host "$host" --dest-repo "$dest_repo" --dest-host "$dest_host" --base "$base" \
    --work "$work" "${extra[@]}" || rc=$?

  # ⚠ RETIRE AVANT LE BRANCHEMENT : la sortie 6 CONSERVE le repertoire pour inspection, et le jeton
  # y survivrait indefiniment dans un chemin que personne ne surveille.
  rm -f "$tokfile"

  if [[ "$rc" == 6 ]]; then
    echo "publish run: clone conserve pour inspection -> $work" >&2
  else
    rm -rf "$base_dir"
  fi
  return "$rc"
}

cmd_publish_status() {
  local repo="${1:-}"
  [[ -n "$repo" ]] || die "publish status: usage — publish status <owner/nom-interne>"
  [[ "$repo" == */* ]] || die "publish status: « $repo » n'est pas un owner/nom (repo interne)"
  local slug="${repo//\//__}"
  local binding="$PUBLISH_DIR/$slug.json"
  if [[ ! -r "$binding" ]]; then
    echo "publish « $repo » : non lie (option) — aucun endpoint de publish configure."
    echo "  Pour publier un jour : lcars approve $repo --forge <name> --as <repo-dest>"
    return 0
  fi
  local host dest_host dest_repo base cli
  host="$(_json_field "$binding" host)"
  dest_host="$(_json_field "$binding" dest_host)"
  dest_repo="$(_json_field "$binding" dest_repo)"
  base="$(_json_field "$binding" base)"
  cli="$(_dest_cli "$host")"
  echo "publish « $repo » : lie a $dest_host/$dest_repo (base $base)"
  local arc=0
  _fc auth-ok "$host" "$dest_host" "$dest_repo" || arc=$?
  case "$arc" in
    0) echo "  [ok] $cli authentifie" ;;
    4) echo "  [!!] $cli PAS INSTALLE — Tier 2 (helper git cable, PR/MR a ouvrir a la main), ou installe $cli pour l'automatique" ;;
    *) echo "  [!!] $cli non authentifie — « $cli auth login » (ou cable un helper git)" ;;
  esac
  export GIT_TERMINAL_PROMPT=0
  local dest_url; dest_url="$(_dest_url "$dest_host" "$dest_repo")"
  if git ls-remote --exit-code "$dest_url" "refs/heads/$base" >/dev/null 2>&1; then
    echo "  [ok] base « $base » peuplee cote $dest_host (phase 1 faite)"
  else
    echo "  [!!] base « $base » absente/injoignable cote $dest_host — « lcars approve $repo » (phase 1)"
  fi
}

cmd_approve() {
  # Empty = "derive it from the destination", done below, after the existence probe.
  local repo="" forge="" as="" base="" visibility="private"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --forge) forge="$2"; shift 2 ;;
      --as) as="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --public) visibility="public"; shift ;;
      --private) visibility="private"; shift ;;
      -*) die "approve: option inconnue $1" ;;
      *) if [[ -z "$repo" ]]; then repo="$1"; shift; else die "approve: argument en trop « $1 »"; fi ;;
    esac
  done
  [[ -n "$repo" ]] || die "approve: usage — approve <owner/nom-interne> [--forge <name> --as <repo-dest>] [--base main] [--public]"
  [[ "$repo" == */* ]] || die "approve: « $repo » n'est pas un owner/nom (repo interne)"
  # Org-qualified binding key (owner__name), NOT the name alone: two projects with the same name in
  # two orgs must not collide on one binding. MUST match ProjectPublish.binding_key/1 (`owner/name`
  # -> `owner__name`), or the host write and the worker read miss each other.
  local slug="${repo//\//__}"
  local binding="$PUBLISH_DIR/$slug.json"

  # Resolve WHAT/WHERE first (mode + destination), so mode errors fire without any forge config.
  local host dest_host dest_repo link_mode
  if [[ -n "$forge" ]]; then
    link_mode=1
    local tfile="$FORGES_DIR/$forge.json"
    [[ -r "$tfile" ]] || die "approve: forge « $forge » absente du pool (lcars forge list)"
    [[ -n "$as" ]] || die "approve: --forge exige --as <nom-du-repo-destination>"
    host="$(_json_field "$tfile" host)"
    dest_host="$(_json_field "$tfile" dest_host)"
    dest_repo="$(_json_field "$tfile" owner)/$as"
  else
    link_mode=0
    [[ -r "$binding" ]] || die "approve: « $slug » pas encore lie — « approve $repo --forge <name> --as <repo> » d'abord"
    host="$(_json_field "$binding" host)"
    dest_host="$(_json_field "$binding" dest_host)"
    dest_repo="$(_json_field "$binding" dest_repo)"
    base="$(_json_field "$binding" base)"
    [[ -n "$base" ]] || die "approve: la liaison $binding ne declare pas de « base ».
  Relie a nouveau en la nommant : approve $repo --forge <name> --as <repo-dest> --base <branche>"
  fi

  local cli; cli="$(_dest_cli "$host")"
  # ⚠ LA SONDE N'EST DELIBEREMENT PAS PRISE ICI : entre ce point et son usage il y a un clone et une
  # reecriture d'historique complete, 2 a 10 minutes. Un jeton qui expire dans cette fenetre ferait
  # echouer la creation sur un 401 brut. `have_cli` est lu au moment ou il decide quelque chose.
  local have_cli
  export GIT_TERMINAL_PROMPT=0

  local env_file="${LCARS_FLEET_ENV:-$HOME/.lcars/fleet.env}"
  _load_container_env
  [[ -n "${FORGE_BASE_URL:-}" ]] || die "approve: FORGE_BASE_URL absent ($env_file) — conteneur non configure"

  local dest_url; dest_url="$(_dest_url "$dest_host" "$dest_repo")"
  mkdir -p "$PUBLISH_DIR"; chmod 700 "$PUBLISH_DIR"

  # ⚠ PAS `local`, ET LE TRAP EST LA RAISON. Un trap EXIT se declenche a la fin du SCRIPT, donc apres
  # le retour de cette fonction : un `local` a disparu a ce moment-la. Sous `set -u` le trap mourrait
  # sur « work_base: unbound variable », ce qui couterait deux fois — `approve` sortirait 1 EN CAS
  # DE SUCCES, et le clone ne serait JAMAIS retire, la fuite meme que ce trap doit empecher.
  work_base="$(mktemp -d)"
  trap 'rm -rf "$work_base"' EXIT
  local work="$work_base/clone"

  # APRES LE TRAP, ET L'ORDRE EST LE CONTRAT : pose dans le repertoire, le jeton tombe avec lui sur
  # TOUTE sortie, `die` compris. Demande avant, il faudrait un second balayage — la ligne qu'on oublie.
  local tokfile
  tokfile="$(_authority_token_file "$(_forge_account)" "$work_base")" \
    || die "approve: pas de jeton de forge (cause ci-dessus)"

  "$(dirname "$(readlink -f "$0")")/publish-transform.sh" \
    --repo "$repo" --forge "$FORGE_BASE_URL" --token-file "$tokfile" --out "$work" \
    || die "approve: production du clone certifie echouee (voir ci-dessus)"
  cd "$work"

  # git push/fetch/ls-remote to the dest carry no token — the wired helper supplies the credential.
  if [[ "$link_mode" == 1 ]]; then
    have_cli=0
    if _fc auth-ok "$host" "$dest_host" "$dest_repo"; then have_cli=1; fi
    local repo_exists=0 rex=0
    if [[ "$have_cli" == 1 ]]; then
      _dest_repo_exists "$host" "$dest_host" "$dest_repo" || rex=$?
      case "$rex" in
        0) repo_exists=1 ;;
        1) repo_exists=0 ;;
        *) die "approve: existence de $dest_host/$dest_repo INDECIDABLE — $cli ne peut ni la voir
  ni prouver son absence (depot prive d'un tiers ? droits insuffisants ?). Rien n'a ete cree.
  Verifie le nom et tes droits, ou passe par un repo pre-cree (Tier 2)." ;;
      esac
    else
      git ls-remote "$dest_url" >/dev/null 2>&1 && repo_exists=1
    fi
    if [[ "$repo_exists" == 0 ]]; then
      [[ "$have_cli" == 1 ]] || die "approve: $dest_host/$dest_repo n'existe pas et $cli n'est pas authentifie.
  Tier 1 : '$cli auth login' pour l'auto-creation.  Tier 2 : cree le repo vide dans l'UI web puis relance."
      _dest_repo_create "$host" "$dest_host" "$dest_repo" "$visibility" \
        || die "approve: creation de $dest_host/$dest_repo echouee ($cli repo create)"
      echo "approve: $dest_host/$dest_repo cree ($visibility) sous ton login $cli."
    fi
    # LA BASE SE DERIVE DE LA DESTINATION, elle ne se suppose pas. Le cas non evident : un depot
    # PRESENT mais VIDE n'a aucune ref a lire — c'est le Tier 2 supporte, et la on choisit.
    if [[ -z "$base" ]]; then
      if [[ "$repo_exists" == 1 ]]; then
        base="$(_fc default-branch "$host" "$dest_host" "$dest_repo" 2>/dev/null || true)"
        if [[ -z "$base" ]]; then
          # `--exit-code` with no pattern: 0 = the repo has refs, non-zero = it is empty.
          if git ls-remote --exit-code "$dest_url" >/dev/null 2>&1; then
            die "approve: branche par defaut de $dest_host/$dest_repo illisible alors que le depot
  n'est PAS vide — refuse de deviner. Nomme-la : approve $repo --forge $forge --as $as --base <branche>"
          fi
          base="main"
        else
          echo "approve: base derivee de la destination -> « $base »"
        fi
      else
        base="main"
      fi
    fi
    if git ls-remote --exit-code "$dest_url" "refs/heads/$base" >/dev/null 2>&1; then
      die "approve: $dest_host/$dest_repo a deja « $base » — refuse d'ecraser. Vide-la ou choisis un autre repo."
    fi
    git push -q "$dest_url" "HEAD:refs/heads/$base" \
      || die "approve: echec du peuplement initial vers $dest_host/$dest_repo"
    python3 -c 'import json,sys;json.dump({"host":sys.argv[2],"dest_host":sys.argv[3],"dest_repo":sys.argv[4],"base":sys.argv[5]},open(sys.argv[1],"w"),indent=2)' \
      "$binding" "$host" "$dest_host" "$dest_repo" "$base"
    chmod 600 "$binding"
    echo "approve: « $slug » lie a $dest_host/$dest_repo et peuple ($base)."
  else
    git fetch -q "$dest_url" "$base" \
      || die "approve: lecture de $base sur $dest_host/$dest_repo impossible"
    if [[ "$(git rev-parse HEAD)" == "$(git rev-parse FETCH_HEAD)" ]]; then
      echo "approve: rien a pousser — $dest_host/$dest_repo $base deja a jour."
    elif ! git merge-base --is-ancestor FETCH_HEAD HEAD; then
      die "approve: $base n'est PAS un ancetre du clone reecrit (reecriture non deterministe ou divergence) — rien pousse."
    else
      git push -q "$dest_url" "HEAD:refs/heads/$base" \
        || die "approve: echec du push direct vers $dest_host/$dest_repo"
      echo "approve: « $slug » pousse en direct vers $dest_host/$dest_repo $base."
    fi
  fi
}


# Le repertoire courant est verifie AVANT le dispatch, et pour tous les verbes : `help` ne coute
# rien, et tout le reste finit par lancer le BEAM ou git, qui meurent tous les deux sans le dire.
_cwd_lisible

case "${1:-help}" in
  tool) ;;
  help|-h|--help) [[ -z "${HOME:-}" ]] || _etat_humain help ;;
  *) _etat_humain "$1" ;;
esac

case "${1:-help}" in
  spawn)  shift; cmd_spawn "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  attach) shift; cmd_attach "$@" ;;
  project)
    shift; cmd_project "$@" ;;
  catalogue) shift; cmd_catalogue "$@" ;;
  forge) shift; cmd_forge "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  approve) shift; cmd_approve "$@" ;;
  admiral) shift; cmd_admiral "$@" ;;
  tool)   shift; cmd_tool "$@" ;;
  help|-h|--help) usage ;;
  *) echo "lcars: commande inconnue '${1}'" >&2; echo >&2; usage; exit 1 ;;
esac
