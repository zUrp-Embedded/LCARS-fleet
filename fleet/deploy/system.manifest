# SOURCE: fleet/deploy/system.manifest
# STARDATE: (posée par /push-github)
# STATUS: data, not code — CE QUE LE PROVISIONNEMENT A LE DROIT DE POSER SUR UNE MACHINE.
# ⚠ IL N'A AUCUN LECTEUR AU MOMENT OU IL EST POSE, ET C'EST VOULU. Trois gestes le liront
# (`20-groups` pour les GID, `25-directories` pour sa table, `provision uninstall` a l'envers) ;
# aucun ne peut etre ecrit avant lui. C'etait le trou d'ordre du corpus d'alice : trois gestes
# bloques sur un objet que personne n'avait la charge de creer.
#
# ─── FORMAT ─────────────────────────────────────────────────────────────────────────────────────
#
#   <classe>  <objet>  <mode>  <proprietaire>  <substrat>
#
#   classe     prefix   la racine de l'install
#              dir      un repertoire durable
#              anchor   un fichier a un chemin FIXE hors prefixe (ce que l'OS ou le PATH exige)
#              link     un symlink hors prefixe
#              group    un groupe unix, avec son GID
#              runtime  un objet volatile, refait au boot (tmpfs)
#              human    un objet dans le home d'une personne — POSE, jamais preserve
#              account  un compte unix de SERVICE, avec son groupe propre — retire TOUJOURS
#              person   un compte unix d'HUMAIN — retire JAMAIS sans `--humans` explicite
#              docker   un objet docker : conteneur, reseau ou volume
#              preserve ce qu'une desinstallation ne doit JAMAIS toucher
#
# ⚠ POUR `account`, LE `mode` PORTE LE GID et le `proprietaire` porte le shell — une reutilisation de
# colonnes, assumee, plutot qu'un sixieme champ que sept classes sur neuf laisseraient vide.
#   mode       octal, ou `-` quand la classe n'en porte pas
#   proprietaire `user:group`, ou `-`
#   substrat   `any` | `wsl` | `linux` | `docker`, ou une combinaison separee par `+`
#
#   `<human>` dans un chemin est un joker : il vaut pour chaque humain enrole.
#
# ─── CE QUI EST DELIBEREMENT ABSENT ─────────────────────────────────────────────────────────────
#
# Les paquets apt. Ils ont deja leur table (`10-packages.sh`) et leur temoin bidirectionnel
# (`deploy_manifest.bats`) ; ce qui manquait etait le JOURNAL — qui distingue `apt_installed` de
# `apt_already` — et il est genere par machine, pas declare ici.

# ─── LA RACINE ──────────────────────────────────────────────────────────────────────────────────
prefix    /opt/lcars/runtime                              0750  root:fleet          wsl+linux

# ─── REPERTOIRES DURABLES ───────────────────────────────────────────────────────────────────────
dir       /opt/lcars                                   0755  root:root           wsl+linux
dir       /opt/lcars/admiral-skills                    0755  root:root           docker
dir       /opt/lcars/tofu                              0755  root:root           wsl+linux
dir       /opt/lcars/tofu/providers                    0755  root:root           wsl+linux
dir       /opt/lcars/share                                  0755  root:root           wsl+linux
dir       /opt/lcars/share/avatars                     0755  root:root           wsl+linux
dir       /opt/lcars/share/favicon                     0755  root:root           wsl+linux
dir       /opt/lcars/share/doc                         0755  root:root           wsl+linux
# ⚠ LE REPERTOIRE NE SE FERME PAS ICI, ET C'EST UN CONTRAT D'ORDRE. Quatre lecteurs sous uid
# HUMAIN vivent encore dessous — le BEAM au boot (`runtime.exs`), `publish run`/`approve`, le skill
# du siege, et l'outil de pod `project_publish`. Les fermer avant de les avoir migres casserait la
# boite en silence : le noeud demarre vert et le premier push meurt sur une auth vide.
# `lcars-authority` traverse par le groupe `fleet`, dont il est membre.
# ⚠ CE REPERTOIRE NE CONTIENT PAS QUE DES SECRETS, et c'est ce qui a impose le `0710`. `forge.url`
# et `forge.public.url` y vivent en `0644` : ce sont des ADRESSES, pas des secrets.
# `0710` : le groupe TRAVERSE, il ne LISTE pas. Un chemin connu s'ouvre (`forge.url`), l'enumeration
# des comptes reste fermee, et les secrets restent `0600` — mesure sur banc : `cat forge.url` OK,
# `ls` refuse, `cat` d'un `0600` refuse.
dir       /opt/lcars/var/tokens                       0710  lcars-authority:fleet  any
dir       /home/catalogues                             0750  root:fleet          any
dir       /var/lib/lcars                               0755  root:root           docker

dir       /opt/lcars/var                               0755  root:root           any
dir       /opt/lcars/var/tofu                          0700  lcars-authority:lcars-authority  wsl+linux
dir       /etc/lcars                                   0755  root:root           wsl+linux

# ─── TOOLCHAINS PRECOMPILES ─────────────────────────────────────────────────────────────────────
dir       /opt/node-<version>                          0755  root:root           wsl+linux

# ─── ANCRES — fichiers a chemin fixe hors prefixe ───────────────────────────────────────────────
anchor    /etc/tmpfiles.d/lcars-console.conf           0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-landing.service    0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-converger.service  0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-catalogue.service  0644  root:root           wsl+linux
anchor    /etc/systemd/system/lcars-privileged.service 0644  root:root           wsl+linux
anchor    /etc/lcars/host-consent                      0644  root:root           linux
anchor    /etc/lcars/services.env                      0640  root:fleet          wsl+linux
anchor    /etc/lcars/seat.uid                          0644  root:root           any
anchor    /etc/lcars/deck-oidc.json                    0640  root:lcars-system   wsl+linux
anchor    /usr/local/bin/tofu                          0755  root:root           wsl+linux
anchor    /usr/local/bin/lcars-toolchain-converge      0755  root:root           any
anchor    /usr/local/bin/lcars-authority-ask           0755  root:root           any

# ─── SYMLINKS DE PATH ───────────────────────────────────────────────────────────────────────────

# ⚠ LES LIENS D'ACTIVATION DE SYSTEMD, POSES PAR `systemctl enable`, JAMAIS PAR NOUS.
# `64-services:497` fait `enable --now` ; systemd ecrit le lien dans la cible. Ils n'etaient declares
# nulle part — MESURE DU 2026-08-28 : les quatre survivent a `uninstall --yes`, pointant vers des
# unites SUPPRIMEES, donc quatre liens morts dans `multi-user.target` que le prochain boot signale.
# Le nom se compose a l'execution (`unit_path() { "$1.service" }`) sous un repertoire exempte : ni
# ISO 1/2 ni ISO 2/2 ne pouvaient les voir. Les declarer est ce qui les rend retirables.
link      /etc/systemd/system/multi-user.target.wants/lcars-landing.service     -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-converger.service   -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-catalogue.service   -  -  wsl+linux
link      /etc/systemd/system/multi-user.target.wants/lcars-privileged.service  -  -  wsl+linux

link      /usr/local/bin/fleet_v2                      -     -                   wsl+linux
link      /usr/local/bin/lcars                         -     -                   wsl+linux
link      /usr/local/bin/node                          -     -                   wsl+linux
link      /usr/local/bin/npm                           -     -                   wsl+linux
link      /usr/local/bin/npx                           -     -                   wsl+linux

# ─── GROUPES ────────────────────────────────────────────────────────────────────────────────────
group     fleet                                        2000  -                   any
group     lcars-console                                2001  -                   any

# ─── COMPTES DE SERVICE ─────────────────────────────────────────────────────────────────────────
# ⚠ LEUR GID N'EST PAS FIXE ICI, ET C'EST DELIBERE. `21-service-accounts` cree le groupe par
# `ensure_group`, qui lit cette table : y poser un GID le figerait. Mesure du 2026-08-28 : ils
# tombent en 2002/2003 parce que 2000 et 2001 sont pris. Les figer demande de choisir des numeros
# qu'aucune machine installee ne porte — un geste separe, pas un effet de bord de cette ligne.
account   lcars-authority                              -     /usr/sbin/nologin   any
account   lcars-system                                 -     /usr/sbin/nologin   any

# ─── VOLATILES — refaits au boot ────────────────────────────────────────────────────────────────
runtime   /run/lcars                                   0755  root:root           wsl+linux
runtime   /run/lcars/console                           0711  root:root           wsl+linux
runtime   /run/lcars/console/<human>                   2710  <human>:lcars-console  wsl+linux
# Le sgid est porteur : le marqueur pose par le BEAM doit rester du groupe `fleet`.
runtime   /run/lcars/toolchain                         2775  root:fleet          any
runtime   /run/lcars/authority                         0750  lcars-authority:fleet  any
# ─── LES DEUX PORTES DU SERVICE D'AUTORITE ──────────────────────────────────────────────────────
# ⚠ L'ACL D'UNE SOCKET NE PORTE AUCUNE AUTORISATION. Elle borne qui peut FRAPPER ; qui a le droit se
# decide par `SO_PEERCRED` puis par une question a la forge. Confondre les deux serait refaire le
# defaut que ce chantier retire — une decision prise en lisant une projection de groupe.
runtime   /run/lcars/authority/catalogue.sock          0660  lcars-authority:fleet  any
runtime   /run/lcars/authority/roles.sock              0660  lcars-authority:fleet  any
# ─── LA PORTE DU SERVICE PRIVILEGIE ─────────────────────────────────────────────────────────────
runtime   /run/lcars/privileged                        0750  root:fleet          any
runtime   /run/lcars/privileged/toolchain.sock         0660  root:fleet          any
runtime   /run/lcars-converger.refused                 0644  root:root           any

runtime   /run/lock/lcars                              0700  root:root           any

# ⚠ POSE PAR TOFU LUI-MEME, PAS PAR UN MODULE. `46-tofu` invoque le binaire, qui ecrit son cache de
# plugins sous le HOME de root. Mesure du 2026-08-28 : present apres l'install, survivant a
# l'uninstall, et dans aucune liste — ni la mienne, ni celle du plan. C'est le cas « pose par un
# tiers » : on le declare parce qu'on le PROVOQUE, pas parce qu'on l'ecrit.
dir       /root/.terraform.d                           0755  root:root           wsl+linux
runtime   /run/lcars-provision.rc                      0644  root:root           docker
runtime   /run/lcars-humans.rc                         0644  root:root           docker

# ─── DANS LE HOME DES PERSONNES — POSE, jamais preserve ─────────────────────────────────────────
human     /home/<human>/.lcars                         0700  <human>:-           any
human     /home/<human>/.lcars/log                     0700  <human>:-           any
human     /home/<human>/.lcars/fleet_v2.env            0600  <human>:-           any
human     /home/<human>/pods                           0700  <human>:-           any
human     /home/<human>/.local/bin/claude              0755  <human>:-           any

# ─── PRESERVE — ce qu'une desinstallation ne touche JAMAIS ──────────────────────────────────────
preserve  /home/projects                               2775  root:fleet          any
preserve  /home/projects.ops                           2775  root:fleet          any
preserve  /home/projects.workshop                      2775  root:fleet          any

# ⚠ CE FICHIER EXISTAIT AVANT NOUS, ET C'EST TOUTE LA RAISON DE SA CLASSE. `/etc/skel/.bashrc` est
# livre par la distribution ; LCARS l'ECRASE (`62-runtime-helpers`, table DATA) pour que tout humain
# cree ensuite recoive le prompt, les alias et `force_color_prompt` du rail — `useradd -m` recopie
# `/etc/skel` a la CREATION, jamais apres.
#
# Le RETIRER a la desinstallation laisserait la machine sans squelette du tout, donc dans un etat
# PIRE qu'avant l'install : chaque compte cree ensuite naitrait sans `.bashrc`. `preserve` dit
# exactement ca — pose, jamais repris. Restaurer l'original demanderait de l'avoir sauvegarde, ce
# qu'on ne fait pas : on ne promet pas une reversibilite qu'on ne tient pas.
preserve  /etc/skel/.bashrc                            0644  root:root           any
