#!/usr/bin/env bash
# SOURCE: fleet/deploy/provision
# AUTHOR: DrDree
# STARDATE: 2026-07-05
# STATUS: PROTO-V2 — LE point d'entrée provisioning : apply (converge), doctor (sonde nuke-drill), list
#
# Machine nue → `fleet_v2 start` fonctionnel, en UN geste rejouable à l'infini :
#     sudo fleet/deploy/provision apply
#     fleet/deploy/provision doctor        # sonde read-only — LA sonde du nuke-drill
#
# Modèle (inversion délibérée de la v1) :
#   - les modules `modules.d/NN-*.sh` sont des PROCESSUS exécutés, pas des scripts sourcés dans un
#     namespace commun : un module qui meurt rend SON verdict, il n'avorte pas le durcissement des
#     autres à moitié fait. L'ordre est le préfixe numérique, lisible dans un `ls`.
#   - chaque module expose `check` (sonde read-only) et `apply` (check → fix → re-check) ;
#     le doctor N'EST PAS un autre code : c'est le même check que l'apply utilise. Une seule vérité.
#   - chaque module DÉCLARE son terrain en tête (greppable, pas de registre à maintenir), sur
#     DEUX axes (D6 de l'ADR install/compile/release — les confondre rendait le doctor Docker
#     muet sur le verrou RO, le câblage bin et la sonde bwrap) :
#         # APPLY-ON: wsl linux   où les MUTATIONS tournent (en Docker le stage image a déjà
#                                 appliqué → l'apply de ce module est remplacé par son check)
#         # CHECK-ON: any         où l'ÉTAT-CIBLE doit être VRAI (le doctor sonde tout ça)
#         # NEEDS: root|human     SOUS QUELLE IDENTITÉ le module est joué (le runner la pose)
#   - AUCUNE sentinelle d'état : l'état, c'est le système, re-sondé à chaque run. (La machine à
#     états v1 — .install_ok/.fleet_ready/.deploy_ok/.offline-bootstrap éparpillées sur 2 dossiers —
#     pouvait rester coincée « ni-vierge-ni-provisionnée » sans un message pour l'humain.)
#   - pas de reprise-par-bashrc-trigger : après le reboot WSL (lockdown C:), l'humain RELANCE le
#     même apply — l'idempotence rend la reprise triviale, le doctor dit où on en est.
#
# Codes retour module (contrat) : check 0=conforme 1=drift 2=erreur-de-sonde ·
#                                 apply 0=convergé 1=échec 2=appliqué, drift résiduel ·
#                                 3 (les DEUX verbes) = MORT AVANT SON VERDICT, rendu par la garde
#                                 de sortie de provision-lib. Il lui fallait son propre code : `2`
#                                 est pris des deux cotes, et un module tue par `set -e` rendait
#                                 justement 2 — donc « rien n'est cassé » sur un module inacheve.
# Codes retour runner : apply 0=tout convergé 1=au moins un échec 2=appliqué, drift résiduel ·
#                       doctor 0=conforme 1=drift 2=erreur.
# Le 2 d'apply manquait, et son absence n'etait pas un trou de vocabulaire : un module qui constate
# une non-convergence dans son apply rendait 0, donc « tout convergé », drift compris a zero dans le
# bilan alors qu'une ligne DRIFT venait d'etre imprimee.
#
# USAGE :
#   provision apply  [--substrate S] [--only MODULE]… [--human USER] [--env FILE] [--verbose]
#                    [--port-forge N] [--port-deck N]
#   provision doctor [--substrate S] [--only MODULE]… [--human USER] [--env FILE] [--porcelain] [--verbose]
#   provision update [--substrate S] [--human USER] [--env FILE]
#   provision list   [--substrate S]
#
# `update` = la jambe runtime du triangle (source→forge→runtime) : pull --ff-only du checkout,
# APRÈS vérification d'autorité (le remote DOIT matcher PROV_EXPECTED_REPO — déclaré, jamais
# deviné), puis re-exec du runner FRAÎCHEMENT PULLÉ en `apply` (le provisioning qui vient
# d'arriver s'applique lui-même — pas de vieux code qui déroule du neuf). Toujours un converge
# COMPLET : pas de --only sur update (un update partiel est un état qu'on ne veut pas pouvoir
# représenter). Héritier direct de fleet-update.sh v1 (F-E1 : autorité-avant-pull ; « already
# up to date — reconverging anyway »).
# Options :
#   --substrate S   force le substrat (auto par défaut : docker si /.dockerenv, wsl si kernel
#                   Microsoft, linux sinon)
#   --only M        n'exécute que ce module (répétable ; nom complet ou préfixe numérique)
#   --human USER    humain cible des modules per-humain (défaut : SUDO_USER, sinon l'appelant)
#   --env FILE      fichier KEY=VALUE sourcé avant tout (surcharge les défauts de la lib)
#   --porcelain     (doctor) sortie machine `MODULE=OK|DRIFT|ERROR`, une ligne par module

set -euo pipefail

SELF="$(readlink -f "$0")"
PROV_ROOT="$(dirname "$SELF")"                      # LA racine, résolue UNE fois puis propagée par
MODULES_DIR="$PROV_ROOT/modules.d"                  # env — jamais d'heuristique ../.. par module
export PROVISION_LIB="$PROV_ROOT/lib/provision-lib.sh"

usage() { sed -n '6,52p' "$SELF" | sed 's/^# \{0,1\}//'; }
die()   { echo "provision: $*" >&2; exit 1; }

[[ -f "$PROVISION_LIB" ]] || die "lib introuvable: $PROVISION_LIB"
[[ -d "$MODULES_DIR" ]]   || die "modules.d introuvable: $MODULES_DIR"

# ─── Args ─────────────────────────────────────────────────────────────────────────────────────────
CMD="${1:-}"; shift || true
SUBSTRATE="auto"
PORCELAIN=0
ENV_FILE=""
UNINSTALL_YES=0
UNINSTALL_HUMANS=0
declare -a ONLY=()

# Un port refusé se dit ICI, pas trois modules plus loin sur un `compose up` qui échoue.
#
# ⚠ ELLE NE REND RIEN, ET C'EST LOAD-BEARING. Écrite en `export X="$(valid_port …)"`, son `die`
# tuait le SOUS-SHELL de la substitution : le script continuait, avec une valeur vide. Le refus
# s'imprimait et ne refusait pas.
valid_port() { # valid_port <valeur> <nom du drapeau> — valide ou meurt, n'imprime rien
  [[ "$1" =~ ^[0-9]+$ ]] || die "$2 : « $1 » n'est pas un nombre"
  (( $1 >= 1024 && $1 <= 65535 )) || die "$2 : $1 hors plage — 1024 à 65535 (sous 1024 le deck, qui tourne en « nobody », ne peut pas binder)"
}

# ⚠ LA FORME EST CELLE DE DOCKER, PAS LA NÔTRE. Un projet compose doit commencer par une minuscule
# ou un chiffre, et ne porter que minuscules, chiffres, `_` et `-` — docker refuse le reste, mais
# trois modules plus loin, sur un message qui parle de compose et pas du drapeau qu'on a tapé.
valid_project() { # valid_project <valeur> <nom du drapeau>
  [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || die "$2 : « $1 » n'est pas un nom de projet compose — minuscules, chiffres, « _ » et « - », et le premier caractère n'est ni l'un ni l'autre"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --substrate) SUBSTRATE="${2:?--substrate attend une valeur}"; shift 2 ;;
    --only)      ONLY+=("${2:?--only attend un module}"); shift 2 ;;
    --human)     export PROV_HUMAN="${2:?--human attend un user}"; shift 2 ;;
    # ⚖ USER 2026-08-21 : « on crée pas un user sur une machine nue. dans docker c'est sans gravité,
    # là ça demande au moins une validation user. » Ce drapeau EST cette validation : nommer le
    # compte, c'est l'autoriser. Sans lui, `22-fleet-human` ne crée RIEN — il dérive en nommant le
    # geste. Un défaut câblé (`lcars`) ferait apparaître un utilisateur que personne n'a demandé sur
    # une machine qui n'a aucun désinstalleur.
    --fleet-human) export PROV_FLEET_HUMAN="${2:?--fleet-human attend un user}"; shift 2 ;;
    # Les deux ports que la machine PUBLIE. Ils ont un défaut (21000, 20999) et une sonde qui refuse
    # si le port est déjà pris par autre chose — mais le geste de changer d'avis n'existait que par
    # variable d'environnement, et une variable ne survit pas au `sudo` d'`install.sh`.
    # ⚠ `< 1024` EST REFUSÉ : le deck tourne sous `nobody`, qui ne peut pas binder un port privilégié.
    --port-forge) valid_port "${2:?--port-forge attend un port}" --port-forge
                  export PROV_FORGE_HOST_PORT="$2"; shift 2 ;;
    --port-deck)  valid_port "${2:?--port-deck attend un port}" --port-deck
                  export PROV_DECK_PORT="$2"; shift 2 ;;
    # Le NOM d'instance de la forge : conteneur, réseau, volumes et projet du runner en dérivent
    # tous (`48-forge-host:157-158,189`). C'est donc le seul geste qui monte une SECONDE forge
    # plutôt que de déplacer celle qui tourne.
    --forge-project) valid_project "${2:?--forge-project attend un nom}" --forge-project
                     export PROV_FORGE_PROJECT="$2"; shift 2 ;;
    --env)       ENV_FILE="${2:?--env attend un fichier}"; shift 2 ;;
    --porcelain) PORCELAIN=1; shift ;;
    # ⚠ `uninstall` NE FAIT RIEN SANS `--yes`, ET CE N'EST PAS UNE COURTOISIE. Le verbe lit une
    # table et retire ce qu'elle nomme : une erreur dans la table devient une erreur sur la machine.
    # Sans ce drapeau il IMPRIME son plan et sort — la seule façon de relire une liste avant qu'elle
    # ne s'exécute.
    --yes)       UNINSTALL_YES=1; shift ;;
    # Les objets du home d'une personne sont POSÉS par LCARS mais vécus par elle. On les PROPOSE,
    # on ne les impose pas (§ `human` du manifeste).
    --humans)    UNINSTALL_HUMANS=1; shift ;;
    # Le détail d'une étape longue, pour celui qui veut savoir sur quoi elle traîne. Hérité par les
    # modules (qui sont des processus) : d'où l'export.
    --verbose|-v) export PROV_VERBOSE=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *) die "option inconnue: $1 (--help)" ;;
  esac
done
case "$CMD" in apply|doctor|update|list|uninstall) ;; ""|-h|--help) usage; exit 0 ;; *) die "commande inconnue: $CMD (--help)" ;; esac
[[ "$CMD" == "update" && "${#ONLY[@]}" -gt 0 ]] && die "update est TOUJOURS un converge complet — pas de --only (lance apply --only pour un module isolé)"

if [[ -n "$ENV_FILE" ]]; then
  [[ -r "$ENV_FILE" ]] || die "--env illisible: $ENV_FILE"
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
fi

# shellcheck source=lib/provision-lib.sh
. "$PROVISION_LIB"

[[ "$SUBSTRATE" == "auto" ]] && SUBSTRATE="$(detect_substrate)"
case "$SUBSTRATE" in wsl|docker|linux) ;; *) die "substrat inconnu: $SUBSTRATE (wsl|docker|linux)" ;; esac
export PROV_SUBSTRATE="$SUBSTRATE"

# ─── D'OÙ VIENT CE QU'ON S'APPRÊTE À POSER ──────────────────────────────────────────────────────
# Chaque module converge vers ce que dit SA source, donc « conforme » ne signifie jamais plus que
# « conforme à l'arbre que j'ai sous la main ». Un checkout en retard réinstalle l'état d'avant en
# rendant VERT — release, auxiliaires, convergeur — et aucun verdict ne peut le voir.
#
# La seule chose qui manquait était de le DIRE. Un opérateur qui lit « source 4c1820dd » en tête de
# son apply sait ce qu'il pose ; sans cette ligne, il ne le sait jamais, et il n'a aucune raison
# d'aller le chercher.
export PROV_SOURCE_REV="$(prov_source_rev)"

# ─── update : pull VÉRIFIÉ du checkout, puis re-exec du runner pullé en apply ─────────────────────
if [[ "$CMD" == "update" ]]; then
  [[ "$EUID" -eq 0 ]] || die "update exige root (il enchaîne sur apply) — relance : sudo $SELF update"
  ROOT="$(repo_root)"
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "update: $ROOT n'est pas un checkout git"

  # 1. AUTORITÉ AVANT PULL (F-E1) : le remote doit matcher le repo déclaré. Pas de défaut :
  #    on refuse de deviner à qui on fait confiance.
  # 6-109 — L'AUTORITÉ INCLUT L'HÔTE, et la comparaison est EXACTE. Elle était une SOUS-CHAÎNE :
  # avec `fleet/lcars` attendu, `https://hote-attaquant/attaquant/fleet/lcars-malware.git` passait,
  # et le runner exécutait ce code en root. Ni l'hôte, ni le propriétaire, ni la fin du nom n'étaient
  # regardés.
  [[ -n "$PROV_EXPECTED_REPO" ]] || die "update: PROV_EXPECTED_REPO non posé — déclare l'autorité COMPLÈTE, hôte compris (ex: PROV_EXPECTED_REPO=forge.example.org/fleet/lcars) via --env ou l'environnement ; SANS elle, aucun pull"
  case "$PROV_EXPECTED_REPO" in
    */*/*) ;;
    # La forme `owner/repo` était celle d'avant, et elle ne PEUT PAS être acceptée : sans hôte, elle
    # autorise n'importe quelle forge. On refuse en disant quoi écrire, plutôt que de deviner un hôte.
    *) die "update: PROV_EXPECTED_REPO=« $PROV_EXPECTED_REPO » n'a pas d'hôte — une autorité sans hôte autorise n'importe quelle forge. Écris « <hôte>/<owner>/<repo> » (ex: forge.example.org/fleet/lcars)" ;;
  esac
  REMOTE_URL="$(git -C "$ROOT" remote get-url "$PROV_UPDATE_REMOTE" 2>/dev/null || true)"
  [[ -n "$REMOTE_URL" ]] || die "update: remote « $PROV_UPDATE_REMOTE » absent du checkout $ROOT"
  REMOTE_ID="$(prov_parse_remote "$REMOTE_URL")" \
    || die "update: remote « $REMOTE_URL » non analysable (forme inconnue, userinfo, ou chemin qui n'est pas <owner>/<repo>) — pull REFUSÉ"
  [[ "$REMOTE_ID" == "$PROV_EXPECTED_REPO" ]] \
    || die "update: remote « $REMOTE_URL » → « $REMOTE_ID » ≠ autorité déclarée « $PROV_EXPECTED_REPO » — pull REFUSÉ"

  # 2. Le pull s'exécute comme l'OWNER du checkout (jamais root : des objets .git root dans le
  #    checkout d'un humain = le clobber qu'on a fui). Identité validée avant usage (IEC, v1:84).
  OWNER="$(stat -c '%U' "$ROOT")"
  [[ "$OWNER" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "update: owner du checkout invalide: « $OWNER »"
  BEFORE="$(git -C "$ROOT" rev-parse --short=8 HEAD)"

  # Lock apply pris AVANT le pull (un converge concurrent pendant qu'on change le code sous lui
  # est exactement ce que le lock interdit) ; relâché avant le re-exec — le nouveau runner le reprend.
  # Le chemin vient de `prov_lock_path` : dossier root-owned 0700, `TMPDIR` non honoré (6-130).
  LOCK="$(prov_lock_path)" || die "verrou: emplacement sûr indisponible — apply/update REFUSÉ"
  exec 9>"$LOCK"
  flock -n 9 || die "un autre apply/update est en cours (lock: $LOCK)"
  runuser -u "$OWNER" -- git -C "$ROOT" pull --ff-only "$PROV_UPDATE_REMOTE" \
    || die "update: pull --ff-only en échec (divergence ? réseau ?) — rien n'a été appliqué"
  AFTER="$(git -C "$ROOT" rev-parse --short=8 HEAD)"
  if [[ "$BEFORE" == "$AFTER" ]]; then
    echo "provision update: déjà à jour ($AFTER) — re-converge quand même (idempotent)"
  else
    echo "provision update: $BEFORE → $AFTER"
    git -C "$ROOT" --no-pager log --oneline "$BEFORE..$AFTER" | sed 's/^/  /'
  fi
  flock -u 9

  # 3. Re-exec du runner FRAÎCHEMENT PULLÉ : c'est le code qui vient d'arriver qui s'applique,
  #    pas celui chargé avant le pull (sinon un update du provisioning lui-même ne prend
  #    effet qu'à l'update SUIVANT — la faille self-update classique).
  REEXEC=(--substrate "$SUBSTRATE" --human "$PROV_HUMAN")
  [[ -n "$ENV_FILE" ]] && REEXEC+=(--env "$ENV_FILE")
  exec "$SELF" apply "${REEXEC[@]}"
fi

# ─── Découverte + filtrage ────────────────────────────────────────────────────────────────────────
# Deux headers, deux axes (D6). La sélection se fait sur CHECK-ON : partout où l'état-cible doit
# être vrai, le module est retenu. En apply, un module retenu dont APPLY-ON ne couvre pas le
# substrat courant tourne en CHECK (l'état est bâti ailleurs — stage image, build — mais il DOIT
# tenir ici ; un drift est alors un ÉCHEC d'apply : rien ne peut le converger sur place).
# Un module sans les DEUX headers est une ERREUR de construction (fail-loud).
module_field() { # $1=file $2=FIELD → valeur (vide si absent)
  sed -n "s/^# ${2}: *//p" "$1" | head -1
}

substrate_in() { # $1=liste (`any` ou mots séparés par des espaces) → 0 si $SUBSTRATE dedans
  [[ "$1" == "any" ]] && return 0
  case " $1 " in *" $SUBSTRATE "*) return 0 ;; *) return 1 ;; esac
}

declare -a SELECTED=() EFFECTIVE=()
for mod in "$MODULES_DIR"/[0-9][0-9]-*.sh; do
  [[ -f "$mod" ]] || die "aucun module dans $MODULES_DIR"
  name="$(basename "$mod" .sh)"
  apply_on="$(module_field "$mod" APPLY-ON)"
  check_on="$(module_field "$mod" CHECK-ON)"
  needs="$(module_field "$mod" NEEDS)"
  [[ -n "$apply_on" ]] || die "$name: header '# APPLY-ON:' manquant"
  [[ -n "$check_on" ]] || die "$name: header '# CHECK-ON:' manquant"
  [[ -n "$needs" ]]    || die "$name: header '# NEEDS:' manquant"
  # Cohérence : appliquer là où on ne vérifie pas est irreprésentable — tout terrain d'APPLY-ON
  # doit être couvert par CHECK-ON.
  if [[ "$check_on" != "any" ]]; then
    for s in $apply_on; do
      [[ "$s" == "any" ]] && die "$name: APPLY-ON any exige CHECK-ON any"
      case " $check_on " in *" $s "*) ;; *) die "$name: APPLY-ON contient « $s » hors de CHECK-ON ($check_on)" ;; esac
    done
  fi
  # Filtre --only (nom complet `10-packages` ou préfixe `10`).
  if [[ "${#ONLY[@]}" -gt 0 ]]; then
    keep=0
    for o in "${ONLY[@]}"; do [[ "$name" == "$o" || "$name" == "$o"-* ]] && keep=1; done
    [[ "$keep" -eq 1 ]] || continue
  fi
  substrate_in "$check_on" || continue
  SELECTED+=("$mod")
  if [[ "$CMD" == "apply" ]] && substrate_in "$apply_on"; then
    EFFECTIVE+=("apply")
  else
    EFFECTIVE+=("check")
  fi
done
[[ "${#SELECTED[@]}" -gt 0 ]] || die "aucun module ne matche (substrat=$SUBSTRATE${ONLY[0]:+, only=${ONLY[*]}})"

if [[ "$CMD" == "list" ]]; then
  for mod in "${SELECTED[@]}"; do
    printf '%-28s APPLY-ON=%-12s CHECK-ON=%-10s NEEDS=%s\n' "$(basename "$mod" .sh)" \
      "$(module_field "$mod" APPLY-ON)" "$(module_field "$mod" CHECK-ON)" "$(module_field "$mod" NEEDS)"
  done
  exit 0
fi

# ─── Garde de privilège (apply) ───────────────────────────────────────────────────────────────────
# Le runner N'ESCALADE JAMAIS lui-même (pas de exec sudo caché — l'entrée racine install.sh porte
# le consentement + l'escalade). Il dit exactement ce qui manque. Il DÉS-escalade, en revanche :
# un module `NEEDS: human` est joué sous son humain par `run_module`, donc root peut tout appliquer.
if [[ "$CMD" == "apply" && "$EUID" -ne 0 ]]; then
  for i in "${!SELECTED[@]}"; do
    # Seuls les modules qui vont réellement MUTER exigent root (un check-only reste read-only).
    if [[ "${EFFECTIVE[$i]}" == "apply" && "$(module_field "${SELECTED[$i]}" NEEDS)" == "root" ]]; then
      die "apply exige root pour $(basename "${SELECTED[$i]}" .sh) — relance : sudo $SELF apply${ONLY[0]:+ --only ${ONLY[*]}}"
    fi
  done
fi

# ─── Lock anti-runs-concurrents (apply seulement — doctor est read-only, libre) ──────────────────
if [[ "$CMD" == "apply" ]]; then
  # 6-130 — le nom était `${TMPDIR:-/tmp}/lcars-provision.$(id -u).lock`, donc sous `sudo`
  # `/tmp/lcars-provision.0.lock` : FIXE, devinable, dans un dossier que tout le monde écrit. Et
  # `exec 9>` suit les liens et TRONQUE avant que `flock` ne protège quoi que ce soit.
  #
  # ─── LA PORTÉE SE DÉRIVE DE LA SÉLECTION, ELLE NE SE DÉCLARE PAS ──────────────────────────────
  #
  # Une passe dont TOUS les modules sont `NEEDS: human` ne touche qu'un seul home : elle prend le
  # verrou DE CET HUMAIN. Tout le reste — un apply complet, qui pose `/local`, `/etc`, les unités —
  # prend le verrou global. Deux humains n'ont aucun objet commun ; les sérialiser ne protégeait rien
  # et coûtait l'équipement d'un compte (mesure du 2026-08-25, voir `prov_lock_path`).
  #
  # ⚠ DÉRIVÉE, JAMAIS PASSÉE EN ARGUMENT, et c'est la même doctrine que les sockets de service :
  # rien de ce que l'APPELANT écrit ne décide de ce qui est verrouillé. Un `--per-human` pourrait
  # mentir ; `SELECTED` est ce qui va réellement tourner. Elle est déjà calculée ici (l.245-294) —
  # le verrou vient après, exprès.
  #
  # ⚠ ET `PROV_HUMAN` DOIT ÊTRE NON VIDE POUR QUE LA PORTÉE EXISTE. Sans lui, une passe per-humain
  # n'a pas d'humain : on retombe sur le verrou global, qui est le comportement sûr — sérialiser à
  # tort coûte une attente, ne pas sérialiser assez coûte deux écrivains sur un objet.
  _lock_scope=""
  if [[ -n "${PROV_HUMAN:-}" ]]; then
    _lock_scope="$PROV_HUMAN"
    for mod in "${SELECTED[@]}"; do
      [[ "$(module_field "$mod" NEEDS)" == "human" ]] || { _lock_scope=""; break; }
    done
  fi

  LOCK="$(prov_lock_path "$_lock_scope")" || die "verrou: emplacement sûr indisponible — apply REFUSÉ"
  exec 9>"$LOCK"
  flock -n 9 \
    || die "un autre apply est en cours${_lock_scope:+ pour « $_lock_scope »} (lock: $LOCK)"
fi

# ─── LE JOURNAL DE CETTE MACHINE ─────────────────────────────────────────────────────────────────
#
# `system.manifest` dit ce que le provisionnement a le DROIT de poser — statique, versionné, le même
# partout. Le journal dit ce qui a été posé ICI, et il porte le seul fait qu'aucun fichier statique
# ne peut connaître : `apt_installed` contre `apt_already`. Sans cette séparation, une
# désinstallation retire des paquets que l'opérateur avait avant — pire que d'en laisser.
#
# ⚠ L'ACCUMULATEUR EST UN FICHIER, ET LE RUNNER EST LE SEUL À POUVOIR L'OUVRIR. Les modules sont des
# PROCESSUS : aucun d'eux ne voit ce qu'un autre a noté, et aucun ne sait quand la passe se termine.
# Le runner le crée avant la boucle, les modules y notent par `prov_journal_note`, il le scelle après.
#
# ⚠ APPLY SEULEMENT. Un `doctor` ne pose rien ; lui faire écrire un journal ferait raconter à la
# machine une pose qui n'a pas eu lieu.
JOURNAL_FILE="${LCARS_JOURNAL_FILE:-/etc/lcars/install.journal}"
MANIFEST_FILE="${LCARS_SYSTEM_MANIFEST:-$(dirname "$SELF")/system.manifest}"

# ─── uninstall — IL NE CONTIENT AUCUNE LISTE ────────────────────────────────────────────────────
#
# Il lit `system.manifest` (ce qu'on a le DROIT de poser) et `install.journal` (ce qui a été posé
# ICI). Même règle que `etc/install.manifest` : la table est la source, personne ne recopie. Une
# liste en dur dans ce fichier serait un second inventaire — et celui qui dérive est toujours celui
# qu'on ne relit pas.
#
# ⚠ SIX RÈGLES DE SÛRETÉ, ET LA CINQUIÈME A ÉTÉ APPRISE À LA MAIN sur .63 le 2026-08-22 :
#
#   1. SANS MANIFESTE, ON REFUSE. Pas de repli, pas de « je fais au mieux » : un désinstalleur qui
#      devine est plus dangereux qu'un qui s'arrête. Même contrat que le témoin de `install.manifest`
#      — « manifest absent = erreur de sonde, PAS un pass silencieux ».
#   2. `preserve` N'EST JAMAIS TOUCHÉ, ni lui ni ce qu'il contient. C'est le TRAVAIL des gens.
#   3. SANS JOURNAL, AUCUN PAQUET N'EST RETIRÉ. Le journal est la seule chose qui distingue ce que
#      LCARS a installé de ce que l'opérateur avait déjà ; sans lui, retirer serait un pari sur le
#      bien d'autrui. On le DIT et on laisse les paquets.
#   4. LE PLAN S'IMPRIME AVANT DE S'EXÉCUTER (`--yes`). Une erreur dans la table devient une erreur
#      sur la machine ; il faut pouvoir la relire.
#   5. UN OBJET PRÉSERVÉ PEUT DÉPENDRE D'UN OBJET D'EMPREINTE. Les trois faces sont en
#      `2775 root:fleet` : retirer le groupe `fleet` les laisserait avec un GID orphelin. Mesuré au
#      nettoyage manuel — `groupdel fleet` a échoué, et c'était la BONNE réponse. Un groupe encore
#      porté par un objet préservé n'est pas retirable, et ce n'est pas une erreur.
#   6. L'ORDRE EST L'INVERSE DE LA POSE. Fichiers et liens d'abord, répertoires du plus profond au
#      moins profond, groupes en dernier. Un `rm` de répertoire avant son contenu ne rate pas — mais
#      un `groupdel` avant les fichiers qu'il possède, si.
uninstall_run() {
  [[ -r "$MANIFEST_FILE" ]] || die "manifeste introuvable ($MANIFEST_FILE) — un désinstalleur qui devine est plus dangereux qu'un qui s'arrête"

  local rows preserve_roots=() journal_pkgs=() line cls obj mode owner sub
  rows="$(grep -vE '^\s*#|^\s*$' "$MANIFEST_FILE")"

  while read -r cls obj mode owner sub; do
    [[ "$cls" == "preserve" ]] && preserve_roots+=("$obj")
  done <<<"$rows"

  preserved() { # preserved <chemin> -> 0 si lui-meme ou un ancetre est preserve
    local p="$1" r
    for r in "${preserve_roots[@]}"; do
      [[ "$p" == "$r" || "$p" == "$r"/* ]] && return 0
    done
    return 1
  }

  # LES PAQUETS : le journal, et lui seul.
  if [[ -r "$JOURNAL_FILE" ]]; then
    mapfile -t journal_pkgs < <(awk '$1=="apt_installed"{ $1=""; sub(/^ /,""); print }' "$JOURNAL_FILE" | tr ' ' '\n' | grep -v '^$' | sort -u)
  fi

  # ─── LE PLAN ──────────────────────────────────────────────────────────────────────────────────
  local -a files=() dirs=() groups=() humans=()
  while read -r cls obj mode owner sub; do
    preserved "$obj" && continue
    case "$cls" in
      anchor|link|runtime) files+=("$obj") ;;
      dir|prefix)          dirs+=("$obj") ;;
      group)               groups+=("$obj") ;;
      human)               humans+=("$obj") ;;
    esac
  done <<<"$rows"

  # Du plus profond au moins profond : `/opt/lcars/tofu/providers` avant `/opt/lcars`.
  mapfile -t dirs < <(printf '%s\n' "${dirs[@]}" | awk '{ print gsub(/\//,"/"), $0 }' | sort -rn | cut -d' ' -f2-)

  echo "${_PC}=== provision uninstall — plan lu dans $(basename "$MANIFEST_FILE") ===${_PN}"
  printf '  %-10s %d objet(s)\n' "fichiers" "${#files[@]}"
  printf '  %-10s %d répertoire(s)\n' "dirs" "${#dirs[@]}"
  printf '  %-10s %d groupe(s)\n' "groupes" "${#groups[@]}"
  if [[ "${#journal_pkgs[@]}" -gt 0 ]]; then
    printf '  %-10s %d paquet(s) : %s\n' "apt" "${#journal_pkgs[@]}" "${journal_pkgs[*]}"
  else
    printf '  %-10s %s\n' "apt" "${_PA}AUCUN — journal absent ou vide ($JOURNAL_FILE) : impossible de distinguer ce que LCARS a posé de ce qui était déjà là${_PN}"
  fi
  if [[ "$UNINSTALL_HUMANS" -eq 1 ]]; then
    printf '  %-10s %d objet(s) dans les homes (--humans)\n' "humains" "${#humans[@]}"
  else
    printf '  %-10s %s\n' "humains" "${#humans[@]} objet(s) LAISSÉS — « --humans » pour les retirer aussi"
  fi
  printf '  %-10s %s\n' "préservé" "${preserve_roots[*]}"

  if [[ "$UNINSTALL_YES" -ne 1 ]]; then
    echo ""
    echo "  ${_PA}RIEN N'A ÉTÉ RETIRÉ.${_PN} Relis ce plan, puis : sudo $SELF uninstall --yes"
    return 0
  fi

  # ─── L'EXÉCUTION ──────────────────────────────────────────────────────────────────────────────
  local o removed=0 kept=0
  for o in "${files[@]}"; do
    [[ -e "$o" || -L "$o" ]] || continue
    rm -f "$o" && removed=$((removed + 1)) || echo "  ${_PA}non retiré : $o${_PN}"
  done
  if [[ "$UNINSTALL_HUMANS" -eq 1 ]]; then
    for o in "${humans[@]}"; do
      # Le joker `<human>` se resout sur les homes reels — le manifeste ne peut pas les nommer.
      local h
      for h in /home/*; do
        local real="${o//<human>/$(basename "$h")}"
        [[ -e "$real" ]] && { rm -rf "$real" && removed=$((removed + 1)); }
      done
    done
  fi
  for o in "${dirs[@]}"; do
    [[ -d "$o" ]] || continue
    rm -rf "$o" && removed=$((removed + 1)) || echo "  ${_PA}non retiré : $o${_PN}"
  done
  for o in "${groups[@]}"; do
    getent group "$o" >/dev/null 2>&1 || continue
    if groupdel "$o" >/dev/null 2>&1; then
      removed=$((removed + 1))
    else
      # RÈGLE 5 : un groupe encore porté par un objet préservé n'est pas retirable, et c'est JUSTE.
      kept=$((kept + 1))
      echo "  ${_PA}groupe $o gardé — encore porté par un objet préservé (les faces sont en root:$o)${_PN}"
    fi
  done
  for o in "${journal_pkgs[@]}"; do
    run_quiet env DEBIAN_FRONTEND=noninteractive apt-get remove -y "$o" \
      && removed=$((removed + 1)) || echo "  ${_PA}paquet non retiré : $o${_PN}"
  done

  echo ""
  printf '  %d objet(s) retiré(s), %d gardé(s) délibérément.\n' "$removed" "$kept"
  echo "  ${_PC}Le travail est intact :${_PN} ${preserve_roots[*]}"
  return 0
}

if [[ "$CMD" == "uninstall" ]]; then
  # ⚠ ROOT N'EST EXIGÉ QUE POUR RETIRER. Lire un plan est une lecture : le refuser sans root
  # obligerait l'opérateur à `sudo` pour SAVOIR ce qui va disparaître — c'est-à-dire à escalader
  # avant de décider. La sonde reste ouverte, le geste reste fermé.
  [[ "$UNINSTALL_YES" -ne 1 || "$EUID" -eq 0 ]] \
    || die "uninstall --yes demande root (il retire des objets systeme) — sans --yes, il imprime son plan"
  uninstall_run
  exit $?
fi
if [[ "$CMD" == "apply" ]]; then
  PROV_JOURNAL_ACC="$(mktemp "${TMPDIR:-/tmp}/prov-journal.XXXXXX" 2>/dev/null || true)"
  export PROV_JOURNAL_ACC
fi

# ─── run_module <mod> <eff> [humain] — L'UID SE DÉCIDE ICI, ET UNE SEULE FOIS ────────────────────
#
# Un module `# NEEDS: human` pose l'état d'UN humain DANS le home de cet humain. Il ne fait aucune
# opération root — pas une seule sur les quatre qui le déclarent. Il tournait pourtant en root, et
# redemandait ligne par ligne, par `as_human`, l'identité qu'on venait de lui retirer.
#
# ⚠ UNE DÉS-ESCALADE PAR LIGNE N'EST PAS UNE DÉS-ESCALADE : c'est autant d'occasions d'en oublier
# une, et la ligne oubliée s'exécute en root sans que rien ne le dise. Le module DÉCLARE l'identité
# dont il a besoin ; c'est au runner de la lui donner, pas à lui de la reconquérir.
#
# ⚠ `runuser` GARDE l'environnement exporté (mesuré) mais REPOSE le PATH depuis `login.defs`. Les
# modules travaillent en chemins absolus et le runner ne pose aucun PATH, donc le décor est le même
# des deux côtés de la frontière — mais un module qui prendrait une dépendance sur le PATH du runner
# la perdrait ICI, silencieusement.
#
# ⚠ CE QUE ROOT TRAVERSAIT, L'HUMAIN DOIT Y AVOIR DROIT. L'install RO du prefix est `root:fleet`,
# groupe seul (poste comme boîte) : un module per-humain qui y lit son template ne le peut que si
# son humain est DANS le groupe de fleet. `20-groups` l'y met, et son rang est ce qui rend la
# lecture possible aux rangs 40, 70 et 75 — réordonner casserait ça en silence, sur une lecture.
#
# L'humain passe en ARGUMENT, jamais en préfixe d'affectation : `PROV_HUMAN=x run_module …` devant
# une FONCTION laisse la variable posée dans le shell appelant après le retour, donc le reste de la
# boucle jouerait sous l'humain du dernier tour.
run_module() {
  local mod="$1" eff="$2" human="${3:-${PROV_HUMAN:-}}" name
  name="$(basename "$mod" .sh)"
  (
    export PROVISION_RUN=1 PROVISION_MODULE="$name" PROV_HUMAN="$human"
    if [[ "$(module_field "$mod" NEEDS)" != "human" || "$(id -un)" == "$human" ]]; then
      bash "$mod" "$eff"
    else
      # `as_human` porte DÉJÀ les deux cas restants : root impersonne, un tiers est refusé avec le
      # motif exact. Un second message ici ferait chercher deux causes à un seul fait.
      as_human bash "$mod" "$eff"
    fi
  )
}

# ─── Exécution ────────────────────────────────────────────────────────────────────────────────────
total=0 ok=0 drift=0 failed=0
declare -a REPORT=()

for i in "${!SELECTED[@]}"; do
  mod="${SELECTED[$i]}"
  name="$(basename "$mod" .sh)"
  eff="${EFFECTIVE[$i]}"
  total=$((total + 1))
  if [[ "$CMD" == "apply" && "$eff" == "check" ]]; then
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name (check — APPLY-ON=$(module_field "$mod" APPLY-ON), hors substrat $SUBSTRATE) ===${_PN}"
  else
    [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name ($eff) ===${_PN}"
  fi
  rc=0
  run_module "$mod" "$eff" || rc=$?
  case "$CMD:$eff:$rc" in
    # 3 = MORT AVANT SON VERDICT (garde de sortie de provision-lib). Un code a lui seul, parce que
    # `2` est deja pris — « erreur de sonde » au doctor, « appliqué, drift résiduel » a l'apply — et
    # qu'un module tue par `set -e` rendait justement 2 par coincidence. Le bilan disait alors
    # « rien n'est cassé » d'un module qui n'avait pas fini de tourner. Le module le dit lui-meme :
    # lui seul sait s'il a rendu son verdict.
    *:*:3) failed=$((failed + 1)); REPORT+=("$name=ERROR") ;;
    doctor:check:0) ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    doctor:check:1) drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    doctor:check:*)
      failed=$((failed + 1)); REPORT+=("$name=ERROR")
      # UN COMPTEUR SANS LIGNE EST UN ECHEC MUET. rc >= 2 vaut « erreur de sonde » — et c'est AUSSI
      # ce que rend un module mort sous `set -e` avant d'avoir appele `verdict_check`. Dans ce
      # second cas il n'a rien imprime du tout : le bilan affichait « échecs: 1 » sans nommer le
      # module ni la raison, et le lecteur n'avait aucun bout par ou tirer. Mesure du 2026-08-18 :
      # 70-human, tue par `pipefail` sur un `fleet_v2.env` absent, trois lignes DRIFT justes puis
      # plus rien.
      echo "${_PR}ERREUR $name:${_PN} sonde en erreur (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est MORT avant de rendre son verdict" >&2 ;;
    apply:apply:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    # 2 = « appliqué, drift résiduel » : le module a fait ce qu'il pouvait et l'état-cible n'est
    # PAS tenu. Ce n'est pas un échec (rien n'est cassé) et surtout pas un OK — c'est le troisième
    # mot, et son absence faisait compter ces modules comme convergés, ligne de bilan comprise.
    # AVANT le fourre-tout : l'ordre des clauses EST ce qui distingue les deux.
    apply:apply:2)  drift=$((drift + 1)); REPORT+=("$name=DRIFT") ;;
    apply:apply:*)
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      # Meme raison qu'au doctor : un apply qui meurt avant son verdict ne dit rien de lui-meme.
      echo "${_PR}ERREUR $name:${_PN} apply en echec (rc=$rc) — si aucune ligne FAIL n'apparaît au-dessus, le module est MORT avant de rendre son verdict" >&2 ;;
    apply:check:0)  ok=$((ok + 1));       REPORT+=("$name=OK") ;;
    apply:check:*)
      # État-cible absent ET inapplicable ici : rien sur CE substrat ne peut le converger — le
      # fournisseur est ailleurs (stage image, build). Un apply qui le tairait serait vert-menteur.
      failed=$((failed + 1)); REPORT+=("$name=FAIL")
      echo "FAIL  $name: etat-cible non tenu sur $SUBSTRATE et inapplicable ici (APPLY-ON=$(module_field "$mod" APPLY-ON)) — rebuild l'image/le build qui le fournit" >&2 ;;
  esac
done

# ─── SECOND PASSAGE : L'ÉTAT PER-HUMAIN DE L'HUMAIN DE FLEET ─────────────────────────────────────
# `--human` désigne QUI joue les modules `# NEEDS: human`, et sur le rail poste c'est l'opérateur
# (SUDO_USER) — c'est-à-dire, presque toujours, le compte uid 1000 que GUARD B réserve au siège.
# `22-fleet-human` vient de créer l'humain de fleet ; sans ce passage, son `~/.lcars`, son `~/pods`
# et son `fleet_v2.env` n'existeraient jamais, et `fleet_v2 start` échouerait sous lui pour une
# raison sans rapport avec ce qu'on a passé la nuit à corriger.
#
# LA LISTE SE CALCULE, ELLE NE SE RECOPIE PAS — même règle et même code que `converge_human` du
# convergeur de boîte : le provisionnement DÉCLARE lesquels de ses modules sont per-humain
# (`# NEEDS: human`), on lit la déclaration. Une liste en dur redevient fausse au prochain module
# ajouté ; c'est arrivé deux fois côté boîte (la console, puis le binaire `claude`).
#
# ⚠ EN BOUCLE INTERNE, JAMAIS EN RÉ-INVOQUANT `provision` : le verrou est tenu par CE processus, et
# une ré-entrée se refuserait elle-même — « un autre apply est en cours ». Le convergeur de boîte,
# lui, tourne dans un processus séparé et peut se permettre l'appel.
#
# ⚠ ET LES VERDICTS DE CE PASSAGE COMPTENT COMME LES AUTRES. Les faire taire donnerait un bilan qui
# ignore la moitié per-humain de l'installation — c'est-à-dire précisément la moitié dont dépend le
# démarrage de la fleet.
if [[ "$CMD" == "apply" && "$SUBSTRATE" != "docker" ]]; then
  _fleet_human="${PROV_FLEET_HUMAN:-}"
  [[ -n "$_fleet_human" ]] || _fleet_human="${PROV_HUMAN:-}"
  if [[ "$_fleet_human" != "${PROV_HUMAN:-}" ]] && is_fleet_human "$_fleet_human" 2>/dev/null; then
    [[ "$PORCELAIN" -eq 1 ]] || {
      echo ""
      echo "${_PC}=== état per-humain de « $_fleet_human » (l'humain qui lancera la fleet) ===${_PN}"
    }
    # ⚠ ON REJOUE `SELECTED`, ON NE RE-PARCOURT PAS `modules.d`. La sélection est déjà calculée plus
    # haut, et elle porte TROIS décisions qu'un second parcours perdrait : le filtre `--only`, le
    # gating de substrat (`CHECK-ON`), et le choix apply-vs-check (`APPLY-ON`). Les refaire ici,
    # c'est en oublier une — et un `--only 70-human` qui ne vaudrait que pour la première moitié du
    # geste est exactement le genre d'asymétrie que personne ne remarque avant longtemps.
    for i in "${!SELECTED[@]}"; do
      mod="${SELECTED[$i]}"
      [[ "$(module_field "$mod" NEEDS)" == "human" ]] || continue
      name="$(basename "$mod" .sh)"
      eff="${EFFECTIVE[$i]}"
      total=$((total + 1))
      [[ "$PORCELAIN" -eq 1 ]] || echo "${_PC}=== $name ($eff — humain $_fleet_human) ===${_PN}"
      rc=0
      run_module "$mod" "$eff" "$_fleet_human" || rc=$?
      # Les codes s'interprètent selon le VERBE joué, jamais selon la commande demandée : `check`
      # rend 1 pour un drift, `apply` rend 2. Confondre les deux ferait compter un drift comme un
      # échec sur tout module hors de son substrat d'application.
      case "$eff:$rc" in
        *:0)        ok=$((ok + 1));     REPORT+=("$name@$_fleet_human=OK") ;;
        apply:2|check:1) drift=$((drift + 1)); REPORT+=("$name@$_fleet_human=DRIFT") ;;
        *)          failed=$((failed + 1)); REPORT+=("$name@$_fleet_human=FAIL")
                    echo "${_PR}ERREUR $name ($_fleet_human):${_PN} $eff en echec (rc=$rc)" >&2 ;;
      esac
    done
  fi
fi

# ─── Verdict ──────────────────────────────────────────────────────────────────────────────────────
if [[ "$PORCELAIN" -eq 1 ]]; then
  printf '%s\n' "${REPORT[@]}"
else
  echo ""
  # LA SOURCE EST DANS LE RÉCAP, PAS SEULEMENT EN TÊTE : c'est la ligne qu'un opérateur relit, et
  # c'est celle qu'il colle dans un rapport. Un verdict sans son origine ne se compare à rien.
  # ⚠ LE JOURNAL SE SCELLE AVANT LE RÉCAP, ET IL NE PEUT PAS FAIRE ÉCHOUER UNE PASSE. Il RACONTE ce
  # qui vient d'être posé ; il ne décide de rien. Un journal illisible est une perte d'information —
  # elle se DIT, elle ne renverse pas un verdict que 25 modules viennent de rendre.
  if [[ "$CMD" == "apply" && -n "${PROV_JOURNAL_ACC:-}" && -s "$PROV_JOURNAL_ACC" ]]; then
    if mkdir -p "$(dirname "$JOURNAL_FILE")" 2>/dev/null; then
      {
        echo "# SOURCE: $JOURNAL_FILE"
        echo "# STATUS: mesure, pas declaration — CE QUI A ETE POSE SUR CETTE MACHINE."
        echo "#"
        echo "# Son jumeau statique est fleet/deploy/system.manifest, qui dit ce que le"
        echo "# provisionnement a le DROIT de poser. Celui-ci dit ce qu'il A pose, ici."
        echo "#"
        echo "# ⚠ apt_installed / apt_already EST LA RAISON D'ETRE DE CE FICHIER. La distinction"
        echo "# n'est connaissable QU'AVANT l'install : une seconde plus tard, dpkg repond"
        echo "# « present » pour les deux. Un uninstall qui l'ignore retire des paquets que"
        echo "# l'operateur avait avant — pire que d'en laisser."
        echo "posed_at      $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "source_rev    ${PROV_SOURCE_REV:-inconnue}"
        echo "substrate     $SUBSTRATE"
        echo "prefix        ${PROV_PREFIX:-inconnu}"
        echo "modules       total=$total ok=$ok drift=$drift failed=$failed"
        # Une clef par ligne, valeurs fusionnées et dédoublonnées : `apt_ensure` est appelée par
        # plusieurs modules, et trois lignes `apt_installed` pour un même paquet ne disent rien de
        # plus qu'une.
        awk '{ k=$1; $1=""; sub(/^ /,""); acc[k]=acc[k] " " $0 }
             END { for (k in acc) {
                     n=split(acc[k], w, " "); delete seen; out=""
                     for (i=1;i<=n;i++) if (w[i]!="" && !(w[i] in seen)) { seen[w[i]]=1; out=out " " w[i] }
                     printf "%-13s%s\n", k, out } }' "$PROV_JOURNAL_ACC" | sort
      } > "$JOURNAL_FILE" 2>/dev/null \
        && chmod 0644 "$JOURNAL_FILE" 2>/dev/null \
        || echo "  ${_PA}journal NON écrit ($JOURNAL_FILE) — l'install est faite, sa trace ne l'est pas${_PN}"
    else
      echo "  ${_PA}journal NON écrit : $(dirname "$JOURNAL_FILE") inaccessible${_PN}"
    fi
    rm -f "$PROV_JOURNAL_ACC"
  fi

  echo "${_PC}=== provision $CMD — substrat $SUBSTRATE · source $PROV_SOURCE_REV ===${_PN}"
  # UN COMPTEUR N'EST TEINTÉ QUE S'IL PORTE QUELQUE CHOSE. Un « échecs: 0 » en rouge apprend au
  # lecteur à ignorer le rouge, et le jour où il vaut 3 il ne le voit plus.
  #
  # ⚠ LA TEINTE ENGLOBE « libellé: valeur », JAMAIS LA VALEUR SEULE. Une séquence ANSI glissée entre
  # les deux COUPE le jeton : la sortie devient « drift: <ESC>1<ESC> » et la chaîne littérale
  # « drift: 1 » n'y est plus. Mesuré le 2026-08-18 — deux témoins du runner, qui cherchent
  # exactement cette chaîne, sont passés au rouge dès que la couleur a été allumée, et seulement
  # alors. Même règle que pour les étiquettes : on ne teinte jamais l'intérieur d'un motif.
  _tint() { # _tint <couleur> <libellé> <valeur>
    if [[ "$3" -gt 0 ]]; then printf '%s%s: %s%s' "$1" "$2" "$3" "$_PN"; else printf '%s: %s' "$2" "$3"; fi
  }
  printf '  modules: %d · %s · %s · %s\n' "$total" \
    "$(_tint "$_PG" "conformes/convergés" "$ok")" \
    "$(_tint "$_PA" "drift" "$drift")" \
    "$(_tint "$_PR" "échecs" "$failed")"
  if [[ "$CMD" == "doctor" && "$drift" -gt 0 ]]; then
    echo "  ${_PA}→ converger :${_PN} sudo $SELF apply"
  fi
  # ⚠ « RIEN N'EST CASSÉ » NE SE DIT QUE QUAND RIEN N'EST CASSÉ. Cette phrase sortait dès qu'il y
  # avait du drift, ÉCHECS COMPRIS — donc la dernière ligne lue par l'opérateur rassurait pendant
  # que trois modules venaient d'imprimer FAIL et que le code de sortie disait 1. Mesuré le
  # 2026-08-21, install à froid sur machine dédiée : « échecs: 3 » puis « Rien n'est cassé ».
  #
  # Le code de retour, lui, était déjà juste. C'est exactement ce qui rend la faute chère : rien
  # n'échoue, aucun test ne rougit, et seul un humain qui lit la fin se fait une idée fausse de
  # l'état de sa machine. L'échec passe DEVANT, parce qu'il prime — un état-cible non tenu sur un
  # module qui a échoué n'est pas « un geste qui manque », c'est une conséquence.
  if [[ "$CMD" == "apply" && "$failed" -gt 0 ]]; then
    echo "  ${_PR}→ EN ÉCHEC${_PN} sur $failed module(s) — voir les lignes FAIL ci-dessus."
    [[ "$drift" -gt 0 ]] && \
      echo "    ($drift autre(s) module(s) en DRIFT : état-cible non tenu, souvent en conséquence.)"
  elif [[ "$CMD" == "apply" && "$drift" -gt 0 ]]; then
    echo "  ${_PA}→ APPLIQUÉ, MAIS L'ÉTAT-CIBLE N'EST PAS TENU${_PN} sur $drift module(s) — voir les lignes"
    echo "    DRIFT ci-dessus. Rien n'est cassé ; il manque un geste (forge, credentials, réseau)."
  fi
fi
[[ "$failed" -gt 0 ]] && exit "$([[ "$CMD" == "doctor" ]] && echo 2 || echo 1)"
# Le drift résiduel a son propre code dans les DEUX verbes — en apply il valait 0, c'est-à-dire
# « tout convergé », sur une machine dont un module venait d'imprimer DRIFT.
[[ "$drift" -gt 0 ]] && exit "$([[ "$CMD" == "doctor" ]] && echo 1 || echo 2)"
exit 0
