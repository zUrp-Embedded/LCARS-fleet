#     fleet-update.sh — Pull runtime from GitHub + deploy to all agents.
#     Replaces self-update.sh. Single update entry point.
#
#
# --- END HEADER ---



# --help: extract [EN] section from this header
[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && {
    sed -n '/^#     \[EN\]/,/^# --- END HEADER ---/{/\[EN\]/d; /END HEADER/d; s/^#     //; s/^#[[:space:]]*$//; p}' "$0"
    exit 0
}

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fleet-env.sh"

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[fleet-update]${NC}  $*"; }
warn()  { echo -e "${YELLOW}[fleet-update]${NC}  $*"; }
error() { echo -e "${RED}[fleet-update]${NC} $*" >&2; exit 1; }

DRY=0; FORCE=0; JSON=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY=1; shift ;;
        --force)   FORCE=1; shift ;;
        --json)    JSON=1; DRY=1; shift ;;
        *)         error "Unknown arg: $1" ;;
    esac
done

RUNTIME="$LCARS_ROOT"
PROVISION_SYSTEM="$RUNTIME/fleet/provisioning/provision-system.sh"
PROVISION_USERS="$RUNTIME/fleet/provisioning/provision-users.sh"
DEPLOY="$RUNTIME/fleet/provisioning/deploy.sh"

# Resolve FLEET_USER from blueprint (needed by provision scripts)
_FU=""
[ -f "$RUNTIME/fleet/fleet.yaml" ] && \
    _FU=$(yq '.fleet.identity.fleet_user' "$RUNTIME/fleet/fleet.yaml" 2>/dev/null)
[[ "$_FU" == "null" || -z "$_FU" ]] && _FU="$(logname 2>/dev/null || echo "${SUDO_USER:-$USER}")"
FLEET_USER="$_FU"

# IEC 61508: sanitize FLEET_USER before using in sudo/git operations
[[ "$FLEET_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo "ERROR: invalid fleet_user '$FLEET_USER'" >&2; exit 1; }

if [ ! -d "$RUNTIME/.git" ]; then
    [ -f "/home/private/.offline-bootstrap" ] && \
        error "$RUNTIME: offline bootstrap pending — run post-install-offline.sh first (onboard_v2 Step 6.5 does it automatically)"
    error "$RUNTIME is not a git repository"
fi

# M1-FIX: ensure safe.directory before ANY git operation on runtime
sudo -u "$FLEET_USER" git config --global --get-all safe.directory 2>/dev/null | grep -qF "$RUNTIME" \
    || sudo -u "$FLEET_USER" git config --global --add safe.directory "$RUNTIME"

# F-E1 FIX: verify remote authority BEFORE pull (was post-pull — safety chain inversion)
# Authority predicate from fleet-system.yaml (single source of truth), not a loose glob
_EXPECTED_REPO=$(yq '.fleet.repo' "$RUNTIME/fleet/fleet-system.yaml" 2>/dev/null)
_REMOTE_URL="$(git -C "$RUNTIME" remote get-url origin 2>/dev/null || true)"
if [[ -z "$_EXPECTED_REPO" || "$_EXPECTED_REPO" == "null" ]]; then
    error "$RUNTIME/fleet/fleet-system.yaml missing fleet.repo — cannot verify authority"
fi
if [[ "$_REMOTE_URL" != *"$_EXPECTED_REPO"* ]]; then
    error "$RUNTIME remote '$_REMOTE_URL' does not match expected repo '$_EXPECTED_REPO' — aborting before pull"
fi

BEFORE=$(git -C "$RUNTIME" rev-parse --short HEAD)
BRANCH=$(git -C "$RUNTIME" branch --show-current)
[[ $JSON -eq 0 ]] && info "runtime: $RUNTIME (branch: $BRANCH, at: $BEFORE)"

if [[ $DRY -eq 1 ]]; then
    if [[ $JSON -eq 1 ]]; then
        cat <<JSON
{
  "runtime": "$RUNTIME",
  "branch": "$BRANCH",
  "commit": "$BEFORE",
  "fleet_user": "$FLEET_USER",
  "deploy": "$DEPLOY",
  "provision_system": "$PROVISION_SYSTEM",
  "provision_users": "$PROVISION_USERS",
  "deploy_exists": $([ -x "$DEPLOY" ] && echo true || echo false),
  "is_git_repo": true
}
JSON
    else
        info "[dry-run] would pull from origin ($BRANCH)"
        info "[dry-run] would run deploy.sh"
    fi
    exit 0
fi

info "pulling from origin"
sudo -u "$FLEET_USER" git -C "$RUNTIME" pull --ff-only

AFTER=$(git -C "$RUNTIME" rev-parse --short HEAD)
if [ "$BEFORE" = "$AFTER" ]; then
    info "already up to date ($AFTER) — reconverging anyway (idempotent)"
else
    info "updated: $BEFORE → $AFTER"
    git -C "$RUNTIME" --no-pager log --oneline "$BEFORE".."$AFTER"
fi


# IEC 61508: verify RUNTIME integrity before chmod (git-repo check only — remote already verified pre-pull)
if [ ! -d "$RUNTIME/.git" ]; then
    error "$RUNTIME is not a git repository — aborting permission normalization"
fi

# Normalize permissions after pull (git inherits umask, not target modes)
# sudo required: files may be owned by fleet_user after git pull
sudo find "$RUNTIME" -type f -name '*.sh' -exec chmod 755 {} +
sudo find "$RUNTIME" -type f \( -name '*.md' -o -name '*.yaml' -o -name '*.json' -o -name '*.py' \) -exec chmod 644 {} +

# Rebuild fleet.yaml if sources changed (before deploy uses it)
BUILD_YAML="$RUNTIME/fleet/fleet-build-yaml.sh"
[ -x "$BUILD_YAML" ] && bash "$BUILD_YAML"

# Provision chain: system → users → deploy (all idempotent)
if [ -x "$PROVISION_SYSTEM" ]; then
    info "provisioning system..."
    sudo bash "$PROVISION_SYSTEM" "$FLEET_USER"
fi

if [ -x "$PROVISION_USERS" ]; then
    info "provisioning users..."
    sudo bash "$PROVISION_USERS" "$FLEET_USER"
fi

if [ -x "$DEPLOY" ]; then
    info "deploying..."
    sudo bash "$DEPLOY"
    # JUPITER-001: shell cache removed — fleet-env.sh always reads fleet.yaml fresh.
    unset _FLEET_ENV_LOADED 2>/dev/null
    info "fleet-update done: $BEFORE → $AFTER"
else
    error "deploy.sh not found at $DEPLOY"
fi
