#!/usr/bin/env bash
# SOURCE: bin/lcars
# AUTHOR: starfleet
# STARDATE: 2026-06-14
# STATUS: PROTO-V2 — operator CLI for the fleet: spawn / list / attach (LAUNCH-1/2/2b)
#
# Host-side operator tool for driving the LCARS v2 daemon. Three gestures covering the "launch a pod,
# see it, attach to it" loop:
#   - `lcars spawn <role>`     POST /api/admin/spawn (established control path, no-auth loopback). The
#                              spawn is dispatched ASYNC (event admin.spawn.request → spawn_pod), so the
#                              202 means "queued", NOT "pod alive". Confirm with `lcars list`.
#   - `lcars list`             LIVE pods read straight off the substrate (the per-pod tmux socks ARE the
#                              real liveness; fleet_api's /api/pods answers 501 not_implemented, F-C118).
#                              Dependency-free — works even with the API down.
#   - `lcars attach <pod_id>`  attaches the terminal to the pod's tmux session (`tmux -S <sock> attach`).
#                              Ctrl-b d detaches WITHOUT killing the pod.
#
# `attach` requires the operator to have the SAME UID as the daemon (the per-pod sock dirs are `0700`).
# Current model: each human launches THEIR fleet through `bin/fleet_v2` → the BEAM and the pods run under
# THEIR UID → they attach their own pods directly, with no privilege and no special case. (There is no
# `User=lcars` system service any more: the systemd model is gone.) Holds for bwrap pods (sock
# bind-mounted host-side) as well as host pods (LAUNCH-Q).
#
# Config (env):
#   LCARS_API_URL         the daemon's REST base (default: read from ~/.lcars/run/api_url, written by
#                         fleet_v2 at start — the ports are per-human/UID, so no static default can be
#                         right; fleet not started → a clear error, never a guessed port)
#   LCARS_TMUX_SOCK_BASE  base of the per-pod socks (default ~/.lcars/run/tmux-sock; = the Elixir
#                         default, c368f89d)
#   LCARS_TMUX_BIN        tmux binary (default: tmux from the PATH)

set -euo pipefail

# A7: explicit env > runtime state written by fleet_v2 > vide. JAMAIS un port devine.
#
# ⚠ CE BLOC ETAIT FATAL, et il gardait une valeur que PERSONNE NE LIT : `spawn` passe par
# `$API_SOCK` (l'AF_UNIX), `list` et `attach` par les socks tmux, et `$API_URL` n'apparait que dans
# le texte d'aide. Le garde tuait donc tout le CLI quand la fleet n'avait jamais demarre — y compris
# `list`, dont l'en-tete de ce fichier promet qu'il « marche meme avec l'API down », et surtout
# `catalogue install|verify|enable`, qui sont precisement les gestes d'une boite NEUVE, avant le
# premier `fleet_v2 start`. Mesure : sur un banc frais, `lcars catalogue list` sortait en 1.
#
# Chaque verbe garde donc ce dont IL a besoin, la ou il s'en sert — `cmd_spawn` echoue deja sur
# `$API_SOCK` avec le bon message.
if [[ -n "${LCARS_API_URL:-}" ]]; then
  API_URL="$LCARS_API_URL"
elif [[ -r "$HOME/.lcars/run/api_url" ]]; then
  API_URL="$(cat "$HOME/.lcars/run/api_url")"
else
  API_URL=""
fi
SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"
# `spawn` (write) goes through the per-human AF_UNIX socket (ControlRouter), off the network the
# pod shares. Reads stay on $API_URL (TCP loopback).
API_SOCK="${LCARS_API_SOCK:-$HOME/.lcars/run/api.sock}"
TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"

PROG="$(basename "$0")"

die() { echo "lcars: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
$PROG — CLI fleet LCARS v2

USAGE
  $PROG spawn <role> [--issue <id>] [--brief <texte>]
      Demande au daemon de lancer un pod du role <role> (= nom de cap-profile,
      ex: architect, engineer, consultant). Dispatch ASYNC : le pod n'est pas
      vivant au retour — « $PROG list » pour le voir. NB : les roles
      boot_at_start (starfleet) montent seuls au boot de la fleet ; spawn sert
      surtout aux roles ponctuels et au test.

  $PROG list
      Liste les pods VIVANTS (socks tmux par-pod) + le statut de leur session tmux.

  $PROG ls
      Alias de « $PROG list ». Le dispatcher accepte les deux depuis toujours ; seul
      l'usage l'ignorait, ce qui en faisait une commande que personne n'instruisait.

  $PROG attach <pod_id>
      Attache ce terminal sur la session tmux du pod (Ctrl-b d rend la main sans
      tuer le pod).

  $PROG catalogue list
      Les catalogues installes, et lesquels sont ACTIFS, dans l'ordre de precedence.

  $PROG catalogue install <source> [nom]
      Installe un catalogue depuis un depot git, une archive tar.gz ou un dossier
      local. Le NOM vient du catalogue (son « name: »), pas de la source ni de vous :
      [nom] n'est qu'une assertion, et la pose echoue si le catalogue en dit un autre.
      N'active RIEN : installe n'est pas actif.

  $PROG catalogue verify <nom>
      Joue sur ce catalogue exactement les controles que le boot joue. Code de
      sortie = verdict.

  $PROG catalogue enable <nom> | disable <nom>
      Ajoute / retire une ligne de la declaration d'activite. REFUSE d'activer un
      catalogue que verify ne passe pas. NE PROVISIONNE PAS la forge : activer rend
      un catalogue LU, ca ne cree ni son org ni ses comptes de role — enable nomme
      le geste qui reste.

  $PROG catalogue remove <nom>
      Supprime un catalogue installe. Refuse s'il est actif.

  $PROG project migrate <owner/nom> <catalogue>
      Migre un projet vers un autre catalogue : transfert du depot dans l'org de ce
      catalogue, PUIS repointage de l'origin des trois faces locales. Les deux
      moities, ou rien — un transfert seul laisse un projet qui marche par accident,
      via la redirection 301. REFUSE un catalogue qui n'est pas actif ici.

  $PROG help
      Cette aide.

ENV
  LCARS_API_URL=$API_URL       (lectures REST, TCP loopback)
  LCARS_API_SOCK=$API_SOCK     (spawn, socket AF_UNIX host-only)
  LCARS_TMUX_SOCK_BASE=$SOCK_BASE
EOF
}

# --- spawn -----------------------------------------------------------------

cmd_spawn() {
  local role="" issue="" brief="" have_brief=0
  [[ $# -ge 1 && "$1" != --* ]] || die "spawn: role requis (ex: $PROG spawn architect)"
  role="$1"; shift
  # The role is a cap-profile slug (JSON anti-injection for the jq-less payload path below).
  [[ "$role" =~ ^[a-z][a-z0-9-]*$ ]] || die "spawn: role '$role' invalide (slug [a-z0-9-] attendu)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="${2:?--issue exige une valeur}"; shift 2 ;;
      --brief) brief="${2:?--brief exige une valeur}"; have_brief=1; shift 2 ;;
      *) die "spawn: argument inconnu '$1'" ;;
    esac
  done
  [[ -z "$issue" || "$issue" =~ ^[A-Za-z0-9._-]+$ ]] || die "spawn: --issue '$issue' invalide"

  # JSON payload. The brief field is free text → jq, for correct escaping; otherwise printf (safe slugs).
  local payload
  if [[ "$have_brief" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || die "spawn: --brief exige jq (pour le quoting JSON du texte libre)"
    payload="$(jq -nc --arg r "$role" --arg t "$issue" --arg m "$brief" \
      '{cap_profile_name:$r} + (if $t=="" then {} else {issue_id:$t} end) + {brief:$m}')"
  elif [[ -n "$issue" ]]; then
    payload="$(printf '{"cap_profile_name":"%s","issue_id":"%s"}' "$role" "$issue")"
  else
    payload="$(printf '{"cap_profile_name":"%s"}' "$role")"
  fi

  # Contract: `/api/admin/spawn` accepts only a FLAT allowlisted DTO (`cap_profile_name` + `issue_id` +
  # `brief`) — NO raw `opts`: any key outside the allowlist (including an `opts` supplied by the client)
  # fails the spawn with a 422. The API rebuilds the spawner's internal `opts` itself from `brief`
  # (cf. SpawnAdmission).
  local body http
  # `--unix-socket`: the write door lives on the per-human AF_UNIX socket (ControlRouter), NOT on
  # the TCP loopback - the pod (shared host netns) cannot reach it. The host in the URL is ignored
  # with --unix-socket; we keep a dummy host. curl WITHOUT -f: a 4xx/5xx does not make curl fail
  # (we read the code via -w); only a transport failure (exit != 0) -> `|| die`.
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn" \
            -H 'content-type: application/json' -d "$payload" \
            -w $'\n%{http_code}' 2>/dev/null)" \
    || die "control socket injoignable ($API_SOCK) — fleet_v2 tourne pour cet utilisateur ?"

  http="${body##*$'\n'}"; body="${body%$'\n'*}"
  case "$http" in
    202) echo "spawn $role : mis en file (202). Le pod monte en async — « $PROG list » pour le voir." ;;
    503) die "fleet en drain de shutdown (503) — retente quand la fleet sera repartie" ;;
    # MA-18: the cap-profile is validated BEFORE the ACK. 422 = unknown role (no such cap-profile),
    # 400 = malformed request. No more lying 202 (it used to ACK, then warn silently daemon-side and
    # spawn nothing).
    422) die "spawn KO : cap-profile '$role' inconnu (422) — le nom de role est faux. $body" ;;
    400) die "spawn KO : appel invalide (400). $body" ;;
    *)   die "spawn KO (HTTP $http) : $body" ;;
  esac
}

# --- list ------------------------------------------------------------------

cmd_list() {
  [[ -d "$SOCK_BASE" ]] || { echo "(aucun pod : $SOCK_BASE absent — la fleet tourne ?)"; return 0; }
  shopt -s nullglob
  local socks=("$SOCK_BASE"/*/pod.sock) found=0
  if [[ ${#socks[@]} -eq 0 ]]; then echo "(aucun pod vivant)"; return 0; fi
  printf '%-40s  %s\n' "POD_ID" "TMUX"
  local sock pod_id session status
  for sock in "${socks[@]}"; do
    pod_id="$(basename "$(dirname "$sock")")"
    session="lcars-pod-$pod_id"
    if "$TMUX_BIN" -S "$sock" has-session -t "$session" 2>/dev/null; then
      status="vivant"
    else
      status="sock orphelin (pas de session)"
    fi
    printf '%-40s  %s\n' "$pod_id" "$status"
    found=1
  done
  [[ "$found" -eq 1 ]] || echo "(aucun pod vivant)"
}

# --- attach ----------------------------------------------------------------

cmd_attach() {
  local pod_id="${1:-}"
  [[ -n "$pod_id" ]] || die "attach: pod_id requis (cf. « $PROG list »)"
  # Anti path-traversal: pod_id is ONE path component (sock = $SOCK_BASE/$pod_id/pod.sock). No `/`, no `..`.
  [[ "$pod_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$pod_id" != *..* ]] \
    || die "attach: pod_id '$pod_id' invalide"
  local sock="$SOCK_BASE/$pod_id/pod.sock"
  [[ -S "$sock" ]] || die "attach: pas de sock pour '$pod_id' ($sock) — pod vivant ? (cf. « $PROG list »)"
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "attach: tmux introuvable ($TMUX_BIN)"
  echo "attach $pod_id (Ctrl-b d rend la main sans tuer le pod)…" >&2
  # UI: the wheel scrolls the tmux scrollback (not the shell history). `set -g mouse on` on the pod's
  # own server, right before attaching → covers EVERY pod through RUNTIME tmux config, with no launcher
  # edit. Mouse ON does change selection: hold Shift to copy to the OS clipboard.
  "$TMUX_BIN" -S "$sock" set -g mouse on 2>/dev/null || true
  exec "$TMUX_BIN" -S "$sock" attach -t "lcars-pod-$pod_id"
}

# --- catalogue -------------------------------------------------------------
#
# LES TROIS CHEMINS SONT AUSSI CONNUS D'ELIXIR (`Fleet.Layout` : catalogues_operator_dir/0,
# catalogues_shipped_dir/0, active_catalogues_path/0). C'est un fait ecrit deux fois, dans deux
# langages qui ne peuvent pas s'appeler — la meme forme que les listes de roles verrouillees par
# `mix lcars.contracts.check`. Un changement ici sans l'autre cote donne un CLI qui ecrit une
# declaration que le runtime ne lit pas : rien ne casse, rien ne s'active, et personne ne le voit.
CAT_DIR="${LCARS_CATALOGUES_DIR:-$HOME/.lcars/catalogues}"
CAT_ACTIVE="${LCARS_CATALOGUES_ACTIVE:-$HOME/.lcars/catalogues.active}"
CAT_SHIPPED="${LCARS_CATALOGUES_SHIPPED:-/opt/lcars/catalogues}"
# Le nom reserve du catalogue metier livre DANS le release : il n'a pas de dossier installe, donc
# il s'active et se desactive, mais ne s'installe ni ne se supprime.
CAT_BUNDLED="fleet"

# Ou vit <nom> : l'operateur d'abord, le livre ensuite — MEME ORDRE que `install_dirs` cote runtime,
# pour qu'un catalogue importe masque un livre du meme nom des deux cotes.
cat_dir_of() {
  local name="$1"
  if [[ -d "$CAT_DIR/$name" ]]; then echo "$CAT_DIR/$name"
  elif [[ -d "$CAT_SHIPPED/$name" ]]; then echo "$CAT_SHIPPED/$name"
  else return 1; fi
}

# Les noms declares, dans l'ordre, commentaires et lignes vides retires. MEME lecture que
# `Fleet.Catalogue.declared_names/0` : un `#` coupe la ligne, on trim, on jette le vide.
cat_declared() {
  [[ -r "$CAT_ACTIVE" ]] || return 0
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$CAT_ACTIVE" | grep -v '^$' || true
}

# L'ACTIVITE N'EST PAS LA DECLARATION, ET LES CONFONDRE FAISAIT MENTIR QUATRE COMMANDES.
# La regle du runtime est dans `Fleet.Catalogue.active_roots/0` : *pas de declaration, ou une
# declaration vide, signifie le catalogue livre dans le release SEUL*. C'est le cas par defaut d'une
# boite neuve — aucun `catalogues.active` n'existe tant que personne n'a rien active.
#
# Ce predicat ne lisait que le fichier. Mesure du 2026-08-12 sur une boite sans declaration, dont
# TOUT tournait sur `fleet` :
#   lcars catalogue list  ->  « fleet   inactif   (« lcars catalogue enable fleet ») »
# Deux lignes de la meme sortie se contredisaient — le bloc ACTIFS disait « le catalogue livre dans
# le release, seul », et la ligne suivante nommait ce catalogue-la inactif. Celle qui ment est celle
# qui nomme un etat et propose une commande, et un agent qui lit ca a un modele faux de sa boite.
#
# -F : le nom est une CHAINE, pas un motif. Sans lui, `my.cat` matche `my_cat` — un point est un
# joker en BRE, et un nom de catalogue est une donnee de l'operateur.
cat_is_active() {
  local declared; declared="$(cat_declared)"
  [[ -n "$declared" ]] || { [[ "$1" == "$CAT_BUNDLED" ]]; return; }
  printf '%s\n' "$declared" | grep -qxF "$1"
}

# Actif SANS que personne ne l'ait declare — l'etat par defaut. Il se dit, parce qu'il ne se
# desactive pas comme un autre (retirer une ligne d'un fichier vide redonne le defaut) et parce
# qu'activer un AUTRE catalogue le fait sortir.
cat_active_by_default() { [[ -z "$(cat_declared)" ]]; }

# La liste porte le CHEMIN de chaque entree, et dit laquelle MASQUE l'autre.
#
# Mesure sur un banc (2026-08-11) : apres `catalogue install` du catalogue `web`, la liste affichait
# « web actif » DEUX FOIS, sans un mot de plus. Ce n'etait pas un doublon d'affichage — `web` existe
# reellement des deux cotes, livre dans l'image et installe par l'operateur — et `cat_dir_of` fait
# gagner l'operateur. Le masquage est une FONCTIONNALITE ; une liste qui montre deux lignes
# identiques la rend indiscernable d'un bug, et l'operateur ne sait pas lequel des deux tourne.
cmd_catalogue_list() {
  local installed=()
  [[ -d "$CAT_DIR" ]] && while IFS= read -r d; do installed+=("operateur:$(basename "$d")"); done \
    < <(find "$CAT_DIR" -mindepth 1 -maxdepth 1 -type d | sort)
  [[ -d "$CAT_SHIPPED" ]] && while IFS= read -r d; do installed+=("livre:$(basename "$d")"); done \
    < <(find "$CAT_SHIPPED" -mindepth 1 -maxdepth 1 -type d | sort)

  echo "ACTIFS (ordre = precedence, $CAT_ACTIVE)"
  if [[ -s "$CAT_ACTIVE" ]] && [[ -n "$(cat_declared)" ]]; then
    local n=0
    while IFS= read -r name; do
      n=$((n + 1))
      if [[ "$name" == "$CAT_BUNDLED" ]]; then
        echo "  $n. $name    (livre dans le release)"
      elif cat_dir_of "$name" >/dev/null; then
        echo "  $n. $name    $(cat_dir_of "$name")"
      else
        echo "  $n. $name    INSTALLE NULLE PART — le boot refusera" >&2
      fi
    done < <(cat_declared)
  else
    # Le nommer, et pas seulement le decrire : « le catalogue livre dans le release » et la ligne
    # « fleet » plus bas etaient le meme objet, et rien ne le disait.
    echo "  1. $CAT_BUNDLED    (par defaut — aucune declaration, cf. « $CAT_ACTIVE »)"
  fi

  echo
  echo "INSTALLES"
  # Le catalogue LIVRE DANS LE RELEASE n'est ni dans CAT_DIR ni dans CAT_SHIPPED — il vit dans le
  # release. Il ne figurait donc nulle part, alors qu'il est le DEFAUT et qu'on peut l'activer par
  # son nom : un operateur qui n'a active que le sien n'avait aucun moyen d'apprendre qu'il existe.
  if cat_active_by_default; then
    printf '  %-14s %-9s %s\n' "$CAT_BUNDLED" "actif" "(dans le release — par defaut, aucune declaration)"
  elif cat_is_active "$CAT_BUNDLED"; then
    printf '  %-14s %-9s %s\n' "$CAT_BUNDLED" "actif" "(dans le release)"
  else
    printf '  %-14s %-9s %s\n' "$CAT_BUNDLED" "inactif" "(dans le release — « $PROG catalogue enable $CAT_BUNDLED »)"
  fi

  if [[ ${#installed[@]} -eq 0 ]]; then
    :
  else
    local entry origin name state note
    for entry in "${installed[@]}"; do
      origin="${entry%%:*}"; name="${entry#*:}"
      state="inactif"; cat_is_active "$name" && state="actif"
      note=""
      # Un nom present des deux cotes : l'operateur GAGNE (cat_dir_of le resout ainsi). On le dit
      # sur les deux lignes, sans quoi elles sont indiscernables.
      if [[ "$origin" == "livre" && -d "$CAT_DIR/$name" ]]; then
        note="(livre — MASQUE par celui de l'operateur)"
      elif [[ "$origin" == "livre" ]]; then
        note="(livre avec l'image)"
      elif [[ -d "$CAT_SHIPPED/$name" ]]; then
        note="(operateur — MASQUE le livre du meme nom)"
      else
        note="(operateur)"
      fi
      printf '  %-14s %-9s %s\n' "$name" "$state" "$note"
    done
  fi
}

# Le binaire de release joue les memes controles que le boot. Dans la boite il est a l'install ;
# hors boite il n'existe pas, et on le DIT au lieu de deviner une commande de repli.
cat_verify_root() {
  local root="$1"
  local bin="${LCARS_FLEET_BIN:-/local/LCARS_v2/rel/lcars_fleet/bin/lcars_fleet}"
  [[ -x "$bin" ]] || die "catalogue verify: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN, ou lancer « mix lcars.catalogue.verify $root » depuis le depot"
  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Application.CatalogueVerify.eval_main(\"$root\")"
}

cmd_catalogue_verify() {
  local name="${1:?catalogue verify: nom requis}"
  [[ "$name" == "$CAT_BUNDLED" ]] && die "catalogue verify: « $CAT_BUNDLED » est le catalogue livre dans le release — le boot le verifie a chaque demarrage"
  local root; root="$(cat_dir_of "$name")" || die "catalogue verify: « $name » n'est installe nulle part (cf. « $PROG catalogue list »)"
  cat_verify_root "$root"
}

cmd_catalogue_enable() {
  local name="${1:?catalogue enable: nom requis}"
  cat_is_active "$name" && { echo "catalogue enable: « $name » est deja actif" >&2; return 0; }

  if [[ "$name" != "$CAT_BUNDLED" ]]; then
    local root; root="$(cat_dir_of "$name")" || die "catalogue enable: « $name » n'est installe nulle part"
    # LE REFUS QUI REND `verify` UTILE : sans lui c'est un outil qu'on peut sauter, avec lui c'est
    # la condition d'activation. Un catalogue casse active est un boot qui refuse, decouvert au
    # redemarrage suivant par quelqu'un qui ne fera pas le lien.
    cat_verify_root "$root" || die "catalogue enable: « $name » ne passe pas verify — non active"
  fi

  mkdir -p "$(dirname "$CAT_ACTIVE")"

  # ⚠ ACTIVER LE PREMIER CATALOGUE EN DESACTIVAIT UN AUTRE, SANS UN MOT. Tant qu'aucune declaration
  # n'existe, le catalogue livre tourne — c'est la regle du runtime, pas une commodite. Ecrire la
  # premiere ligne rend le fichier NON VIDE, la regle du defaut cesse de s'appliquer, et le livre
  # sort de la liste. Mesure du 2026-08-12 sur une boite neuve : « enable web » -> declaration
  # « web » seule, et `fleet` — donc tous les projets de son org — devenu invisible au poller. Le
  # message disait « ajoute en DERNIER », ce qui laissait croire a un ajout a ce qui tournait deja.
  #
  # On MATERIALISE donc le defaut implicite avant d'ajouter, dans cet ordre : ce que la boite faisait
  # tourner reste en tete, le nouveau vient apres. Un operateur qui ne veut vraiment que le sien le
  # retire ensuite — et ce `disable`-la marche, parce que la declaration existe maintenant.
  if [[ "$name" != "$CAT_BUNDLED" ]] && cat_active_by_default; then
    printf '%s\n' "$CAT_BUNDLED" >> "$CAT_ACTIVE"
    echo "catalogue enable: « $CAT_BUNDLED » etait actif PAR DEFAUT — il est ecrit en tete pour le rester" >&2
    echo "  (sans ca, cette premiere declaration l'aurait fait sortir : « $PROG catalogue disable $CAT_BUNDLED » pour ne garder que le tien)" >&2
  fi

  printf '%s\n' "$name" >> "$CAT_ACTIVE"
  echo "catalogue enable: « $name » ajoute en DERNIER dans $CAT_ACTIVE" >&2
  echo "  l'ordre des lignes EST la precedence — editer le fichier pour le remonter" >&2
  # Les images gelent au boot : pretendre agir a chaud serait un mensonge operationnel.
  echo "  la fleet tourne encore sur ses images gelees : « fleet_v2 stop && fleet_v2 start » pour appliquer" >&2

  # CE QUE L'ACTIVATION NE FAIT PAS, ET QU'ELLE TAISAIT. Activer un catalogue le rend LU par la
  # fleet ; ca ne cree ni son org ni ses comptes sur la forge. Un redemarrage sur un catalogue non
  # provisionne part chercher des jetons de role qui n'existent pas, et le premier dispatch boucle
  # en `role_token_unavailable` — loin d'ici, sans que rien ne rappelle ce qui manquait.
  #
  # Ce verbe ne peut pas provisionner lui-meme : il n'a aucun acces forge, et lui en donner un
  # ferait d'une commande locale un acteur distant. Il NOMME donc le geste, ce qui est la difference
  # entre un outil qui se tait et un outil qui n'agit pas.
  if [[ "$name" != "$CAT_BUNDLED" ]]; then
    echo "  ⚠ la forge n'a NI l'org « $name » NI ses comptes de role — l'activation ne provisionne pas :" >&2
    echo "      etc/enroll-catalogue.sh --catalogue <racine> --tofu-dir <copie de deploy/deps>" >&2
    echo "      puis « tofu apply » dans ce dossier (le module deploy/deps/instance/ d'abord, une seule fois par forge)" >&2
  fi
}

cmd_catalogue_disable() {
  local name="${1:?catalogue disable: nom requis}"
  cat_is_active "$name" || die "catalogue disable: « $name » n'est pas actif"

  # ON NE DESACTIVE PAS UN DEFAUT PAR SOUSTRACTION. Sans declaration, le catalogue livre tourne ;
  # retirer sa ligne d'un fichier qui n'en a aucune laisse le fichier vide, et un fichier vide
  # REDONNE le defaut. La commande aurait rendu 0 en ne changeant rien — le pire des deux mondes.
  # Ce qu'il faut est de declarer ce qui tourne A SA PLACE, et c'est ce que dit le refus.
  if cat_active_by_default; then
    die "catalogue disable: « $name » est actif PAR DEFAUT (aucune declaration dans $CAT_ACTIVE) —
  un defaut ne se retire pas, il se REMPLACE : « $PROG catalogue enable <autre> » ecrit la
  declaration (et y garde « $name » en tete), puis « $PROG catalogue disable $name »."
  fi
  # Le temporaire vit DANS le repertoire cible : `mv` y est un rename atomique garanti par le
  # noyau, alors que depuis /tmp (souvent un autre systeme de fichiers) c'est une copie suivie
  # d'un delete — une interruption au milieu laisse la declaration tronquee.
  local tmp; tmp="$(mktemp "$(dirname "$CAT_ACTIVE")/.catalogues.active.XXXXXX")"

  # -F et pas de motif bricole autour du nom. L'ancienne forme etait
  # `grep -vx "[[:space:]]*$name[[:space:]]*"` et elle portait DEUX defauts : un nom contenant `.`
  # supprimait ses voisins (BRE), et un nom formant un motif INVALIDE faisait sortir grep en 2 —
  # que le `|| true` avalait, laissant `$tmp` vide et `mv` VIDER la declaration entiere. Desactiver
  # un catalogue desactivait tout, en silence.
  #
  # Les trois codes de grep sont donc distingues : 0 = des lignes restent, 1 = plus aucune (legitime
  # quand c'etait la seule), 2 = erreur — et celui-la refuse au lieu d'ecrire.
  local rc=0
  grep -Fxv "$name" "$CAT_ACTIVE" > "$tmp" || rc=$?
  if [[ "$rc" -gt 1 ]]; then
    rm -f "$tmp"
    die "catalogue disable: lecture de $CAT_ACTIVE echouee (grep rc=$rc) — rien n'a ete ecrit"
  fi
  mv "$tmp" "$CAT_ACTIVE"
  echo "catalogue disable: « $name » retire de $CAT_ACTIVE (rien n'est supprime du disque)" >&2
  echo "  « fleet_v2 stop && fleet_v2 start » pour appliquer" >&2
}

cmd_catalogue_remove() {
  local name="${1:?catalogue remove: nom requis}"
  [[ "$name" == "$CAT_BUNDLED" ]] && die "catalogue remove: « $CAT_BUNDLED » vit dans le release — « $PROG catalogue disable $CAT_BUNDLED » pour cesser de l'utiliser"
  cat_is_active "$name" && die "catalogue remove: « $name » est ACTIF — le desactiver d'abord"
  local dir="$CAT_DIR/$name"
  [[ -d "$dir" ]] || die "catalogue remove: « $name » n'est pas dans $CAT_DIR (les catalogues livres sous $CAT_SHIPPED ne se suppriment pas : ils reviennent au prochain update)"
  rm -rf "$dir"
  echo "catalogue remove: $dir supprime" >&2
}

# Trois sources, zero scp : ce qui manque a une boite headless, c'est un transport qu'on ait deja.
# Le nom DECLARE par un catalogue, lu a la racine de son manifeste. Cle de premier niveau, donc
# ancree en colonne 0 : un `name:` indente appartient a autre chose. La charte est la meme que cote
# runtime (kebab, pas de `_`), et un nom qui ne la respecte pas ne sort pas d'ici — le refus detaille
# vient de `catalogue verify`, dont c'est le metier.
cat_declared_name() { # $1=racine -> le nom, ou 1
  local m="$1/catalogue.yaml" n
  [[ -r "$m" ]] || return 1
  n="$(sed -n 's/^name:[[:space:]]*\([a-z0-9][a-z0-9-]*\)[[:space:]]*$/\1/p' "$m" | head -1)"
  [[ -n "$n" ]] || return 1
  printf '%s' "$n"
}

# Le nom vient du CATALOGUE, plus de l'installateur. Il fallait donc deballer avant de savoir ou
# ranger : on deballe dans un staging, on lit le nom, puis on renomme. L'argument [name] survit comme
# une ASSERTION — l'operateur dit ce qu'il croit installer, et on refuse si le catalogue dit autre
# chose — mais il ne baptise plus rien. Avant, sans argument, le nom valait le basename de la
# source : deux boites pouvaient donc heberger le meme catalogue sous deux noms, ce qui ne coutait
# rien tant que le nom etait une poignee locale, et devient faux des qu'il adresse une org de forge.
cmd_catalogue_install() {
  local src="${1:?catalogue install: source requise (depot git, archive tar.gz, ou dossier)}"
  local claimed="${2:-}"
  mkdir -p "$CAT_DIR"
  local staging; staging="$(mktemp -d "$CAT_DIR/.install.XXXXXX")" \
    || die "catalogue install: staging impossible dans $CAT_DIR"

  case "$src" in
    *.git|git@*|*://*.git)
      command -v git >/dev/null || { rm -rf "$staging"; die "catalogue install: git introuvable"; }
      rmdir "$staging"
      git clone --depth 1 "$src" "$staging" >&2 || { rm -rf "$staging"; die "catalogue install: clone echoue"; }
      rm -rf "$staging/.git"
      ;;
    http://*|https://*)
      command -v curl >/dev/null || { rm -rf "$staging"; die "catalogue install: curl introuvable"; }
      command -v tar  >/dev/null || { rm -rf "$staging"; die "catalogue install: tar introuvable"; }
      curl -fsSL "$src" | tar -xz -C "$staging" --strip-components=1 \
        || { rm -rf "$staging"; die "catalogue install: telechargement ou extraction echoue"; }
      ;;
    *)
      [[ -d "$src" ]] || { rm -rf "$staging"; die "catalogue install: « $src » n'est ni un depot git, ni une URL, ni un dossier"; }
      cp -r "$src/." "$staging/"
      ;;
  esac

  local name
  name="$(cat_declared_name "$staging")" || {
    rm -rf "$staging"
    die "catalogue install: la source ne declare pas de « name: » valide dans catalogue.yaml — un catalogue porte son nom, il ne le recoit pas de son dossier"
  }
  [[ -n "$claimed" && "$claimed" != "$name" ]] && { rm -rf "$staging"; die "catalogue install: la source se nomme « $name », pas « $claimed » — c'est le catalogue qui nomme"; }
  [[ "$name" == "$CAT_BUNDLED" ]] && { rm -rf "$staging"; die "catalogue install: « $CAT_BUNDLED » est le nom du catalogue livre dans le release"; }

  local dest="$CAT_DIR/$name"
  [[ -e "$dest" ]] && { rm -rf "$staging"; die "catalogue install: $dest existe deja — « $PROG catalogue remove $name » d'abord"; }
  mv "$staging" "$dest" || { rm -rf "$staging"; die "catalogue install: installation impossible dans $dest"; }

  echo "catalogue install: « $name » installe dans $dest — INACTIF" >&2
  echo "  « $PROG catalogue verify $name » puis « $PROG catalogue enable $name »" >&2
}

# La migration vit au RUNTIME, pas ici : elle a besoin de la forge (transfert) ET des remotes locaux
# (repointage), et ce CLI n'a aucun acces forge — lui en donner un ferait d'une commande locale un
# acteur distant. Meme porte que `catalogue verify` : un `eval` sur la release, verdict au code de
# sortie.
cmd_project_migrate() {
  local repo="${1:?project migrate: depot requis (owner/nom)}"
  local cat="${2:?project migrate: catalogue cible requis}"
  [[ "$repo" == */* ]] || die "project migrate: « $repo » n'est pas un owner/nom"
  local bin="${LCARS_FLEET_BIN:-/local/LCARS_v2/rel/lcars_fleet/bin/lcars_fleet}"
  [[ -x "$bin" ]] || die "project migrate: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"

  # L'ADRESSE de la forge vient de l'environnement de l'OPERATEUR : `~/.lcars/fleet_v2.env` est le
  # fichier qu'il edite, et `bin/fleet_v2` le charge exactement ainsi. Le charger ici ne donne aucun
  # acces forge a ce CLI — il ne fait toujours aucun appel : il TRANSMET sa configuration au release,
  # qui agit. Sans ca la porte echoue sur `{:config, {:missing, :base_url}}` sur une boite ou tout est
  # cable, parce que FORGE_BASE_URL ne vit que dans ce fichier (mesure du 2026-08-11 : `env` du login
  # `lcars` ne porte aucun FORGE_*, et rien ne le source hors fleet_v2).
  #
  # Le fichier porte AUSSI des ports ; `LCARS_TOOL_EVAL=1` neutralise le bloc qui les ouvrirait, donc
  # le charger reste sans effet de bord. C'est la meme frontiere que le garde, prise par l'autre bout.
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"
  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$env_file"
    set +a
  fi

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Project.Onboard.eval_migrate(\"$repo\", \"$cat\")"
}

cmd_project() {
  case "${1:-}" in
    migrate) shift; cmd_project_migrate "$@" ;;
    "")      die "project: sous-commande requise (migrate)" ;;
    *)       die "project: sous-commande inconnue « $1 » (migrate)" ;;
  esac
}

cmd_catalogue() {
  case "${1:-list}" in
    list|ls)  shift; cmd_catalogue_list "$@" ;;
    install)  shift; cmd_catalogue_install "$@" ;;
    verify)   shift; cmd_catalogue_verify "$@" ;;
    enable)   shift; cmd_catalogue_enable "$@" ;;
    disable)  shift; cmd_catalogue_disable "$@" ;;
    remove)   shift; cmd_catalogue_remove "$@" ;;
    *) die "catalogue: sous-commande inconnue '${1}' (list|install|verify|enable|disable|remove)" ;;
  esac
}

# --- dispatch --------------------------------------------------------------

case "${1:-help}" in
  spawn)  shift; cmd_spawn "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  attach) shift; cmd_attach "$@" ;;
  project)
    shift; cmd_project "$@" ;;
  catalogue) shift; cmd_catalogue "$@" ;;
  help|-h|--help) usage ;;
  *) echo "lcars: commande inconnue '${1}'" >&2; echo >&2; usage; exit 1 ;;
esac
