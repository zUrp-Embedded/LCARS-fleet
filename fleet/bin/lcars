#!/usr/bin/env bash
# SOURCE: bin/lcars
# AUTHOR: starfleet
# STARDATE: 2026-06-14
# STATUS: PROTO-V2 — operator CLI for the fleet: spawn / list / attach (LAUNCH-1/2/2b)
#
# Host-side operator tool for driving the LCARS v2 daemon. Three gestures covering the "launch a pod,
# see it, attach to it" loop:
#   - `lcars spawn <role>`     POST /api/admin/spawn (established control path, no-auth loopback). The
#                              spawn is dispatched ASYNC (event admin.spawn.request → spawn_pod), so the
#                              202 means "queued", NOT "pod alive". Confirm with `lcars list`.
#   - `lcars list`             LIVE pods read straight off the substrate (the per-pod tmux socks ARE the
#                              real liveness; fleet_api's /api/pods answers 501 not_implemented, F-C118).
#                              Dependency-free — works even with the API down.
#   - `lcars attach <pod_id>`  attaches the terminal to the pod's tmux session (`tmux -S <sock> attach`).
#                              Ctrl-b d detaches WITHOUT killing the pod.
#
# `attach` requires the operator to have the SAME UID as the daemon (the per-pod sock dirs are `0700`).
# Current model: each human launches THEIR fleet through `bin/fleet_v2` → the BEAM and the pods run under
# THEIR UID → they attach their own pods directly, with no privilege and no special case. (There is no
# `User=lcars` system service any more: the systemd model is gone.) Holds for bwrap pods (sock
# bind-mounted host-side) as well as host pods (LAUNCH-Q).
#
# Config (env):
#   LCARS_API_SOCK        the daemon's control socket (default ~/.lcars/run/api.sock, per-human).
#                         C'est la SEULE voie vers la fleet : le domaine API n'a plus de surface
#                         TCP, donc plus d'URL — `LCARS_API_URL` a ete retiree le 2026-08-14.
#   LCARS_TMUX_SOCK_BASE  base of the per-pod socks (default ~/.lcars/run/tmux-sock; = the Elixir
#                         default, c368f89d)
#   LCARS_TMUX_BIN        tmux binary (default: tmux from the PATH)

set -euo pipefail

# ⚠ `$API_URL` A DISPARU AVEC LA SURFACE QU'ELLE DESIGNAIT (2026-08-14). Ce fichier resolvait une
# URL de lecture depuis `~/.lcars/run/api_url`, et son propre commentaire disait deja que PERSONNE
# NE LA LIT : `spawn` passe par `$API_SOCK`, `list` et `attach` par les socks tmux, et `$API_URL`
# n'apparaissait que dans le texte d'aide. Le domaine API n'a plus de listener TCP du tout, donc
# la resolution ne pointait plus meme sur une possibilite.
#
# La cicatrice qui reste vraie et qu'on garde : ce bloc a ete FATAL tant qu'il gardait cette valeur.
# Il tuait tout le CLI quand la fleet n'avait jamais demarre — y compris `list`, dont l'en-tete
# promet qu'il « marche meme avec l'API down », et `catalogue install|verify`, precisement
# les gestes d'une boite NEUVE. Chaque verbe garde ce dont IL a besoin, la ou il s'en sert.
SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"
# `spawn` (write) goes through the per-human AF_UNIX socket (ControlRouter), off the network the
# pod shares. C'est desormais la SEULE voie vers la fleet depuis ce CLI.
API_SOCK="${LCARS_API_SOCK:-$HOME/.lcars/run/api.sock}"
TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"

PROG="$(basename "$0")"

die() { echo "lcars: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
$PROG — CLI fleet LCARS v2

USAGE
  $PROG spawn <role> [--issue <id>] [--brief <texte>]
      Demande au daemon de lancer un pod du role <role> (= nom de cap-profile,
      ex: architect, engineer, consultant). Dispatch ASYNC : le pod n'est pas
      vivant au retour — « $PROG list » pour le voir. NB : les roles
      boot_at_start (starfleet) montent seuls au boot de la fleet ; spawn sert
      surtout aux roles ponctuels et au test.

  $PROG list
      Liste les pods VIVANTS (socks tmux par-pod) + le statut de leur session tmux.

  $PROG ls
      Alias de « $PROG list ». Le dispatcher accepte les deux depuis toujours ; seul
      l'usage l'ignorait, ce qui en faisait une commande que personne n'instruisait.

  $PROG attach <pod_id>
      Attache ce terminal sur la session tmux du pod (Ctrl-b d rend la main sans
      tuer le pod).

  $PROG catalogue list
      Ce que la FORGE porte : installes, disponibles, et ceux dont la source a bouge.

  $PROG catalogue install <nom>
      Installe — ou MET A JOUR — le catalogue <nom> depuis le depot que la forge porte.
      ADMIN SEULEMENT, et « admin » est un fait de la FORGE (is_admin), pas de l'uid :
      le geste lit le jeton master, ouvert au groupe que le convergeur derive de la forge.

      La source arrive par la FORGE : un humain pousse son catalogue dans son espace
      personnel depuis son disque, et n'importe qui peut le faire. L'installer est un
      autre geste, et c'est celui-la qui est garde. Le NOM vient du manifeste du depot,
      jamais du nom du depot ni de vous.

      Rejouable : rien n'existe -> il cree ; la source a bouge -> il reconverge ; rien
      n'a bouge -> il ne touche rien. JAMAIS declenche par le boot.

  $PROG catalogue verify <nom>
      Joue sur ce catalogue exactement les controles que le boot joue. Code de
      sortie = verdict.


  $PROG project migrate <owner/nom> <catalogue>
      Migre un projet vers un autre catalogue : transfert du depot dans l'org de ce
      catalogue, PUIS repointage de l'origin des trois faces locales. Les deux
      moities, ou rien — un transfert seul laisse un projet qui marche par accident,
      via la redirection 301. REFUSE un catalogue qui n'est pas actif ici.

  $PROG project reconcile [check|apply]
      La forge dit quels projets existent, le disque suit. Sur un /home neuf — boite
      reinstallee, second humain qui arrive sur une fleet deja peuplee — les faces
      locales n'existent pas alors que les projets, eux, sont intacts. « check » ne
      touche rien et liste ce qui manque ; « apply » importe. Un projet en echec
      n'arrete pas les autres.

  $PROG forge add <name> --host github|gitlab --owner <owner> [--dest-host H]
  $PROG forge list
  $PROG forge status
      Le POOL de forges de publication de CET humain (~/.lcars/forges). Une forge =
      forge + compte + repo. L'AUTH n'est pas stockee ici : c'est le CLI officiel de la
      forge (« gh auth login » / « glab auth login »), deja credential helper git.
      GitLab est une forge de plein droit ; --dest-host pour Enterprise / self-hosted.
      « status » = le doctor : chaque forge + si son CLI est authentifie ([ok]/[!!]).

  $PROG approve <owner/nom-interne> --forge <name> --as <repo-dest> [--base main] [--public]
  $PROG approve <owner/nom-interne> [--base main]
      PHASE 1 — le gate manuel dur de la publication. Avec --forge/--as : CREE-OU-LIE le
      projet a une forge du pool et POUSSE le peuplement initial. Tier 1 (gh/glab
      authentifie) : cree le repo s'il n'existe pas (--public sinon prive). Tier 2 (repo
      pre-cree dans l'UI) : le lie tel quel (refuse d'ecraser une base deja remplie).
      Sans --forge : PUSH DIRECT de l'etat courant sur la base deja liee (garde
      deterministe : refuse si la base n'est pas un ancetre du clone reecrit).
      L'attribution est reecrite (author=humain) avant tout push ; l'auth vers la forge
      externe passe par gh/glab ou le helper git cable (aucun token manipule ici). La
      phase 2 (PR/MR reguliere) est le tool « project_publish » cote pod, pas ce verbe.

  $PROG publish status <owner/nom-interne>
      Le doctor par PROJET : est-il pret a publier ? Non lie = etat valide, rapporte
      calme (pas un trou). Lie : la chaine de readiness (CLI authentifie + base peuplee
      cote forge). Chaque manque nomme le geste suivant.

  $PROG help
      Cette aide.

ENV
  LCARS_API_SOCK=$API_SOCK     (la seule voie vers la fleet, socket AF_UNIX host-only)
  LCARS_TMUX_SOCK_BASE=$SOCK_BASE
EOF
}

# --- spawn -----------------------------------------------------------------

# ─── admiral — la SEANCE DE FIX ([BL-6-101]) ──────────────────────────────────────────────────
# Le SEUL chemin vers un pod hors sandbox, et il est un GESTE : le spawn generique refuse tout
# `containment: none` (422) sauf acquittement explicite — c'est CE flag, pose ICI et nulle part
# ailleurs. Aucun chemin automatique (dispatcher, boot, cartes) ne passe par cette porte.
# Le pod tourne sous l'uid du lanceur (un humain de fleet) : le « porteur a lui » de [BL-6-102] —
# GUARD B interdit au siege (uid 1000) d'etre en amont d'un pod, et ca ne change pas ici.
cmd_admiral() {
  [[ $# -eq 0 ]] || die "admiral: aucun argument — c'est une seance, pas un dispatch"

  local body http payload='{"cap_profile_name":"admiral","host_native_ack":true}'
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn"     -H 'Content-Type: application/json' -d "$payload" -w $'\n%{http_code}')"     || die "admiral: le daemon ne repond pas sur $API_SOCK (fleet lancee ?)"
  http="${body##*$'\n'}"; body="${body%$'\n'*}"

  case "$http" in
    202)
      echo "admiral: seance demandee (202 = en file, PAS encore vivant)."
      echo "  suivi :   $PROG list"
      echo "  s'asseoir: $PROG attach <pod_id>   (Ctrl-b d pour partir sans tuer la seance)"
      ;;
    *)
      die "admiral: refuse ($http) — $body"
      ;;
  esac
}

cmd_spawn() {
  local role="" issue="" brief="" have_brief=0
  [[ $# -ge 1 && "$1" != --* ]] || die "spawn: role requis (ex: $PROG spawn architect)"
  role="$1"; shift
  # The role is a cap-profile slug (JSON anti-injection for the jq-less payload path below).
  [[ "$role" =~ ^[a-z][a-z0-9-]*$ ]] || die "spawn: role '$role' invalide (slug [a-z0-9-] attendu)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="${2:?--issue exige une valeur}"; shift 2 ;;
      --brief) brief="${2:?--brief exige une valeur}"; have_brief=1; shift 2 ;;
      *) die "spawn: argument inconnu '$1'" ;;
    esac
  done
  [[ -z "$issue" || "$issue" =~ ^[A-Za-z0-9._-]+$ ]] || die "spawn: --issue '$issue' invalide"

  # JSON payload. The brief field is free text → jq, for correct escaping; otherwise printf (safe slugs).
  local payload
  if [[ "$have_brief" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || die "spawn: --brief exige jq (pour le quoting JSON du texte libre)"
    payload="$(jq -nc --arg r "$role" --arg t "$issue" --arg m "$brief" \
      '{cap_profile_name:$r} + (if $t=="" then {} else {issue_id:$t} end) + {brief:$m}')"
  elif [[ -n "$issue" ]]; then
    payload="$(printf '{"cap_profile_name":"%s","issue_id":"%s"}' "$role" "$issue")"
  else
    payload="$(printf '{"cap_profile_name":"%s"}' "$role")"
  fi

  # Contract: `/api/admin/spawn` accepts only a FLAT allowlisted DTO (`cap_profile_name` + `issue_id` +
  # `brief`) — NO raw `opts`: any key outside the allowlist (including an `opts` supplied by the client)
  # fails the spawn with a 422. The API rebuilds the spawner's internal `opts` itself from `brief`
  # (cf. SpawnAdmission).
  local body http
  # `--unix-socket`: the write door lives on the per-human AF_UNIX socket (ControlRouter), NOT on
  # the TCP loopback - the pod (shared host netns) cannot reach it. The host in the URL is ignored
  # with --unix-socket; we keep a dummy host. curl WITHOUT -f: a 4xx/5xx does not make curl fail
  # (we read the code via -w); only a transport failure (exit != 0) -> `|| die`.
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn" \
            -H 'content-type: application/json' -d "$payload" \
            -w $'\n%{http_code}' 2>/dev/null)" \
    || die "control socket injoignable ($API_SOCK) — fleet_v2 tourne pour cet utilisateur ?"

  http="${body##*$'\n'}"; body="${body%$'\n'*}"
  case "$http" in
    202) echo "spawn $role : mis en file (202). Le pod monte en async — « $PROG list » pour le voir." ;;
    503) die "fleet en drain de shutdown (503) — retente quand la fleet sera repartie" ;;
    # MA-18: the cap-profile is validated BEFORE the ACK. 422 = unknown role (no such cap-profile),
    # 400 = malformed request. No more lying 202 (it used to ACK, then warn silently daemon-side and
    # spawn nothing).
    422) die "spawn KO : cap-profile '$role' inconnu (422) — le nom de role est faux. $body" ;;
    400) die "spawn KO : appel invalide (400). $body" ;;
    *)   die "spawn KO (HTTP $http) : $body" ;;
  esac
}

# --- list ------------------------------------------------------------------

cmd_list() {
  [[ -d "$SOCK_BASE" ]] || { echo "(aucun pod : $SOCK_BASE absent — la fleet tourne ?)"; return 0; }
  shopt -s nullglob
  local socks=("$SOCK_BASE"/*/pod.sock) found=0
  if [[ ${#socks[@]} -eq 0 ]]; then echo "(aucun pod vivant)"; return 0; fi
  printf '%-40s  %s\n' "POD_ID" "TMUX"
  local sock pod_id session status
  for sock in "${socks[@]}"; do
    pod_id="$(basename "$(dirname "$sock")")"
    session="lcars-pod-$pod_id"
    if "$TMUX_BIN" -S "$sock" has-session -t "$session" 2>/dev/null; then
      status="vivant"
    else
      status="sock orphelin (pas de session)"
    fi
    printf '%-40s  %s\n' "$pod_id" "$status"
    found=1
  done
  [[ "$found" -eq 1 ]] || echo "(aucun pod vivant)"
}

# --- attach ----------------------------------------------------------------

cmd_attach() {
  local pod_id="${1:-}"
  [[ -n "$pod_id" ]] || die "attach: pod_id requis (cf. « $PROG list »)"
  # Anti path-traversal: pod_id is ONE path component (sock = $SOCK_BASE/$pod_id/pod.sock). No `/`, no `..`.
  [[ "$pod_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$pod_id" != *..* ]] \
    || die "attach: pod_id '$pod_id' invalide"
  local sock="$SOCK_BASE/$pod_id/pod.sock"
  [[ -S "$sock" ]] || die "attach: pas de sock pour '$pod_id' ($sock) — pod vivant ? (cf. « $PROG list »)"
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "attach: tmux introuvable ($TMUX_BIN)"
  echo "attach $pod_id (Ctrl-b d rend la main sans tuer le pod)…" >&2
  # UI: the wheel scrolls the tmux scrollback (not the shell history). `set -g mouse on` on the pod's
  # own server, right before attaching → covers EVERY pod through RUNTIME tmux config, with no launcher
  # edit. Mouse ON does change selection: hold Shift to copy to the OS clipboard.
  "$TMUX_BIN" -S "$sock" set -g mouse on 2>/dev/null || true
  exec "$TMUX_BIN" -S "$sock" attach -t "lcars-pod-$pod_id"
}

# --- catalogue -------------------------------------------------------------
#
# LES DEUX CHEMINS SONT AUSSI CONNUS D'ELIXIR (`Fleet.Layout` : catalogues_installed_dir/0,
# catalogues_shipped_dir/0). C'est un fait ecrit deux fois, dans deux langages qui ne peuvent pas
# s'appeler — la meme forme que les listes de roles verrouillees par `mix lcars.contracts.check`.
# Un changement ici sans l'autre cote donne une CLI qui lit un cache sur lequel rien ne tourne, et
# c'est en mode degrade (release injoignable) qu'elle l'affiche — le seul moment ou l'operateur n'a
# aucune seconde source pour le recouper.
CAT_DIR="${LCARS_CATALOGUES_DIR:-/home/catalogues}"
CAT_SHIPPED="${LCARS_CATALOGUES_SHIPPED:-/opt/lcars/catalogues}"
# Le nom reserve du catalogue metier livre DANS le release : il n'a pas de dossier installe, donc
# rien ne l'installe et rien ne le supprime — il est la, toujours.
CAT_BUNDLED="fleet"

# Ou vit <nom> : l'operateur d'abord, le livre ensuite — MEME ORDRE que `install_dirs` cote runtime,
# pour qu'un catalogue importe masque un livre du meme nom des deux cotes.
cat_dir_of() {
  local name="$1"
  if [[ -d "$CAT_DIR/$name" ]]; then echo "$CAT_DIR/$name"
  elif [[ -d "$CAT_SHIPPED/$name" ]]; then echo "$CAT_SHIPPED/$name"
  else return 1; fi
}

# La liste porte le CHEMIN de chaque entree, et dit laquelle MASQUE l'autre.
#
# Mesure sur un banc (2026-08-11) : apres `catalogue install` du catalogue `web`, la liste affichait
# « web actif » DEUX FOIS, sans un mot de plus. Ce n'etait pas un doublon d'affichage — `web` existe
# reellement des deux cotes, livre dans l'image et installe par l'operateur — et `cat_dir_of` fait
# gagner l'operateur. Le masquage est une FONCTIONNALITE ; une liste qui montre deux lignes
# identiques la rend indiscernable d'un bug, et l'operateur ne sait pas lequel des deux tourne.
# LA LISTE NE PEUT PAS REPONDRE SEULE, ET ELLE NE FAIT PLUS SEMBLANT.
#
# Elle imprimait « installe » pour tout ce qui avait un dossier — c'est exactement comme ca qu'un
# banc a affiche `web` installe pendant que la forge n'avait jamais porte d'org `web`. « Installe »
# est un fait de FORGE (l'org porte sa source), et `bin/lcars` n'a aucun acces forge, par design :
# donner a une commande locale un acteur distant est precisement ce que cette regle evite.
#
# Elle demande donc au release, par la meme porte `eval` que `catalogue verify`. La porte parle en
# MOTS (`INSTALLED`, `AVAILABLE`, `UPDATABLE`), pas en tableau formate : une colonne ajoutee un jour
# ne doit pas avoir a se mettre d'accord entre deux langages.
# ─── la configuration de la BOITE, chargee une fois pour toutes les portes ────────────────────────
#
# ⚠ L'ADRESSE de la forge vit dans `~/.lcars/fleet_v2.env` et NULLE PART AILLEURS. Mesure du
# 2026-08-11 : l'environ d'un login humain ne porte aucun `FORGE_*`, et rien ne source ce fichier
# hors `fleet_v2`. Une porte qui ne le charge pas rend `{:config, {:missing, :base_url}}` sur une
# boite entierement cablee, sous un message qui accuse la forge — c'est D3 de l'audit independant
# du 2026-08-16, et il avait deja mordu `project migrate` avant `catalogue list`.
#
# CHARGER CE FICHIER NE DONNE AUCUN ACCES FORGE A CE CLI. Il ne fait toujours aucun appel : il
# TRANSMET sa configuration au release, qui agit. Le fichier porte AUSSI des ports d'ecoute ;
# `LCARS_TOOL_EVAL=1`, pose par chaque appelant, neutralise le bloc qui les ouvrirait.
#
# La fonction existe parce que ces lignes etaient recopiees a chaque porte, avec leur commentaire :
# trois copies d'un contrat qui n'a qu'une source, dont deux avaient deja diverge d'un `2>/dev/null`.
_load_box_env() {
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"
  [[ -f "$env_file" ]] || return 0
  set -a
  # shellcheck disable=SC1090
  . "$env_file"
  set +a
}

# Le binaire de release — un seul defaut, pose ici. L'appelant decide ce qu'il fait de son absence :
# `catalogue list` la rend en 127 pour la dire, les autres portes meurent dessus.
_release_bin() { printf '%s\n' "${LCARS_FLEET_BIN:-/local/LCARS_v2/rel/lcars_fleet/bin/lcars_fleet}"; }

cat_states() {
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || return 127
  _load_box_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Application.CatalogueLifecycle.eval_main()"
}

cmd_catalogue_list() {
  # ⚠ `out="$(...)"; rc=$?` NE MARCHE PAS SOUS `set -e` : une substitution de commande qui echoue
  # dans une affectation tue le script AVANT la ligne suivante — donc `rc` n'etait jamais lu et
  # aucun des refus ci-dessous n'etait atteint. Le `||` fait de l'affectation une condition, ce qui
  # est exactement l'exception que `set -e` prevoit.
  local out rc=0
  out="$(cat_states 2>&1)" || rc=$?

  case "$rc" in
    0)
      printf '  %-16s %-11s %s\n' "CATALOGUE" "ETAT" "DEPOT"
      while read -r state name src; do
        case "$state" in
          INSTALLED) printf '  %-16s %-11s %s\n' "$name" "installe" "$src" ;;
          UPDATABLE) printf '  %-16s %-11s %s\n' "$name" "MAJ DISPO" "$src  → « $PROG catalogue install $name » met a jour" ;;
          AVAILABLE) printf '  %-16s %-11s %s\n' "$name" "disponible" "$src  → « $PROG catalogue install $name » (admin forge)" ;;
        esac
      done <<< "$out"
      ;;
    3)
      # Le doublon : on NE CHOISIT PAS. Les deux proprietaires sont nommes, et c'est a eux de
      # trancher — devenir arbitre ici, ce serait rendre une reponse a celui qui perd sans qu'il
      # puisse savoir pourquoi.
      echo "catalogue list: DEUX depots declarent le meme catalogue — refus." >&2
      printf '%s\n' "$out" | sed 's/^DUPLICATE /  /' >&2
      echo "  Aucun des deux n'est choisi. Supprimez-en un (ou renommez-le dans son manifeste)." >&2
      return 3
      ;;
    127)
      # SANS RELEASE ON DIT QU'ON NE SAIT PAS. Deviner rendrait le mensonge qu'on vient de retirer,
      # a l'endroit qu'un operateur lit en premier.
      echo "catalogue list: pas de release joignable (LCARS_FLEET_BIN) — l'etat des catalogues est" >&2
      echo "  un fait de FORGE, et cette commande n'y a pas acces. Le materiel present ici :" >&2
      [[ -d "$CAT_DIR" ]] && find "$CAT_DIR" -mindepth 1 -maxdepth 1 -type d -printf '    %f  (installe)\n' 2>/dev/null | sort >&2
      [[ -d "$CAT_SHIPPED" ]] && find "$CAT_SHIPPED" -mindepth 1 -maxdepth 1 -type d -printf '    %f  (graine de l image)\n' 2>/dev/null | sort >&2
      echo "    $CAT_BUNDLED  (dans le release)" >&2
      return 127
      ;;
    *)
      echo "catalogue list: la forge n'a pas repondu — rien n'est conclu." >&2
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      return "$rc"
      ;;
  esac
}

# Le binaire de release joue les memes controles que le boot. Dans la boite il est a l'install ;
# hors boite il n'existe pas, et on le DIT au lieu de deviner une commande de repli.
cat_verify_root() {
  local root="$1"
  local bin="${LCARS_FLEET_BIN:-/local/LCARS_v2/rel/lcars_fleet/bin/lcars_fleet}"
  [[ -x "$bin" ]] || die "catalogue verify: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN, ou lancer « mix lcars.catalogue.verify $root » depuis le depot"
  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Application.CatalogueVerify.eval_main(\"$root\")"
}

cmd_catalogue_verify() {
  local name="${1:?catalogue verify: nom requis}"
  [[ "$name" == "$CAT_BUNDLED" ]] && die "catalogue verify: « $CAT_BUNDLED » est le catalogue livre dans le release — le boot le verifie a chaque demarrage"
  local root; root="$(cat_dir_of "$name")" || die "catalogue verify: « $name » n'est installe nulle part (cf. « $PROG catalogue list »)"
  cat_verify_root "$root"
}

# Trois sources, zero scp : ce qui manque a une boite headless, c'est un transport qu'on ait deja.
# Le nom DECLARE par un catalogue, lu a la racine de son manifeste. Cle de premier niveau, donc
# ancree en colonne 0 : un `name:` indente appartient a autre chose. La charte est la meme que cote
# runtime (kebab, pas de `_`), et un nom qui ne la respecte pas ne sort pas d'ici — le refus detaille
# vient de `catalogue verify`, dont c'est le metier.
cat_declared_name() { # $1=racine -> le nom, ou 1
  local m="$1/catalogue.yaml" n
  [[ -r "$m" ]] || return 1
  n="$(sed -n 's/^name:[[:space:]]*\([a-z0-9][a-z0-9-]*\)[[:space:]]*$/\1/p' "$m" | head -1)"
  [[ -n "$n" ]] || return 1
  printf '%s' "$n"
}

# Le nom vient du CATALOGUE, plus de l'installateur. Il fallait donc deballer avant de savoir ou
# ranger : on deballe dans un staging, on lit le nom, puis on renomme. L'argument [name] survit comme
# une ASSERTION — l'operateur dit ce qu'il croit installer, et on refuse si le catalogue dit autre
# chose — mais il ne baptise plus rien. Avant, sans argument, le nom valait le basename de la
# source : deux boites pouvaient donc heberger le meme catalogue sous deux noms, ce qui ne coutait
# rien tant que le nom etait une poignee locale, et devient faux des qu'il adresse une org de forge.
# ⚖ UN SEUL VERBE (user, 2026-08-16), et il MET A JOUR quand le catalogue est deja la. Il ne copie
# plus de materiel localement : la source arrive par la FORGE — un humain pousse son catalogue dans
# son espace personnel, un admin l'installe. Le materiel local devient un cache derive.
#
# LE GATE EST LA CAPACITE, PAS UN DRAPEAU. Installer exige de lire le jeton master
# (`0640 root:lcars-admin`) et d'ecrire l'etat de tofu : un non-admin est refuse par le systeme de
# fichiers, jamais par un booleen qu'on pourrait oublier de poser. Cette commande NE LE CONTOURNE
# PAS — elle NOMME ce qui manque au lieu d'echouer sur une permission qui n'apprend rien.
#
# ⚖ 2026-08-17 : le groupe porte `is_admin` DE LA FORGE, projete par le convergeur d'humains. Le
# gate ne change pas de nature, il change de GRANTEUR — la forge au lieu de `uid 0`, que personne
# n'a ni n'aura.
cmd_catalogue_install() {
  local name="${1:?catalogue install: nom requis (cf. « $PROG catalogue list »)}"
  local gestures="${LCARS_FORGE_GESTURES:-/opt/lcars/forge-gestures.sh}"

  [[ "$name" == "$CAT_BUNDLED" ]] \
    && die "catalogue install: « $CAT_BUNDLED » est livre DANS le release — il n'y a pas de depot d'ou l'installer, et rien a mettre a jour"

  [[ -x "$gestures" ]] \
    || die "catalogue install: gestes forge introuvables ($gestures) — cette commande ne s'execute que DANS la boite"

  # ⚖ ARBITRAGE USER (2026-08-17) : « ADMIN » EST UN FAIT DE FORGE, PAS `uid 0`.
  # Ce test etait `[[ "$(id -u)" -ne 0 ]]`, et il gatait sur une propriete qu'AUCUN humain n'a ni
  # n'aura : le seul root de la boite est `admiral`, compte d'administration SYSTEME, dont le
  # metier est d'installer des paquets et non des catalogues. Le deck, lui, tenait deja le bon
  # modele — il lit `is_admin` sur la forge a chaque connexion. Les deux portes disent desormais la
  # meme chose.
  #
  # LE GATE RESTE LA CAPACITE, PAS UN BOOLEEN : c'est la lecture du jeton master
  # (`0640 root:lcars-admin`) qui autorise, et l'appartenance au groupe vient de `is_admin` par le
  # convergeur d'humains. Tester ici ne fait qu'expliquer un refus que le systeme de fichiers
  # prononcerait de toute facon — un test oublie ne donnerait donc rien a personne.
  local master="${LCARS_MASTER_TOKEN_FILE:-/home/private/forge-master.token}"
  if [[ ! -r "$master" ]]; then
    if [[ ! -e "$master" ]]; then
      die "catalogue install: cette boite n'a AUCUNE autorite de creation ($master absent).
  Un admin la pose une fois : « FORGE_ADMIN_TOKEN=<jeton site-admin> ./docker.sh config »."
    fi
    die "catalogue install: ton compte n'administre pas ce runtime.
  « admin » est un fait de la FORGE : ton compte y porte is_admin, ou il ne le porte pas. Un
  proprietaire de la forge te promeut, et le convergeur t'ouvre la porte au tour suivant (30 s) —
  effectif a ta prochaine session. Ce n'est PAS une histoire de sudo : personne n'est root ici."
  fi

  "$gestures" install "$name"
}

cmd_project_migrate() {
  local repo="${1:?project migrate: depot requis (owner/nom)}"
  local cat="${2:?project migrate: catalogue forge requis}"
  [[ "$repo" == */* ]] || die "project migrate: « $repo » n'est pas un owner/nom"
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "project migrate: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"
  _load_box_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Project.Onboard.eval_migrate(\"$repo\", \"$cat\")"
}

# LA FORGE SAIT QUELS PROJETS EXISTENT, LE DISQUE NE LE SAIT PLUS. Un `/home` neuf — boite
# reinstallee, second humain qui arrive sur une fleet deja peuplee — n'a aucune face : l'inventaire
# n'existe que sur la forge, et rien ne l'y lisait. Cette porte relaie ; l'import lui-meme est le
# rail qui existe deja (`import/2`, idempotent), aucun verbe n'est ajoute.
#
# `check` ne touche rien et dit ce qui manque ; `apply` importe. Un projet en echec n'arrete pas les
# autres — une boite a laquelle il manque neuf projets sur dix doit en recuperer neuf, pas zero.
cmd_project_reconcile() {
  local mode="${1:-check}"
  case "$mode" in
    check|apply) ;;
    *) die "project reconcile: mode inconnu « $mode » (check|apply)" ;;
  esac
  local bin; bin="$(_release_bin)"
  [[ -x "$bin" ]] || die "project reconcile: binaire de release introuvable ($bin) — poser LCARS_FLEET_BIN"
  _load_box_env

  HOME="${HOME}" RELEASE_TMP="${RELEASE_TMP:-/tmp}" LCARS_TOOL_EVAL=1 \
    "$bin" eval "Fleet.Project.Onboard.eval_reconcile(:$mode)"
}

cmd_project() {
  case "${1:-}" in
    migrate)   shift; cmd_project_migrate "$@" ;;
    reconcile) shift; cmd_project_reconcile "$@" ;;
    "")        die "project: sous-commande requise (migrate|reconcile)" ;;
    *)         die "project: sous-commande inconnue « $1 » (migrate|reconcile)" ;;
  esac
}

cmd_catalogue() {
  case "${1:-list}" in
    list|ls)  shift; cmd_catalogue_list "$@" ;;
    install)  shift; cmd_catalogue_install "$@" ;;
    verify)   shift; cmd_catalogue_verify "$@" ;;
    *) die "catalogue: sous-commande inconnue '${1}' (list|install|verify)" ;;
  esac
}

# --- publish forges (pool) + approve (phase-1 gate) -----------------------
# PER-HUMAN, under ~/.lcars (Layout.state_dir = the human's own runtime state). NOT /home/private —
# that is the SHARED forge worker-token store (root:fleet, keyed by role). Each human's fleet reads
# its own ~/.lcars, so "each user their pool" holds by construction. Tokens are the human's own files
# (mode 600), read host-side by this CLI (it runs as the human), and NEVER enter a pod.
FORGES_DIR="$HOME/.lcars/forges"
PUBLISH_DIR="$HOME/.lcars/publish"

# Plain destination URL — no token, ever: auth is the CLI credential helper (gh/glab), not ours.
_dest_url() { printf 'https://%s/%s.git' "$1" "$2"; }  # dest_host repo

# The official CLI of a host — the Tier-1 credential helper AND repo-creator. OPTIONAL: absent, approve
# falls to Tier 2 (link a pre-created repo, push via the operator's own wired helper). gh<->glab are
# 1:1. We NEVER read or pass a token: auth is `gh/glab auth login` or the operator's helper, never ours.
_dest_cli() { case "$1" in github) echo gh ;; gitlab) echo glab ;; *) die "host inconnu: $1 (github|gitlab)" ;; esac; }
_json_field() { python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$1" "$2"; }

# Tier-1 repo bootstrap via the CLI's own API — the create right comes WITH `gh/glab auth login`, no
# expensive scope to grant by hand. _dest_repo_exists probes; _dest_repo_create makes it under the login.
_dest_repo_exists() { case "$1" in gh) gh repo view "$2" ;; glab) glab repo view "$2" ;; esac >/dev/null 2>&1; }
_dest_repo_create() {  # cli repo visibility(public|private)
  case "$1" in
    gh)   gh   repo create "$2" "--$3" ;;
    glab) glab repo create "$2" "--$3" ;;
  esac
}

cmd_forge() {
  case "${1:-}" in
    add)      shift; cmd_forge_add "$@" ;;
    list|ls)  shift; cmd_forge_list "$@" ;;
    status)   shift; cmd_forge_status "$@" ;;
    "")       die "forge: sous-commande requise (add|list|status)" ;;
    *)        die "forge: sous-commande inconnue « $1 » (add|list|status)" ;;
  esac
}

cmd_forge_add() {
  local name="" host="" owner="" dest_host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --owner) owner="$2"; shift 2 ;;
      --dest-host) dest_host="$2"; shift 2 ;;
      -*) die "forge add: option inconnue $1" ;;
      *) if [[ -z "$name" ]]; then name="$1"; shift; else die "forge add: argument en trop « $1 »"; fi ;;
    esac
  done
  [[ -n "$name" && -n "$host" && -n "$owner" ]] || \
    die "forge add: usage — forge add <name> --host github|gitlab --owner <owner> [--dest-host H]"
  case "$host" in
    github) [[ -n "$dest_host" ]] || dest_host="github.com" ;;
    gitlab) [[ -n "$dest_host" ]] || dest_host="gitlab.com" ;;
    *) die "forge add: --host inconnu « $host » (github|gitlab)" ;;
  esac
  # No token here: auth is `$(_dest_cli "$host") auth login`, the CLI's own credential store.
  # `name` becomes a path component — refuse traversal (self-harm, but the slug guard has it too).
  [[ "$name" != */* && "$name" != .* ]] || die "forge add: nom invalide « $name » (pas de '/' ni de '.' en tete)"
  mkdir -p "$FORGES_DIR"; chmod 700 "$FORGES_DIR"
  local out="$FORGES_DIR/$name.json"
  python3 -c 'import json,sys;json.dump({"host":sys.argv[2],"dest_host":sys.argv[3],"owner":sys.argv[4]},open(sys.argv[1],"w"),indent=2)' \
    "$out" "$host" "$dest_host" "$owner"
  chmod 600 "$out"
  echo "forge « $name » enregistree ($host $owner @ $dest_host). Auth: $(_dest_cli "$host") auth login."
}

cmd_forge_list() {
  local f found=0
  if [[ -d "$FORGES_DIR" ]]; then
    for f in "$FORGES_DIR"/*.json; do
      [[ -e "$f" ]] || continue
      found=1
      python3 -c 'import json,os,sys;d=json.load(open(sys.argv[1]));print("  %-16s %-7s %s/%s" % (os.path.basename(sys.argv[1])[:-5],d.get("host"),d.get("dest_host"),d.get("owner")))' "$f"
    done
  fi
  [[ "$found" == 1 ]] || echo "aucune forge (pool vide) — lcars forge add <name> ..."
}

# Forge-level doctor: each forge in the pool + whether its official CLI is authenticated (reaches the
# CLI, not the network). [ok] = ready ; [!!] = the operator's next gesture, named.
cmd_forge_status() {
  local f found=0
  if [[ -d "$FORGES_DIR" ]]; then
    for f in "$FORGES_DIR"/*.json; do
      [[ -e "$f" ]] || continue
      found=1
      local name host owner dest_host cli
      name="$(basename "$f" .json)"
      host="$(_json_field "$f" host)"
      owner="$(_json_field "$f" owner)"
      dest_host="$(_json_field "$f" dest_host)"
      cli="$(_dest_cli "$host")"
      if command -v "$cli" >/dev/null 2>&1 && "$cli" auth status >/dev/null 2>&1; then
        echo "  [ok] $name  ($host $owner @ $dest_host) — $cli authentifie"
      else
        echo "  [!!] $name  ($host $owner @ $dest_host) — $cli non authentifie : « $cli auth login »"
      fi
    done
  fi
  [[ "$found" == 1 ]] || echo "aucune forge (pool vide) — lcars forge add <name> ..."
}

cmd_publish() {
  case "${1:-}" in
    status) shift; cmd_publish_status "$@" ;;
    "")     die "publish: sous-commande requise (status)" ;;
    *)      die "publish: sous-commande inconnue « $1 » (status)" ;;
  esac
}

# Project-level doctor: is THIS project ready to publish ? A non-linked project is a VALID terminal
# state (most never publish), so it is reported CALM — never a red hole. Only a linked project runs
# the readiness chain (CLI auth + base populated). The base check reaches the external forge.
cmd_publish_status() {
  local repo="${1:-}"
  [[ -n "$repo" ]] || die "publish status: usage — publish status <owner/nom-interne>"
  [[ "$repo" == */* ]] || die "publish status: « $repo » n'est pas un owner/nom (repo interne)"
  local slug="${repo//\//__}"
  local binding="$PUBLISH_DIR/$slug.json"
  if [[ ! -r "$binding" ]]; then
    echo "publish « $repo » : non lie (option) — aucun endpoint de publish configure."
    echo "  Pour publier un jour : lcars approve $repo --forge <name> --as <repo-dest>"
    return 0
  fi
  local host dest_host dest_repo base cli
  host="$(_json_field "$binding" host)"
  dest_host="$(_json_field "$binding" dest_host)"
  dest_repo="$(_json_field "$binding" dest_repo)"
  base="$(_json_field "$binding" base)"
  cli="$(_dest_cli "$host")"
  echo "publish « $repo » : lie a $dest_host/$dest_repo (base $base)"
  if command -v "$cli" >/dev/null 2>&1 && "$cli" auth status >/dev/null 2>&1; then
    echo "  [ok] $cli authentifie"
  else
    echo "  [!!] $cli non authentifie — « $cli auth login » (ou cable un helper git)"
  fi
  export GIT_TERMINAL_PROMPT=0
  local dest_url; dest_url="$(_dest_url "$dest_host" "$dest_repo")"
  if git ls-remote --exit-code "$dest_url" "refs/heads/$base" >/dev/null 2>&1; then
    echo "  [ok] base « $base » peuplee cote $dest_host (phase 1 faite)"
  else
    echo "  [!!] base « $base » absente/injoignable cote $dest_host — « lcars approve $repo » (phase 1)"
  fi
}

cmd_approve() {
  local repo="" forge="" as="" base="main" visibility="private"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --forge) forge="$2"; shift 2 ;;
      --as) as="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --public) visibility="public"; shift ;;
      --private) visibility="private"; shift ;;
      -*) die "approve: option inconnue $1" ;;
      *) if [[ -z "$repo" ]]; then repo="$1"; shift; else die "approve: argument en trop « $1 »"; fi ;;
    esac
  done
  [[ -n "$repo" ]] || die "approve: usage — approve <owner/nom-interne> [--forge <name> --as <repo-dest>] [--base main] [--public]"
  [[ "$repo" == */* ]] || die "approve: « $repo » n'est pas un owner/nom (repo interne)"
  # Org-qualified binding key (owner__name), NOT the name alone: two projects with the same name in
  # two orgs must not collide on one binding. MUST match ProjectPublish.binding_key/1 (`owner/name`
  # -> `owner__name`), or the host write and the worker read miss each other.
  local slug="${repo//\//__}"
  local binding="$PUBLISH_DIR/$slug.json"

  # Resolve WHAT/WHERE first (mode + destination), so mode errors fire without any forge config.
  local host dest_host dest_repo link_mode
  if [[ -n "$forge" ]]; then
    link_mode=1
    local tfile="$FORGES_DIR/$forge.json"
    [[ -r "$tfile" ]] || die "approve: forge « $forge » absente du pool (lcars forge list)"
    [[ -n "$as" ]] || die "approve: --forge exige --as <nom-du-repo-destination>"
    host="$(_json_field "$tfile" host)"
    dest_host="$(_json_field "$tfile" dest_host)"
    dest_repo="$(_json_field "$tfile" owner)/$as"
  else
    link_mode=0
    [[ -r "$binding" ]] || die "approve: « $slug » pas encore lie — « approve $repo --forge <name> --as <repo> » d'abord"
    host="$(_json_field "$binding" host)"
    dest_host="$(_json_field "$binding" dest_host)"
    dest_repo="$(_json_field "$binding" dest_repo)"
    base="$(_json_field "$binding" base)"
  fi

  # The CLI (gh/glab) is OPTIONAL — it is only NEEDED to CREATE a repo that does not exist yet (Tier 1).
  # Linking an existing repo + pushing only need a wired git credential helper (Tier 2: the operator's
  # own creds — the homelab-GitLab case). We detect it here; we never hold a token. GIT_TERMINAL_PROMPT=0
  # so a missing helper fails LOUD at push instead of hanging on a prompt (a headless BEAM can't answer).
  local cli; cli="$(_dest_cli "$host")"
  local have_cli=0
  if command -v "$cli" >/dev/null 2>&1 && "$cli" auth status >/dev/null 2>&1; then have_cli=1; fi
  export GIT_TERMINAL_PROMPT=0

  # Internal forge config — one source, loaded by the one function that knows it (`_load_box_env`).
  # This door is the only one that CONSUMES the values itself instead of passing them to the release,
  # so it is also the only one that refuses on their absence.
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"
  _load_box_env
  [[ -n "${FORGE_BASE_URL:-}" ]] || die "approve: FORGE_BASE_URL absent ($env_file) — boite non configuree"
  [[ -n "${FORGE_TOKEN_FILE:-}" && -r "${FORGE_TOKEN_FILE}" ]] || die "approve: FORGE_TOKEN_FILE absent/illisible ($env_file)"

  local dest_url; dest_url="$(_dest_url "$dest_host" "$dest_repo")"
  mkdir -p "$PUBLISH_DIR"; chmod 700 "$PUBLISH_DIR"

  # Scratch clone, removed on ANY exit (die exits → EXIT trap fires; the CLI runs one verb then ends,
  # so a single EXIT trap is safe). mktemp -d is 0700; no external secret ever lands in it.
  local work_base; work_base="$(mktemp -d)"
  trap 'rm -rf "$work_base"' EXIT
  local work="$work_base/clone"

  # Certified-clean clone (author rewrite + internal-attribution scan). Its exit propagates.
  "$(dirname "$(readlink -f "$0")")/publish-to-github.sh" \
    --repo "$repo" --forge "$FORGE_BASE_URL" --token-file "$FORGE_TOKEN_FILE" --out "$work" \
    || die "approve: production du clone certifie echouee (voir ci-dessus)"
  cd "$work"

  # git push/fetch/ls-remote to the dest carry no token — the wired helper supplies the credential.
  if [[ "$link_mode" == 1 ]]; then
    # CREATE-OR-LINK. Does the destination repo exist at all? Probe via the CLI when we have it
    # (accurate), else via a bare ls-remote (Tier 2: the operator pre-created it, so it answers).
    local repo_exists=0
    if [[ "$have_cli" == 1 ]]; then
      _dest_repo_exists "$cli" "$dest_repo" && repo_exists=1
    else
      git ls-remote "$dest_url" >/dev/null 2>&1 && repo_exists=1
    fi
    if [[ "$repo_exists" == 0 ]]; then
      # Tier 1: auto-create under the login (free — no create-scope to grant by hand). Without the CLI
      # we cannot create: tell the operator his two ways forward rather than push into the void.
      [[ "$have_cli" == 1 ]] || die "approve: $dest_host/$dest_repo n'existe pas et $cli n'est pas authentifie.
  Tier 1 : '$cli auth login' pour l'auto-creation.  Tier 2 : cree le repo vide dans l'UI web puis relance."
      _dest_repo_create "$cli" "$dest_repo" "$visibility" \
        || die "approve: creation de $dest_host/$dest_repo echouee ($cli repo create)"
      echo "approve: $dest_host/$dest_repo cree ($visibility) sous ton login $cli."
    fi
    # LINK: never clobber a base the human populated by hand (a repo pre-created WITH content, Tier 2).
    if git ls-remote --exit-code "$dest_url" "refs/heads/$base" >/dev/null 2>&1; then
      die "approve: $dest_host/$dest_repo a deja « $base » — refuse d'ecraser. Vide-la ou choisis un autre repo."
    fi
    git push -q "$dest_url" "HEAD:refs/heads/$base" \
      || die "approve: echec du peuplement initial vers $dest_host/$dest_repo"
    python3 -c 'import json,sys;json.dump({"host":sys.argv[2],"dest_host":sys.argv[3],"dest_repo":sys.argv[4],"base":sys.argv[5]},open(sys.argv[1],"w"),indent=2)' \
      "$binding" "$host" "$dest_host" "$dest_repo" "$base"
    chmod 600 "$binding"
    echo "approve: « $slug » lie a $dest_host/$dest_repo et peuple ($base)."
  else
    # DIRECT push to an existing base: determinism gate (base must be an ancestor of the fresh clone).
    git fetch -q "$dest_url" "$base" \
      || die "approve: lecture de $base sur $dest_host/$dest_repo impossible"
    if [[ "$(git rev-parse HEAD)" == "$(git rev-parse FETCH_HEAD)" ]]; then
      echo "approve: rien a pousser — $dest_host/$dest_repo $base deja a jour."
    elif ! git merge-base --is-ancestor FETCH_HEAD HEAD; then
      die "approve: $base n'est PAS un ancetre du clone reecrit (reecriture non deterministe ou divergence) — rien pousse."
    else
      git push -q "$dest_url" "HEAD:refs/heads/$base" \
        || die "approve: echec du push direct vers $dest_host/$dest_repo"
      echo "approve: « $slug » pousse en direct vers $dest_host/$dest_repo $base."
    fi
  fi
}

# --- dispatch --------------------------------------------------------------

case "${1:-help}" in
  spawn)  shift; cmd_spawn "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  attach) shift; cmd_attach "$@" ;;
  project)
    shift; cmd_project "$@" ;;
  catalogue) shift; cmd_catalogue "$@" ;;
  forge) shift; cmd_forge "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  approve) shift; cmd_approve "$@" ;;
  admiral) shift; cmd_admiral "$@" ;;
  help|-h|--help) usage ;;
  *) echo "lcars: commande inconnue '${1}'" >&2; echo >&2; usage; exit 1 ;;
esac
