#!/usr/bin/env bash
# SOURCE: bin/lcars
# AUTHOR: starfleet
# STARDATE: 2026-06-14
# STATUS: PROTO-V2 — operator CLI for the fleet: spawn / list / attach (LAUNCH-1/2/2b)
#
# Host-side operator tool for driving the LCARS v2 daemon. Three gestures covering the "launch a pod,
# see it, attach to it" loop:
#   - `lcars spawn <role>`     POST /api/admin/spawn (established control path, no-auth loopback). The
#                              spawn is dispatched ASYNC (event admin.spawn.request → spawn_pod), so the
#                              202 means "queued", NOT "pod alive". Confirm with `lcars list`.
#   - `lcars list`             LIVE pods read straight off the substrate (the per-pod tmux socks ARE the
#                              real liveness; fleet_api's /api/pods answers 501 not_implemented, F-C118).
#                              Dependency-free — works even with the API down.
#   - `lcars attach <pod_id>`  attaches the terminal to the pod's tmux session (`tmux -S <sock> attach`).
#                              Ctrl-b d detaches WITHOUT killing the pod.
#
# `attach` requires the operator to have the SAME UID as the daemon (the per-pod sock dirs are `0700`).
# Current model: each human launches THEIR fleet through `bin/fleet_v2` → the BEAM and the pods run under
# THEIR UID → they attach their own pods directly, with no privilege and no special case. (There is no
# `User=lcars` system service any more: the systemd model is gone.) Holds for bwrap pods (sock
# bind-mounted host-side) as well as host pods (LAUNCH-Q).
#
# Config (env):
#   LCARS_API_URL         the daemon's REST base (default: read from ~/.lcars/run/api_url, written by
#                         fleet_v2 at start — the ports are per-human/UID, so no static default can be
#                         right; fleet not started → a clear error, never a guessed port)
#   LCARS_TMUX_SOCK_BASE  base of the per-pod socks (default ~/.lcars/run/tmux-sock; = the Elixir
#                         default, c368f89d)
#   LCARS_TMUX_BIN        tmux binary (default: tmux from the PATH)

set -euo pipefail

# A7: explicit env > runtime state written by fleet_v2 > fail-loud (never a guessed port).
if [[ -n "${LCARS_API_URL:-}" ]]; then
  API_URL="$LCARS_API_URL"
elif [[ -r "$HOME/.lcars/run/api_url" ]]; then
  API_URL="$(cat "$HOME/.lcars/run/api_url")"
else
  echo "lcars: LCARS_API_URL absent et ~/.lcars/run/api_url introuvable — la fleet tourne-t-elle (fleet_v2 start) ?" >&2
  exit 1
fi
SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"
# `spawn` (write) goes through the per-human AF_UNIX socket (ControlRouter), off the network the
# pod shares. Reads stay on $API_URL (TCP loopback).
API_SOCK="${LCARS_API_SOCK:-$HOME/.lcars/run/api.sock}"
TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"

PROG="$(basename "$0")"

die() { echo "lcars: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
$PROG — CLI fleet LCARS v2

USAGE
  $PROG spawn <role> [--issue <id>] [--brief <texte>]
      Demande au daemon de lancer un pod du role <role> (= nom de cap-profile,
      ex: architect, engineer, consultant). Dispatch ASYNC : le pod n'est pas
      vivant au retour — « $PROG list » pour le voir. NB : les roles
      boot_at_start (starfleet) montent seuls au boot de la fleet ; spawn sert
      surtout aux roles ponctuels et au test.

  $PROG list        (alias : $PROG ls)
      Liste les pods VIVANTS (socks tmux par-pod) + le statut de leur session tmux.

  $PROG attach <pod_id>
      Attache ce terminal sur la session tmux du pod (Ctrl-b d rend la main sans
      tuer le pod).

  $PROG help
      Cette aide.

ENV
  LCARS_API_URL=$API_URL       (lectures REST, TCP loopback)
  LCARS_API_SOCK=$API_SOCK     (spawn, socket AF_UNIX host-only)
  LCARS_TMUX_SOCK_BASE=$SOCK_BASE
EOF
}

# --- spawn -----------------------------------------------------------------

cmd_spawn() {
  local role="" issue="" brief="" have_brief=0
  [[ $# -ge 1 && "$1" != --* ]] || die "spawn: role requis (ex: $PROG spawn architect)"
  role="$1"; shift
  # The role is a cap-profile slug (JSON anti-injection for the jq-less payload path below).
  [[ "$role" =~ ^[a-z][a-z0-9-]*$ ]] || die "spawn: role '$role' invalide (slug [a-z0-9-] attendu)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="${2:?--issue exige une valeur}"; shift 2 ;;
      --brief) brief="${2:?--brief exige une valeur}"; have_brief=1; shift 2 ;;
      *) die "spawn: argument inconnu '$1'" ;;
    esac
  done
  [[ -z "$issue" || "$issue" =~ ^[A-Za-z0-9._-]+$ ]] || die "spawn: --issue '$issue' invalide"

  # JSON payload. The brief field is free text → jq, for correct escaping; otherwise printf (safe slugs).
  local payload
  if [[ "$have_brief" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || die "spawn: --brief exige jq (pour le quoting JSON du texte libre)"
    payload="$(jq -nc --arg r "$role" --arg t "$issue" --arg m "$brief" \
      '{cap_profile_name:$r} + (if $t=="" then {} else {issue_id:$t} end) + {brief:$m}')"
  elif [[ -n "$issue" ]]; then
    payload="$(printf '{"cap_profile_name":"%s","issue_id":"%s"}' "$role" "$issue")"
  else
    payload="$(printf '{"cap_profile_name":"%s"}' "$role")"
  fi

  # Contract: `/api/admin/spawn` accepts only a FLAT allowlisted DTO (`cap_profile_name` + `issue_id` +
  # `brief`) — NO raw `opts`: any key outside the allowlist (including an `opts` supplied by the client)
  # fails the spawn with a 422. The API rebuilds the spawner's internal `opts` itself from `brief`
  # (cf. SpawnAdmission).
  local body http
  # `--unix-socket`: the write door lives on the per-human AF_UNIX socket (ControlRouter), NOT on
  # the TCP loopback - the pod (shared host netns) cannot reach it. The host in the URL is ignored
  # with --unix-socket; we keep a dummy host. curl WITHOUT -f: a 4xx/5xx does not make curl fail
  # (we read the code via -w); only a transport failure (exit != 0) -> `|| die`.
  body="$(curl -sS -m 10 --unix-socket "$API_SOCK" -X POST "http://localhost/api/admin/spawn" \
            -H 'content-type: application/json' -d "$payload" \
            -w $'\n%{http_code}' 2>/dev/null)" \
    || die "control socket injoignable ($API_SOCK) — fleet_v2 tourne pour cet utilisateur ?"

  http="${body##*$'\n'}"; body="${body%$'\n'*}"
  case "$http" in
    202) echo "spawn $role : mis en file (202). Le pod monte en async — « $PROG list » pour le voir." ;;
    503) die "fleet en drain de shutdown (503) — retente quand la fleet sera repartie" ;;
    # MA-18: the cap-profile is validated BEFORE the ACK. 422 = unknown role (no such cap-profile),
    # 400 = malformed request. No more lying 202 (it used to ACK, then warn silently daemon-side and
    # spawn nothing).
    422) die "spawn KO : cap-profile '$role' inconnu (422) — le nom de role est faux. $body" ;;
    400) die "spawn KO : appel invalide (400). $body" ;;
    *)   die "spawn KO (HTTP $http) : $body" ;;
  esac
}

# --- list ------------------------------------------------------------------

cmd_list() {
  [[ -d "$SOCK_BASE" ]] || { echo "(aucun pod : $SOCK_BASE absent — la fleet tourne ?)"; return 0; }
  shopt -s nullglob
  local socks=("$SOCK_BASE"/*/pod.sock) found=0
  if [[ ${#socks[@]} -eq 0 ]]; then echo "(aucun pod vivant)"; return 0; fi
  printf '%-40s  %s\n' "POD_ID" "TMUX"
  local sock pod_id session status
  for sock in "${socks[@]}"; do
    pod_id="$(basename "$(dirname "$sock")")"
    session="lcars-pod-$pod_id"
    if "$TMUX_BIN" -S "$sock" has-session -t "$session" 2>/dev/null; then
      status="vivant"
    else
      status="sock orphelin (pas de session)"
    fi
    printf '%-40s  %s\n' "$pod_id" "$status"
    found=1
  done
  [[ "$found" -eq 1 ]] || echo "(aucun pod vivant)"
}

# --- attach ----------------------------------------------------------------

cmd_attach() {
  local pod_id="${1:-}"
  [[ -n "$pod_id" ]] || die "attach: pod_id requis (cf. « $PROG list »)"
  # Anti path-traversal: pod_id is ONE path component (sock = $SOCK_BASE/$pod_id/pod.sock). No `/`, no `..`.
  [[ "$pod_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$pod_id" != *..* ]] \
    || die "attach: pod_id '$pod_id' invalide"
  local sock="$SOCK_BASE/$pod_id/pod.sock"
  [[ -S "$sock" ]] || die "attach: pas de sock pour '$pod_id' ($sock) — pod vivant ? (cf. « $PROG list »)"
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "attach: tmux introuvable ($TMUX_BIN)"
  echo "attach $pod_id (Ctrl-b d rend la main sans tuer le pod)…" >&2
  # UI: the wheel scrolls the tmux scrollback (not the shell history). `set -g mouse on` on the pod's
  # own server, right before attaching → covers EVERY pod through RUNTIME tmux config, with no launcher
  # edit. Mouse ON does change selection: hold Shift to copy to the OS clipboard.
  "$TMUX_BIN" -S "$sock" set -g mouse on 2>/dev/null || true
  exec "$TMUX_BIN" -S "$sock" attach -t "lcars-pod-$pod_id"
}

# --- dispatch --------------------------------------------------------------

case "${1:-help}" in
  spawn)  shift; cmd_spawn "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  attach) shift; cmd_attach "$@" ;;
  help|-h|--help) usage ;;
  *) echo "lcars: commande inconnue '${1}'" >&2; echo >&2; usage; exit 1 ;;
esac
