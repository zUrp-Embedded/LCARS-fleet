{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:lcars:workflow-map-v2.5",
  "title": "LCARS Workflow Map v2.5 (enveloppe kind/metadata/spec)",
  "description": "Structural schema dérivé du canon réel des workflow_maps (standard-qa, audit-only). Enveloppe unique kind/metadata/spec ; pas de champ apiVersion (le versioning vit dans le code, pas dans le YAML).",
  "type": "object",
  "required": ["kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "WorkflowMap"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "applicable_intensity": {"type": "array", "items": {"enum": ["L0", "L1", "L2", "L3", "L4"]}},
        "applicable_regime": {"type": "array", "items": {"enum": ["R1", "R2"]}}
      }
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regime_default": {"enum": ["R1", "R2"]},
        "score_target": {"type": "string"},
        "profile_preuve": {"type": "string"}
      }
    },
    "selection_priority": {"type": "array", "items": {"type": "string"}},
    "spec": {
      "type": "object",
      "required": ["steps", "max_rework_rounds"],
      "additionalProperties": false,
      "properties": {
        "max_rework_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "Budget anti-emballement du pipeline : nb de restarts complets du workflow tolérés avant escalade humaine (budget total de step-runs = nb_steps × (max_rework_rounds + 1)). OBLIGATOIRE — pas de défaut caché en code : l'auteur du map déclare sa policy de churn (donnée, pas mécanisme figé)."
        },
        "on_escalation": {"type": "object"},
        "on_failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notify_role": {"type": "string"},
            "log_path": {"type": "string"},
            "cleanup": {"type": "boolean"}
          }
        },
        "steps": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-zA-Z0-9_-]+$": {
              "type": "object",
              "required": ["role", "profile"],
              "additionalProperties": false,
              "properties": {
                "role": {"type": "string", "minLength": 1},
                "profile": {"type": "string", "minLength": 1},
                "brief_kind": {"enum": ["worker", "judge"]},
                "judge_target": {"enum": ["brief", "deliverable"]},
                "effect": {
                  "enum": ["reversible", "fire_once"],
                  "description": "réservé : idempotence/fire-once, pas encore consommé par aucune logique"
                },
                "needs": {"type": "array", "items": {"type": "string"}},
                "condition": {"type": "string"},
                "inputs": {"type": "array", "items": {"type": "string"}},
                "outputs": {"type": "array", "items": {"type": "string"}},
                "timeout_sec": {"type": "integer", "minimum": 1},
                "coordHook": {"type": ["string", "null"]},
                "decisions": {"type": "array", "items": {"type": "string"}},
                "gate": {
                  "oneOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "required": ["type"],
                      "additionalProperties": false,
                      "properties": {
                        "type": {"enum": ["hard", "soft", "terminal"]},
                        "rules": {"type": "array", "items": {"type": "string"}},
                        "human_approval_required": {"type": "boolean"},
                        "approval_prompt": {"type": "string"},
                        "fallback_invoke_gatekeeper": {"type": "boolean"},
                        "on_blocking_severity": {"type": "string"},
                        "on_revision_severity": {"type": "string"}
                      }
                    }
                  ]
                },
                "post_extract": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "git": {
                      "type": "object",
                      "required": ["repo_url", "branch"],
                      "additionalProperties": false,
                      "properties": {
                        "repo_url": {"type": "string", "minLength": 1},
                        "branch": {"type": "string", "minLength": 1},
                        "push": {"type": "boolean"},
                        "add_paths": {"type": "array", "items": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
