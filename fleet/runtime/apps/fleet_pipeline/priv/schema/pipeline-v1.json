{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "version", "stages"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "integer"]},
    "stages": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["role", "profile"],
          "additionalProperties": false,
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "profile": {"type": "string", "minLength": 1},
            "mandate_kind": {"enum": ["worker", "judge"]},
            "judge_target": {"enum": ["mandate", "deliverable"]},
            "effect": {
              "enum": ["reversible", "fire_once"],
              "description": "réservé : idempotence/fire-once, pas encore consommé par aucune logique"
            },
            "needs": {
              "type": "array",
              "items": {"type": "string"}
            },
            "condition": {"type": "string"},
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from_stage", "key"],
                "properties": {
                  "from_stage": {"type": "string"},
                  "key": {"type": "string"}
                }
              }
            },
            "outputs": {
              "type": "array",
              "items": {"type": "string"}
            },
            "timeout_sec": {"type": "integer", "minimum": 1},
            "gate": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {"enum": ["hard", "soft", "terminal"]},
                    "rule": {},
                    "rules": {"type": "array"},
                    "max_rounds": {"type": "integer", "minimum": 1}
                  }
                }
              ]
            },
            "coordHook": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
