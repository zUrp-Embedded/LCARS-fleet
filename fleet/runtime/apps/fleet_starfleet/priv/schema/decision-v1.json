{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["decision", "reason", "details"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["allow", "halt", "escalate", "retry"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "chain": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
