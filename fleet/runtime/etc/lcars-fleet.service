# lcars-fleet.service — chantier 16
#
# SOURCE: /etc/systemd/system/lcars-fleet.service
# AUTHOR: LORDZURP
# STARDATE: 2026.130
# STATUS: OPERATIONAL — daemon LCARS v2 umbrella OTP Ring 0
#
# Install :
#   sudo cp etc/lcars-fleet.service /etc/systemd/system/
#   sudo cp bin/lcars-readiness /usr/local/bin/ && sudo chmod +x /usr/local/bin/lcars-readiness
#   sudo cp etc/lcars-fleet.env.template /etc/fleet/lcars-fleet.env  # éditer secrets
#   sudo chown root:lcars /etc/fleet/lcars-fleet.env && sudo chmod 0640 /etc/fleet/lcars-fleet.env
#   sudo systemctl daemon-reload && sudo systemctl enable --now lcars-fleet.service

[Unit]
Description=LCARS Fleet daemon (Elixir umbrella OTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=lcars
Group=lcars
WorkingDirectory=/var/lib/lcars
EnvironmentFile=/etc/fleet/lcars-fleet.env
ExecStart=/var/lib/lcars/release/bin/fleet_umbrella start
ExecStartPost=/usr/local/bin/lcars-readiness 60
# Z0 #4 (conformance) : grace-shutdown coordonné câblé (DN §31/§67-69). ExecReload
# draine in-flight sans restart ; ExecStop = drain + arrêt propre (begin(45s) puis
# stop) ; ExecStopPost = cleanup locks/queues. Sans ces 3, `systemctl stop` tuait
# brutalement (Fleet.Starfleet.Shutdown.begin jamais invoqué) — « inacceptable
# production » DN §67-69.
# DEPLOY : les 3 helpers vivent dans bin/, copiés en /usr/local/bin (root:root 0755)
# par la procédure etc/README.md §"Procédure deploy" étape 3 (sans quoi systemd skip
# ExecStop = retour au stop brutal). Table des livrables etc/README.md à jour.
ExecReload=/usr/local/bin/lcars-fleet-reload
ExecStop=/usr/local/bin/lcars-fleet-stop
ExecStopPost=/usr/local/bin/lcars-fleet-stop-post
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
NotifyAccess=main

# Hardening systemd — refus par défaut canon LCARS v1 §0 #1
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lcars /var/log/fleet-audit.jsonl /var/log/fleet-starfleet.jsonl /tmp
# /run/lcars/tmux-sock : base des sockets tmux par-pod (bwrap_launch.sh `install -d`).
# Sous ProtectSystem=strict, /run/lcars n'est PAS writable hors ReadWritePaths/RuntimeDirectory →
# le spawn de pod echoue ("install: cannot change permissions ... No such file"). RuntimeDirectory
# cree /run/lcars/tmux-sock owned par le service user (lcars) + RW a chaque start (tmpfs-safe).
RuntimeDirectory=lcars/tmux-sock
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
CapabilityBoundingSet=
# AmbientCapabilities= vide — port :8080 > 1024 ne requiert pas
# CAP_NET_BIND_SERVICE. Rétablir CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# seul si reverse proxy direct :80/:443 future.
SystemCallFilter=@system-service
# D6 #586 (sf empirique) : le deny ~@privileged @resources bloquait
# par seccomp les syscalls bwrap (unshare/mount/setns/pivot_root) →
# tous les pods exec mouraient "Bad system call (core dumped)" capté
# pod_dir/bwrap.stderr. Remplacé par allow explicite @mount @namespace
# (bwrap a besoin de mount + user/mount/pid namespaces pour son
# sandbox). Hardening conservé via le reste (PrivateTmp, ProtectHome,
# CapabilityBoundingSet vide, RestrictNamespaces user mount, etc.).
SystemCallFilter=@mount @namespace
RestrictNamespaces=user mount
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
