# lcars-fleet.env.template — chantier 16
#
# SOURCE: /etc/fleet/lcars-fleet.env (à copier puis éditer)
# AUTHOR: LORDZURP
# STARDATE: 2026.130
# STATUS: TEMPLATE — ne pas commit avec valeurs secrets
#
# Permissions cible : root:lcars 0640 (cohérent G24 invariant
# fleet_credentials chantier 3 PROMOTED). Lecture pod-side
# interdite (système-side seul).

# Mix release Erlang VM
RELEASE_NODE=fleet@127.0.0.1
RELEASE_COOKIE=__GENERATE_VIA_BASE64_32_BYTES__

# LCARS paths
LCARS_CONFIG_PATH=/var/lib/lcars/config
LCARS_LOG_LEVEL=info
LCARS_CAPPROFILES_ROOT=/var/lib/lcars/capprofiles
LCARS_CREDENTIALS_ROOT=/var/lib/lcars/credentials
LCARS_PIPELINES_ROOT=/var/lib/lcars/pipelines
LCARS_STARFLEET_AUDIT_LOG=/var/log/fleet-starfleet.jsonl
LCARS_COORD_POLICIES_PATH=/var/lib/lcars/coord-policies.yaml

# Gitea — webhook + API
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=__GITEA_API_TOKEN__
FLEET_WEBHOOK_SECRET_PATH=/etc/fleet/webhook-secret

# fleet_api (ch15)
FLEET_API_PORT=8080
FLEET_API_SECRET_PATH=/etc/fleet/api-secret

# Config repo (atomic write + git auto commit ch15 GitCommitter)
LCARS_CONFIG_REPO=/var/lib/lcars/config

# ============================================================
# Run #5 — pods long-lived (ADR-G) / MCP / pilot / forge.
# AJOUTÉ 2026-06-02 (audit deep-05 C6 : le template était incomplet vs config/runtime.exs → un deploy
# ne pouvait pas activer le chemin run #5). Convention : OBLIGATOIRE décommenté, optionnel commenté,
# DANGEREUX-si-exposé marqué.
# ============================================================

# Pods.
# DÉCIDÉ 2026-06-01 (monde-invoqué/ADR-E) : défaut = PER-HUMAIN `/home/<human>/pods/pod_<id>`
# (pod.ex `pod_dir_for`), 0700, isolé OS gratis — PAS un `/home/pods` ou `/var/lib/lcars/pods` PARTAGÉ.
# `LCARS_PODS_ROOT` = OVERRIDE base-plate (déploiement non-standard) → LE LAISSER NON-SET pour le défaut
# per-humain. (Ne PAS mettre `/home/pods` : c'est précisément le partagé rejeté.) L'ownership effective
# UID-humain (le pod tourne EN tant que l'humain, via systemd-run --uid) = substrat à brancher.
# LCARS_PODS_ROOT=/var/lib/lcars/pods
LCARS_BOOT_PERMANENT_AT_START=false

# Backend de lancement. Défaut = chaîne bwrap (LauncherPortBackend). 'tmux' = HORS bwrap (POC dev) et
# exige AUSSI LCARS_UNSAFE_ALLOW_HOST_TMUX=1 (quarantaine — JAMAIS prod, containment: none).
# LCARS_LAUNCH_BACKEND=tmux
# LCARS_UNSAFE_ALLOW_HOST_TMUX=1

# Canal MCP fleet↔pod (broker get_task/submit_result + push). ⚠️ *_PORT/*_URL/*_BRIDGE_PATH = surfaces
# INTERNES sans auth transport (audit deep-04) → binder 127.0.0.1, ne jamais exposer hors host de confiance.
LCARS_FLEET_MCP_URL=http://127.0.0.1:4399/mcp
LCARS_FLEET_MCP_POD_FACING_PORT=4399
LCARS_FLEET_MCP_BRIDGE_PATH=/usr/local/lib/lcars/fleet_mcp_stdio_bridge.py
# LCARS_FLEET_MCP_CHANNEL_URL=http://127.0.0.1:4400/channels
# LCARS_FLEET_MCP_CHANNEL_HTTP_PORT=4400

# fleet_pilot (dispatcher webhook→pipeline). OFF par défaut.
# LCARS_PILOT_DISPATCHER=true
# LCARS_PILOT_POLL_REPO=owner/repo
# LCARS_PILOT_POLL_INTERVAL_MS=30000
# LCARS_PILOT_ROUTING_PATH=/var/lib/lcars/pilot-routing.yaml

# Forge — runtime.exs lit FORGE_* (les GITEA_* ci-dessus sont legacy ch15 ; FORGE_* est l'abstraction active).
FORGE_BASE_URL=https://gitea.example.com
FORGE_TOKEN_FILE=/etc/fleet/forge-token
