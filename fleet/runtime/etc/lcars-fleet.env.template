# interdite (système-side seul).

# Mix release Erlang VM
RELEASE_NODE=fleet@127.0.0.1
RELEASE_COOKIE=__GENERATE_VIA_BASE64_32_BYTES__

# LCARS paths
LCARS_CONFIG_PATH=/var/lib/lcars/config
LCARS_LOG_LEVEL=info
LCARS_CAPPROFILES_ROOT=/var/lib/lcars/capprofiles
LCARS_CREDENTIALS_ROOT=/var/lib/lcars/credentials
LCARS_PIPELINES_ROOT=/var/lib/lcars/pipelines
LCARS_STARFLEET_AUDIT_LOG=/var/log/fleet-starfleet.jsonl
LCARS_COORD_POLICIES_PATH=/var/lib/lcars/coord-policies.yaml

# Gitea — webhook + API
GITEA_URL=https://gitea.example.com
GITEA_TOKEN=__GITEA_API_TOKEN__
FLEET_WEBHOOK_SECRET_PATH=/etc/fleet/webhook-secret

# fleet_api (ch15)
FLEET_API_PORT=8080
FLEET_API_SECRET_PATH=/etc/fleet/api-secret

# Config repo (atomic write + git auto commit ch15 GitCommitter)
LCARS_CONFIG_REPO=/var/lib/lcars/config
