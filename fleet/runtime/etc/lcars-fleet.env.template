# lcars-fleet.env.template — chantier 16
#
# SOURCE: /etc/fleet/lcars-fleet.env (à copier puis éditer)
# AUTHOR: LORDZURP
# STARDATE: 2026.130
# STATUS: TEMPLATE — ne pas commit avec valeurs secrets
#
# Permissions cible : root:lcars 0640 (cohérent G24 invariant
# fleet_credentials chantier 3 PROMOTED). Lecture pod-side
# interdite (système-side seul).
#
# F164/F165 (review) : template RÉ-ALIGNÉ sur config/runtime.exs — toute var lue par le runtime est
# documentée ici, et inversement aucune var morte (knob qu'aucun module ne lit). Convention :
# OBLIGATOIRE décommenté, optionnel/override commenté, DANGEREUX-si-exposé marqué.

# Mix release Erlang VM
# RELEASE_DISTRIBUTION=name (PAS none) : les helpers ExecStop/ExecReload (lcars-fleet-stop / -reload)
# joignent le nœud par `fleet_umbrella rpc` (graceful shutdown Fleet.Starfleet.Shutdown.*). Sans nœud
# nommé (distribution none) le rpc échoue (:noconnection) → stop/reload cassent, unit « failed ». `name`
# (pas `sname`) car RELEASE_NODE est un nom long (node@host). 127.0.0.1 = loopback only (pas exposé).
RELEASE_DISTRIBUTION=name
RELEASE_NODE=lcars@127.0.0.1
RELEASE_COOKIE=__GENERATE_VIA_BASE64_32_BYTES__

# LCARS paths
LCARS_LOG_LEVEL=info
LCARS_CAPPROFILES_ROOT=/var/lib/lcars/capprofiles
LCARS_PIPELINES_ROOT=/var/lib/lcars/pipelines
LCARS_COORD_POLICIES_PATH=/var/lib/lcars/coord-policies.yaml
LCARS_STARFLEET_AUDIT_LOG=/var/log/fleet-starfleet.jsonl
# State FS recovery (session_id/phase persistés). Doctrine 2026-06-11 (fleet sous l'humain) : viser
# `/home/<human>/.lcars/state` plutôt que /var/lib/lcars (migration data à scoper, cf. handoff §5.0).
# LCARS_STATE_PATH=/var/lib/lcars
# F092 — racine des workspaces de pipeline (scratch git). HORS /tmp (ADR-E). Non-set → défaut
# `~/.lcars/workspaces`. Surcharge :
# LCARS_WORKSPACES_ROOT=/home/<human>/.lcars/workspaces

# fleet_api (ch15) — pas d'auth applicative (HMAC retiré ; frontière = isolation réseau du container)
FLEET_API_PORT=8080

# fleet_observation (deck read-only :8091, BL-026). Non-set → 8091.
# LCARS_OBSERVATION_PORT=8091

# Config repo (atomic write + git auto commit ch15 GitCommitter)
LCARS_CONFIG_REPO=/var/lib/lcars/config

# ============================================================
# Forge (FORGE_* = l'abstraction active ; les GITEA_* sont RETIRÉS, F164).
# ============================================================
FORGE_BASE_URL=https://gitea.example.com
# Token API forge (lecture issues/comments/labels). `_FILE` = chemin fichier (préféré), sinon valeur inline.
FORGE_TOKEN_FILE=/etc/fleet/forge-token
# FORGE_TOKEN=__INLINE_TOKEN__
# Token de PUSH write-scoped (publish des livrables). Non-set → FORGE_TOKEN.
# FORGE_PUSH_TOKEN=__INLINE_PUSH_TOKEN__
# F058/F059/F060 : login du compte SYSTÈME (propriétaire de FORGE_TOKEN). Les marqueurs forge
# (route/hop/result) ne font foi QUE de ce login. Non-set → dérivé via GET /user (1 round-trip, caché).
# FORGE_BOT_LOGIN=lcars-system

# Webhook Gitea (:8081 HMAC). F161/F036 : ON-SWITCH explicite (sinon le listener ne démarre JAMAIS).
FLEET_WEBHOOK_SECRET_PATH=/etc/fleet/webhook-secret
# LCARS_FLEET_WEBHOOKS=true
# LCARS_FLEET_WEBHOOK_PORT=8081
# (Signaux OS : pas de knob — SignalsOS est non-fonctionnel jusqu'à F037, cf. runtime.exs.)

# ============================================================
# Run #5 — pods long-lived (ADR-G) / MCP / pilot.
# ============================================================

# Pods : défaut PER-HUMAIN `/home/<human>/pods/pod_<id>` (0700, isolé OS gratis). Ownership UID-humain
# PAR CONSTRUCTION : le daemon tourne sous `User=<humain>` (doctrine 2026-06-11), le pod (Port BEAM)
# hérite l'UID → PAS de systemd-run --uid. Chaque humain = sa fleet sous son user. Override base-plate
# via le CONFIG `:fleet_spawner, :pod_dir_root` (déploiement non-standard) — pas un env knob.
LCARS_BOOT_PERMANENT_AT_START=false
# Recovery : reprendre les pods persistés au boot (défaut désactivé).
# LCARS_RECOVERY_RESUME_ENABLED=true
# Base des sockets tmux par-pod (= côté bwrap_launch). Non-set → /run/lcars/tmux-sock.
# LCARS_TMUX_SOCK_BASE=/run/lcars/tmux-sock
# Kick host→pod (cadence du « yop » jusqu'au 1er get_task).
# LCARS_KICK_FIRST_DELAY_MS=2000
# LCARS_KICK_RETRY_MS=2000
# LCARS_KICK_MAX_ATTEMPTS=15

# Canal MCP fleet↔pod (broker get_task/submit_result). ⚠️ *_PORT/*_URL/*_BRIDGE_PATH = surfaces INTERNES
# sans auth transport (audit deep-04) → binder 127.0.0.1, ne jamais exposer hors host de confiance.
LCARS_FLEET_MCP_URL=http://127.0.0.1:4399/mcp
LCARS_FLEET_MCP_POD_FACING_PORT=4399
LCARS_FLEET_MCP_BRIDGE_PATH=/usr/local/lib/lcars/fleet_mcp_stdio_bridge.py

# fleet_pilot (dispatcher forge→pipeline). OFF par défaut. Deux modes :
# LCARS_PILOT_DISPATCHER=true    # mode legacy (pipeline RAM)
# LCARS_PILOT_STAGE=true         # mode stage (forge-driven, recommandé)
# LCARS_PILOT_POLL_REPO=owner/repo
# LCARS_PILOT_POLL_INTERVAL_MS=30000
# LCARS_PILOT_ROUTING_PATH=/var/lib/lcars/pilot-routing.yaml
# LCARS_PILOT_STAGE_ROUTING=/var/lib/lcars/pilot-stage-routing.yaml
# Remote git où le SYSTÈME pousse les livrables (HopConsumer). Non-set → dérivé du base_url forge.
# LCARS_HOP_REMOTE=https://gitea.example.com/owner/repo.git

# Z4 — identité git de l'humain : DÉRIVÉE de l'OS (git config user.name/email → GECOS → login).
# Plus de catalogue settings_users.yaml ni de knob (doctrine 2026-06-11 : l'user OS = l'humain de la
# fleet). Pré-requis : l'humain a `git config --global user.{name,email}` (sinon fallback <login>@<host>).
