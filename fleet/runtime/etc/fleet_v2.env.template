# fleet_v2.env — config humaine pour `fleet_v2 start`
#
# Copier en ~/.lcars/fleet_v2.env puis éditer. La fleet tourne SOUS toi (l'humain qui lance) :
# pods, creds (~/.claude), identité git héritent ton UID. `fleet_v2` calcule seul les ports
# (offset déterministe sur l'UID), pose les chemins sous ~/.lcars/* et les on-switches — ici,
# juste la forge + le repo surveillé.

# --- Forge (obligatoire pour le stage-mode) ---
FORGE_BASE_URL=http://10.42.0.118
# Token de l'humain qui lance = compte OPÉRATEUR/poller (identité HUMAIN sur la forge), DISTINCT des
# tokens de RÔLE des workers (ceux-là vivent dans /home/private/<role>.gitea_token, lus par les pods).
# Non-set → fallback ~/.gitea_token.
# FORGE_TOKEN_FILE=~/.gitea_token
# FORGE_TOKEN=__inline__

# --- Le repo que la fleet surveille (OBLIGATOIRE) ---
# NB v1 : le poller est mono-repo + assignee=rôle. Le repo-agnostique (assignee=humain) = chantier ②.
LCARS_PILOT_POLL_REPO=fleet/poc-helloworld

# --- Overrides (optionnels) ---
# MIX_ENV=dev                          # prod par défaut (vrai run) ; dev pour itérer plus vite
# LCARS_PILOT_POLL_INTERVAL_MS=30000
# Ports : auto-calculés (offset UID, bloc de 10 dès 21000). Override explicite si besoin :
# FLEET_API_PORT=...  LCARS_OBSERVATION_PORT=...  LCARS_FLEET_MCP_POD_FACING_PORT=...  LCARS_FLEET_WEBHOOK_PORT=...
