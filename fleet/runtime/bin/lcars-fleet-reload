#!/usr/bin/env bash
# DEPLOY: instance-util
# lcars-fleet-reload : drain in-flight sans restart full (systemd ExecReload)
# Canon : 04_design-notes/ring0/lcars-fleet_service.md §"Helper lcars-fleet-reload"
# Invoque Fleet.Starfleet.Shutdown.drain_in_flight/1 via Erlang RPC release.
# Sortie : queue dispatched jobs vidée, audit logs flush, daemon reste up.

set -euo pipefail
/var/lib/lcars/release/bin/fleet_umbrella rpc \
  'Fleet.Starfleet.Shutdown.drain_in_flight(grace_ms: 30_000)'
