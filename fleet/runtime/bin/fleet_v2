#!/usr/bin/env bash
# SOURCE: bin/fleet_v2
# AUTHOR: starfleet
# STARDATE: 2026-06-15
# STATUS: PROTO-V2 — human launcher. `fleet_v2 start` runs the fleet AS the human, detached;
#         starfleet (front-desk) comes up permanent and is reachable through Claude Desktop, NOT a
#         terminal (reorg 2026-07-19: no arch attach any more — the arch is per-project, spawned
#         when a project is opened).
#
# Model (ADR-E): the BEAM runs *as* the human who launches it → the Port spawns the pods, which
# INHERIT its UID (no systemd, no UID drop, no /var/lib/lcars). The state paths already default under
# the home on the Elixir side (state_fs_root / tmux sock / task-queue / audit → ~/.lcars/*, commit
# c368f89d). So this launcher posts ONLY what cannot be defaulted:
#   - the per-human PORTS (deterministic offset on the UID → N fleets coexist in ONE container);
#   - the MCP spec (3 env vars required, or the pod does not launch: :mcp_server_spec_required);
#   - the on-switches (starfleet permanent front-desk + forge-driven step-mode machine).
#
# Human config: ~/.lcars/fleet_v2.env (cf. etc/fleet_v2.env.template) — forge (projects are discovered
#         by ORG MEMBERSHIP, no fixed watched repo).
# Gestures: fleet_v2 {start|stop|restart|status|version|forge}.

set -euo pipefail

SELF="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SELF")"
RUNTIME_DIR="$(dirname "$BIN_DIR")"

# This script must NEVER depend on the caller's CWD: every path it writes is already absolute (under
# $HOME), but the PROCESS itself must also start from a directory it is guaranteed to be able to read.
# `cmd_stop` spins up a TEMPORARY Erlang node (`fleet_umbrella rpc`, not embedded) whose code path
# search includes `.` to load the compiler modules the RPC eval needs — from an unreadable CWD that is
# a burst of `eacces` from code_server. `cd` BEFORE any relative computation (SELF/BIN_DIR/RUNTIME_DIR
# are already resolved to absolute above, so they survive this `cd`).
cd "$HOME" || { echo "fleet_v2: \$HOME ($HOME) inaccessible — impossible d'ancrer un CWD fiable" >&2; exit 1; }

# Erlang distribution (opt-in through LCARS_FLEET_V2_ERL_NODE) — ONE derivation, shared by start
# (distributed launch) and stop (graceful RPC, F7). The flag and cookie come from the ENV FILE
# (~/.lcars/fleet_v2.env), so the derivation MUST run after load_env(): computing it at the script's
# top level reads vars that are not loaded yet, and the release then starts with NO distribution —
# RPC and graceful stop silently dead.
ERL_NODE="fleet_$(id -un)@127.0.0.1"
ERL_COOKIE=""
DIST_ON=""
ENV_LOADED=""

load_env() {
  [[ -n "$ENV_LOADED" ]] && return 0
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"
  # shellcheck source=/dev/null
  if [[ -f "$env_file" ]]; then set -a; . "$env_file"; set +a; fi
  ENV_LOADED=1
  ERL_COOKIE="${LCARS_FLEET_V2_ERL_COOKIE:-lcars}"
  [[ -n "${LCARS_FLEET_V2_ERL_NODE:-}" ]] && DIST_ON=1 || true
}
TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"
SESSION="${LCARS_FLEET_V2_SESSION:-fleet_v2}"
DAEMON_SOCK="${LCARS_FLEET_V2_SOCK:-$HOME/.lcars/run/fleet_v2.sock}"
MIX_ENV_DEFAULT="${LCARS_FLEET_V2_MIX_ENV:-prod}"

die() { echo "fleet_v2: $*" >&2; exit 1; }
dtmux() { "$TMUX_BIN" -S "$DAEMON_SOCK" "$@"; }

# Per-human port block (D2). Deterministic on the UID: a block of 10 ports from 21000 up.
# (uid % 500) → up to 500 humans before two blocks collide; past that, override the ports explicitly.
compute_ports() {
  local uid base
  uid="$(id -u)"
  base=$(( 21000 + (uid % 500) * 10 ))
  API_PORT="${FLEET_API_PORT:-$base}"
  OBS_PORT="${LCARS_OBSERVATION_PORT:-$(( base + 1 ))}"
  # base+2 is RESERVED (the pod-facing MCP HTTP port, removed): the MCP transport is no longer a shared
  # HTTP listener but one AF_UNIX socket per pod (cf. LCARS_FLEET_MCP_SOCK_BASE). The slot is left empty
  # so the webhook port below does not shift.
  WEBHOOK_PORT="${LCARS_FLEET_WEBHOOK_PORT:-$(( base + 3 ))}"
}

setup_env() {
  load_env
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"

  # Forge profile: switch between forges WITHOUT editing anything. A profile lives in
  # ~/.lcars/forge.d/<name>.env and posts the FORGE_* of THAT forge (URL + system token + role-token
  # dir). The runtime stays SINGLE-FORGE: it reads the FORGE_* resolved below (runtime.exs). The name
  # is only a handle — a forge's one real variable is its ip:port URL.
  #
  # Active forge, 3 levels (strongest wins):
  #   1. LCARS_FORGE explicit in the env                        → ONE-SHOT override (a spot test)
  #   2. ~/.lcars/forge.active (written by `fleet_v2 forge <n>`) → the PERSISTENT switch (git-checkout style)
  #   3. otherwise                                              → `work` (the hard default)
  # Sourced AFTER the flat env → the profile wins. Default `work` with no profile file keeps the flat
  # fleet_v2.env's FORGE_* honoured: no switch and no profile is the historical behaviour.
  local _forge_deliberate="${LCARS_FORGE+set}"
  local forge_active_file="${LCARS_FORGE_STATE:-$HOME/.lcars/forge.active}"
  if [[ -z "$_forge_deliberate" && -r "$forge_active_file" ]]; then
    local _active; _active="$(tr -d '[:space:]' < "$forge_active_file" 2>/dev/null || true)"
    [[ -n "$_active" ]] && { LCARS_FORGE="$_active"; _forge_deliberate="set"; }
  fi
  : "${LCARS_FORGE:=work}"
  local forge_file="${LCARS_FORGE_DIR:-$HOME/.lcars/forge.d}/${LCARS_FORGE}.env"
  if [[ -f "$forge_file" ]]; then
    set -a
    # shellcheck source=/dev/null
    . "$forge_file"
    set +a
  elif [[ -n "$_forge_deliberate" ]]; then
    die "profil forge inconnu : « $LCARS_FORGE » — $forge_file absent (« fleet_v2 forge <nom> » vers un profil existant, ou ajoute le fichier)"
  fi

  # F-037 multi-project: the poller DISCOVERS its repos by listing the ORG, so no
  # LCARS_PILOT_POLL_REPO is required any more. The fail-loud guard is on FORGE_BASE_URL (discovery
  # + per-step-run push), matching the Elixir guard `Fleet.Pilot.Application.step_children!`.
  # WS3 retired the mutable topic marker this comment used to name: org membership IS the admission
  # frontier, and per-human scoping moved to the issue-level `assigned_by` filter. A launcher that
  # names a mechanism the code dropped is read as current — it printed that claim at every start.
  : "${FORGE_BASE_URL:?config manquante : FORGE_BASE_URL=http://forge (dans $env_file) — requis pour le scan des projets + le push}"

  compute_ports

  # Per-human ports (read by runtime.exs: fleet_api / fleet_observation / event_router).
  export FLEET_API_PORT="$API_PORT"
  export LCARS_OBSERVATION_PORT="$OBS_PORT"
  export LCARS_FLEET_WEBHOOK_PORT="$WEBHOOK_PORT"

  # A7 (port agreement): THIS fleet's API URL, written into the runtime state — the `lcars` CLI (and
  # any tool outside the fleet env) READS it instead of guessing a port. A static default like :8080
  # could not be right for anyone: the ports are per-human, computed on the UID above.
  mkdir -p "$HOME/.lcars/run"
  printf 'http://localhost:%s\n' "$API_PORT" > "$HOME/.lcars/run/api_url"

  # MCP spec — path of the pod's stdio bridge (co-located with this launcher). The pod↔central
  # transport is no longer a shared loopback HTTP URL but a per-pod AF_UNIX socket (base set below,
  # LCARS_FLEET_MCP_SOCK_BASE); only the bridge path is still an MCP-spec env var.
  export LCARS_FLEET_MCP_BRIDGE_PATH="${LCARS_FLEET_MCP_BRIDGE_PATH:-$BIN_DIR/fleet_mcp_stdio_bridge.py}"

  # Pod launchers (N0/N1), taken from $BIN_DIR (= the install /local/LCARS_v2/bin, OR the source tree in
  # dev). Everything under the install, ZERO copies scattered in /usr/local/bin. The parent dir is bound
  # RO into the sandbox (pod.ex `system_mounts`, derived from claude_launch_path). cap-profiles are NOT
  # set here → the release reads its bundled priv (`:code.priv_dir`) and dev mode points at the source
  # (cf. cmd_start): that is what keeps prod self-contained.
  export LCARS_BWRAP_LAUNCH_PATH="${LCARS_BWRAP_LAUNCH_PATH:-$BIN_DIR/bwrap_launch.sh}"
  export LCARS_HOST_LAUNCH_PATH="${LCARS_HOST_LAUNCH_PATH:-$BIN_DIR/host_launch.sh}"
  export LCARS_CLAUDE_LAUNCH_PATH="${LCARS_CLAUDE_LAUNCH_PATH:-$BIN_DIR/claude_launch.sh}"

  # Per-pod tmux sock: the Elixir default is ~/.lcars/run/tmux-sock (under the home, c368f89d). Exported
  # explicitly so the wait, the attach and the `lcars` CLI all compute the SAME path.
  export LCARS_TMUX_SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"

  # Base of the per-pod MCP sockets (one AF_UNIX channel <base>/<pod_id>/sock per pod). SAME logic as
  # the tmux sock above: the central default (/run/lcars/mcp) is not writable without privilege when a
  # HUMAN launches the fleet, so we put the path under their home. runtime.exs reads this env as the
  # base where central creates the socket, AND bwrap_launch.sh reads it to bind the per-pod dir at the
  # same absolute path inside the sandbox: ONE source for both sides.
  export LCARS_FLEET_MCP_SOCK_BASE="${LCARS_FLEET_MCP_SOCK_BASE:-$HOME/.lcars/run/mcp}"

  # CLI `lcars` -> per-human API. READS go through the TCP loopback port; the WRITE (spawn) goes
  # through a per-human AF_UNIX socket (ControlRouter) - off the network the pod shares. The file
  # lives under ~/.lcars/run/ (the real home is never bound into the pod).
  export LCARS_API_URL="${LCARS_API_URL:-http://localhost:$API_PORT}"
  export LCARS_API_SOCK="${LCARS_API_SOCK:-$HOME/.lcars/run/api.sock}"
  # Clear a leftover socket from a previous instance (AF_UNIX is not removed on close; the daemon
  # rebinds it at boot). Rebinding at runtime after a crash is handled on the BEAM side.
  rm -f "$LCARS_API_SOCK"

  # On-switches: the permanent boots, the forge-driven step-mode machine runs. BOTH are
  # overridable defaults, never clobbers: LCARS_BOOT_PERMANENT_AT_START=false is the
  # operator's MAINTENANCE boot (no permanent pod spawned = no spend, no forge effect) —
  # an unconditional export here silently turned that intent into a full boot. The
  # engine side refuses an unparseable value (EnvParse.bool! in runtime.exs): a typo on
  # a reduction-of-effects switch stops the boot, it never becomes the active default.
  export LCARS_BOOT_PERMANENT_AT_START="${LCARS_BOOT_PERMANENT_AT_START:-true}"
  export LCARS_PILOT_STEP="${LCARS_PILOT_STEP:-true}"

  # Erlang distribution (named node, RPC debug) is handled per MODE in cmd_start, under a name DERIVED
  # PER-HUMAN. The release distributes `-sname fleet_umbrella` by DEFAULT — a FIXED shared name, so two
  # humans land on the same node in the shared epmd and the second BEAM CRASHES. cmd_start therefore
  # forces either a per-human node (`fleet_<user>`, when LCARS_FLEET_V2_ERL_NODE is set = debug) or
  # `RELEASE_DISTRIBUTION=none` (the normal case: no epmd, no collision). Per-human, like the ports.

  mkdir -p "$LCARS_TMUX_SOCK_BASE" "$LCARS_FLEET_MCP_SOCK_BASE" "$(dirname "$DAEMON_SOCK")"

  # Persist the computed runtime env so the human can drive `lcars` afterwards (`source` this file).
  cat > "$HOME/.lcars/run/fleet_v2.runtime.env" <<RT
# Genere par fleet_v2 start — \`source\` pour utiliser lcars (spawn/list/attach) hors de cette session.
export LCARS_API_URL="$LCARS_API_URL"
export LCARS_API_SOCK="$LCARS_API_SOCK"
export LCARS_TMUX_SOCK_BASE="$LCARS_TMUX_SOCK_BASE"
RT
}

# The fleet starts DETACHED (tmux daemon) and nothing is attached automatically (reorg 2026-07-19: the
# arch no longer boots at start — starfleet is the front-desk, reachable through Claude Desktop, NOT a
# terminal; the arch is per-project, spawned when a project is opened). To debug a pod by hand:
# `lcars attach <pod_id>`; for the BEAM logs, the tmux daemon below.
fleet_up_notice() {
  echo "fleet_v2: fleet up (daemon tmux). starfleet (front-desk) est dans Claude Desktop." >&2
  echo "fleet_v2: logs BEAM : « $TMUX_BIN -S $DAEMON_SOCK attach -t $SESSION » · un pod : « lcars attach <pod_id> »" >&2
}

cmd_start() {
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "tmux introuvable ($TMUX_BIN)"
  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    # Fleet ALREADY up: re-source the runtime env (to match the live fleet) and just report.
    local rt="$HOME/.lcars/run/fleet_v2.runtime.env"
    # shellcheck source=/dev/null
    [[ -r "$rt" ]] && { set -a; . "$rt"; set +a; }
    echo "fleet_v2: la fleet tourne." >&2
    fleet_up_notice
    return 0
  fi
  setup_env

  # Claude credentials preflight — the ONE input no pod can think without. The runtime already
  # fails loud per-pod (Fleet.Credentials, credentials_unreadable), but that lands in tmux logs
  # AFTER a start that looked green from this door: the operator sees a running fleet that
  # silently spawns nothing. The door says it BEFORE, names the gesture, and refuses — same
  # contract as the missing FORGE_BASE_URL. Explicit escape for credential-less debugging.
  local cred="$HOME/.claude/.credentials.json"
  if [[ ! -s "$cred" && -z "${LCARS_START_WITHOUT_CLAUDE:-}" ]]; then
    die "credentials claude absentes ($cred) — la fleet demarrerait, mais AUCUN pod ne peut penser (fail silencieux).
  Geste d'identite : lance 'claude', /login, bonjour, /exit — puis relance 'fleet_v2 start'.
  Demarrage sans agents assume : LCARS_START_WITHOUT_CLAUDE=1 fleet_v2 start"
  fi

  local mix_env="${MIX_ENV:-$MIX_ENV_DEFAULT}"

  # Mode follows the deployment (derived from where this launcher sits — nothing hardcoded):
  #   - INSTALL (/local/LCARS_v2): the self-contained RELEASE (`rel/.../bin/fleet_umbrella start`) runs
  #     WITHOUT the repo (bundled priv, embedded ERTS).
  #   - SOURCE (dev): `mix run --no-halt` from the repo (fast iteration). The catalogue is the live
  #     source tree either way — `_build/<env>/lib/lcars_fleet/priv` is a symlink to `priv/`.
  # Erlang distribution is PER-HUMAN (cf. setup_env): node `fleet_<user>`, never the shared fixed
  # `fleet_umbrella`. ON only when LCARS_FLEET_V2_ERL_NODE is set (RPC debug); OFF otherwise (no epmd).
  local erl_node="$ERL_NODE" erl_cookie="$ERL_COOKIE" dist_on="$DIST_ON"

  local rel_bin="$RUNTIME_DIR/rel/fleet_umbrella/bin/fleet_umbrella"
  local mode launch_cmd
  if [[ -x "$rel_bin" ]]; then
    mode="release"
    # The install is RO (system-owned) → the BEAM writes its tmp in the human's home, not the install.
    export RELEASE_TMP="${RELEASE_TMP:-$HOME/.lcars/tmp}"
    mkdir -p "$RELEASE_TMP"
    # Override the `-sname fleet_umbrella` default (shared → multi-human collision).
    if [[ -n "$dist_on" ]]; then
      export RELEASE_DISTRIBUTION=name RELEASE_NODE="$erl_node" RELEASE_COOKIE="$erl_cookie"
    else
      export RELEASE_DISTRIBUTION=none
    fi
    launch_cmd="exec '$rel_bin' start"
  else
    mode="dev (mix run, MIX_ENV=$mix_env)"
    # NO cap-profile root pinned here. Mix links `_build/<env>/lib/lcars_fleet/priv` to the source
    # `priv/`, so the default root ALREADY reads the live tree — the override bought nothing, and
    # it made this launcher a second authority on the catalogue's layout. It broke the moment the
    # catalogue moved (2026-08-01) and killed the BEAM at boot: one layout, one authority, and it
    # is `Fleet.Catalogue`, never a path rebuilt in shell.
    [[ -n "$dist_on" ]] && export ELIXIR_ERL_OPTIONS="-name $erl_node -setcookie $erl_cookie ${ELIXIR_ERL_OPTIONS:-}"
    launch_cmd="cd '$RUNTIME_DIR' && exec mix run --no-halt"
  fi

  echo "fleet_v2: lancement du BEAM sous $(id -un) (uid $(id -u)) — $mode" >&2
  echo "fleet_v2: ports — API $API_PORT · obs $OBS_PORT · webhook $WEBHOOK_PORT" >&2
  echo "fleet_v2: scan multi-projet — tout depot de l'org (F-037, plus de repo fixe)" >&2

  # DEDICATED tmux socket (fresh server) → it captures the env exported above. The BEAM runs detached
  # there and survives this terminal. `start` (release) / `mix run --no-halt` (dev): the foreground is
  # held by tmux.
  MIX_ENV="$mix_env" dtmux new-session -d -s "$SESSION" "$launch_cmd"
  # UI: the wheel scrolls the BEAM logs' scrollback (not the shell history). Same gesture in `lcars attach`.
  dtmux set -g mouse on 2>/dev/null || true

  # Nothing to wait for or attach to (the arch no longer boots at start). The BEAM boots detached; the
  # BootOrchestrator brings starfleet + governance up post-readiness. We hand back immediately.
  fleet_up_notice
}

# F7: GRACEFUL stop first — Shutdown.begin (refuse new work + drain in-flight) then :init.stop (ordered
# OTP shutdown: the pods' terminate runs, trap_exit F3 → teardown + checkpoint seed). The tmux
# kill-server is only the FALLBACK (BEAM without distribution, RPC down, or a graceful that outlasts
# the wait below). A direct kill-server means NO shutdown path ever executes the Shutdown rail — which
# is what it was built for.
cmd_stop() {
  load_env
  if ! dtmux has-session -t "$SESSION" 2>/dev/null; then
    echo "fleet_v2: pas de fleet active." >&2
    return 0
  fi

  # GRACEFUL door, NOMINAL path: SIGTERM to the BEAM. OTP turns it into :init.stop and
  # calls Fleet.Application.prep_stop (refuse-new + drain in-flight, Shutdown.begin)
  # BEFORE any supervisor dies. Needs NO Erlang distribution — the old graceful path
  # lived behind the debug-only RPC (LCARS_FLEET_V2_ERL_NODE), so the operator's normal
  # stop went straight to kill-server and the drain never ran in production. The BEAM is
  # the direct child of the tmux pane shell (the release script execs down to beam:
  # same pid). kill-server stays the FALLBACK, for a BEAM that no longer answers.
  echo "fleet_v2: stop graceful (drain puis teardown, dans l'ordre)..." >&2
  local pane_pid beam_pid
  pane_pid="$(dtmux display-message -p -t "$SESSION" '#{pane_pid}' 2>/dev/null || true)"
  beam_pid=""
  [[ -n "$pane_pid" ]] && beam_pid="$(pgrep -P "$pane_pid" 2>/dev/null | head -1 || true)"

  if [[ -n "$beam_pid" ]]; then
    kill -TERM "$beam_pid" 2>/dev/null || true

    # Wait for the BEAM to finish cleanly (the tmux session dies with it). This is the OUTER
    # bound of the WHOLE clean stop: the drain's own deadline AND the ordered teardown that
    # follows it (pods' terminate → checkpoint seed) must both fit inside. Set tighter than the
    # drain deadline, it makes that deadline decorative — the fallback kill-server below then
    # cuts the checkpoint, the one thing a clean stop exists to save. The asymmetry decides the
    # value: too generous costs an operator's wait on a BEAM that is already stuck, too tight
    # costs pod state. Still a literal posed HERE rather than derived from the BEAM's own
    # deadline — that single source is BL-6-52. Under `set -e`, `((i++))` returns 0 (falsy) on
    # the first round and kills the script silently, hence the explicit form below.
    local i=0 max_wait="${FLEET_V2_STOP_WAIT:-90}"
    while dtmux has-session -t "$SESSION" 2>/dev/null && (( i < max_wait )); do
      sleep 1
      i=$((i + 1))
    done
  else
    echo "fleet_v2: BEAM introuvable sous la session tmux — fallback kill direct." >&2
  fi

  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    dtmux kill-server 2>/dev/null || true
    echo "fleet_v2: BEAM mort (fallback kill — le prochain start reape les pods restants)." >&2
  else
    echo "fleet_v2: BEAM mort proprement (drain puis teardown)." >&2
  fi
}

cmd_status() {
  # Version FIRST: "which build is running?" answered at a glance, without reading build_info.txt by
  # hand (reuses cmd_version — same data as `fleet_v2 version` and the /api/version endpoint).
  cmd_version
  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    echo "fleet_v2: BEAM vivant. Logs : $TMUX_BIN -S $DAEMON_SOCK attach -t $SESSION"
    LCARS_TMUX_SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}" \
      "$BIN_DIR/lcars" list 2>/dev/null || true
  else
    echo "fleet_v2: fleet morte."
  fi
}

# Build version: observed ("which commit is running?"), not inferred. SAME data as the REST
# /api/version endpoint and the boot log (short git SHA + dirty + ref). The source follows the
# deployment, like cmd_start: in RELEASE the SHA is embedded in the priv at build time (the repo is not
# there), in SOURCE/dev we ask git LIVE.
cmd_version() {
  local rel_root="$RUNTIME_DIR/rel/fleet_umbrella"
  local build_file
  # Single app post-collapse: the priv lives under `lcars_fleet-<vsn>`, NAMESPACED by domain
  # (`priv/api/`, no more per-app umbrella priv). THIS path MUST follow the BEAM writer/reader
  # (`Application.app_dir(:lcars_fleet, "priv/api/build_info.txt")`, build_info.ex) — otherwise the glob
  # misses, we fall through to git (absent at release runtime) and the status lies "build unknown".
  build_file="$(ls -1 "$rel_root"/lib/lcars_fleet-*/priv/api/build_info.txt 2>/dev/null | head -1 || true)"

  if [[ -n "$build_file" && -f "$build_file" ]]; then
    # RELEASE: read the embedded file (key=value, written by write_build_info/1).
    local sha dirty ref dflag=""
    sha="$(sed -n 's/^sha=//p' "$build_file")"
    dirty="$(sed -n 's/^dirty=//p' "$build_file")"
    ref="$(sed -n 's/^ref=//p' "$build_file")"
    [[ "$dirty" == "true" ]] && dflag="-dirty"
    echo "fleet_v2: build ${sha:-unknown}${dflag} ref=${ref} (source=release)"
  else
    # SOURCE/dev: git LIVE in the repo (git failure → unknown, never a hard error).
    local sha ref dflag=""
    sha="$(git -C "$RUNTIME_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    ref="$(git -C "$RUNTIME_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    [[ -n "$(git -C "$RUNTIME_DIR" status --porcelain 2>/dev/null)" ]] && dflag="-dirty"
    echo "fleet_v2: build ${sha}${dflag} ref=${ref} (source=working_tree)"
  fi
}

# Active forge: the persistent SWITCH (`git checkout` / `kubectl use-context` style). With no argument
# → print the active one + the available profiles. With a name → check that ~/.lcars/forge.d/<name>.env
# exists, then write it to ~/.lcars/forge.active (persistent; the next `start` uses it). A `LCARS_FORGE=`
# in the env stays a ONE-SHOT override above this switch (cf. setup_env).
cmd_forge() {
  local name="${1:-}"
  local state="${LCARS_FORGE_STATE:-$HOME/.lcars/forge.active}"
  local dir="${LCARS_FORGE_DIR:-$HOME/.lcars/forge.d}"
  if [[ -z "$name" ]]; then
    local active="work (aucun switch en place)"
    if [[ -r "$state" ]]; then local a; a="$(tr -d '[:space:]' < "$state")"; [[ -n "$a" ]] && active="$a"; fi
    echo "fleet_v2: forge active = $active"
    if [[ -d "$dir" ]]; then
      local profils=""
      for f in "$dir"/*.env; do [[ -f "$f" ]] && profils+=" $(basename "$f" .env)"; done
      echo "fleet_v2: profils disponibles :${profils:- (aucun sous $dir)}"
    else
      echo "fleet_v2: aucun profil (dir $dir absent)"
    fi
    return 0
  fi
  [[ -f "$dir/$name.env" ]] || die "profil forge « $name » inconnu ($dir/$name.env absent) — ajoute-le d'abord"
  mkdir -p "$(dirname "$state")"
  printf '%s\n' "$name" > "$state"
  echo "fleet_v2: forge active → $name (persistant ; le prochain « fleet_v2 start » l'utilise)"
}

# restart = stop (graceful: drain + ordered teardown, fallback kill) THEN start. A `LCARS_FORGE=` or a
# `fleet_v2 forge <name>` beforehand applies to the start.
cmd_restart() {
  cmd_stop
  cmd_start "$@"
}

# Source guard (standard idiom): sourcing the file loads the functions WITHOUT running
# the dispatcher — the bats suite (test/fleet_v2/) exercises setup_env/cmd_* directly.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then return 0; fi

case "${1:-help}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status)  shift; cmd_status "$@" ;;
  version) shift; cmd_version "$@" ;;
  forge)   shift; cmd_forge "$@" ;;
  *) echo "usage: fleet_v2 {start|stop|restart|status|version|forge [nom]}" >&2; exit 1 ;;
esac
