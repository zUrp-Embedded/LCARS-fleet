#!/usr/bin/env bash
# SOURCE: bin/fleet_v2
# AUTHOR: starfleet
# STARDATE: 2026-06-15
# STATUS: PROTO-V2 — launcher humain. `fleet_v2 start` démarre la fleet SOUS l'humain, boote l'arch
#         (pod permanent), et attache l'humain à son REPL claude.
#
# Modèle (ADR-E / doctrine 2026-06-11) : la BEAM tourne *as* l'humain qui lance → le Port spawn les pods,
# qui HÉRITENT son UID (pas de systemd, pas de drop d'UID, pas de /var/lib/lcars). Les chemins d'état
# défautent déjà sous le home côté Elixir (state_fs_root / sock tmux / task-queue / audit → ~/.lcars/*,
# commit c368f89d). Ce launcher ne pose donc QUE le non-defaultable :
#   - les PORTS per-humain (offset déterministe sur l'UID → N fleets coexistent dans UN conteneur) ;
#   - la spec MCP (3 env requis sinon le pod ne lance pas : :mcp_server_spec_required) ;
#   - les on-switches (arch permanent + machine step-mode forge-driven).
#
# Config humaine : ~/.lcars/fleet_v2.env (cf. etc/fleet_v2.env.template) — forge (les projets sont
#         découverts par topic `lcars-fleet-<humain>`, plus de repo fixe surveillé).
# Gestes : fleet_v2 {start|stop|status}.

set -euo pipefail

SELF="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SELF")"
RUNTIME_DIR="$(dirname "$BIN_DIR")"          # bin/.. = l'umbrella
TMUX_BIN="${LCARS_TMUX_BIN:-tmux}"
SESSION="${LCARS_FLEET_V2_SESSION:-fleet_v2}"
DAEMON_SOCK="${LCARS_FLEET_V2_SOCK:-$HOME/.lcars/run/fleet_v2.sock}"
MIX_ENV_DEFAULT="${LCARS_FLEET_V2_MIX_ENV:-prod}"

die() { echo "fleet_v2: $*" >&2; exit 1; }
dtmux() { "$TMUX_BIN" -S "$DAEMON_SOCK" "$@"; }

# Bloc de ports per-humain (D2). Déterministe sur l'UID : bloc de 10 ports à partir de 21000.
# (uid % 500) → jusqu'à 500 humains avant collision de bloc ; au-delà, override explicite des ports.
compute_ports() {
  local uid base
  uid="$(id -u)"
  base=$(( 21000 + (uid % 500) * 10 ))
  API_PORT="${FLEET_API_PORT:-$base}"
  OBS_PORT="${LCARS_OBSERVATION_PORT:-$(( base + 1 ))}"
  # base+2 RÉSERVÉ (ex-port HTTP MCP pod-facing, retiré) : le transport MCP n'est plus un listener HTTP
  # partagé mais une socket AF_UNIX par pod (cf. LCARS_FLEET_MCP_SOCK_BASE). Slot laissé vide pour ne pas
  # décaler le port webhook ci-dessous.
  WEBHOOK_PORT="${LCARS_FLEET_WEBHOOK_PORT:-$(( base + 3 ))}"
}

setup_env() {
  local env_file="${LCARS_FLEET_V2_ENV:-$HOME/.lcars/fleet_v2.env}"
  # env humain fourni au runtime (pas un chemin constant) :
  # shellcheck source=/dev/null
  if [[ -f "$env_file" ]]; then set -a; . "$env_file"; set +a; fi

  # F-037 multi-projet : le poller DÉCOUVRE ses repos par topic (lcars-fleet-<human>) → plus de
  # LCARS_PILOT_POLL_REPO requis. La garde fail-loud porte désormais sur FORGE_BASE_URL (découverte +
  # push per-step-run), alignée sur la garde Elixir `Fleet.Pilot.Application.step_children!`.
  : "${FORGE_BASE_URL:?config manquante : FORGE_BASE_URL=http://forge (dans $env_file) — requis pour la découverte + le push}"

  compute_ports

  # Ports per-humain (lus par runtime.exs : fleet_api / fleet_observation / event_router).
  export FLEET_API_PORT="$API_PORT"
  export LCARS_OBSERVATION_PORT="$OBS_PORT"
  export LCARS_FLEET_WEBHOOK_PORT="$WEBHOOK_PORT"

  # Spec MCP — chemin du bridge stdio du pod (co-localisé avec ce launcher). Le transport pod↔central
  # n'est plus une URL HTTP loopback partagée mais une socket AF_UNIX per-pod (base posée plus bas,
  # LCARS_FLEET_MCP_SOCK_BASE) ; seul le chemin du bridge reste un env de spec MCP.
  export LCARS_FLEET_MCP_BRIDGE_PATH="${LCARS_FLEET_MCP_BRIDGE_PATH:-$BIN_DIR/fleet_mcp_stdio_bridge.py}"

  # Launchers pod (N0/N1) : depuis $BIN_DIR (= l'install /local/LCARS_v2/bin, OU le source en dev). Tout
  # sous l'install, ZÉRO copie éparpillée dans /usr/local/bin. Le dir parent est bindé RO dans le sandbox
  # (pod.ex `system_mounts`, dérivé de claude_launch_path). cap-profiles : PAS posé ici → la release lit
  # son priv bundlé (`:code.priv_dir`) ; le mode dev pointe le source (cf. cmd_start) — étanchéité prod.
  export LCARS_BWRAP_LAUNCH_PATH="${LCARS_BWRAP_LAUNCH_PATH:-$BIN_DIR/bwrap_launch.sh}"
  export LCARS_HOST_LAUNCH_PATH="${LCARS_HOST_LAUNCH_PATH:-$BIN_DIR/host_launch.sh}"
  export LCARS_CLAUDE_LAUNCH_PATH="${LCARS_CLAUDE_LAUNCH_PATH:-$BIN_DIR/claude_launch.sh}"

  # Sock tmux per-pod : défaut Elixir = ~/.lcars/run/tmux-sock (home, c368f89d). Exporté explicitement
  # pour que le wait + l'attach + le CLI `lcars` calculent le MÊME chemin.
  export LCARS_TMUX_SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}"

  # Base des sockets MCP per-pod (un canal AF_UNIX <base>/<pod_id>/sock par pod). MÊME logique que la
  # sock tmux ci-dessus : le défaut central (/run/lcars/mcp) n'est pas writable sans privilège quand un
  # HUMAIN lance la fleet → on pose un chemin sous son home. runtime.exs lit cet env comme base où le
  # central crée la socket, ET bwrap_launch.sh le lit pour binder le dir per-pod au même chemin absolu
  # dans le sandbox : UNE seule source pour les deux côtés.
  export LCARS_FLEET_MCP_SOCK_BASE="${LCARS_FLEET_MCP_SOCK_BASE:-$HOME/.lcars/run/mcp}"

  # CLI `lcars` → API per-humain.
  export LCARS_API_URL="${LCARS_API_URL:-http://localhost:$API_PORT}"

  # On-switches : l'arch boote (permanent), la machine step-mode tourne (forge-driven).
  export LCARS_BOOT_PERMANENT_AT_START=true
  export LCARS_PILOT_STEP="${LCARS_PILOT_STEP:-true}"

  # Distribution Erlang (node nommé, RPC debug) : gérée par MODE dans cmd_start, avec un nom DÉRIVÉ
  # PER-HUMAIN. ⚠ La release distribue `-sname fleet_umbrella` par DÉFAUT (nom FIXE partagé) → 2 humains =
  # même node dans l'epmd partagé = 2e BEAM CRASH (vu live lordzurp 2026-06-22). cmd_start force donc soit
  # un node per-humain (`fleet_<user>`, si LCARS_FLEET_V2_ERL_NODE set = debug), soit `RELEASE_DISTRIBUTION=
  # none` (normal : pas d'epmd, pas de collision). Per-humain comme les ports.

  mkdir -p "$LCARS_TMUX_SOCK_BASE" "$LCARS_FLEET_MCP_SOCK_BASE" "$(dirname "$DAEMON_SOCK")"

  # Persiste l'env runtime calculé pour que l'humain pilote `lcars` ensuite (`source` ce fichier).
  cat > "$HOME/.lcars/run/fleet_v2.runtime.env" <<RT
# Genere par fleet_v2 start — \`source\` pour utiliser lcars (spawn/list/attach) hors de cette session.
export LCARS_API_URL="$LCARS_API_URL"
export LCARS_TMUX_SOCK_BASE="$LCARS_TMUX_SOCK_BASE"
RT
}

cmd_start() {
  command -v "$TMUX_BIN" >/dev/null 2>&1 || die "tmux introuvable ($TMUX_BIN)"
  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    die "fleet_v2 déjà démarrée (« fleet_v2 status » / « fleet_v2 stop »)."
  fi
  setup_env

  local mix_env="${MIX_ENV:-$MIX_ENV_DEFAULT}"

  # Mode selon le déploiement (PARAMÈTRE, dérivé de la position de ce launcher — pas de hardcode) :
  #   - INSTALL (/local/LCARS_v2) : la RELEASE auto-contenue (`rel/.../bin/fleet_umbrella start`) tourne
  #     SANS le repo (priv bundlé, ERTS embarqué) → étanche.
  #   - SOURCE (dev) : `mix run --no-halt` depuis le repo (itération rapide) + cap-profiles LIVE du source.
  # Distribution Erlang PER-HUMAIN (cf. setup_env) : node `fleet_<user>` (jamais le `fleet_umbrella` fixe
  # partagé). ON seulement si LCARS_FLEET_V2_ERL_NODE est posé (debug RPC) ; sinon OFF (pas d'epmd).
  local erl_node="fleet_$(id -un)@127.0.0.1"
  local erl_cookie="${LCARS_FLEET_V2_ERL_COOKIE:-lcars}"
  local dist_on=""; [[ -n "${LCARS_FLEET_V2_ERL_NODE:-}" ]] && dist_on=1

  local rel_bin="$RUNTIME_DIR/rel/fleet_umbrella/bin/fleet_umbrella"
  local mode launch_cmd
  if [[ -x "$rel_bin" ]]; then
    mode="release"
    # Install RO (owner système) → le BEAM écrit son tmp dans le home de l'humain, pas dans l'install.
    export RELEASE_TMP="${RELEASE_TMP:-$HOME/.lcars/tmp}"
    mkdir -p "$RELEASE_TMP"
    # Override le défaut `-sname fleet_umbrella` (partagé → collision multi-humain).
    if [[ -n "$dist_on" ]]; then
      export RELEASE_DISTRIBUTION=name RELEASE_NODE="$erl_node" RELEASE_COOKIE="$erl_cookie"
    else
      export RELEASE_DISTRIBUTION=none
    fi
    launch_cmd="exec '$rel_bin' start"
  else
    mode="dev (mix run, MIX_ENV=$mix_env)"
    export LCARS_CAPPROFILES_ROOT="${LCARS_CAPPROFILES_ROOT:-$RUNTIME_DIR/apps/fleet_cap_profile/priv/canon/cap-profiles}"
    [[ -n "$dist_on" ]] && export ELIXIR_ERL_OPTIONS="-name $erl_node -setcookie $erl_cookie ${ELIXIR_ERL_OPTIONS:-}"
    launch_cmd="cd '$RUNTIME_DIR' && exec mix run --no-halt"
  fi

  echo "fleet_v2: démarrage du BEAM sous $(id -un) (uid $(id -u)) — $mode" >&2
  echo "fleet_v2: ports — API $API_PORT · obs $OBS_PORT · webhook $WEBHOOK_PORT" >&2
  echo "fleet_v2: découverte multi-projet par topic lcars-fleet-<humain> (F-037, plus de repo fixe)" >&2

  # Socket tmux DÉDIÉ (serveur frais) → capture l'env exporté ci-dessus. Le BEAM y tourne détaché, survit
  # à ce terminal. `start` (release) / `mix run --no-halt` (dev) : foreground tenu par le tmux.
  MIX_ENV="$mix_env" dtmux new-session -d -s "$SESSION" "$launch_cmd"
  # UI : molette = scroll du scrollback des logs BEAM (pas l'historique shell). cf. même geste dans `lcars attach`.
  dtmux set -g mouse on 2>/dev/null || true

  echo "fleet_v2: attente du boot de l'arch…" >&2
  local arch_sock="" arch_pod=""
  for _ in $(seq 1 120); do
    # Glob PRÉFIXE (pas `-*`) : depuis BL-055 l'id permanent est DÉTERMINISTE (`permanent-architect`,
    # sans `-<os_time>`) → le `-*` historique ne matchait plus jamais (timeout 120s, arch non attaché).
    arch_sock="$(ls -1d "$LCARS_TMUX_SOCK_BASE"/permanent-architect*/ 2>/dev/null | head -1 || true)"
    if [[ -n "$arch_sock" && -S "${arch_sock}pod.sock" ]]; then
      arch_pod="$(basename "${arch_sock%/}")"
      # F-ATTACH-RACE : le FICHIER sock apparaît une fraction avant que la session tmux INTERNE
      # (`lcars-pod-<id>`) y soit créée → on attend la SESSION, pas juste le sock, sinon le `lcars
      # attach` ci-dessous tire dans cette fenêtre → « no sessions » (alors que l'arch est vivant).
      "$TMUX_BIN" -S "${arch_sock}pod.sock" has-session -t "lcars-pod-$arch_pod" 2>/dev/null && break
    fi
    dtmux has-session -t "$SESSION" 2>/dev/null \
      || die "le BEAM s'est arrêté (logs : « $TMUX_BIN -S $DAEMON_SOCK attach -t $SESSION »)"
    sleep 1; arch_sock=""; arch_pod=""
  done
  [[ -n "$arch_pod" ]] || die "l'arch n'a pas booté en 120s (logs : « $TMUX_BIN -S $DAEMON_SOCK attach -t $SESSION »)"

  echo "fleet_v2: arch up ($arch_pod) — attache (Ctrl-b d = détacher sans tuer la fleet)" >&2
  exec "$BIN_DIR/lcars" attach "$arch_pod"
}

cmd_stop() {
  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    dtmux kill-server 2>/dev/null || true
    echo "fleet_v2: BEAM arrêté. (Pods éventuels reapés au prochain start par l'OrphanReaper.)" >&2
  else
    echo "fleet_v2: pas de fleet active." >&2
  fi
}

cmd_status() {
  # Version EN TÊTE : « quel build tourne ? » constatable d'un coup d'œil, sans aller lire build_info.txt
  # à la main (réutilise cmd_version, même donnée que `fleet_v2 version` / l'endpoint /api/version).
  cmd_version
  if dtmux has-session -t "$SESSION" 2>/dev/null; then
    echo "fleet_v2: BEAM vivant. Logs : $TMUX_BIN -S $DAEMON_SOCK attach -t $SESSION"
    LCARS_TMUX_SOCK_BASE="${LCARS_TMUX_SOCK_BASE:-$HOME/.lcars/run/tmux-sock}" \
      "$BIN_DIR/lcars" list 2>/dev/null || true
  else
    echo "fleet_v2: arrêtée."
  fi
}

# Version du build : constatable (« quel commit tourne ? »), pas déduite. MÊME donnée que
# l'endpoint REST /api/version et le log de boot (SHA git court + dirty + ref). Source selon le
# déploiement, comme cmd_start : en RELEASE le SHA est embarqué dans le priv au build (le repo
# n'est pas là), en SOURCE/dev on interroge git LIVE.
cmd_version() {
  local rel_root="$RUNTIME_DIR/rel/fleet_umbrella"
  local build_file
  build_file="$(ls -1 "$rel_root"/lib/fleet_api-*/priv/build_info.txt 2>/dev/null | head -1 || true)"

  if [[ -n "$build_file" && -f "$build_file" ]]; then
    # RELEASE : lire le fichier embarqué (clef=valeur, posé par write_build_info/1).
    local sha dirty ref dflag=""
    sha="$(sed -n 's/^sha=//p' "$build_file")"
    dirty="$(sed -n 's/^dirty=//p' "$build_file")"
    ref="$(sed -n 's/^ref=//p' "$build_file")"
    [[ "$dirty" == "true" ]] && dflag="-dirty"
    echo "fleet_v2: build ${sha:-unknown}${dflag} ref=${ref} (source=release)"
  else
    # SOURCE/dev : git LIVE dans le repo (échec git → unknown, jamais d'erreur dure).
    local sha ref dflag=""
    sha="$(git -C "$RUNTIME_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    ref="$(git -C "$RUNTIME_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    [[ -n "$(git -C "$RUNTIME_DIR" status --porcelain 2>/dev/null)" ]] && dflag="-dirty"
    echo "fleet_v2: build ${sha}${dflag} ref=${ref} (source=working_tree)"
  fi
}

case "${1:-help}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  status)  shift; cmd_status "$@" ;;
  version) shift; cmd_version "$@" ;;
  *) echo "usage: fleet_v2 {start|stop|status|version}" >&2; exit 1 ;;
esac
