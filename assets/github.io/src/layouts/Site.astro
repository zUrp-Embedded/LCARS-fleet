---
// Le SEUL squelette du site. Rail a deux niveaux (les pages, puis les sections de la page
// courante), bascule de theme, et pied de provenance. Aucune page ne redefinit tout ca :
// c'est la difference entre un site et cinq fichiers qui se ressemblent.
const { title, pages, current, sections = [] } = Astro.props;
const PAGES = [
  { href: '/',                 label: 'Ce que c’est' },
  { href: '/mecaniques/',      label: 'Comment ça marche' },
  { href: '/equipage/',        label: 'L’équipage' },
  { href: '/travailler-avec/', label: 'Travailler avec' },
  { href: '/mettre-en-route/', label: 'Mettre en route' }
];
const nav = pages ?? PAGES;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles/lcars.css" />
  <script is:inline>
    // Le theme AVANT le premier rendu, sinon la page clignote. Le choix du lecteur l'emporte
    // sur sa preference systeme ; sans choix, on ne pose rien et le media query decide.
    try { const t = localStorage.getItem('lcars-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <div class="shell">
    <nav class="rail" aria-label="Navigation">
      <a class="brand" href="/">LCARS</a>
      <p class="grp">Le site</p>
      {nav.map((p) => (
        <a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.label}</a>
      ))}
      {sections.length > 0 && <p class="grp">Cette page</p>}
      {sections.map((s, i) => (
        <a href={`#${s.id}`}><span class="n">{String(i + 1).padStart(2, '0')}</span>{s.label}</a>
      ))}
      <button class="themer" type="button" id="themer" aria-label="Basculer le thème">thème</button>
    </nav>

    <main><slot /></main>

    <footer class="foot">
      <span>LCARS &mdash; <b>Lightweight Contained Agent Resilient System</b></span>
      <span>build <b>{__COMMIT__}</b></span>
      <span><b>{__BUILT__}</b></span>
      <span>cartes, sièges et verdicts <b>lus dans le catalogue de ce commit</b></span>
    </footer>
  </div>
  <script is:inline>
    document.getElementById('themer')?.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('lcars-theme', next); } catch {}
    });
  </script>
</body>
</html>
