---
// LE MANUEL DE LA CONSOLE — page DERIVEE. Les verbes, leurs arguments, leurs options et les
// variables d'environnement viennent de `lib/cli.js`, qui lit les deux scripts. Ce qui est ecrit
// ici est la PROSE : ce qu'un `usage()` ne dit pas — pourquoi une commande refuse ce qu'elle
// refuse, et ce qu'elle ne fait pas.
//
// L'APPARIEMENT EST GARDE. Chaque verbe lu doit avoir sa prose, et chaque prose doit correspondre
// a un verbe lu : une commande ajoutee au script sans un mot ici, ou un paragraphe qui survit a la
// commande qu'il decrivait, CASSE LE BUILD. C'est la seule facon qu'un manuel ecrit a la main ne
// perime pas en silence — et il perimerait, personne ne relit un manuel pour verifier qu'il dit
// encore vrai.
import Site from '../layouts/Site.astro';
import SectionHead from '../components/SectionHead.astro';
import { fleetVerbs, fleetStartOptions, lcarsEntries, envVars } from '../lib/cli.js';

const verbs = fleetVerbs();
const startOpts = fleetStartOptions();
const entries = lcarsEntries();
const env = envVars();

// La prose, indexee par le verbe tel que le script l'ecrit.
const FLEET = {
  'start': `Démarre la fleet. Les rôles déclarés au boot — starfleet en tête — montent seuls,
            sans qu'on ait à les demander.`,
  'stop': `Arrêt gracieux, dans l'ordre : la fleet cesse d'accepter du nouveau travail, laisse
           finir ce qui est en vol, puis démonte. Si le BEAM ne répond plus, elle retombe sur un
           arrêt sec — et le dit.`,
  'restart': `stop puis start. C'est le geste qui applique un changement de catalogue ou de forge :
              la fleet gèle ses images au démarrage, rien de tout ça ne bascule à chaud.`,
  'status': `Trois réponses d'un coup : quelle version tourne, si le BEAM est vivant, et la liste
             des pods. Plus la commande pour aller lire les logs du daemon.`,
  'version': `Le commit qui tourne, pas celui qu'on croit avoir déployé. En release il est lu dans
              le build ; depuis les sources, demandé à git en direct. Un arbre modifié est marqué
              dirty, et une release n'a pas de branche : elle est bâtie depuis un commit, ce que la
              sortie dit au lieu d'afficher un champ vide.`,
  'forge [nom]': `Sans argument : la forge active et les profils disponibles. Avec un nom :
                  bascule vers ce profil, de façon persistante — le prochain démarrage l'utilise.
                  Un nom sans fichier de profil est refusé plutôt qu'inventé.`
};

const LCARS = {
  'lcars spawn': `Le dispatch est asynchrone : au retour, le pod n'est pas encore vivant. Un 202
                  veut dire « mis en file ». Un 422 dit que le rôle n'existe pas — le cap-profile
                  est validé avant l'accusé de réception, il n'y a plus de 202 menteur. Un 503 dit
                  que la fleet s'arrête.`,
  'lcars list': `Lu directement sur les sockets tmux, pas sur une API qui pourrait avoir une autre
                 opinion : la commande marche même quand le daemon ne répond plus. Une socket sans
                 session est signalée comme telle — un état nommé, pas un pod compté par erreur.`,
  'lcars ls': `Le dispatcher acceptait l'alias depuis toujours ; seul l'usage l'ignorait, ce qui en
               faisait une commande que personne n'instruisait.`,
  'lcars attach': `Ctrl-b d rend la main sans tuer le pod. La molette fait défiler l'historique ;
                   maintenir Maj pendant la sélection copie vers le presse-papier du système. Il
                   faut le même UID que le daemon — chacun attache ses propres pods, sans privilège
                   et sans cas particulier.`,
  'lcars catalogue list': `L'ordre des lignes est la précédence. Deux catalogues peuvent porter le
                           même nom — un livré, un apporté ; celui de l'opérateur gagne, et la
                           liste dit lequel masque l'autre : deux lignes identiques seraient
                           indiscernables d'un bug.`,
  'lcars catalogue install': `Trois transports, pour qu'une boîte sans accès disque en ait toujours
                              un sous la main. Installer n'active rien.`,
  'lcars catalogue verify': `Sans lui, un catalogue cassé se découvre au redémarrage suivant, par
                             quelqu'un qui ne fera pas le lien.`,
  'lcars catalogue enable': `Activer refuse un catalogue qui ne passe pas la vérification — c'est
                             ce refus qui rend l'étape précédente utile plutôt qu'optionnelle. Et
                             activer ne provisionne pas la forge : le catalogue devient lu, son org
                             et ses comptes de rôle n'existent pas pour autant. La commande nomme
                             le geste qui reste.`,
  'lcars catalogue remove': `Les catalogues livrés avec l'image ne se suppriment pas : ils
                             reviendraient à la prochaine mise à jour.`,
  'lcars project migrate': `Les deux moitiés, ou rien. Un transfert seul laisserait un projet qui
                            marche par accident, par la redirection que la forge laisse derrière
                            elle — jusqu'au jour où elle disparaît.`,
  'lcars help': null
};

// LA GARDE. Un verbe sans prose, ou une prose sans verbe, arrete le build.
const missing = [
  ...verbs.filter((v) => !(v in FLEET)).map((v) => `fleet_v2 « ${v} » n'a pas de prose`),
  ...Object.keys(FLEET).filter((k) => !verbs.includes(k)).map((k) => `la prose « ${k} » ne correspond à aucun verbe de fleet_v2`),
  ...entries.filter((e) => !(e.verb in LCARS)).map((e) => `lcars « ${e.verb} » n'a pas de prose`),
  ...Object.keys(LCARS).filter((k) => !entries.some((e) => e.verb === k)).map((k) => `la prose « ${k} » ne correspond à aucune entrée de lcars`)
];
if (missing.length > 0) {
  throw new Error(`manuel.astro : le manuel et les scripts ont divergé —\n  ${missing.join('\n  ')}`);
}

const sections = [
  { id: 'fleet', label: 'fleet_v2' },
  { id: 'lcars', label: 'lcars' },
  { id: 'env', label: 'Environnement' },
  { id: 'pas-des-commandes', label: 'Ce qui n’en est pas' }
];
---
<Site title="LCARS — Manuel de la console" current="/manuel/" sections={sections}>

  <header class="head">
    <div class="elbow" aria-hidden="true"></div>
    <div>
      <div class="caps" aria-hidden="true"><i></i><i></i><i></i></div>
      <p class="eyebrow">Manuel · console</p>
      <h1>Deux binaires,<br><em>{verbs.length + entries.length} gestes</em></h1>
      <p class="lede">Toute la conduite de la boîte tient dans deux commandes.
      <b>fleet_v2</b> tient la vie de la fleet — la démarrer, l'arrêter, savoir ce qui tourne.
      <b>lcars</b> tient ce qui vit dedans : les pods, les catalogues, les projets.</p>
      <p class="lede">Elles sont installées dans <code>/usr/local/bin</code>. Tout le reste —
      ouvrir un ticket, cadrer un projet, lancer un chantier — se demande à <b>starfleet</b>, dans
      sa console, en français.</p>
      <p class="sig">Les deux refusent plutôt que de deviner : un rôle inconnu, un profil de forge
      absent, un catalogue qui ne passe pas ses contrôles <b>ne produisent pas un
      demi-résultat</b>.</p>
    </div>
  </header>

  <section id="fleet">
    <SectionHead id="fleet" title="fleet_v2" cap={`la vie de la boîte — ${verbs.length} verbes`} />
    <p class="intro">Un daemon dans une session tmux. Il tourne sous <b>votre</b> UID : chaque
    humain lance sa fleet, et n'attache que ses propres pods.</p>

    <div class="entries">
      {verbs.map((v) => (
        <article class="entry" style="--k:var(--blue)">
          <div class="syn"><b>fleet_v2 {v}</b>{v === 'start' && <i>[{startOpts.map((o) => o.flag).join('] [')}]</i>}</div>
          <div class="bd">
            <p>{FLEET[v]}</p>
            {v === 'start' && (
              <dl class="kv">
                {startOpts.map((o) => (<><dt>{o.flag}</dt><dd>{o.text}</dd></>))}
              </dl>
            )}
            {v === 'start' && (
              <div class="warn"><b>Refus au démarrage si les credentials Claude manquent.</b> La
              fleet démarrerait très bien — et aucun pod ne pourrait penser. Un succès qui ne
              produit rien est pire qu'un refus.</div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="lcars">
    <SectionHead id="lcars" title="lcars" cap={`pods · catalogues · projets — ${entries.length} entrées`} />
    <p class="intro">Ce qui vit dans la boîte. <code>lcars</code> ne parle jamais à la forge
    lui-même : quand un geste en a besoin, il le passe au runtime et rend son verdict.</p>

    <div class="entries">
      {entries.map((e) => (
        <article class="entry" style="--k:var(--mauve)">
          <div class="syn"><b>{e.verb}</b>{e.args && <i>{e.args}</i>}</div>
          <div class="bd">
            <p>{e.text}</p>
            {LCARS[e.verb] && <p>{LCARS[e.verb]}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="env">
    <SectionHead id="env" title="Environnement" cap={`${env.length} variables, toutes avec un défaut`} />
    <p class="intro">Les ports sont dérivés de votre UID : deux humains sur la même machine ne se
    marchent pas dessus. <b>Aucun défaut statique ne peut donc être juste</b> — quand la valeur
    manque, les commandes le disent au lieu de tenter un port au hasard.</p>

    <dl class="kv">
      {env.map((v) => (<><dt>{v.name}</dt><dd><code>{v.fallback || '—'}</code> · {v.scope}</dd></>))}
    </dl>

    <p class="note">La porte d'écriture (spawn) passe par une socket AF_UNIX, pas par le réseau :
    elle est hors d'atteinte de ce que les pods peuvent joindre.</p>
  </section>

  <section id="pas-des-commandes">
    <SectionHead id="pas-des-commandes" title="Ce qui n'est pas une commande"
      cap="on le demande, on ne le tape pas" />
    <p class="intro">Créer un projet, en importer un, le cadrer, le mettre en pause : ces gestes
    existent, mais ils <b>ne se tapent pas dans un terminal</b>. On les demande à starfleet, en
    français, dans sa console — c'est lui qui tient le portefeuille.</p>

    <pre class="term"><span class="m"># dans la console de starfleet, pas dans un shell</span>

<span class="p">&gt;</span> <span class="c">montre-moi les cartes de workflow disponibles</span>
<span class="p">&gt;</span> <span class="c">importe le dépôt lordzurp/mon-projet, carte « livraison », criticité C2</span>
<span class="p">&gt;</span> <span class="c">mets le projet vitrine en pause, je reprends lundi</span></pre>

    <p class="note">La frontière n'est pas cosmétique : un shell exécute, starfleet arbitre. Un
    import demande une carte, une criticité et un cadrage — trois choses qu'une ligne de commande
    ne saurait pas réclamer au bon moment. <a href="/outils/">Les outils, par porteur →</a></p>
  </section>

</Site>
