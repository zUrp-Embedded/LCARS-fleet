# Force LF line endings (prevents CRLF issues in Docker/WSL)
*.sh text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# ── Binaires ─────────────────────────────────────────────────────────────────
# DECLARES, jamais devines. Sans ces lignes ces fichiers sont `unspecified` et
# leur sort depend de l'heuristique du client : un git Windows en
# `core.autocrlf=true` peut les prendre pour du texte et convertir leurs fins de
# ligne. La signature PNG porte justement un CRLF (`89 50 4e 47 0d 0a 1a 0a`) —
# un octet de controle place la POUR detecter ce cas. Une conversion transforme
# chaque `0d 0a` en `0d 0d 0a` : l'image est detruite, le diff n'en montre rien,
# et aucun gate ne mesure l'integrite d'un asset.
# Mesure du 2026-09-03 : les 23 binaires suivis sont sains.
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gz    binary
*.zip   binary
*.woff  binary
*.woff2 binary

# ── Briques vendorées ────────────────────────────────────────────────────────
# Code tiers copié tel quel dans l'arbre (voir <brique>/VENDOR.md).
#
# `linguist-vendored` exclut ces fichiers des statistiques de langage GitHub et
# les replie par défaut dans les diffs : ils ne doivent pas peser sur la mesure
# du code LCARS. Le chemin contient déjà `vendor/`, que Linguist détecte
# nativement — la déclaration explicite garantit le comportement quel que soit
# l'outil (GitHub, Gitea, cloc, tokei…).
fleet/vendor/** linguist-vendored=true
fleet/vendor/** linguist-generated=true

# ...sauf la couche LCARS, qui est du code à nous et doit être comptée et revue.
fleet/vendor/*/adapter.py           linguist-vendored=false
fleet/vendor/*/adapter.py           linguist-generated=false
fleet/vendor/*/lcars_*.py           linguist-vendored=false
fleet/vendor/*/lcars_*.py           linguist-generated=false
fleet/vendor/*/lcars_tests/**       linguist-vendored=false
fleet/vendor/*/lcars_tests/**       linguist-generated=false
fleet/vendor/*/run_tests.sh         linguist-vendored=false
fleet/vendor/*/update_vendor.sh     linguist-vendored=false
fleet/vendor/*/VENDOR.md            linguist-vendored=false
