# Force LF line endings (prevents CRLF issues in Docker/WSL)
*.sh text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# ── Briques vendorées ────────────────────────────────────────────────────────
# Code tiers copié tel quel dans l'arbre (voir <brique>/VENDOR.md).
#
# `linguist-vendored` exclut ces fichiers des statistiques de langage GitHub et
# les replie par défaut dans les diffs : ils ne doivent pas peser sur la mesure
# du code LCARS. Le chemin contient déjà `vendor/`, que Linguist détecte
# nativement — la déclaration explicite garantit le comportement quel que soit
# l'outil (GitHub, Gitea, cloc, tokei…).
fleet/runtime/vendor/** linguist-vendored=true
fleet/runtime/vendor/** linguist-generated=true

# ...sauf la couche LCARS, qui est du code à nous et doit être comptée et revue.
fleet/runtime/vendor/*/adapter.py           linguist-vendored=false
fleet/runtime/vendor/*/adapter.py           linguist-generated=false
fleet/runtime/vendor/*/lcars_*.py           linguist-vendored=false
fleet/runtime/vendor/*/lcars_*.py           linguist-generated=false
fleet/runtime/vendor/*/lcars_tests/**       linguist-vendored=false
fleet/runtime/vendor/*/lcars_tests/**       linguist-generated=false
fleet/runtime/vendor/*/run_tests.sh         linguist-vendored=false
fleet/runtime/vendor/*/update_vendor.sh     linguist-vendored=false
fleet/runtime/vendor/*/VENDOR.md            linguist-vendored=false
